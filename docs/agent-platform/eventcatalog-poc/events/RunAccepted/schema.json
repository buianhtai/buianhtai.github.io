{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:example:agent-platform:RunAccepted:0.1.0",
  "title": "RunAccepted",
  "description": "An admitted run was durably persisted with a pinned agent configuration.",
  "type": "object",
  "properties": {
    "runId": {
      "type": "string"
    },
    "agentVersionDigest": {
      "type": "string"
    },
    "acceptedAt": {
      "type": "string",
      "format": "date-time"
    },
    "sourceType": {
      "type": "string"
    },
    "traceId": {
      "type": "string"
    },
    "sessionId": {
      "type": "string"
    }
  },
  "required": [
    "runId",
    "agentVersionDigest",
    "acceptedAt"
  ],
  "additionalProperties": false
}
