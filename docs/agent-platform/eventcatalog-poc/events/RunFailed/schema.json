{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:example:agent-platform:RunFailed:0.1.0",
  "title": "RunFailed",
  "description": "An admitted run reached a terminal failure without a completed response.",
  "type": "object",
  "properties": {
    "runId": {
      "type": "string"
    },
    "safeErrorCode": {
      "type": "string"
    },
    "failedAt": {
      "type": "string",
      "format": "date-time"
    },
    "retryExhausted": {
      "type": "boolean"
    },
    "traceId": {
      "type": "string"
    }
  },
  "required": [
    "runId",
    "safeErrorCode",
    "failedAt"
  ],
  "additionalProperties": false
}
