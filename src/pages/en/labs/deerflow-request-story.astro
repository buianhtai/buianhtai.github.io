<script>
 // One authoritative view model coordinates chapters, events, boundaries and deep links.
 for(const root of document.querySelectorAll<HTMLElement>('[data-story-root]')){
  const tabs=[...root.querySelectorAll<HTMLButtonElement>('[data-scene-tab]')];
  const panels=[...root.querySelectorAll<HTMLElement>('[data-story-panel]')];
  const mobile=[...root.querySelectorAll<HTMLElement>('[data-mobile]')];
  const illustrations=[...root.querySelectorAll<HTMLElement>('[data-vignette]')];
  const protocolExamples=[...root.querySelectorAll<HTMLElement>('[data-story-example]')];
  const nodes=[...root.querySelectorAll<SVGGElement>('[data-node]')];
  const wires=[...root.querySelectorAll<SVGGElement>('[data-wire]')];
  const depthButtons=[...root.querySelectorAll<HTMLButtonElement>('[data-depth-button]')];
  const failureButtons=[...root.querySelectorAll<HTMLButtonElement>('[data-failure-button]')];
  const prev=root.querySelector<HTMLButtonElement>('[data-prev]');
  const next=root.querySelector<HTMLButtonElement>('[data-next]');
  const play=root.querySelector<HTMLButtonElement>('[data-play]');
  const counter=root.querySelector<HTMLElement>('[data-counter]');
  const progress=root.querySelector<HTMLElement>('[data-progress]');
  const meter=progress?.querySelector<HTMLElement>('span');
  const meterLabel=root.querySelector<HTMLOutputElement>('[data-meter-label]');
  const focusIndex=root.querySelector<HTMLElement>('[data-focus-index]');
  const focusTitle=root.querySelector<HTMLElement>('[data-focus-title]');
  const focusDescription=root.querySelector<HTMLElement>('[data-focus-description]');
  const codeFocus=root.querySelector<HTMLElement>('[data-code-focus]');
  const codeLine=root.querySelector<HTMLElement>('[data-code-line]');
  const codeSource=root.querySelector<HTMLAnchorElement>('[data-code-source]');
  const failureBox=root.querySelector<HTMLElement>('[data-failure-explanation]');
  const failureTitle=root.querySelector<HTMLElement>('[data-failure-title]');
  const failureDescription=root.querySelector<HTMLElement>('[data-failure-description]');
  const share=root.querySelector<HTMLButtonElement>('[data-share-view]');
  if(!prev||!next||!play||!counter||!progress||!meter||!meterLabel)continue;

  const chapters=[
   {nodes:['browser','nginx','gateway'],wires:['http1','http2']},
   {nodes:['gateway','worker','db'],wires:['sql','task']},
   {nodes:['browser','gateway','worker','bridge','model'],wires:['model','publish','subscribe','sse']},
   {nodes:['worker','model','bridge','tools'],wires:['model','publish','toolcall']},
   {nodes:['worker','db','bridge','gateway'],wires:['sql','subscribe','publish']},
   {nodes:['browser','gateway','bridge','db'],wires:['http1','subscribe','sql','sse']},
   {nodes:['gateway','worker','db'],wires:['task','sql']},
   {nodes:['browser','nginx','gateway','worker','db','bridge','model','tools'],wires:['http1','http2','task','sql','model','publish','subscribe','sse','toolcall']}
  ];
  const traceEvents=[
   {chapter:0,nodes:['browser','nginx','gateway'],wires:['http1','http2'],title:'React submits a run',detail:'Browser → Nginx → FastAPI · HTTP request',code:'POST /api/langgraph/threads/{id}/runs/stream',source:'frontend/src/core/api/api-client.ts'},
   {chapter:1,nodes:['gateway'],wires:[],title:'RunManager accepts ownership',detail:'Request validation, run identity and admission inside the Gateway',code:'run_mgr.create_or_reject(...)',source:'backend/app/gateway/services.py'},
   {chapter:1,nodes:['gateway','db'],wires:['sql'],title:'Optional run metadata persistence',detail:'RunStore writes metadata when persistent storage is configured',code:'RunStore · run status / ownership / journal',source:'backend/packages/harness/deerflow/runtime/runs/manager.py'},
   {chapter:1,nodes:['gateway','worker'],wires:['task'],title:'Async Python worker starts',detail:'FastAPI Gateway → process-local asyncio.Task',code:'asyncio.create_task(worker)',source:'backend/app/gateway/services.py'},
   {chapter:3,nodes:['worker','model'],wires:['model'],title:'LangGraph calls the model',detail:'Worker → model API · graph event streaming',code:'async for update in graph.astream(...):',source:'backend/packages/harness/deerflow/runtime/runs/worker.py'},
   {chapter:3,nodes:['worker','tools'],wires:['toolcall'],title:'Authorized tool execution',detail:'Permission enforcement → MCP or another tool adapter (optional)',code:'model proposal → authorization → adapter',source:'backend/packages/harness/deerflow/authz/enforcement.py'},
   {chapter:4,nodes:['worker','db'],wires:['sql'],title:'Graph state checkpoint',detail:'Configured LangGraph checkpointer · not the RunStore record',code:'Checkpointer → graph/thread state',source:'backend/packages/harness/deerflow/runtime/runs/worker.py'},
   {chapter:2,nodes:['worker','bridge','gateway','browser'],wires:['publish','subscribe','sse'],title:'StreamBridge delivers events',detail:'Worker → StreamBridge → Gateway → SSE browser stream',code:'publish(event) → subscribe() → SSE',source:'backend/app/gateway/services.py'},
   {chapter:2,nodes:['gateway','browser'],wires:['sse'],title:'Terminal stream signal',detail:'SSE completion frame to the React client',code:'event: end\ndata: null',source:'backend/app/gateway/services.py'}
  ];
  const chapterEvents=[0,3,7,5,6,7,3,8];
  const failures={
   disconnect:{chapter:5,event:7,nodes:['browser','gateway','bridge'],wires:['subscribe','sse'],title:'SSE connection interrupted',detail:'The browser stream may disappear while the run continues. Reconnect using a cursor when available; reload durable thread state if the buffered event gap cannot be replayed.'},
   denied:{chapter:3,event:5,nodes:['worker','tools'],wires:['toolcall'],title:'Tool execution denied',detail:'A model can propose an action, but execution-time permissions can stop it. Do not assume that a denied tool has made an external change.'},
   crash:{chapter:6,event:3,nodes:['gateway','worker','db'],wires:['task','sql'],title:'Worker interrupted or ownership stale',detail:'A lease detects stale ownership, not the outcome of external side effects. Reconcile state and tool outcomes before deciding whether to retry.'}
  };
  type Failure = 'normal'|'disconnect'|'denied'|'crash';
  type Depth = 'overview'|'components'|'code';
  let current=0,selectedEvent=0,depth:Depth='components',failure:Failure='normal',focus:'chapter'|'event'='chapter';
  let timer:number|undefined;
  const clamp=(v:number,max:number)=>Number.isInteger(v)?Math.max(0,Math.min(max,v)):0;
  const revealStory=()=>{
   const nav=root.querySelector<HTMLElement>('.chapters');if(!nav)return;
   nav.scrollIntoView({block:'start',behavior:window.matchMedia('(prefers-reduced-motion: reduce)').matches?'auto':'smooth'});
  };
  const stop=()=>{if(timer!==undefined){clearInterval(timer);timer=undefined;}play.setAttribute('aria-pressed','false');play.querySelector('span')!.textContent='Play story';};
  const syncTimeline=()=>{
   document.dispatchEvent(new CustomEvent('deerflow:trace-set',{detail:{index:selectedEvent}}));
  };
  const syncUrl=()=>{
   const url=new URL(location.href);
   url.searchParams.set('chapter',String(current+1));
   url.searchParams.set('event',String(selectedEvent+1));
   url.searchParams.set('depth',depth);
   url.searchParams.set('view',focus);
   if(failure==='normal')url.searchParams.delete('failure');
   else url.searchParams.set('failure',failure);
   history.replaceState(null,'',url.pathname+url.search+url.hash);
  };
  const render=(writeUrl=true,syncTrace=true)=>{
   root.dataset.scene=String(current);root.dataset.depth=depth;
   tabs.forEach((b,i)=>{b.classList.toggle('selected',i===current);b.setAttribute('aria-pressed',String(i===current));});
   panels.forEach((p,i)=>{p.hidden=i!==current;});
   mobile.forEach((p,i)=>{p.hidden=i!==current;});
   illustrations.forEach(el=>{el.hidden=Number(el.dataset.vignette)!==current;});
   protocolExamples.forEach(el=>{el.hidden=Number(el.dataset.storyExample)!==current;});
   const fault=failure==='normal'?null:failures[failure];
   const diagram=fault||(focus==='event'?traceEvents[selectedEvent]:chapters[current]);
   nodes.forEach(n=>n.classList.toggle('on',diagram.nodes.includes(n.dataset.node||'')));
   wires.forEach(w=>w.classList.toggle('on',diagram.wires.includes(w.dataset.wire||'')));
   depthButtons.forEach(b=>b.setAttribute('aria-pressed',String(b.dataset.depthButton===depth)));
   failureButtons.forEach(b=>b.setAttribute('aria-pressed',String(b.dataset.failureButton===failure)));
   if(focusIndex)focusIndex.textContent=focus==='event'||fault?'EVENT '+String(selectedEvent+1).padStart(2,'0')+' / 09':'CHAPTER '+String(current+1).padStart(2,'0')+' / 08';
   if(focusTitle)focusTitle.textContent=fault?fault.title:focus==='event'?traceEvents[selectedEvent].title:'System view · '+(tabs[current]?.querySelector('strong')?.textContent||'');
   if(focusDescription)focusDescription.textContent=fault?fault.detail:traceEvents[selectedEvent].detail;
   if(codeFocus)codeFocus.hidden=depth!=='code';
   if(codeLine)codeLine.textContent=traceEvents[selectedEvent].code;
   if(codeSource)codeSource.href=(root.dataset.sourceRoot||'')+traceEvents[selectedEvent].source;
   if(failureBox)failureBox.hidden=!fault;
   if(failureTitle)failureTitle.textContent=fault?.title||'';
   if(failureDescription)failureDescription.textContent=fault?.detail||'';
   counter.textContent=String(current+1).padStart(2,'0')+' / 08';
   meterLabel.textContent=counter.textContent;
   progress.setAttribute('aria-valuenow',String(current+1));meter.style.width=((current+1)/8*100)+'%';
   prev.disabled=current===0;next.disabled=current===7;
   if(syncTrace)syncTimeline();
   if(writeUrl)syncUrl();
  };
  const chooseChapter=(n:number,scroll=true)=>{
   stop();current=clamp(n,7);selectedEvent=chapterEvents[current];focus='chapter';failure='normal';
   render();if(scroll)revealStory();
  };
  const chooseEvent=(n:number)=>{
   stop();selectedEvent=clamp(n,8);current=traceEvents[selectedEvent].chapter;focus='event';failure='normal';
   render(true,false); // Trace widget has already updated its own selection.
  };
  const chooseFailure=(value:Failure)=>{
   stop();failure=value;
   if(value==='normal'){focus='chapter';selectedEvent=chapterEvents[current];}
   else{const fault=failures[value];current=fault.chapter;selectedEvent=fault.event;focus='event';}
   render();
  };
  tabs.forEach((b,i)=>b.addEventListener('click',()=>chooseChapter(i)));
  prev.addEventListener('click',()=>chooseChapter(current-1));
  next.addEventListener('click',()=>chooseChapter(current+1));
  depthButtons.forEach(b=>b.addEventListener('click',()=>{depth=(b.dataset.depthButton||'components') as Depth;render();}));
  failureButtons.forEach(b=>b.addEventListener('click',()=>chooseFailure((b.dataset.failureButton||'normal') as Failure)));
  document.addEventListener('deerflow:trace-selected',(e:Event)=>{
   const index=(e as CustomEvent<{index:number}>).detail?.index;
   if(typeof index==='number')chooseEvent(index);
  });
  play.addEventListener('click',()=>{
   if(timer!==undefined){stop();return;}
   if(current===7){current=0;selectedEvent=0;focus='chapter';failure='normal';render();}
   revealStory();play.setAttribute('aria-pressed','true');play.querySelector('span')!.textContent='Pause';
   timer=window.setInterval(()=>{
    if(current===7){stop();return;}
    current++;selectedEvent=chapterEvents[current];focus='chapter';failure='normal';render();
    if(current===7)stop();
   },4200);
  });
  if(share)share.addEventListener('click',async()=>{
   syncUrl();
   try{await navigator.clipboard.writeText(location.href);
    const label=share.querySelector<HTMLElement>('span');
    if(label)label.textContent='Link copied';
   }catch{const label=share.querySelector<HTMLElement>('span');if(label)label.textContent='Copy URL from address bar';}
  });
  document.addEventListener('visibilitychange',()=>{if(document.hidden)stop();});
  tabs.forEach(b=>b.addEventListener('keydown',e=>{
   if(e.key!=='ArrowRight'&&e.key!=='ArrowLeft')return;
   e.preventDefault();const i=e.key==='ArrowRight'?(current+1)%8:(current+7)%8;
   chooseChapter(i);tabs[i]?.focus();
  }));
  const loadUrl=()=>{
   const p=new URLSearchParams(location.search);
   const d=p.get('depth');depth=d==='overview'||d==='code'?d:'components';
   const f=p.get('failure');failure=f==='disconnect'||f==='denied'||f==='crash'?f:'normal';
   current=clamp(Number(p.get('chapter')||1)-1,7);
   selectedEvent=clamp(Number(p.get('event')||chapterEvents[current]+1)-1,8);
   focus=p.get('view')==='event'?'event':'chapter';
   if(failure!=='normal'){const fault=failures[failure];current=fault.chapter;selectedEvent=fault.event;focus='event';}
   else if(focus==='event')current=traceEvents[selectedEvent].chapter;
   render(false);
  };
  window.addEventListener('popstate',()=>{stop();loadUrl();});
  loadUrl();
 }
</script>