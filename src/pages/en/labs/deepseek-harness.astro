---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ArchitectureExplorer from '../../../components/labs/ArchitectureExplorer.astro';
import model from '../../../data/architecture/deepseek-harness.json';
import snippets from '../../../data/architecture/deepseek-harness-excerpts.json';
/**
 * Editorial boundaries organize the reading experience, not runtime call order.
 * Keep these separate from the generated manifest/import evidence model.
 */
const visualModel = {
  ...model,
  sourceExcerpts: snippets.excerpts,
  visualZones: {
    system: [
      { label: 'Entry & assembly', note: 'Remote sessions and plugin composition', nodes: ['boot', 'api'] },
      { label: 'Execution core', note: 'Agent behavior and external capabilities', nodes: ['core', 'capabilities'] },
      { label: 'Services & state', note: 'Model access and durable session records', nodes: ['llm', 'session'] },
    ],
    core: [
      { label: 'Contracts', note: 'The agent interface and scoped events', nodes: ['core-agent', 'core-scope'] },
      { label: 'Run & tools', note: 'The driver and tool execution pipeline', nodes: ['core-agent-loop', 'core-tools'] },
      { label: 'Context', note: 'Prompts and session history', nodes: ['core-system-prompt', 'core-session'] },
    ],
    loop: [
      { label: 'Lifecycle & input', note: 'Start, resume and claim work', nodes: ['file-index.ts', 'file-inbox.ts'] },
      { label: 'Turn execution', note: 'Advance the model and tools', nodes: ['file-agent.ts', 'file-assistant-stream.ts', 'file-tool-calls.ts'] },
      { label: 'Context & policy', note: 'Runtime setup and concurrency limits', nodes: ['file-runtime-context.ts', 'file-constants.ts'] },
    ],
  },
};
---
<BaseLayout title="DeepSeek Harness — architecture explorer" description="Explore DeepSeek Harness through a revision-pinned component map, package dependencies, agent-loop source files and a guided turn walkthrough." noindex>
  <div class="harness-page"><a class="return-link" href="/en/blog/">← Engineering notes / Architecture lab</a><ArchitectureExplorer model={visualModel} /></div>
</BaseLayout>
<style>.harness-page{width:min(1700px,calc(100% - 2rem));margin:1.5rem auto 3rem;}.return-link{display:inline-block;margin-bottom:1rem;font-size:.8rem;color:var(--color-text-muted);}@media(max-width:640px){.harness-page{width:calc(100% - 1rem);}}</style>
