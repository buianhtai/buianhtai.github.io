-size:.72rem!important}.reading{padding:50px 0 15px}.reading h2{font-size:clamp(1.6rem,3vw,2.6rem);letter-spacing:-.05em;margin:6px 0 25px}.reading-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}.reading article{border:1px solid var(--x-border);background:var(--x-panel);border-radius:10px;padding:22px}.reading h3{font-size:1.04rem}.reading p{line-height:1.7;color:var(--x-muted);font-size:.81rem}.next{margin:30px 0;color:var(--x-muted);line-height:1.75}.code-xray :is(button,[role=button],a):focus-visible{outline:3px solid var(--x-accent);outline-offset:2px}
