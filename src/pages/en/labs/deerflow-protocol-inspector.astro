---
import BaseLayout from '../../../layouts/BaseLayout.astro';
const revision='1f15e0b43ca58b9601514f9f5c408fb032022833';
const root='https://github.com/bytedance/deer-flow/blob/'+revision+'/';
const steps=[
 {id:'request',group:'HTTP',title:'01 · Run request',who:'Browser → Nginx → Gateway',transport:'HTTP POST',state:'No run yet',wire:'POST /api/langgraph/threads/{thread_id}/runs/stream HTTP/1.1\nContent-Type: application/json\nAccept: text/event-stream\n\n{\n  "assistant_id": "<configured assistant>",\n  "input": {"messages": [{"role":"human","content":"Investigate incident"}]},\n  "on_disconnect": "continue"\n}',detail:'The React client submits a run request through the Nginx rewrite to FastAPI. This example is representative and is not a captured packet.',source:'frontend/src/core/api/api-client.ts'},
 {id:'admit',group:'RUNTIME',title:'02 · Admission and ownership',who:'Gateway → RunManager',transport:'Python call',state:'PENDING → RUNNING',wire:'start_run(request)\n  → RunManager.create_or_reject(...)\n  → optional persistent RunStore record\n  → asyncio.create_task(worker)\n\nNo default Kafka / RabbitMQ dispatch.',detail:'The run identity and admission logic are distinct from graph checkpoints. Persistence and ownership behaviour depend on configuration.',source:'backend/app/gateway/services.py'},
 {id:'headers',group:'SSE',title:'03 · Open response',who:'Gateway → Browser',transport:'HTTP response',state:'RUNNING',wire:'HTTP/1.1 200 OK\nContent-Type: text/event-stream\nCache-Control: no-cache\n\n: connection established',detail:'The response remains open. The SSE consumer subscribes to StreamBridge; SSE is delivery, not task scheduling.',source:'backend/app/gateway/services.py'},
 {id:'model',group:'RUNTIME',title:'04 · Graph and model',who:'Worker → LangGraph → Model',transport:'async graph stream',state:'RUNNING',wire:'async for event in graph.astream(...):\n    await bridge.publish(event)\n\n# Illustrative control flow; event modes vary.',detail:'The worker advances graph execution and publishes updates independently of the browser receiving them.',source:'backend/packages/harness/deerflow/runtime/runs/worker.py'},
 {id:'delta',group:'SSE',title:'05 · Stream event',who:'StreamBridge → Gateway → Browser',transport:'SSE frame',state:'RUNNING',wire:'id: <stream-event-id>\nevent: <stream-mode>\ndata: {"event":"<illustrative update>"}\n\n: heartbeat',detail:'Each SSE frame is an event-delivery unit; it is not a checkpoint nor a durable tool commit. The wire format here is illustrative.',source:'backend/app/gateway/services.py'},
 {id:'checkpoint',group:'STATE',title:'06 · Graph checkpoint',who:'LangGraph → Checkpointer',transport:'State persistence',state:'RUNNING',wire:'Checkpoint: graph / thread state\nRunStore: run identity, status, ownership\nStreamBridge: event delivery / optional replay\n\nThese are separate state responsibilities.',detail:'A graph checkpoint allows reconstruction of graph state at a configured boundary. It does not establish exactly-once external side effects.',source:'backend/packages/harness/deerflow/runtime/runs/worker.py'},
 {id:'end',group:'SSE',title:'07 · Completion',who:'Worker → Bridge → Browser',transport:'SSE terminal frame',state:'SUCCEEDED (illustrative)',wire:'event: end\ndata: null\n\n# The run metadata is reconciled separately.',detail:'The end-of-stream signal tells the subscriber delivery has finished. The run record and durable thread state are separate sources.',source:'backend/app/gateway/services.py'},
 {id:'disconnect',group:'FAILURE',title:'08 · Disconnected client',who:'Browser → Gateway',transport:'Rejoin / stream cursor',state:'Run may still be RUNNING',wire:'Last-Event-ID: <previous-event-id>\n\n# Missing replay window (illustrative):\nevent: gap\ndata: {"code":"stream_replay_gap",\n       "recovery":"reload_durable_state"}',detail:'A lost network connection does not prove execution stopped. Reconnect to the existing run; if replay is unavailable, reload durable thread state.',source:'backend/app/gateway/services.py'},
 {id:'cancel',group:'FAILURE',title:'09 · Cancellation',who:'Client → Gateway → RunManager',transport:'HTTP control / task lifecycle',state:'CANCELLING → terminal',wire:'Client requests cancellation\n  → Gateway authorizes request\n  → runtime signals active task\n  → reconcile run metadata\n\n# Conceptual lifecycle, not an exact wire schema.',detail:'Cancellation is a runtime control operation, not just closing SSE. In-flight tool side effects need their own handling.',source:'backend/packages/harness/deerflow/runtime/runs/manager.py'},
 {id:'crash',group:'FAILURE',title:'10 · Stale worker',who:'RunManager ↔ RunStore',transport:'Lease / reconcile',state:'Stale ownership → inspect',wire:'Worker crashes or loses ownership\n  → lease may expire\n  → inspect status + checkpoint\n  → verify external tool outcome\n  → decide whether retry is safe\n\nNever assume exactly-once effects.',detail:'Recovery is configuration dependent; automatic retry may duplicate an already executed external operation.',source:'backend/packages/harness/deerflow/runtime/runs/run_ownership_config.py'}
];
---
<BaseLayout title="DeerFlow protocol & runtime inspector" description="Interactive source-backed walkthrough of HTTP, SSE, runtime state, checkpoints and recovery.">
<main class="lab">
<header class="hero"><a class="back" href="/en/labs/deerflow-request-story/">← Return to the eight-chapter request story</a><p class="eyebrow">DEERFLOW 2.0 / ENGINEERING LAB</p><h1>Trace the request.<br/><em>Inspect the wire.</em></h1><p class="lede">A source-backed teaching model for HTTP admission, SSE streaming, state ownership and failure recovery. Select each event to see its payload, execution boundary and implementation file.</p><div class="notice">Conceptual trace, not production telemetry. Header/event examples are illustrative and optional storage/transport depends on deployment configuration.</div></header>
<section class="workspace" data-inspector>
<div class="topline"><div><span class="eyebrow">INTERACTIVE EXECUTION</span><h2>Protocol & runtime inspector</h2></div><div class="controls"><button type="button" data-play>▶ Play sequence</button><button type="button" data-reset>↺ Reset</button></div></div>
<div class="filters" role="group" aria-label="Trace filter"><button data-filter="ALL" aria-pressed="true">All events</button><button data-filter="HTTP" aria-pressed="false">HTTP</button><button data-filter="SSE" aria-pressed="false">SSE</button><button data-filter="RUNTIME" aria-pressed="false">Runtime</button><button data-filter="STATE" aria-pressed="false">State</button><button data-filter="FAILURE" aria-pressed="false">Recovery</button></div>
<div class="columns"><aside class="timeline" aria-label="Select an execution event">{steps.map((s,i)=><button class="event" type="button" data-step={i} data-group={s.group} aria-pressed={i===0}><span class="num">{String(i+1).padStart(2,'0')}</span><span class="evtext"><small>{s.group} · {s.transport}</small><strong>{s.title}</strong></span></button>)}</aside>
<div class="inspect"><div class="meta"><span data-group-label>HTTP</span><span data-state> No run yet</span></div><h3 data-title>01 · Run request</h3><p class="path" data-who>Browser → Nginx → Gateway</p><div class="wiretop"><strong>WIRE / EXECUTION DETAIL</strong><button type="button" data-copy>Copy payload</button></div><pre><code data-wire></code></pre><p class="explain" data-detail></p><div class="source"><span>PINNED SOURCE</span><a target="_blank" rel="noopener noreferrer" data-source href={root+steps[0].source}>{steps[0].source} ↗</a></div><div class="nav"><button data-prev type="button">← Previous</button><span data-counter>1 / 10</span><button data-next type="button">Next →</button></div></div></div>
</section>
<section class="below"><h2>Explore the third lens: architectural patterns</h2><p>Go beyond sequence diagrams: compare the intent, trade-offs and alternatives behind each DeerFlow boundary.</p><a href="/en/labs/deerflow-pattern-atlas/">Open the interactive Design Pattern Atlas →</a></section>\n<section class="below"><h2>Three different state owners</h2><div class="states"><article><small>01 / RUNSTORE</small><h3>Run lifecycle</h3><p>Admission, status, ownership and optional persisted run records. A run ID is not a checkpoint.</p><a href={root+'backend/packages/harness/deerflow/runtime/runs/manager.py'}>Inspect manager ↗</a></article><article><small>02 / CHECKPOINTER</small><h3>Graph execution state</h3><p>Thread and graph snapshots at configured checkpoint boundaries. Not an external side-effect ledger.</p><a href={root+'backend/packages/harness/deerflow/runtime/runs/worker.py'}>Inspect worker ↗</a></article><article><small>03 / STREAMBRIDGE</small><h3>Event delivery</h3><p>Publish/subscribe transport and optional replay. Not a durable queue or task scheduler.</p><a href={root+'backend/packages/harness/deerflow/runtime/stream_bridge/base.py'}>Inspect bridge ↗</a></article></div></section>
<section class="below"><h2>Concurrency & recovery mental model</h2><div class="sequence"><div>Browser<div class="sub">HTTP / SSE</div></div><span>→</span><div>Gateway<div class="sub">Run admission</div></div><span>→</span><div>asyncio.Task<div class="sub">Worker execution</div></div><span>⇄</span><div>LangGraph<div class="sub">Checkpoint + tools</div></div><span>→</span><div>StreamBridge<div class="sub">Publish / replay</div></div></div><p>The diagram shows one logical run, not a guarantee of process isolation. Multiple concurrent runs may share a Python process; ownership and storage topology govern cross-worker safety. Disconnect, cancellation and worker failure require different recovery decisions.</p><a href="/en/blog/deerflow-2-agent-harness-architecture/">Read the full technical deep dive ↗</a></section>
</main>
<script define:vars={{steps}}>
const root=document.querySelector('[data-inspector]');
if(root){
 let active=0,filter='ALL',timer=null;
 const all=[...root.querySelectorAll('[data-step]')];
 const get=(s)=>root.querySelector('[data-'+s+']');
 function visible(){return all.filter(el=>!el.hidden).map(el=>Number(el.dataset.step));}
 function render(index){
  active=index;const s=steps[active];
  get('title').textContent=s.title;get('who').textContent=s.who;get('wire').textContent=s.wire;
  get('detail').textContent=s.detail;get('state').textContent=s.state;get('group-label').textContent=s.group;
  get('source').textContent=s.source+' ↗';get('source').href='https://github.com/bytedance/deer-flow/blob/1f15e0b43ca58b9601514f9f5c408fb032022833/'+s.source;
  get('counter').textContent=(active+1)+' / '+steps.length;
  all.forEach(el=>el.setAttribute('aria-pressed',String(Number(el.dataset.step)===active)));
  if(!all[active].hidden)all[active].scrollIntoView({block:'nearest',behavior:'smooth'});
 }
 function stop(){if(timer){clearInterval(timer);timer=null;}get('play').textContent='▶ Play sequence';}
 function shift(direction){const ids=visible();const at=ids.indexOf(active);render(ids[(at+direction+ids.length)%ids.length]);}
 root.querySelectorAll('[data-filter]').forEach(el=>el.addEventListener('click',()=>{stop();filter=el.dataset.filter;root.querySelectorAll('[data-filter]').forEach(b=>b.setAttribute('aria-pressed',String(b===el)));all.forEach(b=>b.hidden=filter!=='ALL'&&b.dataset.group!==filter);render(visible()[0]);}));
 all.forEach(el=>el.addEventListener('click',()=>{stop();render(Number(el.dataset.step));}));
 get('prev').addEventListener('click',()=>{stop();shift(-1);});get('next').addEventListener('click',()=>{stop();shift(1);});
 get('reset').addEventListener('click',()=>{stop();root.querySelector('[data-filter="ALL"]').click();});
 get('play').addEventListener('click',()=>{if(timer){stop();return;}get('play').textContent='Ⅱ Pause';timer=setInterval(()=>{const ids=visible();const at=ids.indexOf(active);if(at===ids.length-1){stop();return;}render(ids[at+1]);},2100);});
 get('copy').addEventListener('click',async()=>{try{await navigator.clipboard.writeText(steps[active].wire);get('copy').textContent='Copied';setTimeout(()=>get('copy').textContent='Copy payload',1200);}catch{get('copy').textContent='Copy unavailable';}});
 const params=new URLSearchParams(location.search);const requested=params.get('step');const match=steps.findIndex(s=>s.id===requested);render(match>=0?match:0);
}
</script>
<style>
:root{color-scheme:light dark}.lab{--bg:#0e1a25;--panel:#172736;--line:#34495b;--ink:#f0f5f9;--muted:#b3c4d0;--accent:#77dcc8;background:var(--bg);color:var(--ink);min-height:100vh;padding:clamp(22px,4vw,65px);font-family:Inter,system-ui,sans-serif}.lab *{box-sizing:border-box}.hero,.workspace,.below{max-width:1260px;margin:0 auto}.back{color:var(--accent);font-size:.85rem;text-decoration:none}.eyebrow{font:700 .68rem/1.4 ui-monospace,monospace;letter-spacing:.13em;color:var(--accent)}.hero h1{font-size:clamp(2.5rem,6vw,5.4rem);letter-spacing:-.06em;line-height:1.03;margin:18px 0}.hero h1 em{color:var(--accent);font-style:normal}.lede{font-size:clamp(1rem,1.8vw,1.22rem);max-width:750px;line-height:1.7;color:var(--muted)}.notice{margin:25px 0 40px;border-left:3px solid var(--accent);padding:12px 18px;background:var(--panel);font-size:.83rem;line-height:1.6;color:var(--muted)}.workspace{background:var(--panel);border:1px solid var(--line);border-radius:18px;overflow:hidden}.topline{padding:24px;display:flex;justify-content:space-between;gap:16px;align-items:center;flex-wrap:wrap}.topline h2,.below h2{margin:6px 0;font-size:clamp(1.4rem,2.4vw,2rem);letter-spacing:-.04em}.controls,.filters{display:flex;flex-wrap:wrap;gap:8px}button{cursor:pointer;font:inherit}button:focus-visible,a:focus-visible{outline:3px solid var(--accent);outline-offset:2px}.controls button,.filters button,.nav button,.wiretop button{background:transparent;color:var(--ink);border:1px solid var(--line);border-radius:8px;padding:9px 12px}.controls button:hover,.filters button[aria-pressed=true],.filters button:hover,.nav button:hover{background:#24685f;border-color:#4cb5a3;color:white}.filters{padding:0 24px 22px}.filters button{font-size:.75rem}.columns{display:grid;grid-template-columns:minmax(260px,35%) minmax(0,1fr);border-top:1px solid var(--line)}.timeline{max-height:710px;overflow:auto;border-right:1px solid var(--line);padding:14px}.event{display:flex;align-items:flex-start;gap:12px;background:transparent;border:1px solid transparent;border-radius:9px;color:var(--ink);width:100%;text-align:left;padding:15px 12px}.event[hidden]{display:none}.event[aria-pressed=true]{background:#234b55;border-color:#4db8a9}.event:hover{background:#203a4c}.num{font:700 .75rem ui-monospace,monospace;color:var(--accent)}.evtext{min-width:0;display:grid;gap:5px}.evtext small{font:.62rem ui-monospace,monospace;color:var(--muted)}.evtext strong{font-size:.88rem;line-height:1.45}.inspect{min-width:0;padding:clamp(16px,3vw,30px)}.meta{display:flex;gap:10px;flex-wrap:wrap}.meta span{border:1px solid var(--line);padding:6px 10px;border-radius:50px;font:.68rem ui-monospace,monospace;color:var(--accent)}.inspect h3{font-size:clamp(1.45rem,2.4vw,2.1rem);letter-spacing:-.045em;margin:22px 0 6px}.path{color:var(--muted);font-size:.84rem}.wiretop{display:flex;align-items:center;justify-content:space-between;gap:8px;margin-top:28px;font:.65rem ui-monospace,monospace;letter-spacing:.05em}.wiretop button{font-size:.7rem}.inspect pre{background:#0a1520;color:#b8f2de;border:1px solid var(--line);padding:20px;border-radius:10px;white-space:pre-wrap;overflow-wrap:anywhere;line-height:1.7;font-size:.77rem;min-height:215px}.inspect code{white-space:inherit}.explain{color:var(--muted);font-size:.9rem;line-height:1.75}.source{padding:16px 0;border-top:1px solid var(--line);display:grid;gap:7px}.source span{font:.63rem ui-monospace,monospace;color:var(--muted)}.source a,.below a{color:var(--accent);overflow-wrap:anywhere;font-size:.81rem}.nav{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-top:18px}.nav span{font:.75rem ui-monospace,monospace;color:var(--muted)}.below{padding:48px 0 15px}.below>p{line-height:1.8;color:var(--muted);max-width:920px}.states{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px;margin-top:22px}.states article{border:1px solid var(--line);background:var(--panel);padding:24px;border-radius:12px}.states small{color:var(--accent);font:.68rem ui-monospace,monospace}.states h3{font-size:1.14rem;margin-bottom:8px}.states p{color:var(--muted);font-size:.83rem;line-height:1.7}.sequence{display:flex;gap:10px;flex-wrap:wrap;align-items:center;margin:24px 0}.sequence>div{flex:1;min-width:110px;background:var(--panel);border:1px solid var(--line);border-radius:9px;padding:14px;text-align:center;font-size:.8rem;font-weight:700}.sequence .sub{font-size:.65rem;color:var(--muted);font-weight:400;margin-top:8px}.sequence>span{color:var(--accent)}@media(prefers-color-scheme:light){.lab{--bg:#eef4f5;--panel:#ffffff;--line:#b5ccd3;--ink:#173044;--muted:#486474;--accent:#087c70}.inspect pre{background:#102437;color:#d5ffe7}.event[aria-pressed=true]{background:#d5f2ec}.event:hover{background:#e3eff1}.controls button:hover,.filters button[aria-pressed=true],.filters button:hover,.nav button:hover{color:#fff}}@media(max-width:720px){.lab{padding:17px}.columns{grid-template-columns:minmax(0,1fr)}.timeline{display:flex;gap:6px;overflow-x:auto;max-height:none;border-right:0;border-bottom:1px solid var(--line);padding:12px}.event{min-width:190px;max-width:215px;padding:12px}.event strong{font-size:.78rem}.inspect{padding:16px}.states{grid-template-columns:1fr}.sequence>span{display:none}.sequence>div{min-width:42%}.filters{padding:0 15px 15px}.topline{padding:18px}.inspect pre{min-height:155px}}@media(prefers-reduced-motion:reduce){*{scroll-behavior:auto!important}}
</style>