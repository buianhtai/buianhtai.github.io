---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import DeerFlowInteractiveTopology from '../../../components/mdx/DeerFlowInteractiveTopology.astro';
const revision='1f15e0b43ca58b9601514f9f5c408fb032022833';
const repo='https://github.com/bytedance/deer-flow/blob/'+revision+'/';
const patterns=[
{id:'gateway',type:'Boundary',title:'API Gateway + Reverse Proxy',short:'One public edge, internal backend contracts',when:'Browser submits /api/langgraph/* requests',why:'Keep browser/API coupling small and enforce HTTP boundaries before run admission.',cost:'Adds forwarding configuration and another place to debug headers, timeouts and SSE buffering.',alternative:'Directly expose API service with ingress controller',file:'docker/nginx/nginx.conf',in:['Browser','Nginx','FastAPI Gateway'],out:'HTTP request routed to backend',status:'IMPLEMENTATION'},
{id:'task',type:'Execution',title:'Async Task per Run',short:'Lightweight in-process asynchronous dispatch',when:'FastAPI accepts a run and schedules its worker',why:'Avoid introducing a dedicated job broker for the normal request path.',cost:'Process crashes and multi-instance coordination need explicit ownership, persistence and recovery policies.',alternative:'Durable queue with external worker fleet (Temporal, Celery or equivalent)',file:'backend/app/gateway/services.py',in:['Gateway','RunManager','asyncio.Task'],out:'Worker executes independently of SSE reader',status:'IMPLEMENTATION'},
{id:'manager',type:'Coordination',title:'Run Manager + Lease',short:'Admission control and runtime ownership',when:'Run creation, concurrent admission and stale execution inspection',why:'Separate run lifecycle from transport connection and graph checkpointing.',cost:'Leases detect stale ownership, not exactly-once external side effects.',alternative:'External workflow orchestrator with durable execution semantics',file:'backend/packages/harness/deerflow/runtime/runs/manager.py',in:['Gateway','RunManager','RunStore'],out:'Run identity, status and ownership decisions',status:'IMPLEMENTATION'},
{id:'bridge',type:'Messaging',title:'Publish–Subscribe Bridge',short:'Separate event producers from SSE consumers',when:'Graph emits progress; browser receives stream frames',why:'Worker does not need a direct socket connection to the browser.',cost:'Transport and replay windows depend on deployment. Buffer eviction creates gaps.',alternative:'Direct worker streaming or durable event log',file:'backend/packages/harness/deerflow/runtime/stream_bridge/base.py',in:['Graph Worker','StreamBridge','Gateway','SSE Client'],out:'Incremental events and optional replay',status:'IMPLEMENTATION'},
{id:'checkpoint',type:'State',title:'Checkpoint / Resume',short:'Graph state lives outside transient delivery',when:'An execution step persists conversation state',why:'The next graph step or state reload can use recorded graph state, independent of SSE events.',cost:'Checkpoint presence does not prove external tool side effects are reversible or idempotent.',alternative:'Stateless run replay; event-sourced state machine',file:'backend/packages/harness/deerflow/runtime/runs/worker.py',in:['LangGraph','Checkpointer','Thread state'],out:'Durable graph state at configured boundaries',status:'IMPLEMENTATION'},
{id:'adapter',type:'Integration',title:'Ports & Adapters',short:'Pluggable tools behind stable interfaces',when:'Agent calls an MCP, sandbox or built-in tool',why:'Keep tool invocation and authorization separate from graph orchestration.',cost:'Adapters need consistent timeouts, cancellation, authz and idempotency contracts.',alternative:'Directly embed integration SDK calls inside agent nodes',file:'backend/packages/harness/deerflow/authz/enforcement.py',in:['Graph','Tool permission','Adapter','External service'],out:'Authorized tool outcome returned to graph',status:'INTERPRETATION'},
{id:'reconnect',type:'Reliability',title:'Cursor Replay + State Reconciliation',short:'Rejoin a stream without restarting the run',when:'SSE disconnects or event history is no longer available',why:'Differentiate loss of delivery from loss of execution.',cost:'A replay gap requires a fallback to durable thread state; missing chunks cannot be reconstructed reliably.',alternative:'Always reload full state on reconnect',file:'backend/app/gateway/services.py',in:['Last-Event-ID','Gateway','Bridge','Thread State'],out:'Replay recent events or report gap',status:'IMPLEMENTATION'},
{id:'outcome',type:'Reliability',title:'Idempotency Boundary',short:'Do not confuse replay with safe retry',when:'Worker fails during external tool execution',why:'Side effects may have succeeded even if acknowledgement was lost.',cost:'End-to-end exactly-once behaviour needs explicit tool-level design; it is not guaranteed by a run lease.',alternative:'Operation IDs, deduplication ledger and outcome reconciliation',file:'backend/packages/harness/deerflow/runtime/runs/run_ownership_config.py',in:['Worker','Tool side effect','RunStore'],out:'Retry decision requires outcome investigation',status:'DESIGN LESSON'}
];
---
<BaseLayout title="DeerFlow architectural pattern atlas" description="Explore DeerFlow runtime, protocol, recovery and their underlying design patterns and trade-offs.">
<main class="atlas" data-atlas>
<header class="hero"><a href="/en/labs/deerflow-protocol-inspector/">← Protocol & Runtime Inspector</a><p class="eyebrow">THE THIRD LENS / ARCHITECTURE REASONING</p><h1>See the system.<br><em>Recognize the pattern.</em></h1><p>DeerFlow’s components are the implementation. The patterns explain <strong>why</strong> they are organized this way, <strong>where</strong> the boundaries lie, and <strong>when</strong> another design might work better.</p><div class="disclaimer">Pattern labels are our architectural interpretations, not design-pattern names officially assigned by DeerFlow. Source anchors point to a pinned upstream revision. Reliability guarantees are never inferred from diagrams.</div></header>
<DeerFlowInteractiveTopology />
<section class="below" style="max-width:1250px;margin:24px auto;padding:20px"><h2>Explore actual code relationships</h2><p>Trace DeerFlow functions, async tasks, streaming interfaces, and verified call sites.</p><a href="/en/labs/deerflow-code-xray/">Open Source Code X-Ray →</a></section>
<section class="stage"><div class="head"><div><small>ARCHITECTURE EXPLORER</small><h2>One system, eight patterns</h2></div><span class="indicator">SELECT TO EXPLORE ↘</span></div>
<div class="filters" role="group" aria-label="Pattern categories"><button data-filter="All" aria-pressed="true">All</button><button data-filter="Execution">Execution</button><button data-filter="Messaging">Messaging</button><button data-filter="State">State</button><button data-filter="Reliability">Reliability</button><button data-filter="Coordination">Coordination</button><button data-filter="Integration">Integration</button><button data-filter="Boundary">Boundary</button></div>
<div class="layout"><div class="visual"><svg viewBox="0 0 880 430" role="img" aria-label="Diagram showing Browser through Nginx and Gateway, RunManager and graph worker, with database, bridge, model and tools">
<defs><marker id="arrow" markerWidth="8" markerHeight="8" refX="6" refY="3" orient="auto"><path d="M0 0 L6 3 L0 6" fill="none" stroke="currentColor" stroke-width="1.4"/></marker></defs>
<g class="zones"><rect x="8" y="24" width="212" height="390" rx="17"/><rect x="229" y="24" width="422" height="390" rx="17"/><rect x="660" y="24" width="212" height="390" rx="17"/><text x="26" y="48">CLIENT / EDGE</text><text x="248" y="48">APPLICATION / RUNTIME</text><text x="678" y="48">EXTERNAL</text></g>
<g class="lines"><path data-link="gateway" d="M165 123H253"/><path data-link="task manager" d="M387 123H473"/><path data-link="manager checkpoint" d="M326 167V300"/><path data-link="bridge reconnect" d="M540 167V300H105V167"/><path data-link="adapter outcome" d="M608 123H678"/><path data-link="checkpoint" d="M387 335H473"/><path data-link="adapter" d="M540 167V230H746V290"/></g>
<g class="node" data-node="gateway reconnect"><rect x="22" y="87" width="143" height="80" rx="12"/><text x="93" y="116">Browser</text><text class="sub" x="93" y="138">React / SSE</text></g>
<g class="node" data-node="gateway"><rect x="254" y="87" width="133" height="80" rx="12"/><text x="320" y="116">Gateway</text><text class="sub" x="320" y="138">FastAPI</text></g>
<g class="node" data-node="task manager"><rect x="474" y="87" width="134" height="80" rx="12"/><text x="541" y="116">Run worker</text><text class="sub" x="541" y="138">async graph</text></g>
<g class="node" data-node="checkpoint manager"><rect x="254" y="300" width="133" height="70" rx="12"/><text x="320" y="328">RunStore</text><text class="sub" x="320" y="347">status / ownership</text></g>
<g class="node" data-node="bridge reconnect"><rect x="474" y="300" width="134" height="70" rx="12"/><text x="541" y="328">Bridge</text><text class="sub" x="541" y="347">pub/sub / replay</text></g>
<g class="node" data-node="adapter outcome"><rect x="679" y="87" width="170" height="80" rx="12"/><text x="764" y="116">Model & tools</text><text class="sub" x="764" y="138">authorized calls</text></g>
<g class="node" data-node="checkpoint"><rect x="679" y="300" width="170" height="70" rx="12"/><text x="764" y="328">Checkpointer</text><text class="sub" x="764" y="347">graph state</text></g>
</svg><p>Conceptual boundaries; not a literal deploy topology. Select a card to emphasize its architectural concern.</p></div>
<div class="pattern-grid">{patterns.map((p,i)=><button class="pattern" data-pattern={i} data-type={p.type} type="button" aria-pressed={i===0}><span class="overline">{String(i+1).padStart(2,'0')} / {p.type}</span><strong>{p.title}</strong><small>{p.short}</small></button>)}</div></div>
<div class="detail"><div class="detail-head"><div><span class="eyebrow" data-kind>BOUNDARY / IMPLEMENTATION</span><h3 data-title>API Gateway + Reverse Proxy</h3></div><span data-label>IMPLEMENTATION</span></div><div class="flow"><div><small>INPUT / COMPONENTS</small><p data-input></p></div><span>→</span><div><small>OBSERVED RESPONSIBILITY</small><p data-output></p></div></div><div class="analysis"><section><h4>WHEN DOES IT APPEAR?</h4><p data-when></p></section><section><h4>WHY THIS PATTERN?</h4><p data-why></p></section><section><h4>WHAT DOES IT COST?</h4><p data-cost></p></section><section><h4>ALTERNATIVE DESIGN</h4><p data-alternative></p></section></div><div class="links"><a data-code target="_blank" rel="noopener noreferrer" href={repo+patterns[0].file}>Open upstream source ↗</a><a href="/en/labs/deerflow-protocol-inspector/">Inspect HTTP / SSE / runtime sequence →</a></div></div>
</section><footer><h2>Patterns are a vocabulary, not proof of implementation.</h2><p>Use the source link to validate the behaviour behind each pattern. Keep transport disconnections, task cancellation, process failure and external tool effects as separate failure domains.</p></footer></main>
<script define:vars={{patterns,repo}}>
const el=document.querySelector('[data-atlas]');if(el){
 const q=s=>el.querySelector('[data-'+s+']'),btns=[...el.querySelectorAll('[data-pattern]')];
 function select(i){const p=patterns[i];btns.forEach(b=>b.setAttribute('aria-pressed',String(Number(b.dataset.pattern)===i)));q('kind').textContent=p.type.toUpperCase()+' / '+p.status;q('title').textContent=p.title;q('label').textContent=p.status;q('input').textContent=p.in.join(' → ');q('output').textContent=p.out;q('when').textContent=p.when;q('why').textContent=p.why;q('cost').textContent=p.cost;q('alternative').textContent=p.alternative;q('code').href=repo+p.file;q('code').textContent=p.file+' ↗';el.querySelectorAll('[data-node],[data-link]').forEach(n=>{n.classList.toggle('focus',(n.getAttribute('data-node')||n.getAttribute('data-link')||'').split(' ').includes(p.id));});}
 btns.forEach(b=>b.addEventListener('click',()=>select(Number(b.dataset.pattern))));
 el.querySelectorAll('[data-filter]').forEach(b=>b.addEventListener('click',()=>{const f=b.dataset.filter;el.querySelectorAll('[data-filter]').forEach(v=>v.setAttribute('aria-pressed',String(v===b)));btns.forEach(v=>v.hidden=f!=='All'&&v.dataset.type!==f);select(Number(btns.find(v=>!v.hidden).dataset.pattern));}));
 const params=new URLSearchParams(location.search),i=patterns.findIndex(p=>p.id===params.get('pattern'));select(i<0?0:i);
}
</script>
<style>
.atlas{--bg:#0d1823;--panel:#142736;--edge:#344b5b;--ink:#edf4f7;--muted:#a9c3ce;--mint:#76dfcb;min-height:100vh;background:var(--bg);color:var(--ink);font-family:Inter,system-ui,sans-serif;padding:clamp(20px,4vw,64px)}.atlas *{box-sizing:border-box}.atlas a{color:var(--mint)}.atlas button{font:inherit;cursor:pointer}.atlas button:focus-visible,.atlas a:focus-visible{outline:3px solid var(--mint);outline-offset:3px}.hero,.stage,footer{max-width:1330px;margin:0 auto}.hero>a{font-size:.82rem}.eyebrow,.overline,.head small{font:700 .65rem ui-monospace,monospace;letter-spacing:.12em;color:var(--mint)}.hero .eyebrow{margin-top:37px}.hero h1{font-size:clamp(2.7rem,6vw,6.4rem);letter-spacing:-.07em;line-height:1.05;margin:15px 0 25px}.hero h1 em{font-style:normal;color:var(--mint)}.hero>p:not(.eyebrow){font-size:clamp(1rem,1.6vw,1.18rem);line-height:1.7;max-width:780px;color:var(--muted)}.disclaimer{border-left:3px solid var(--mint);background:var(--panel);padding:14px 17px;margin:26px 0 48px;max-width:1020px;font-size:.8rem;line-height:1.7;color:var(--muted)}.stage{border:1px solid var(--edge);border-radius:16px;overflow:hidden;background:var(--panel)}.head{display:flex;justify-content:space-between;align-items:center;gap:12px;padding:25px;flex-wrap:wrap}.head h2{margin:8px 0 0;font-size:clamp(1.4rem,2.5vw,2rem);letter-spacing:-.05em}.indicator{font:.65rem ui-monospace,monospace;color:var(--muted)}.filters{padding:0 25px 23px;display:flex;flex-wrap:wrap;gap:7px}.filters button{background:transparent;color:var(--muted);border:1px solid var(--edge);border-radius:30px;padding:9px 13px;font-size:.75rem}.filters button[aria-pressed=true]{background:var(--mint);color:#102935;border-color:var(--mint)}.layout{display:grid;grid-template-columns:minmax(0,1fr) minmax(300px,34%);border-top:1px solid var(--edge)}.visual{padding:18px;min-width:0;border-right:1px solid var(--edge)}.visual svg{width:100%;height:auto;display:block;color:var(--muted)}.zones rect{stroke:var(--edge);stroke-width:1;fill:#1c3140}.zones text{fill:var(--muted);font:700 13px ui-monospace,monospace;letter-spacing:1px}.lines path{fill:none;stroke:#537587;stroke-width:2;marker-end:url(#arrow);transition:stroke .2s,stroke-width .2s}.lines path.focus{stroke:var(--mint);stroke-width:5}.node rect{fill:#243c4b;stroke:#4c6b7d;stroke-width:1.3;transition:stroke .2s,fill .2s}.node.focus rect{fill:#226357;stroke:var(--mint);stroke-width:3}.node text{fill:var(--ink);font:700 17px system-ui,sans-serif;text-anchor:middle}.node text.sub{font:12px ui-monospace,monospace;fill:var(--muted)}.visual>p{font:.75rem/1.7 ui-monospace,monospace;color:var(--muted);padding:3px 12px}.pattern-grid{display:grid;grid-template-columns:1fr 1fr;align-content:start;padding:10px;gap:8px}.pattern{background:#1c3242;color:var(--ink);border:1px solid var(--edge);border-radius:9px;text-align:left;padding:15px;display:grid;gap:9px;min-width:0}.pattern[hidden]{display:none}.pattern[aria-pressed=true]{border-color:var(--mint);background:#21584f}.pattern strong{font-size:.87rem;line-height:1.3}.pattern small{color:var(--muted);font-size:.7rem;line-height:1.5}.detail{padding:28px;border-top:1px solid var(--edge)}.detail-head{display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap}.detail-head h3{font-size:clamp(1.4rem,3vw,2.6rem);letter-spacing:-.05em;margin:10px 0}.detail-head>span{font:.66rem ui-monospace,monospace;color:var(--mint);border:1px solid var(--edge);padding:8px;border-radius:20px}.flow{display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:17px;margin:22px 0}.flow>div{background:#102333;border:1px solid var(--edge);border-radius:9px;padding:17px;min-height:100px}.flow small,.analysis h4{color:var(--mint);font:.67rem ui-monospace,monospace;letter-spacing:.06em}.flow p{margin-bottom:0;line-height:1.6}.flow>span{color:var(--mint);font-size:1.4rem}.analysis{display:grid;grid-template-columns:1fr 1fr;gap:20px}.analysis section{border-top:1px solid var(--edge)}.analysis p{color:var(--muted);line-height:1.75;font-size:.88rem}.links{display:flex;flex-wrap:wrap;gap:18px;margin-top:24px;border-top:1px solid var(--edge);padding-top:19px;font-size:.78rem;overflow-wrap:anywhere}footer{padding:50px 0}footer h2{font-size:clamp(1.2rem,2vw,1.8rem);letter-spacing:-.05em}footer p{color:var(--muted);line-height:1.8;max-width:760px}@media(max-width:1050px){.layout{grid-template-columns:1fr}.visual{border-right:0;border-bottom:1px solid var(--edge)}}@media(max-width:600px){.atlas{padding:13px}.head,.detail{padding:17px}.filters{padding:0 17px 17px}.visual{padding:5px}.pattern-grid{grid-template-columns:1fr 1fr}.pattern{padding:10px}.pattern strong{font-size:.75rem}.pattern small{font-size:.65rem}.flow{grid-template-columns:1fr;gap:8px}.flow>span{transform:rotate(90deg);justify-self:center}.analysis{grid-template-columns:1fr}.node text{font-size:13px}.node text.sub{font-size:10px}}@media screen and (max-width: 0px){.atlas{--bg:#f1f6f6;--panel:#fff;--edge:#bad0d5;--ink:#193548;--muted:#486673;--mint:#08786b}.zones rect{fill:#eaf2f2}.node rect{fill:#edf4f4;stroke:#87a9aa}.node.focus rect{fill:#c4efe2}.pattern{background:#f2f7f7}.pattern[aria-pressed=true]{background:#d2f1e6}.flow>div{background:#eef6f5}.lines path{stroke:#8ba4b3}} 
:global(html.theme-light) .atlas{--bg:#f1f6f6;--panel:#fff;--edge:#bad0d5;--ink:#193548;--muted:#486673;--mint:#08786b}:global(html.theme-light) .zones rect{fill:#eaf2f2}:global(html.theme-light) .node rect{fill:#edf4f4;stroke:#87a9aa}:global(html.theme-light) .node.focus rect{fill:#c4efe2}:global(html.theme-light) .pattern{background:#f2f7f7}:global(html.theme-light) .pattern[aria-pressed=true]{background:#d2f1e6}:global(html.theme-light) .flow>div{background:#eef6f5}:global(html.theme-light) .lines path{stroke:#8ba4b3}
</style>