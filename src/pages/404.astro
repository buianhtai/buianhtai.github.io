---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Page not found" description="The page you were looking for doesn't exist. Explore Tai Bui's engineering notes and articles instead." lang="en" noindex>
  <div class="ed-container ed-404">
    <div class="ed-kicker"><span class="ed-dot" aria-hidden="true"></span> HTTP 404 / NOT FOUND</div>
    <div class="ed-404-code" aria-hidden="true">404<span>.</span></div>
    <h1>This page took a different route.</h1>
    <p>The link may have changed, or the article may have moved. You can still find your way around the engineering notes.</p>
    <div class="ed-hero-actions">
      <a class="ed-btn ed-btn-primary" href="/en/blog/">Find an article →</a>
      <a class="ed-btn ed-btn-quiet" href="/en/">Back to home ↗</a>
      <a class="ed-btn ed-btn-quiet" href="/vi/blog/">Tiếng Việt ↗</a>
    </div>
    <div class="ed-404-links"><a href="/en/foundations/">Software Foundations →</a><a href="/en/about/">About the author →</a></div>
  </div>
</BaseLayout>
