---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HomePage from '../../components/editorial/HomePage.astro';
export function getStaticPaths() {
  return [{ params: { lang: 'en' } }, { params: { lang: 'vi' } }];
}
const lang = Astro.params.lang === 'vi' ? 'vi' : 'en';
---
<BaseLayout
  title={lang === 'vi' ? 'Ghi chép Kỹ thuật' : 'Engineering Notes'}
  description={lang === 'vi' ? 'AI agents, hệ thống phân tán, cơ sở dữ liệu và kiến trúc phần mềm.' : 'AI agents, distributed systems, database internals, and engineering craft by Tai Bui.'}
  lang={lang}
>
  <HomePage lang={lang} />
</BaseLayout>
