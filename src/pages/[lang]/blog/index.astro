---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { t } from '../../../i18n/strings';
import { getPostSlug, groupPostsBySeries, seriesMeta } from '../../../lib/posts';

export function getStaticPaths() {
  return [{ params: { lang: 'en' } }, { params: { lang: 'vi' } }];
}

const { lang } = Astro.params;
const posts = (await getCollection('blog', (p) => {
  if (p.data.lang !== lang) return false;
  if (p.data.draft && !import.meta.env.DEV) return false;
  return true;
}))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const groups = groupPostsBySeries(posts);
---

<BaseLayout title={t(lang, 'allPosts')} lang={lang}>
  <div class="max-w-3xl mx-auto px-4 py-10">

    <!-- Page header -->
    <div class="page-header">
      <span class="page-prompt">$</span>
      <h1 class="page-title">ls -lR ~/blog/{lang}/</h1>
    </div>

    {groups.map((group) => {
      const meta = group.series ? seriesMeta[group.series] : null;
      const heading = meta?.title ?? 'standalone';
      const desc = meta?.description;
      const count = group.posts.length;

      return (
        <section class="group-section">
          <!-- Group header -->
          <div class="group-header">
            <span class="group-prompt">{group.series ? 'series' : 'misc'}/</span>
            <span class="group-name">{heading}</span>
            <span class="group-count">[{count}]</span>
          </div>
          {desc && <p class="group-desc">{desc}</p>}

          <!-- Post rows -->
          <ul class="group-list">
            {group.posts.map((post) => (
              <li class="group-item">
                <a href={`/${lang}/blog/${getPostSlug(post)}`} class="group-row">
                  {post.data.seriesOrder != null && (
                    <span class="group-order">{String(post.data.seriesOrder).padStart(2,'0')}.</span>
                  )}
                  <div class="group-content">
                    <div class="group-row-top">
                      <span class="group-post-title">
                        {post.data.title}
                        {post.data.draft && <span class="draft-badge">DRAFT</span>}
                      </span>
                      <time class="group-post-date">{post.data.pubDate.toISOString().slice(0, 10)}</time>
                    </div>
                    <p class="group-post-desc">{post.data.description}</p>
                    {post.data.tags?.length > 0 && (
                      <div class="group-tags">
                        {post.data.tags.map((tag: string) => (
                          <span class="group-tag">#{tag}</span>
                        ))}
                      </div>
                    )}
                  </div>
                </a>
              </li>
            ))}
          </ul>
        </section>
      );
    })}
  </div>
</BaseLayout>

<style>
  /* Page header */
  .page-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 2rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--color-border);
  }
  .page-prompt { color: var(--color-accent); font-family: var(--font-mono); font-weight: 700; font-size: 0.85rem; }
  .page-title {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--color-text-dim);
    font-weight: 400;
    margin: 0;
  }

  /* Group section */
  .group-section { margin-bottom: 2.5rem; }
  .group-header {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.4rem 0.75rem;
    background: var(--color-surface-2);
    border: 1px solid var(--color-border);
    border-bottom: none;
    font-family: var(--font-mono);
    font-size: 0.7rem;
  }
  .group-prompt { color: var(--color-text-muted); }
  .group-name { color: var(--color-accent); font-weight: 600; }
  .group-count { margin-left: auto; color: var(--color-text-muted); }

  .group-desc {
    padding: 0.5rem 0.875rem;
    font-size: 0.78rem;
    color: var(--color-text-dim);
    border: 1px solid var(--color-border);
    border-top: none;
    border-bottom: none;
    background: var(--color-surface);
    margin: 0;
  }

  /* Post list */
  .group-list { list-style: none; margin: 0; padding: 0; }
  .group-item {
    border: 1px solid var(--color-border);
    border-top: none;
  }
  .group-row {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    padding: 0.75rem 0.875rem;
    text-decoration: none;
    background: var(--color-surface);
    transition: background 0.12s;
  }
  .group-row:hover { background: var(--color-accent-glow); }

  .group-order {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: var(--color-text-muted);
    flex-shrink: 0;
    padding-top: 0.15rem;
    min-width: 1.5rem;
  }

  .group-content { flex: 1; min-width: 0; }
  .group-row-top {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.2rem;
  }
  .group-post-title {
    font-size: 0.88rem;
    color: var(--color-text);
    transition: color 0.12s;
    font-weight: 500;
  }
  .group-row:hover .group-post-title { color: var(--color-accent); }

  .group-post-date {
    font-family: var(--font-mono);
    font-size: 0.67rem;
    color: var(--color-text-muted);
    flex-shrink: 0;
    white-space: nowrap;
  }

  .group-post-desc {
    font-size: 0.78rem;
    color: var(--color-text-dim);
    margin: 0.1rem 0 0.3rem;
    line-height: 1.5;
  }

  .group-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
  }
  .group-tag {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: var(--color-text-muted);
  }

  .draft-badge {
    display: inline-block;
    margin-left: 0.4rem;
    padding: 0.1rem 0.35rem;
    font-size: 0.6rem;
    font-family: var(--font-mono);
    font-weight: 700;
    letter-spacing: 0.05em;
    color: var(--color-amber);
    border: 1px solid var(--color-amber);
    opacity: 0.7;
    vertical-align: middle;
  }
</style>
