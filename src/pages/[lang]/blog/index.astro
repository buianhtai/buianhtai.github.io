---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { t } from '../../../i18n/strings';
import { getPostSlug, groupPostsBySeries, seriesMeta } from '../../../lib/posts';

export function getStaticPaths() {
  return [{ params: { lang: 'en' } }, { params: { lang: 'vi' } }];
}

const { lang } = Astro.params;
const posts = (await getCollection('blog', (p) => {
  if (p.data.lang !== lang) return false;
  if (p.data.draft && !import.meta.env.DEV) return false;
  return true;
}))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const groups = groupPostsBySeries(posts);

const allTags = [...new Set(posts.flatMap(p => p.data.tags ?? []))].sort();

const postData = posts.map(p => ({
  id: p.id,
  title: p.data.title,
  description: p.data.description ?? '',
  tags: p.data.tags ?? [],
  series: p.data.series ?? null,
  url: `/${lang}/blog/${getPostSlug(p)}`,
  date: p.data.pubDate.toISOString().slice(0, 10),
  order: p.data.seriesOrder ?? null,
  draft: p.data.draft ?? false,
}));

const groupData = groups.map(g => ({
  series: g.series,
  label: g.series ? (seriesMeta[g.series]?.title ?? g.series) : 'standalone',
  count: g.posts.length,
}));
---

<BaseLayout title={t(lang, 'allPosts')} lang={lang}>
  <div class="blog-index" id="blog-root">

    <!-- Hero -->
    <div class="hero">
      <div class="hero-inner">
        <div class="hero-eyebrow">
          <span class="eyebrow-dot"></span>
          <span class="eyebrow-text">writing</span>
        </div>
        <h1 class="hero-title">All Posts</h1>
        <p class="hero-sub">
          <span id="post-count">{posts.length}</span> articles across {groups.length} series
        </p>
      </div>
    </div>

    <div class="content-shell">

      <!-- Sidebar -->
      <aside class="sidebar">

        <!-- Search -->
        <div class="sidebar-block">
          <div class="search-field">
            <svg class="search-svg" viewBox="0 0 16 16" fill="none">
              <circle cx="6.5" cy="6.5" r="4" stroke="currentColor" stroke-width="1.5"/>
              <path d="M10 10l3 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
            <input
              id="search-input"
              type="search"
              class="search-input"
              placeholder="Search posts…"
              autocomplete="off"
              spellcheck="false"
            />
          </div>
        </div>

        <!-- Series filter -->
        <div class="sidebar-block">
          <div class="sidebar-label">Series</div>
          <div class="series-list" id="series-pills">
            <button class="series-btn series-btn-active" data-filter="all">
              <span class="series-btn-name">All posts</span>
              <span class="series-btn-count">{posts.length}</span>
            </button>
            {groupData.map(g => (
              <button class="series-btn" data-filter={`series:${g.series ?? 'standalone'}`}>
                <span class="series-btn-name">{g.label}</span>
                <span class="series-btn-count">{g.count}</span>
              </button>
            ))}
          </div>
        </div>

        <!-- Tags -->
        {allTags.length > 0 && (
          <div class="sidebar-block">
            <div class="sidebar-label">Tags</div>
            <div class="tag-cloud" id="tag-pills">
              {allTags.map(tag => (
                <button class="tag-chip" data-tag={tag}>{tag}</button>
              ))}
            </div>
          </div>
        )}

      </aside>

      <!-- Main -->
      <main class="main-content">

        <!-- No results -->
        <div class="no-results" id="no-results" hidden>
          <div class="no-results-icon">⌀</div>
          <div class="no-results-text">No posts match your search</div>
          <button class="no-results-reset" id="reset-btn">Clear filters</button>
        </div>

        <!-- Groups -->
        <div id="groups-container">
          {groups.map((group) => {
            const meta = group.series ? seriesMeta[group.series] : null;
            const heading = meta?.title ?? 'Standalone';
            const desc = meta?.description;
            const count = group.posts.length;
            const seriesKey = group.series ?? 'standalone';

            return (
              <section class="series-section" data-series={seriesKey} id={`section-${seriesKey}`}>

                <!-- Section header -->
                <button class="section-header" data-collapse-toggle={seriesKey} aria-expanded="true">
                  <div class="section-header-left">
                    <span class="section-type">{group.series ? 'series' : 'misc'}</span>
                    <span class="section-title">{heading}</span>
                  </div>
                  <div class="section-header-right">
                    <span class="section-count" data-count-label={seriesKey}>{count} posts</span>
                    <svg class="chevron" viewBox="0 0 16 16" fill="none">
                      <path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </div>
                </button>

                {desc && <p class="section-desc">{desc}</p>}

                <!-- Post cards -->
                <ul class="post-list" id={`list-${seriesKey}`}>
                  {group.posts.map((post) => (
                    <li class="post-item" data-post-id={post.id}>
                      <a href={`/${lang}/blog/${getPostSlug(post)}`} class="post-card">
                        <div class="post-card-accent"></div>
                        <div class="post-card-body">
                          <div class="post-meta">
                            {post.data.seriesOrder != null && (
                              <span class="post-index">#{String(post.data.seriesOrder).padStart(2, '0')}</span>
                            )}
                            <time class="post-date">{post.data.pubDate.toISOString().slice(0, 10)}</time>
                            {post.data.draft && <span class="draft-chip">draft</span>}
                          </div>
                          <h3 class="post-title">{post.data.title}</h3>
                          {post.data.description && (
                            <p class="post-desc">{post.data.description}</p>
                          )}
                          {post.data.tags?.length > 0 && (
                            <div class="post-tags">
                              {post.data.tags.map((tag: string) => (
                                <span class="post-tag">{tag}</span>
                              ))}
                            </div>
                          )}
                        </div>
                        <svg class="post-arrow" viewBox="0 0 16 16" fill="none">
                          <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                      </a>
                    </li>
                  ))}
                </ul>

              </section>
            );
          })}
        </div>

      </main>
    </div>
  </div>
</BaseLayout>

<script define:vars={{ postData, groupData }}>
  let activeFilter = 'all';
  let activeTag    = null;
  let searchQuery  = '';

  const searchInput  = document.getElementById('search-input');
  const postCountEl  = document.getElementById('post-count');
  const noResults    = document.getElementById('no-results');
  const resetBtn     = document.getElementById('reset-btn');
  const seriesBtns   = document.querySelectorAll('#series-pills .series-btn');
  const tagChips     = document.querySelectorAll('#tag-pills .tag-chip');

  const collapseState = {};
  groupData.forEach(g => { collapseState[g.series ?? 'standalone'] = true; });

  function normalize(s) {
    return s.toLowerCase().replace(/[^a-z0-9 ]/g, '');
  }

  function matches(post, q) {
    if (!q) return true;
    const n = normalize(q);
    return normalize(post.title).includes(n)
      || normalize(post.description).includes(n)
      || post.tags.some(t => normalize(t).includes(n));
  }

  function applyFilters() {
    let visible = 0;

    groupData.forEach(g => {
      const key     = g.series ?? 'standalone';
      const section = document.getElementById(`section-${key}`);
      const list    = document.getElementById(`list-${key}`);
      if (!section || !list) return;

      const seriesMatch = activeFilter === 'all' || activeFilter === `series:${key}`;
      let sectionVisible = 0;

      list.querySelectorAll('.post-item').forEach(li => {
        const post = postData.find(p => p.id === li.dataset.postId);
        if (!post) return;
        const show = seriesMatch && (!activeTag || post.tags.includes(activeTag)) && matches(post, searchQuery);
        li.hidden = !show;
        if (show) sectionVisible++;
      });

      visible += sectionVisible;
      section.hidden = sectionVisible === 0;

      const label = section.querySelector('[data-count-label]');
      if (label) label.textContent = `${sectionVisible} post${sectionVisible === 1 ? '' : 's'}`;

      if (!section.hidden) syncCollapse(key, list, section);
    });

    if (postCountEl) postCountEl.textContent = String(visible);
    if (noResults) noResults.hidden = visible > 0;
  }

  function syncCollapse(key, list, section) {
    const open = collapseState[key] ?? true;
    const btn  = section.querySelector('[data-collapse-toggle]');
    const chevron = btn?.querySelector('.chevron');
    list.classList.toggle('collapsed', !open);
    btn?.setAttribute('aria-expanded', String(open));
    if (chevron) chevron.style.transform = open ? '' : 'rotate(-90deg)';
  }

  function resetAll() {
    activeFilter = 'all';
    activeTag    = null;
    searchQuery  = '';
    if (searchInput) searchInput.value = '';
    seriesBtns.forEach(b => b.classList.toggle('series-btn-active', b.dataset.filter === 'all'));
    tagChips.forEach(b => b.classList.remove('tag-chip-active'));
    groupData.forEach(g => { collapseState[g.series ?? 'standalone'] = true; });
    applyFilters();
  }

  // Search
  let timer;
  searchInput?.addEventListener('input', () => {
    clearTimeout(timer);
    timer = setTimeout(() => {
      searchQuery = searchInput.value.trim();
      if (searchQuery) groupData.forEach(g => { collapseState[g.series ?? 'standalone'] = true; });
      applyFilters();
    }, 120);
  });
  searchInput?.addEventListener('keydown', e => { if (e.key === 'Escape') resetAll(); });

  // Series
  seriesBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      activeFilter = btn.dataset.filter;
      seriesBtns.forEach(b => b.classList.toggle('series-btn-active', b === btn));
      if (activeFilter !== 'all') {
        const key = activeFilter.replace('series:', '');
        collapseState[key] = true;
      }
      applyFilters();
    });
  });

  // Tags
  tagChips.forEach(btn => {
    btn.addEventListener('click', () => {
      const tag = btn.dataset.tag;
      if (activeTag === tag) {
        activeTag = null;
        btn.classList.remove('tag-chip-active');
      } else {
        activeTag = tag;
        tagChips.forEach(b => b.classList.toggle('tag-chip-active', b === btn));
        groupData.forEach(g => { collapseState[g.series ?? 'standalone'] = true; });
      }
      applyFilters();
    });
  });

  // Collapse
  document.querySelectorAll('[data-collapse-toggle]').forEach(btn => {
    btn.addEventListener('click', () => {
      const key = btn.dataset.collapseToggle;
      collapseState[key] = !collapseState[key];
      applyFilters();
    });
  });

  resetBtn?.addEventListener('click', resetAll);

  applyFilters();
</script>

<style>
  /* ── Layout shell ─────────────────────────────────────────────────────── */
  .blog-index {
    min-height: 100vh;
  }

  /* ── Hero ─────────────────────────────────────────────────────────────── */
  .hero {
    border-bottom: 1px solid var(--color-border);
    background: linear-gradient(180deg, var(--color-surface-2) 0%, var(--color-bg) 100%);
    padding: 3.5rem 2rem 2.5rem;
  }
  .hero-inner {
    max-width: 64rem;
    margin: 0 auto;
  }
  .hero-eyebrow {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
  }
  .eyebrow-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-accent);
    flex-shrink: 0;
  }
  .eyebrow-text {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-accent);
    font-weight: 600;
  }
  .hero-title {
    font-family: var(--font-sans);
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 700;
    color: var(--color-text);
    margin: 0 0 0.5rem;
    letter-spacing: -0.02em;
    line-height: 1.15;
  }
  .hero-sub {
    font-size: 0.95rem;
    color: var(--color-text-dim);
    margin: 0;
  }

  /* ── Content shell (sidebar + main) ──────────────────────────────────── */
  .content-shell {
    max-width: 64rem;
    margin: 0 auto;
    padding: 2.5rem 1.5rem;
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 2.5rem;
    align-items: start;
  }
  @media (max-width: 768px) {
    .content-shell {
      grid-template-columns: 1fr;
      padding: 1.5rem 1rem;
    }
  }

  /* ── Sidebar ──────────────────────────────────────────────────────────── */
  .sidebar {
    position: sticky;
    top: 5rem;
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }
  .sidebar-block {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .sidebar-label {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-text-muted);
    font-weight: 600;
  }

  /* Search */
  .search-field {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 6px;
    padding: 0.5rem 0.75rem;
    transition: border-color 0.15s;
  }
  .search-field:focus-within {
    border-color: var(--color-accent);
    box-shadow: 0 0 0 3px var(--color-accent-glow);
  }
  .search-svg {
    width: 14px;
    height: 14px;
    color: var(--color-text-muted);
    flex-shrink: 0;
  }
  .search-input {
    flex: 1;
    background: transparent;
    border: none;
    outline: none;
    font-family: var(--font-sans);
    font-size: 0.82rem;
    color: var(--color-text);
    min-width: 0;
  }
  .search-input::placeholder { color: var(--color-text-muted); }
  .search-input::-webkit-search-cancel-button { display: none; }

  /* Series list */
  .series-list {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }
  .series-btn {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding: 0.45rem 0.6rem;
    border-radius: 5px;
    border: none;
    background: transparent;
    color: var(--color-text-dim);
    font-family: var(--font-sans);
    font-size: 0.82rem;
    cursor: pointer;
    text-align: left;
    transition: background 0.12s, color 0.12s;
  }
  .series-btn:hover {
    background: var(--color-surface-2);
    color: var(--color-text);
  }
  .series-btn-active {
    background: var(--color-accent-glow);
    color: var(--color-accent);
    font-weight: 600;
  }
  .series-btn-active:hover {
    background: var(--color-accent-glow);
    color: var(--color-accent);
  }
  .series-btn-name {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .series-btn-count {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--color-text-muted);
    flex-shrink: 0;
    margin-left: 0.4rem;
  }
  .series-btn-active .series-btn-count { color: var(--color-accent); opacity: 0.7; }

  /* Tag cloud */
  .tag-cloud {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }
  .tag-chip {
    display: inline-flex;
    align-items: center;
    padding: 0.2rem 0.55rem;
    border-radius: 999px;
    border: 1px solid var(--color-border);
    background: transparent;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--color-text-dim);
    cursor: pointer;
    transition: border-color 0.12s, color 0.12s, background 0.12s;
    line-height: 1.5;
  }
  .tag-chip:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }
  .tag-chip-active {
    border-color: var(--color-accent);
    background: var(--color-accent-glow);
    color: var(--color-accent);
  }

  /* ── No results ───────────────────────────────────────────────────────── */
  .no-results {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
    padding: 3rem 2rem;
    text-align: center;
    border: 1px dashed var(--color-border);
    border-radius: 8px;
  }
  .no-results-icon { font-size: 2rem; opacity: 0.4; }
  .no-results-text { font-size: 0.9rem; color: var(--color-text-dim); }
  .no-results-reset {
    margin-top: 0.25rem;
    padding: 0.35rem 0.9rem;
    border-radius: 5px;
    border: 1px solid var(--color-border);
    background: transparent;
    color: var(--color-text-dim);
    font-size: 0.8rem;
    cursor: pointer;
    transition: border-color 0.12s, color 0.12s;
  }
  .no-results-reset:hover { border-color: var(--color-accent); color: var(--color-accent); }

  /* ── Series section ───────────────────────────────────────────────────── */
  .series-section {
    margin-bottom: 2.5rem;
  }

  .section-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding: 0.8rem 1rem;
    margin-bottom: 0.75rem;
    border: none;
    border-bottom: 2px solid var(--color-border);
    background: transparent;
    cursor: pointer;
    text-align: left;
    color: inherit;
    gap: 1rem;
  }
  .section-header:hover .section-title { color: var(--color-accent); }
  .section-header-left {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    min-width: 0;
  }
  .section-type {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-accent);
    font-weight: 700;
    flex-shrink: 0;
    padding: 0.1rem 0.4rem;
    border: 1px solid var(--color-accent);
    border-radius: 3px;
    opacity: 0.8;
  }
  .section-title {
    font-family: var(--font-sans);
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--color-text);
    transition: color 0.12s;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .section-header-right {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex-shrink: 0;
  }
  .section-count {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--color-text-muted);
  }
  .chevron {
    width: 16px;
    height: 16px;
    color: var(--color-text-muted);
    transition: transform 0.2s ease;
    flex-shrink: 0;
  }

  .section-desc {
    font-size: 0.85rem;
    color: var(--color-text-dim);
    margin: -0.25rem 0 1rem;
    padding: 0 1rem;
    line-height: 1.6;
  }

  /* ── Post list ────────────────────────────────────────────────────────── */
  .post-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .post-list.collapsed { display: none; }

  /* ── Post card ────────────────────────────────────────────────────────── */
  .post-item { display: block; }
  .post-card {
    display: flex;
    align-items: stretch;
    gap: 0;
    text-decoration: none;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    overflow: hidden;
    transition: border-color 0.15s, box-shadow 0.15s, transform 0.1s;
  }
  .post-card:hover {
    border-color: var(--color-accent);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2);
    transform: translateY(-1px);
  }

  /* Accent left stripe */
  .post-card-accent {
    width: 3px;
    background: var(--color-border);
    flex-shrink: 0;
    transition: background 0.15s;
  }
  .post-card:hover .post-card-accent {
    background: var(--color-accent);
  }

  .post-card-body {
    flex: 1;
    min-width: 0;
    padding: 0.9rem 1rem;
  }

  .post-meta {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 0.4rem;
  }
  .post-index {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--color-accent);
    font-weight: 600;
  }
  .post-date {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--color-text-muted);
  }
  .draft-chip {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    color: var(--color-amber);
    border: 1px solid var(--color-amber);
    border-radius: 3px;
    padding: 0.05rem 0.3rem;
    opacity: 0.8;
  }

  .post-title {
    font-family: var(--font-sans);
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--color-text);
    margin: 0 0 0.3rem;
    line-height: 1.4;
    transition: color 0.12s;
  }
  .post-card:hover .post-title { color: var(--color-accent); }

  .post-desc {
    font-size: 0.82rem;
    color: var(--color-text-dim);
    margin: 0 0 0.5rem;
    line-height: 1.55;
  }

  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
  }
  .post-tag {
    font-family: var(--font-mono);
    font-size: 0.63rem;
    color: var(--color-text-muted);
    background: var(--color-surface-2);
    border-radius: 3px;
    padding: 0.1rem 0.4rem;
    transition: color 0.12s;
  }
  .post-card:hover .post-tag { color: var(--color-text-dim); }

  /* Arrow icon */
  .post-arrow {
    width: 16px;
    height: 16px;
    color: var(--color-text-muted);
    flex-shrink: 0;
    margin: auto 0.9rem;
    opacity: 0;
    transition: opacity 0.15s, transform 0.15s, color 0.15s;
  }
  .post-card:hover .post-arrow {
    opacity: 1;
    color: var(--color-accent);
    transform: translateX(2px);
  }
</style>
