---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getPostSlug, seriesMeta } from '../../../lib/posts';

export function getStaticPaths() {
  return [{ params: { lang: 'en' } }, { params: { lang: 'vi' } }];
}
const lang = Astro.params.lang === 'vi' ? 'vi' : 'en';
const vi = lang === 'vi';
const posts = (await getCollection('blog', post => post.data.lang === lang && !post.data.draft))
  .sort((a,b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

const categories = [
  {id:'ai', name:'AI & Agents'}, {id:'architecture',name:'Architecture'},
  {id:'foundations',name:'Foundations'}, {id:'devops',name:'DevOps & Cloud'},
  {id:'golang',name:'Go'}, {id:'tutorial',name:'Tutorials'}
].map(c => ({...c,count:posts.filter(p=>p.data.category===c.id).length})).filter(c=>c.count>0);
const series = Object.entries(seriesMeta).map(([id,meta]) =>
  ({id,title:meta.title,count:posts.filter(p=>p.data.series===id).length})).filter(s=>s.count>0);
const shortDate = (d:Date) => d.toLocaleDateString(vi?'vi-VN':'en-US',{year:'numeric',month:'short',day:'numeric'});
const wordCount = (value:string) => value.trim().split(/\s+/).length;
---
<BaseLayout title={vi ? 'Tất cả bài viết' : 'Writing Archive'}
  description={vi ? 'Khám phá các bài viết chuyên sâu về AI, kiến trúc và kỹ thuật phần mềm.' : 'Deep dives, field notes and engineering ideas about AI, distributed systems and databases.'}
  lang={lang}>
  <header class="ed-archive-hero">
    <div class="ed-container">
      <div class="ed-kicker"><span class="ed-dot"></span> {vi ? 'Kho kiến thức' : 'The knowledge archive'}</div>
      <h1>{vi ? 'Khám phá bài viết.' : 'Ideas worth exploring.'}</h1>
      <p>{vi ? 'Bộ sưu tập các ghi chép kỹ thuật, phân tích kiến trúc và nghiên cứu chuyên sâu. Tìm kiếm hoặc lọc theo chủ đề để bắt đầu.' :
        'A growing collection of architecture studies, engineering field notes, and fundamentals. Find a topic, follow a series, or explore something new.'}</p>
      <div style="display:flex;gap:8px;flex-wrap:wrap;margin-top:26px">
        <span class="ed-pill"><span class="ed-dot"></span>{posts.length} {vi?'bài viết':'articles'}</span>
        <span class="ed-pill">{series.length} {vi?'chuyên đề':'reading series'}</span>
        <span class="ed-pill">MDX · Engineering</span>
      </div>
    </div>
  </header>
  <div class="ed-container ed-archive">
    <div class="ed-archive-shell" id="article-browser">
      <aside class="ed-filters" aria-label={vi ? 'Bộ lọc' : 'Article filters'}>
        <div class="ed-filter-group">
          <h2>{vi ? 'Tìm kiếm' : 'Search articles'}</h2>
          <label class="ed-sr" for="ed-article-search">{vi?'Tìm theo tiêu đề hoặc từ khóa':'Search titles, descriptions and tags'}</label>
          <input id="ed-article-search" type="search" class="ed-search" placeholder={vi?'Tìm bài viết…':'Title, keyword, or tag…'} autocomplete="off" />
        </div>
        <div class="ed-filter-group">
          <h2>{vi ? 'Chủ đề' : 'Topics'}</h2>
          <div class="ed-filter-buttons" id="ed-category-buttons">
            <button class="ed-filter-btn" type="button" data-category="all" aria-pressed="true"><span>{vi?'Tất cả chủ đề':'All topics'}</span><span>{posts.length}</span></button>
            {categories.map(c=><button class="ed-filter-btn" type="button" data-category={c.id} aria-pressed="false"><span>{c.name}</span><span>{c.count}</span></button>)}
          </div>
        </div>
        {series.length>0 && <div class="ed-filter-group">
          <h2>{vi ? 'Chuyên đề' : 'Reading series'}</h2>
          <div class="ed-filter-buttons" id="ed-series-buttons">
            <button class="ed-filter-btn" type="button" data-series="all" aria-pressed="true"><span>{vi?'Tất cả':'All series'}</span></button>
            {series.map(s=><button class="ed-filter-btn" type="button" data-series={s.id} aria-pressed="false"><span>{s.title}</span><span>{s.count}</span></button>)}
          </div>
        </div>}
      </aside>
      <section aria-label={vi ? 'Danh sách bài viết' : 'Article results'}>
        <div class="ed-archive-toolbar">
          <span role="status" aria-live="polite"><strong id="ed-result-count">{posts.length}</strong> {vi ? 'bài viết' : 'articles found'}</span>
          <span>{vi ? 'Mới nhất trước' : 'Newest first'} ↓</span>
        </div>
        <div class="ed-archive-list" id="ed-article-list">
          {posts.map(post => (
            <a class="ed-archive-post" href={`/${lang}/blog/${getPostSlug(post)}`}
              data-search={`${post.data.title} ${post.data.description} ${post.data.tags.join(' ')}`.toLowerCase()}
              data-category={post.data.category} data-series={post.data.series ?? 'standalone'}>
              <time class="ed-archive-date" datetime={post.data.pubDate.toISOString()}>{shortDate(post.data.pubDate)}</time>
              <div>
                <div class="ed-kicker" style="font-size:.62rem">{post.data.series ? seriesMeta[post.data.series]?.title ?? post.data.category : post.data.category}</div>
                <h2>{post.data.title}</h2>
                <p>{post.data.description}</p>
              </div>
              <span class="ed-archive-arrow" aria-hidden="true">↗</span>
            </a>
          ))}
        </div>
        <div id="ed-no-results" class="ed-archive-empty" hidden>
          <h2>{vi ? 'Không tìm thấy bài viết' : 'Nothing matched this search'}</h2>
          <p>{vi?'Thử từ khóa hoặc bộ lọc khác.':'Try another search term or reset the filters.'}</p>
          <button type="button" class="ed-btn ed-btn-quiet ed-archive-more" id="ed-reset">{vi?'Đặt lại bộ lọc':'Reset filters'}</button>
        </div>
      </section>
    </div>
  </div>
</BaseLayout>

<style>
  .ed-archive-post[hidden], #ed-no-results[hidden] { display:none !important; }
</style>
<script is:inline>
  (() => {
    const root = document.getElementById('article-browser');
    if (!root) return;
    const query = document.getElementById('ed-article-search');
    const cards = [...root.querySelectorAll('.ed-archive-post')];
    const count = document.getElementById('ed-result-count');
    const empty = document.getElementById('ed-no-results');
    const categoryBtns = [...root.querySelectorAll('[data-category]')].filter(el=>el.tagName === 'BUTTON');
    const seriesBtns = [...root.querySelectorAll('[data-series]')].filter(el=>el.tagName === 'BUTTON');
    const params = new URLSearchParams(window.location.search);
    let currentCategory = categoryBtns.some(b=>b.dataset.category===params.get('category')) ? params.get('category') : 'all';
    let currentSeries = seriesBtns.some(b=>b.dataset.series===params.get('series')) ? params.get('series') : 'all';
    const update = () => {
      const q = (query.value || '').trim().toLocaleLowerCase();
      let shown = 0;
      cards.forEach(card => {
        const visible = (!q || (card.dataset.search || '').includes(q)) &&
          (currentCategory === 'all' || card.dataset.category === currentCategory) &&
          (currentSeries === 'all' || card.dataset.series === currentSeries);
        card.hidden = !visible;
        if (visible) shown++;
      });
      count.textContent = String(shown);
      empty.hidden = shown > 0;
      categoryBtns.forEach(b=>b.setAttribute('aria-pressed',String(b.dataset.category===currentCategory)));
      seriesBtns.forEach(b=>b.setAttribute('aria-pressed',String(b.dataset.series===currentSeries)));
    };
    categoryBtns.forEach(b=>b.addEventListener('click',()=>{
      currentCategory=b.dataset.category;
      const url=new URL(window.location.href);
      if(currentCategory==='all') url.searchParams.delete('category');
      else url.searchParams.set('category',currentCategory);
      history.replaceState(null,'',url);
      update();
    }));
    seriesBtns.forEach(b=>b.addEventListener('click',()=>{
      currentSeries=b.dataset.series;
      const url=new URL(window.location.href);
      if(currentSeries==='all') url.searchParams.delete('series');
      else url.searchParams.set('series',currentSeries);
      history.replaceState(null,'',url);
      update();
    }));
    query.addEventListener('input',update);
    document.getElementById('ed-reset')?.addEventListener('click',()=>{
      query.value='';currentCategory='all';currentSeries='all';
      const url=new URL(window.location.href);url.searchParams.delete('series');url.searchParams.delete('category');
      history.replaceState(null,'',url);update();query.focus();
    });
    update();
  })();
</script>
