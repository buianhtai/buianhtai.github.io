---
import BaseLayout from '../layouts/BaseLayout.astro';
import FlowLesson from '../components/demo/FlowLesson.astro';
---
<BaseLayout title="Python Learning Lab: How CPython Runs Code" description="Predict, trace, break, and explain how CPython handles main scripts and imported modules.">
  <article class="max-w-3xl mx-auto px-4 py-10">
    <div class="post-chrome">
      <div class="post-chrome-dots"><span></span><span></span><span></span></div>
      <span class="post-chrome-path">~/demo/demo-visual-learning.astro</span>
    </div>
    <header class="post-header">
      <div class="post-meta"><span class="post-meta-prompt">$</span><span>python learning lab · predict → trace → break → explain</span></div>
      <h1 class="post-title">How CPython runs your code</h1>
      <p class="post-desc">Predict whether Python writes bytecode, trace two execution paths, break the import cache, then explain the model back.</p>
    </header>

    <FlowLesson />

    <p class="demo-links">
      <a href="/en/blog">← back to blog</a>
      <span>·</span><span>Lab 01 · execution model</span>
    </p>
  </article>
</BaseLayout>

<style>
  .post-chrome { display: flex; align-items: center; gap: 0.75rem; padding: 0.5rem 0.875rem; background: var(--color-surface); border: 1px solid var(--color-border); border-bottom: none; font-family: var(--font-mono); font-size: 0.7rem; color: var(--color-text-muted); }
  .post-chrome-dots { display: flex; gap: 0.35rem; }
  .post-chrome-dots span { width: 8px; height: 8px; border-radius: 50%; background: var(--color-border-bright); display: block; }
  .post-header { border: 1px solid var(--color-border); border-top: none; padding: 1.5rem 1.25rem; background: var(--color-surface); margin-bottom: 1.5rem; }
  .post-meta { display: flex; gap: 0.4rem; font-family: var(--font-mono); font-size: 0.72rem; color: var(--color-text-muted); margin-bottom: 0.875rem; }
  .post-meta-prompt { color: var(--color-accent); font-weight: 700; }
  .post-title { font-size: clamp(1.4rem, 4vw, 2.1rem); font-weight: 700; line-height: 1.25; color: var(--color-text); margin: 0 0 0.75rem; font-family: var(--font-mono); }
  .post-desc { color: var(--color-text-dim); font-size: 0.95rem; line-height: 1.65; margin: 0; }
  .demo-links { margin-top: 1.5rem; display: flex; gap: 0.6rem; align-items: center; font-family: var(--font-mono); font-size: 0.8rem; color: var(--color-text-muted); }
  .demo-links a { color: var(--color-text-dim); text-decoration: none; }
  .demo-links a:hover { color: var(--color-accent); }
</style>
