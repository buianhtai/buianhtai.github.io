---
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import ReadingTime from '../components/ReadingTime.astro';
import Giscus from '../components/Giscus.astro';
import { getPostSlug, getPostUrl, seriesMeta } from '../lib/posts';
import { existsSync } from 'node:fs';
import { join } from 'node:path';

interface Props {
  post: CollectionEntry<'blog'>;
  headings: {depth:number;slug:string;text:string}[];
  rawContent:string;
  seriesPosts?:CollectionEntry<'blog'>[];
  renderTitle?:boolean;
}
const {post,headings,rawContent,seriesPosts = []} = Astro.props;
const {title,description,pubDate,updatedDate,tags,lang,heroImage,series} = post.data;
const renderTitle = Astro.props.renderTitle ?? post.data.renderTitle;
const dateFmt = (d:Date) => d.toLocaleDateString(lang==='vi'?'vi-VN':'en-US',{month:'short',day:'numeric',year:'numeric'});
const chaptersIndex = seriesPosts.findIndex(p=>getPostSlug(p)===getPostSlug(post));
const previous = chaptersIndex > 0 ? seriesPosts[chaptersIndex-1] : null;
const next = chaptersIndex >= 0 && chaptersIndex < seriesPosts.length - 1 ? seriesPosts[chaptersIndex+1] : null;
const toc = headings.filter(h=>h.depth===2||h.depth===3);
const darkSrc = heroImage?.replace(/\.png$/, '-dark.png');
const hasDarkVariant = Boolean(heroImage && darkSrc && darkSrc!==heroImage && existsSync(join(process.cwd(),'public',darkSrc)));
const related = (await getCollection('blog',p=>!p.data.draft && p.data.lang===lang && p.id!==post.id))
  .map(p=>({post:p,score:(series && p.data.series===series?10:0)+p.data.tags.filter(t=>tags.includes(t)).length}))
  .filter(x=>x.score>0)
  .sort((a,b)=>b.score-a.score || b.post.data.pubDate.getTime()-a.post.data.pubDate.getTime())
  .slice(0,3).map(x=>x.post);
const jsonLd = {
  '@context':'https://schema.org','@type':'BlogPosting',
  headline:title,description,datePublished:pubDate.toISOString(),
  ...(updatedDate?{dateModified:updatedDate.toISOString()}:{}),
  author:{'@type':'Person',name:'Tai Bui',url:'https://github.com/buianhtai'},
  mainEntityOfPage:'https://buianhtai.github.io'+getPostUrl(post),
  ...(heroImage?{image:new URL(heroImage,'https://buianhtai.github.io').toString()}:{}),
  inLanguage:lang,
};
---

<BaseLayout title={title} description={description} lang={lang} ogImage={heroImage} article>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <div class="ed-reading-line" id="ed-reading-progress" aria-hidden="true"></div>
  <article class="ed-container ed-article" id="ed-post">
    <nav class="ed-breadcrumb" aria-label="Breadcrumb">
      <a href={`/${lang}/`}>Home</a><span aria-hidden="true">/</span>
      <a href={`/${lang}/blog`}>Writing</a>
      {series && <><span aria-hidden="true">/</span><span>{seriesMeta[series]?.title ?? series}</span></>}
    </nav>
    <header class="ed-article-head">
      <div class="ed-kicker">{series ? seriesMeta[series]?.title ?? series : post.data.category}</div>
      {renderTitle && <><h1>{title}</h1><p class="ed-article-dek">{description}</p></>}
      <div class="ed-article-meta">
        <span>Tai Bui</span><i aria-hidden="true"></i>
        <time datetime={pubDate.toISOString()}>{dateFmt(pubDate)}</time><i aria-hidden="true"></i>
        <ReadingTime content={rawContent} lang={lang} />
        {updatedDate && <><i aria-hidden="true"></i><span>Updated {dateFmt(updatedDate)}</span></>}
      </div>
      {tags.length>0 && <div class="ed-article-tags">
        {tags.slice(0,6).map(t=><a href={`/${lang}/tags/${t}`} class="ed-article-tag">#{t}</a>)}
      </div>}
    </header>

    {heroImage && <div class="ed-article-hero">
      <img src={heroImage} alt={title} loading="eager"
        class:list={['ed-hero-img-light',{'ed-has-dark':hasDarkVariant}]} />
      {hasDarkVariant && <img src={darkSrc} alt={title} loading="eager" class="ed-hero-img-dark" />}
    </div>}

    <div class="ed-article-layout">
      <div class="ed-article-content prose prose-lg max-w-none" id="ed-article-body">
        {toc.length>0 && <details class="ed-mobile-toc">
          <summary>{lang === 'vi' ? 'Mục lục bài viết' : 'On this page'}</summary>
          <ul>{toc.map(h=><li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ul>
        </details>}
        <slot />
      </div>
      {toc.length>0 && <aside class="ed-article-aside" aria-label="On this page">
        <strong>On this page</strong>
        {toc.map(h=><a href={`#${h.slug}`} data-depth={h.depth}>{h.text}</a>)}
      </aside>}
    </div>

    <div class="ed-article-bottom">
      <div class="ed-section-top">
        <div><div class="ed-kicker">Continue exploring</div><h2>Keep reading</h2></div>
        <a href={`/${lang}/blog`}>All articles ↗</a>
      </div>
      {(previous || next) && <nav class="ed-chapter-links" aria-label="Series navigation">
        {previous ? <a class="ed-chapter-link" href={getPostUrl(previous)}><small>← Previous chapter</small><strong>{previous.data.title}</strong></a>:<div />}
        {next && <a class="ed-chapter-link" href={getPostUrl(next)}><small>Next chapter →</small><strong>{next.data.title}</strong></a>}
      </nav>}
      {related.length>0 && <div class="ed-grid" style="margin-top:30px">
        {related.map(p=><article class="ed-card"><a class="ed-card-link" href={getPostUrl(p)}>
          <div class="ed-card-body">
            <div class="ed-card-top"><span class="ed-card-topic">{p.data.category}</span></div>
            <h3>{p.data.title}</h3><p>{p.data.description}</p>
          </div><div class="ed-card-foot"><span>{dateFmt(p.data.pubDate)}</span><span class="arrow">↗</span></div>
        </a></article>)}
      </div>}
      <Giscus />
    </div>
  </article>
</BaseLayout>

<style>
  .ed-article-hero .ed-hero-img-dark {display:none;}
  :global(html:not(.theme-light)) .ed-article-hero .ed-has-dark {display:none;}
  :global(html:not(.theme-light)) .ed-article-hero .ed-hero-img-dark {display:block;}
  @media(max-width:760px) { .ed-article-bottom .ed-grid {grid-template-columns:1fr;} }
</style>
<script is:inline>
  (() => {
    const bar = document.getElementById('ed-reading-progress');
    const body = document.getElementById('ed-article-body');
    if (!bar || !body) return;
    let queued = false;
    const update = () => {
      queued = false;
      const start = body.getBoundingClientRect().top + window.scrollY;
      const end = body.getBoundingClientRect().bottom + window.scrollY;
      const max = Math.max(end - window.innerHeight, start + 1);
      const progress = Math.max(0,Math.min(1,(window.scrollY-start)/(max-start)));
      bar.style.width = Math.round(progress*100)+'%';
    };
    const schedule = () => { if(!queued) {queued=true;requestAnimationFrame(update);} };
    window.addEventListener('scroll',schedule,{passive:true});
    window.addEventListener('resize',schedule);
    schedule();
  })();
</script>
