---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import '../styles/editorial.css';

interface Props {
  title: string;
  description?: string;
  lang?: string;
  ogImage?: string;
  article?: boolean;
  noindex?: boolean;
  publishedDate?: Date;
  modifiedDate?: Date;
  articleTags?: string[];
}
const {
  title, description = 'Engineering notes on AI, distributed systems and software architecture by Tai Bui.',
  lang = 'en', ogImage, article = false, noindex = false,
  publishedDate, modifiedDate, articleTags = [],
} = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const imageURL = new URL(ogImage || '/og/site.png', Astro.site).toString();
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const matchedSection = currentPath.match(/^\/(en|vi)\/(blog|foundations|tags|about)$/);
const hasLocalizedPeer = currentPath === '/' || currentPath === '/en' || currentPath === '/vi' || Boolean(matchedSection);
const localizedSection = matchedSection ? '/' + matchedSection[2] + '/' : '/';
const enURL = new URL('/en' + localizedSection, Astro.site).toString();
const viURL = new URL('/vi' + localizedSection, Astro.site).toString();
const siteSchema = {
  '@context':'https://schema.org','@type':'WebSite',
  name:'Tai Bui — Engineering Notes',
  url:'https://buianhtai.github.io/',
  inLanguage:['en','vi'],
  author:{'@type':'Person',name:'Tai Bui',url:'https://buianhtai.github.io/en/about/'}
};
const pageTitle = title === 'tai.bui' ? 'Tai Bui — Engineering Notes' : title + ' | Tai Bui';
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#101722" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex,follow"/>}
    {hasLocalizedPeer && <>
      <link rel="alternate" hreflang="en" href={enURL}/>
      <link rel="alternate" hreflang="vi" href={viURL}/>
      <link rel="alternate" hreflang="x-default" href={enURL}/>
    </>}
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml"/>
    <script type="application/ld+json" set:html={JSON.stringify(siteSchema)}/>
    <meta property="og:site_name" content="Tai Bui — Engineering Notes" />
    <meta property="og:locale" content={lang === 'vi' ? 'vi_VN' : 'en_US'}/>
    {hasLocalizedPeer && <meta property="og:locale:alternate" content={lang === 'vi' ? 'en_US' : 'vi_VN'}/>}
    {article && publishedDate && <meta property="article:published_time" content={publishedDate.toISOString()}/>}
    {article && modifiedDate && <meta property="article:modified_time" content={modifiedDate.toISOString()}/>}
    {article && articleTags.map(tag => <meta property="article:tag" content={tag}/>)} 
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={imageURL}/>
    <meta property="og:image:alt" content={pageTitle}/>
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL}/>
    <link rel="alternate" type="application/rss+xml" title="Tai Bui engineering notes" href="/rss.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans:wght@300;400;500;600;700&family=IBM+Plex+Serif:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <script is:inline>
      (() => {
        const saved = localStorage.getItem('theme');
        // The editorial reference is intentionally dark by default.
        // Honor explicit light mode selections saved by returning readers.
        const light = saved === 'light' || saved === 'material-light';
        document.documentElement.classList.remove(
          'theme-dracula','theme-nord','theme-gruvbox','theme-solarized','theme-material',
          'theme-material-light','theme-tokyo-night','theme-tokyo-storm'
        );
        document.documentElement.classList.toggle('theme-light', light);
        const savedPalette = localStorage.getItem('f-palette');
        document.documentElement.classList.toggle('f-light-palette',
          light || ['light','infographic','material-light'].includes(savedPalette));
      })();
    </script>
  </head>
  <body class="min-h-screen flex flex-col">
    <Header lang={lang} />
    <main id="main-content" class="flex-1">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
