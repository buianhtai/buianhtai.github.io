---
import ThemeToggle from './ThemeToggle.astro';
const { lang = 'en' } = Astro.props;
const otherLang = lang === 'en' ? 'vi' : 'en';
const path = Astro.url.pathname;
const isHome = path === '/' || path === `/${lang}/`;
const isBlog = path.startsWith(`/${lang}/blog`);
const isFoundations = path.startsWith(`/${lang}/foundations`);
const isTags = path.startsWith(`/${lang}/tags`);
const isAbout = path.startsWith('/'+lang+'/about');
// Only top-level pages have guaranteed localized equivalents.
const switchedPath = isHome ? `/${otherLang}/` :
  isFoundations ? `/${otherLang}/foundations` :
  isTags ? `/${otherLang}/tags` :
  isAbout ? '/'+otherLang+'/about/' : `/${otherLang}/blog`;
const vi = lang === 'vi';
---
<a href="#main-content" class="ed-skip-link">{vi ? 'Chuyển đến nội dung' : 'Skip to content'}</a>
<header class="ed-header">
  <div class="ed-container ed-header-in">
    <a class="ed-wordmark" href={`/${lang}/`} aria-label="Tai Bui — home">tai<span>.</span>bui<span>_</span></a>
    <nav class="ed-nav" aria-label={vi ? 'Điều hướng chính' : 'Main navigation'}>
      <a href={`/${lang}/blog`} aria-current={isBlog ? 'page' : undefined}>{vi ? 'Bài viết' : 'Writing'}</a>
      <a href={`/${lang}/foundations`} aria-current={isFoundations ? 'page' : undefined}>{vi ? 'Kiến thức nền' : 'Foundations'}</a>
      <a class="ed-nav-projects" href={'/'+lang+'/about/'} aria-current={isAbout ? 'page' : undefined}>{vi ? 'Giới thiệu' : 'About'}</a>
    </nav>
    <div class="ed-header-controls">
      <a href={`/${lang}/blog`} class="ed-icon-button" title={vi ? 'Tìm bài viết' : 'Find articles'} aria-label={vi ? 'Tìm bài viết' : 'Find articles'}>
        <svg aria-hidden="true" viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="10.8" cy="10.8" r="6.5"/><path d="m16 16 5 5"/></svg>
      </a>
      <a href={switchedPath} class="ed-icon-button ed-header-lang" title={vi ? 'English' : 'Tiếng Việt'} aria-label={vi ? 'Switch to English' : 'Chuyển sang tiếng Việt'}>{vi ? 'EN' : 'VI'}</a>
      <ThemeToggle />
    </div>
  </div>
</header>
