---
---

<button
  id="theme-toggle"
  aria-label="Switch theme"
  aria-expanded="false"
  aria-haspopup="true"
  style="margin-left: 0.4rem; padding: 0.3rem 0.55rem; font-family: var(--font-mono); font-size: 0.7rem; color: var(--color-text-muted); border: 1px solid var(--color-border); background: transparent; cursor: pointer; transition: color 0.15s, border-color 0.15s; white-space: nowrap;"
  onmouseover="this.style.color='var(--color-accent)'; this.style.borderColor='var(--color-accent)';"
  onmouseout="this.style.color='var(--color-text-muted)'; this.style.borderColor='var(--color-border)';"
>
  [<span id="theme-label">terminal</span>]
</button>


<script>
  const ALL_THEMES = ['terminal', 'light', 'dracula', 'nord', 'gruvbox', 'solarized'];

  const THEMES = [
    { id: 'terminal',  label: 'terminal-dark', dot: '#00d9ff' },
    { id: 'light',     label: 'light',         dot: '#0070a8' },
    { id: 'dracula',   label: 'dracula',        dot: '#bd93f9' },
    { id: 'nord',      label: 'nord',           dot: '#88c0d0' },
    { id: 'gruvbox',   label: 'gruvbox',        dot: '#fabd2f' },
    { id: 'solarized', label: 'solarized-dark', dot: '#268bd2' },
  ];

  // Build the dropdown once and append to body (escapes any overflow:hidden ancestor)
  function buildDropdown() {
    const existing = document.getElementById('theme-dropdown');
    if (existing) return existing;

    const div = document.createElement('div');
    div.id = 'theme-dropdown';
    div.setAttribute('role', 'menu');
    div.style.display = 'none';

    const header = document.createElement('div');
    header.style.cssText = 'padding:0.3rem 0.6rem;font-size:0.62rem;color:var(--color-text-muted);border-bottom:1px solid var(--color-border);letter-spacing:0.08em;text-transform:uppercase;';
    header.textContent = '$ select theme';
    div.appendChild(header);

    const ul = document.createElement('ul');
    ul.style.cssText = 'list-style:none;margin:0;padding:0.25rem 0;';

    THEMES.forEach(t => {
      const li = document.createElement('li');
      li.className = 'theme-option';
      li.dataset.theme = t.id;
      li.setAttribute('role', 'menuitem');

      const dot = document.createElement('span');
      dot.className = 'theme-dot';
      dot.style.background = t.dot;
      li.appendChild(dot);
      li.appendChild(document.createTextNode(t.label));

      li.addEventListener('click', (e) => {
        e.stopPropagation();
        applyTheme(t.id);
        closeDropdown();
      });

      ul.appendChild(li);
    });

    div.appendChild(ul);
    document.body.appendChild(div);
    return div;
  }

  function applyTheme(theme: string) {
    const html = document.documentElement;
    ALL_THEMES.forEach(t => html.classList.remove('theme-' + t));
    if (theme !== 'terminal') html.classList.add('theme-' + theme);
    localStorage.setItem('theme', theme);

    const label = document.getElementById('theme-label');
    if (label) label.textContent = theme === 'terminal' ? 'terminal' : theme;

    document.querySelectorAll<HTMLElement>('.theme-option').forEach(el => {
      el.classList.toggle('is-active', el.dataset.theme === theme);
    });

    document.dispatchEvent(new CustomEvent('theme-change', { detail: { theme } }));
  }

  function openDropdown() {
    const btn = document.getElementById('theme-toggle');
    const dropdown = buildDropdown();
    if (!btn) return;

    // Position below the button using fixed coords
    const rect = btn.getBoundingClientRect();
    dropdown.style.top = (rect.bottom + 4) + 'px';
    dropdown.style.right = (window.innerWidth - rect.right) + 'px';
    dropdown.style.display = 'block';
    btn.setAttribute('aria-expanded', 'true');
  }

  function closeDropdown() {
    const dropdown = document.getElementById('theme-dropdown');
    const btn = document.getElementById('theme-toggle');
    if (dropdown) dropdown.style.display = 'none';
    if (btn) btn.setAttribute('aria-expanded', 'false');
  }

  function isOpen() {
    const d = document.getElementById('theme-dropdown');
    return d ? d.style.display !== 'none' : false;
  }

  function init() {
    // Apply saved theme
    const saved = localStorage.getItem('theme') || 'terminal';
    applyTheme(saved);

    const btn = document.getElementById('theme-toggle');
    if (!btn) return;

    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      isOpen() ? closeDropdown() : openDropdown();
    });
  }

  // Close on outside click
  document.addEventListener('click', (e) => {
    const dropdown = document.getElementById('theme-dropdown');
    const btn = document.getElementById('theme-toggle');
    if (!dropdown || dropdown.style.display === 'none') return;
    if (btn && btn.contains(e.target as Node)) return;
    if (dropdown.contains(e.target as Node)) return;
    closeDropdown();
  });

  // Close on Escape
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeDropdown();
  });

  // Reposition on scroll/resize while open
  window.addEventListener('scroll', () => {
    if (isOpen()) openDropdown();
  }, { passive: true });

  document.addEventListener('astro:page-load', init);
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
</script>
