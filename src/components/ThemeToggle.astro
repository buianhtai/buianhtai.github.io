---
---

<button
  id="theme-toggle"
  aria-label="Switch theme"
  aria-expanded="false"
  aria-haspopup="true"
  style="margin-left: 0.4rem; padding: 0.3rem 0.55rem; font-family: var(--font-mono); font-size: 0.7rem; color: var(--color-text-muted); border: 1px solid var(--color-border); background: transparent; cursor: pointer; transition: color 0.15s, border-color 0.15s; white-space: nowrap;"
  onmouseover="this.style.color='var(--color-accent)'; this.style.borderColor='var(--color-accent)';"
  onmouseout="this.style.color='var(--color-text-muted)'; this.style.borderColor='var(--color-border)';"
>
  [<span id="theme-label">terminal</span>]
</button>


<script>
  const ALL_THEMES = ['terminal', 'light', 'dracula', 'nord', 'gruvbox', 'solarized', 'material', 'material-light', 'tokyo-night', 'tokyo-storm'];

  const THEMES = [
    // ── Classic ──
    { id: 'terminal',      label: 'terminal-dark',   dot: '#00d9ff', group: 'classic' },
    { id: 'light',         label: 'light',           dot: '#0070a8', group: 'classic' },
    { id: 'dracula',       label: 'dracula',         dot: '#bd93f9', group: 'classic' },
    { id: 'nord',          label: 'nord',            dot: '#88c0d0', group: 'classic' },
    { id: 'gruvbox',       label: 'gruvbox',         dot: '#fabd2f', group: 'classic' },
    { id: 'solarized',     label: 'solarized-dark',  dot: '#268bd2', group: 'classic' },
    // ── Material ──
    { id: 'material',      label: 'material dark',   dot: '#bb86fc', group: 'material' },
    { id: 'material-light',label: 'material light',  dot: '#6200ee', group: 'material' },
    // ── Tokyo Night ──
    { id: 'tokyo-night',   label: 'tokyo night',     dot: '#7aa2f7', group: 'tokyo' },
    { id: 'tokyo-storm',   label: 'tokyo storm',     dot: '#bb9af7', group: 'tokyo' },
  ];

  // Palette that auto-applies when a theme is selected (palette-follows-theme)
  const THEME_PALETTE_MAP: Record<string, string> = {
    'terminal':       'indigo',
    'light':          'light',
    'dracula':        'slate',
    'nord':           'sage',
    'gruvbox':        'amber',
    'solarized':      'indigo',
    'material':       'material',
    'material-light': 'material-light',
    'tokyo-night':    'tokyo',
    'tokyo-storm':    'tokyo-storm',
  };

  const F_PALETTES = [
    { id: 'indigo',         label: 'indigo',         dot: '#4589ff' },
    { id: 'slate',          label: 'slate',          dot: '#a78bfa' },
    { id: 'sage',           label: 'sage',           dot: '#5eead4' },
    { id: 'amber',          label: 'amber',          dot: '#f59e0b' },
    { id: 'light',          label: 'light',          dot: '#1d4ed8' },
    { id: 'infographic',    label: 'infographic',    dot: '#e8441a' },
    { id: 'material',       label: 'material dark',  dot: '#bb86fc' },
    { id: 'material-light', label: 'material light', dot: '#6200ee' },
    { id: 'tokyo',          label: 'tokyo night',    dot: '#7aa2f7' },
    { id: 'tokyo-storm',    label: 'tokyo storm',    dot: '#bb9af7' },
  ];

  // Build the dropdown once and append to body (escapes any overflow:hidden ancestor)
  function buildDropdown() {
    const existing = document.getElementById('theme-dropdown');
    if (existing) return existing;

    const div = document.createElement('div');
    div.id = 'theme-dropdown';
    div.setAttribute('role', 'menu');
    div.style.display = 'none';

    // ── Theme section ──
    const header = document.createElement('div');
    header.style.cssText = 'padding:0.3rem 0.6rem;font-size:0.62rem;color:var(--color-text-muted);border-bottom:1px solid var(--color-border);letter-spacing:0.08em;text-transform:uppercase;';
    header.textContent = '$ select theme';
    div.appendChild(header);

    const ul = document.createElement('ul');
    ul.style.cssText = 'list-style:none;margin:0;padding:0.25rem 0;';

    let lastGroup = '';
    THEMES.forEach(t => {
      // Insert sub-group separator when group changes (skip first group)
      if (t.group !== lastGroup && lastGroup !== '') {
        const sep = document.createElement('li');
        sep.style.cssText = 'height:1px;background:var(--color-border);margin:0.2rem 0.5rem;';
        ul.appendChild(sep);
      }
      lastGroup = t.group;

      const li = document.createElement('li');
      li.className = 'theme-option';
      li.dataset.theme = t.id;
      li.setAttribute('role', 'menuitem');

      const dot = document.createElement('span');
      dot.className = 'theme-dot';
      dot.style.background = t.dot;
      li.appendChild(dot);
      li.appendChild(document.createTextNode(t.label));

      li.addEventListener('click', (e) => {
        e.stopPropagation();
        applyTheme(t.id);
        closeDropdown();
      });

      ul.appendChild(li);
    });

    div.appendChild(ul);

    // ── Foundations palette section (only visible on foundations pages) ──
    const fSection = document.createElement('div');
    fSection.id = 'f-palette-section';
    fSection.style.display = 'none'; // shown dynamically

    const fHeader = document.createElement('div');
    fHeader.style.cssText = 'padding:0.3rem 0.6rem;font-size:0.62rem;color:var(--color-text-muted);border-top:1px solid var(--color-border);border-bottom:1px solid var(--color-border);letter-spacing:0.08em;text-transform:uppercase;margin-top:0.25rem;';
    fHeader.textContent = '◈ foundations palette';
    fSection.appendChild(fHeader);

    const fUl = document.createElement('ul');
    fUl.style.cssText = 'list-style:none;margin:0;padding:0.25rem 0;';

    F_PALETTES.forEach(p => {
      const li = document.createElement('li');
      li.className = 'theme-option';
      li.dataset.fPalette = p.id;
      li.setAttribute('role', 'menuitem');

      const dot = document.createElement('span');
      dot.className = 'theme-dot';
      dot.style.background = p.dot;
      li.appendChild(dot);
      li.appendChild(document.createTextNode(p.label));

      li.addEventListener('click', (e) => {
        e.stopPropagation();
        const fn = (window as any).__applyFPalette;
        if (fn) fn(p.id);
        // sync active state
        document.querySelectorAll<HTMLElement>('[data-f-palette]').forEach(el => {
          el.classList.toggle('is-active', el.dataset.fPalette === p.id);
        });
        closeDropdown();
      });

      fUl.appendChild(li);
    });

    fSection.appendChild(fUl);
    div.appendChild(fSection);

    document.body.appendChild(div);
    return div;
  }

  // Show/hide foundations palette section based on whether we're on a foundations page
  function syncFPaletteSection() {
    const section = document.getElementById('f-palette-section');
    if (!section) return;
    const isFoundations = document.body.hasAttribute('data-f-page');
    section.style.display = isFoundations ? 'block' : 'none';
    if (isFoundations) {
      // Mark active palette
      const saved = localStorage.getItem('f-palette') ?? 'indigo';
      section.querySelectorAll<HTMLElement>('[data-f-palette]').forEach(el => {
        el.classList.toggle('is-active', el.dataset.fPalette === saved);
      });
    }
  }

  function applyTheme(theme: string) {
    const html = document.documentElement;
    ALL_THEMES.forEach(t => html.classList.remove('theme-' + t));
    if (theme !== 'terminal') html.classList.add('theme-' + theme);
    localStorage.setItem('theme', theme);

    const label = document.getElementById('theme-label');
    if (label) label.textContent = theme === 'terminal' ? 'terminal' : theme;

    document.querySelectorAll<HTMLElement>('.theme-option').forEach(el => {
      el.classList.toggle('is-active', el.dataset.theme === theme);
    });

    document.dispatchEvent(new CustomEvent('theme-change', { detail: { theme } }));

    // ── Palette-follows-theme: auto-switch foundations palette ──
    const linkedPalette = THEME_PALETTE_MAP[theme];
    if (linkedPalette) {
      localStorage.setItem('f-palette', linkedPalette);
      // If on a foundations page, apply immediately
      const fn = (window as any).__applyFPalette;
      if (fn) fn(linkedPalette);
      // Sync active dots in dropdown
      document.querySelectorAll<HTMLElement>('[data-f-palette]').forEach(el => {
        el.classList.toggle('is-active', el.dataset.fPalette === linkedPalette);
      });
    }
  }

  function openDropdown() {
    const btn = document.getElementById('theme-toggle');
    const dropdown = buildDropdown();
    if (!btn) return;

    syncFPaletteSection();

    // Position below the button using fixed coords
    const rect = btn.getBoundingClientRect();
    dropdown.style.top = (rect.bottom + 4) + 'px';
    dropdown.style.right = (window.innerWidth - rect.right) + 'px';
    dropdown.style.display = 'block';
    btn.setAttribute('aria-expanded', 'true');
  }

  function closeDropdown() {
    const dropdown = document.getElementById('theme-dropdown');
    const btn = document.getElementById('theme-toggle');
    if (dropdown) dropdown.style.display = 'none';
    if (btn) btn.setAttribute('aria-expanded', 'false');
  }

  function isOpen() {
    const d = document.getElementById('theme-dropdown');
    return d ? d.style.display !== 'none' : false;
  }

  function init() {
    // Apply saved theme
    const saved = localStorage.getItem('theme') || 'terminal';
    applyTheme(saved);

    const btn = document.getElementById('theme-toggle');
    if (!btn) return;

    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      isOpen() ? closeDropdown() : openDropdown();
    });
  }

  // Close on outside click
  document.addEventListener('click', (e) => {
    const dropdown = document.getElementById('theme-dropdown');
    const btn = document.getElementById('theme-toggle');
    if (!dropdown || dropdown.style.display === 'none') return;
    if (btn && btn.contains(e.target as Node)) return;
    if (dropdown.contains(e.target as Node)) return;
    closeDropdown();
  });

  // Close on Escape
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeDropdown();
  });

  // Reposition on scroll/resize while open
  window.addEventListener('scroll', () => {
    if (isOpen()) openDropdown();
  }, { passive: true });

  document.addEventListener('astro:page-load', init);
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
</script>
