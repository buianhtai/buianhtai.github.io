---
---

<div id="theme-picker" style="position: relative; display: inline-block; margin-left: 0.4rem;">
  <button
    id="theme-toggle"
    aria-label="Switch theme"
    aria-expanded="false"
    aria-haspopup="true"
    style="padding: 0.3rem 0.55rem; font-family: var(--font-mono); font-size: 0.7rem; color: var(--color-text-muted); border: 1px solid var(--color-border); background: transparent; cursor: pointer; transition: color 0.15s, border-color 0.15s; white-space: nowrap;"
    onmouseover="this.style.color='var(--color-accent)'; this.style.borderColor='var(--color-accent)';"
    onmouseout="this.style.color='var(--color-text-muted)'; this.style.borderColor='var(--color-border)';"
  >
    [<span id="theme-label">terminal</span>]
  </button>

  <div
    id="theme-menu"
    role="menu"
    style="
      display: none;
      position: absolute;
      right: 0;
      top: calc(100% + 4px);
      min-width: 11rem;
      background: var(--color-surface);
      border: 1px solid var(--color-border-bright);
      font-family: var(--font-mono);
      font-size: 0.7rem;
      z-index: 9999;
      overflow: hidden;
      box-shadow: 0 4px 16px rgba(0,0,0,0.4);
    "
  >
    <div style="padding: 0.3rem 0.6rem; font-size: 0.62rem; color: var(--color-text-muted); border-bottom: 1px solid var(--color-border); letter-spacing: 0.08em; text-transform: uppercase;">$ select theme</div>
    <ul style="list-style: none; margin: 0; padding: 0.25rem 0;">
      <li data-theme="terminal" class="theme-option">
        <span class="theme-dot" style="background: #00d9ff;"></span>terminal-dark
      </li>
      <li data-theme="light" class="theme-option">
        <span class="theme-dot" style="background: #0070a8;"></span>light
      </li>
      <li data-theme="dracula" class="theme-option">
        <span class="theme-dot" style="background: #bd93f9;"></span>dracula
      </li>
      <li data-theme="nord" class="theme-option">
        <span class="theme-dot" style="background: #88c0d0;"></span>nord
      </li>
      <li data-theme="gruvbox" class="theme-option">
        <span class="theme-dot" style="background: #fabd2f;"></span>gruvbox
      </li>
      <li data-theme="solarized" class="theme-option">
        <span class="theme-dot" style="background: #268bd2;"></span>solarized-dark
      </li>
    </ul>
  </div>
</div>

<style>
  .theme-option {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.75rem;
    cursor: pointer;
    color: var(--color-text-dim);
    transition: color 0.1s, background 0.1s;
    user-select: none;
  }
  .theme-option:hover {
    color: var(--color-accent);
    background: var(--color-accent-glow);
  }
  .theme-option.is-active {
    color: var(--color-accent);
  }
  .theme-option.is-active::before {
    content: '▶';
    margin-right: 0.3rem;
    font-size: 0.6rem;
    color: var(--color-accent);
  }
  .theme-dot {
    display: inline-block;
    width: 7px;
    height: 7px;
    border-radius: 0;
    flex-shrink: 0;
  }
</style>

<script>
  // Use a proper module script (not is:inline) — runs after DOM is ready,
  // deduplicated by Astro's bundler, works with View Transitions.

  const ALL_THEMES = ['terminal', 'light', 'dracula', 'nord', 'gruvbox', 'solarized'];

  function applyTheme(theme: string) {
    const html = document.documentElement;
    ALL_THEMES.forEach(t => html.classList.remove('theme-' + t));
    if (theme !== 'terminal') html.classList.add('theme-' + theme);
    localStorage.setItem('theme', theme);

    const label = document.getElementById('theme-label');
    if (label) label.textContent = theme;

    document.querySelectorAll<HTMLElement>('.theme-option').forEach(el => {
      el.classList.toggle('is-active', el.dataset.theme === theme);
    });

    document.dispatchEvent(new CustomEvent('theme-change', { detail: { theme } }));
  }

  function initThemePicker() {
    const btn = document.getElementById('theme-toggle') as HTMLButtonElement | null;
    const menu = document.getElementById('theme-menu') as HTMLElement | null;
    const picker = document.getElementById('theme-picker') as HTMLElement | null;
    if (!btn || !menu || !picker) return;

    // Sync label + active state to current theme
    const current = localStorage.getItem('theme') || 'terminal';
    applyTheme(current);

    function openMenu() {
      menu.style.display = 'block';
      btn.setAttribute('aria-expanded', 'true');
    }
    function closeMenu() {
      menu.style.display = 'none';
      btn.setAttribute('aria-expanded', 'false');
    }
    function isOpen() {
      return menu.style.display !== 'none';
    }

    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      isOpen() ? closeMenu() : openMenu();
    });

    picker.querySelectorAll<HTMLElement>('.theme-option').forEach(el => {
      el.addEventListener('click', (e) => {
        e.stopPropagation();
        applyTheme(el.dataset.theme!);
        closeMenu();
      });
    });

    document.addEventListener('click', (e) => {
      if (!picker.contains(e.target as Node)) closeMenu();
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeMenu();
    });
  }

  // Run on initial load and after each Astro View Transition navigation
  document.addEventListener('astro:page-load', initThemePicker);
  // Fallback for pages without View Transitions
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initThemePicker);
  } else {
    initThemePicker();
  }
</script>
