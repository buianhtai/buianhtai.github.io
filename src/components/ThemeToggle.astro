---
<button type="button" id="theme-toggle" class="ed-icon-button" aria-label="Switch color theme" title="Switch color theme">
  <span id="theme-icon" aria-hidden="true">◐</span>
</button>
<script is:inline>
  (() => {
    const button = document.getElementById('theme-toggle');
    const icon = document.getElementById('theme-icon');
    if (!button || !icon) return;
    const sync = () => {
      const light = document.documentElement.classList.contains('theme-light');
      icon.textContent = light ? '☾' : '☼';
      button.setAttribute('aria-label', light ? 'Switch to dark mode' : 'Switch to light mode');
      button.title = light ? 'Dark mode' : 'Light mode';
    };
    button.addEventListener('click', () => {
      const root = document.documentElement;
      const light = !root.classList.contains('theme-light');
      root.classList.toggle('theme-light', light);
      localStorage.setItem('theme', light ? 'light' : 'terminal');
      root.dispatchEvent(new Event('theme-change', { bubbles:true }));
      document.dispatchEvent(new Event('theme-change'));
      sync();
    });
    sync();
  })();
</script>
