---
import { Icon } from 'astro-icon/components';
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'div'> {
  title: string;
  category: string;
  icon?: string; // Iconify icon name (e.g., 'logos:kafka')
}

const { title, category, icon, ...attrs } = Astro.props;
---

<div class="hero-banner-wrap" {...attrs}>
  <div class="hero-banner-content">
    <p class="hero-banner-category">{category}</p>
    <h1 class="hero-banner-title">{title}</h1>
    {icon && (
      <div class="hero-banner-icon">
        <Icon name={icon} width="64" height="64" />
      </div>
    )}
  </div>
</div>

<style>
  .hero-banner-wrap {
    position: relative;
    padding: 3rem 1.5rem;
    background-color: var(--color-surface-2);
    border: 1px solid var(--color-border);
    margin-bottom: 2rem;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 200px;
  }

  .hero-banner-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    max-width: 800px;
    z-index: 1;
    position: relative;
  }

  .hero-banner-category {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-text-dim);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 0.5rem;
  }

  .hero-banner-title {
    font-family: var(--font-sans);
    font-size: 2.5rem;
    line-height: 1.1;
    color: var(--color-text);
    margin-bottom: 1.5rem;
    font-weight: 700;
  }

  .hero-banner-icon {
    /* Styles for the icon container */
    color: var(--color-accent); /* Use accent color for icon if it's monochrome */
  }

  /* Optional: subtle background pattern for the banner */
  .hero-banner-wrap::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: radial-gradient(
      circle,
      var(--color-border) 1px,
      transparent 1px
    );
    background-size: 28px 28px;
    opacity: 0.1;
    z-index: 0;
  }
</style>
