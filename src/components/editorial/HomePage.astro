---
import { getCollection } from 'astro:content';
import { getPostUrl } from '../../lib/posts';
import seriesData from '../../content/series.json';

interface Props { lang?: 'en' | 'vi'; }
const { lang = 'en' } = Astro.props;
const isVi = lang === 'vi';
const articles = (await getCollection('blog', p => p.data.lang === lang && !p.data.draft))
  .sort((a,b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
const picked = articles.filter(p => p.data.featured).slice(0,3);
const featured = [...picked,...articles.filter(p => !picked.some(x => x.id === p.id))].slice(0,3);
const recent = articles.filter(p => !featured.some(x => x.id === p.id)).slice(0,4);
const series = seriesData.map((s, idx) => ({
  ...s, index: String(idx+1).padStart(2,'0'),
  count: articles.filter(p => p.data.series === s.id).length,
})).filter(s => s.count > 0);
const count = (n: number) => String(n).padStart(2,'0');
const shortDate = (d: Date) => d.toLocaleDateString(lang === 'vi' ? 'vi-VN' : 'en-US', {year:'numeric',month:'short',day:'numeric'});
---

<div class="ed-home">
  <section class="ed-hero">
    <div class="ed-container ed-hero-grid">
      <div>
        <div class="ed-eyebrow ed-kicker"><span class="ed-dot"></span>{isVi ? 'Kỹ thuật phần mềm • Chia sẻ kiến thức' : 'Engineering notes · Learning in public'}</div>
        <h1>
          {isVi ? <>Xây dựng hệ thống.<br /><em>Chia sẻ kiến thức.</em></>
          : <>Building systems.<br /><em>Sharing the thinking.</em></>}
        </h1>
        <p class="ed-hero-intro">
          {isVi
            ? 'Tôi là Tai Bui — kỹ sư backend quan tâm đến AI agents, hệ thống phân tán, cơ sở dữ liệu và những đánh đổi khi thiết kế phần mềm thực tế.'
            : 'I’m Tai Bui, a backend engineer exploring AI agents, distributed systems, database internals and the architecture decisions behind reliable software.'}
        </p>
        <div class="ed-hero-actions">
          <a class="ed-btn ed-btn-primary" href={`/${lang}/blog`}>{isVi ? 'Khám phá bài viết' : 'Explore writing'} <span aria-hidden="true">↗</span></a>
          <a class="ed-btn ed-btn-quiet" href="https://github.com/buianhtai" rel="noopener noreferrer" target="_blank">GitHub <span aria-hidden="true">↗</span></a>
        </div>
        <div class="ed-hero-stats">
          <div class="ed-hero-stat"><strong>{articles.length}</strong><span>{isVi ? 'Bài viết' : 'Articles'}</span></div>
          <div class="ed-hero-stat"><strong>{series.length}</strong><span>{isVi ? 'Chuyên đề' : 'Deep-dive series'}</span></div>
          <div class="ed-hero-stat"><strong>01</strong><span>{isVi ? 'Tư duy kỹ thuật' : 'Engineering mindset'}</span></div>
        </div>
      </div>
      <div class="ed-hero-panel" aria-label="Topics covered in this blog">
        <div class="ed-panel-head"><span>~/engineering/notes</span><span aria-hidden="true">● ● ●</span></div>
        <div class="ed-panel-body">
          <div class="ed-kicker" style="margin-bottom:10px">{isVi ? 'Những điều tôi nghiên cứu' : 'Areas of curiosity'}</div>
          {[
            ['01','AI agents & orchestration','Tools, memory, retrieval'],
            ['02','Distributed systems','Scale, resilience, trade-offs'],
            ['03','Database internals','Storage, queries, consistency'],
            ['04','Engineering craft','From principles to production'],
          ].map(([number,title,subtitle]) => (
            <div class="ed-panel-line">
              <span class="ed-panel-index">{number}</span>
              <div><div class="ed-panel-label">{title}</div><div class="ed-panel-caption">{subtitle}</div></div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="ed-container ed-home-section" aria-labelledby="featured-title">
    <div class="ed-section-top">
      <div><div class="ed-kicker">{isVi ? 'Lựa chọn của tác giả' : 'Editor’s picks'}</div><h2 id="featured-title">{isVi ? 'Bài viết nổi bật' : 'Start with these ideas'}</h2></div>
      <a href={`/${lang}/blog`}>{isVi ? 'Xem tất cả' : 'All articles'} ↗</a>
    </div>
    <div class="ed-grid">
      {featured.map(post => (
        <article class="ed-card">
          <a class="ed-card-link" href={getPostUrl(post)}>
            <div class="ed-card-body">
              <div class="ed-card-top"><span class="ed-card-topic">{post.data.category}</span><span>·</span><time datetime={post.data.pubDate.toISOString()}>{shortDate(post.data.pubDate)}</time></div>
              <h3>{post.data.title}</h3><p>{post.data.description}</p>
            </div>
            <div class="ed-card-foot"><span>{post.data.series ? 'Deep dive / Series' : 'Engineering notes'}</span><span class="arrow" aria-hidden="true">↗</span></div>
          </a>
        </article>
      ))}
    </div>
  </section>

  <section class="ed-container ed-home-section" aria-labelledby="series-title">
    <div class="ed-section-top">
      <div><div class="ed-kicker">{isVi ? 'Học theo lộ trình' : 'Structured learning'}</div><h2 id="series-title">{isVi ? 'Các chuyên đề' : 'Explore the series'}</h2></div>
      <a href={`/${lang}/blog`}>{isVi ? 'Thư viện bài viết' : 'Browse library'} ↗</a>
    </div>
    {series.length > 0 ? (
      <div class="ed-series-grid">
        {series.map(s => (
          <a class="ed-series-card" href={`/${lang}/blog?series=${encodeURIComponent(s.id)}`}>
            <span class="ed-series-icon" aria-hidden="true">{s.index}</span>
            <h3>{s.title}</h3><p>{s.description}</p>
            <small>{s.count} {isVi ? 'bài viết' : 'articles'} <span aria-hidden="true">↗</span></small>
          </a>
        ))}
      </div>
    ): <p class="ed-muted">{isVi ? 'Đang cập nhật các chuyên đề.' : 'More curated series coming soon.'}</p>}
  </section>

  <section class="ed-container ed-home-section" aria-labelledby="latest-title">
    <div class="ed-section-top">
      <div><div class="ed-kicker">{isVi ? 'Mới xuất bản' : 'Fresh from the desk'}</div><h2 id="latest-title">{isVi ? 'Bài viết gần đây' : 'Recent writing'}</h2></div>
      <a href={`/${lang}/blog`}>{isVi ? 'Xem thêm' : 'View all'} ↗</a>
    </div>
    <div class="ed-archive-list">
      {recent.map(post => (
        <a href={getPostUrl(post)} class="ed-archive-post">
          <time class="ed-archive-date" datetime={post.data.pubDate.toISOString()}>{shortDate(post.data.pubDate)}</time>
          <div><div class="ed-kicker" style="font-size:.63rem">{post.data.category}</div><h2>{post.data.title}</h2><p>{post.data.description}</p></div>
          <span class="ed-archive-arrow" aria-hidden="true">↗</span>
        </a>
      ))}
    </div>
  </section>

  <section class="ed-container ed-home-section" id="projects">
    <div class="ed-about">
      <div>
        <div class="ed-kicker">{isVi ? 'Về tác giả' : 'Behind the articles'}</div>
        <h2>{isVi ? 'Viết để hiểu sâu hơn.' : 'Curiosity meets production engineering.'}</h2>
        <p>{isVi
          ? 'Tôi ghi lại những kiến thức, thử nghiệm và bài học trong quá trình thiết kế hệ thống backend và nghiên cứu kiến trúc AI. Mục tiêu là giải thích rõ ràng những điều phức tạp.'
          : 'I write about the internals, experiments, and architectural trade-offs I encounter while building backend systems and studying AI infrastructure. The goal: make hard engineering ideas understandable.'}</p>
      </div>
      <a href="https://github.com/buianhtai" class="ed-btn ed-btn-quiet" target="_blank" rel="noopener noreferrer">{isVi ? 'Xem GitHub' : 'Explore GitHub'} ↗</a>
    </div>
  </section>
</div>
