---
import { getCollection } from 'astro:content';
import { Icon } from 'astro-icon/components';
import { getPostUrl } from '../../lib/posts';
import seriesData from '../../content/series.json';

interface Props { lang?: 'en' | 'vi' }
const { lang = 'en' } = Astro.props;
const vi = lang === 'vi';
const articles = (await getCollection('blog', p => p.data.lang === lang && !p.data.draft))
  .sort((a,b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
const curatedSlugs = lang === 'en' ? [
  'deepagents-kb-mcp-troubleshooting',
  'neo4j-deep-dive-storage-indexes-query-optimization',
  'how-enterprises-handle-large-scale-data-imports',
] : [];
const curated = curatedSlugs.flatMap(slug=>{
  const post = articles.find(p=>p.id.includes(slug));
  return post ? [post] : [];
});
const editorFavorites = articles.filter(p=>p.data.featured && !curated.some(c=>c.id===p.id));
const featured = [...curated, ...editorFavorites,
  ...articles.filter(p=>!curated.some(c=>c.id===p.id) && !editorFavorites.some(f=>f.id===p.id))
].slice(0,3);
const recent = articles.filter(p=>!featured.some(f=>f.id===p.id)).slice(0,4);
const series = seriesData.map(s=>({
  ...s, count:articles.filter(p=>p.data.series===s.id).length
})).filter(s=>s.count>0);
const topics = [
  {label:'AI & Agents', icon:'lucide:brain-circuit', small:'Agents, RAG & tools', href:`/${lang}/blog?category=ai`},
  {label:'System Design', icon:'lucide:network', small:'Scaling & reliability',href:`/${lang}/blog?category=architecture`},
  {label:'Database Internals',icon:'lucide:database',small:'Storage & consistency',href:`/${lang}/foundations`},
  {label:'Programming',icon:'lucide:code-2',small:'Languages & patterns',href:`/${lang}/blog?category=tutorial`},
];
const dateLabel = (date:Date)=>date.toLocaleDateString(vi?'vi-VN':'en-US',{month:'short',day:'numeric',year:'numeric'});
---

<div class="ed-home ed-home-v2">
  <section class="ed-hero" aria-labelledby="hero-heading">
    <div class="ed-container ed-hero-grid">
      <div class="ed-hero-copy">
        <div class="ed-eyebrow ed-kicker"><span class="ed-dot" aria-hidden="true"></span>
          {vi ? 'KỸ THUẬT PHẦN MỀM · TÌM HIỂU CHUYÊN SÂU' : 'ENGINEERING NOTES · LEARNING IN PUBLIC'}
        </div>
        <h1 id="hero-heading">{vi ?
          <>Xây dựng hệ thống.<br/><em>Chia sẻ kiến thức.</em></> :
          <>Building systems.<br/><em>Sharing what I learn.</em></>
        }</h1>
        <p class="ed-hero-intro">{vi
          ? 'Tôi là Tai Bui. Tôi tìm hiểu kiến trúc AI, hệ thống phân tán và những quyết định thiết kế tạo nên phần mềm đáng tin cậy.'
          : 'I’m Tai Bui, a backend engineer exploring AI agents, distributed systems, database internals, and the decisions behind reliable software.'}
        </p>
        <div class="ed-hero-actions">
          <a class="ed-btn ed-btn-primary" href={`/${lang}/blog`}>{vi?'Khám phá bài viết':'Explore articles'} <span aria-hidden="true">→</span></a>
          <a class="ed-btn ed-btn-quiet" href={'/'+lang+'/about/'}>{vi?'Giới thiệu':'About me'} <span aria-hidden="true">↗</span></a>
          <a class="ed-btn ed-btn-quiet" href="/architecture/">{vi ? 'Sơ đồ kiến trúc' : 'Architecture catalog'} <span aria-hidden="true">↗</span></a>
        </div>
        <div class="ed-hero-stats" aria-label={vi?'Thống kê bài viết':'Publishing overview'}>
          <div class="ed-hero-stat"><strong>{articles.length}</strong><span>{vi?'Bài viết':'Articles'}</span></div>
          <div class="ed-hero-stat"><strong>{series.length}</strong><span>{vi?'Chuyên đề':'Series'}</span></div>
          <div class="ed-hero-stat"><strong>{new Set(articles.flatMap(p=>p.data.tags)).size}</strong><span>{vi?'Từ khóa':'Topics & tags'}</span></div>
        </div>
      </div>
      <div class="ed-topic-panel" aria-label={vi?'Khám phá theo chủ đề':'Explore by topic'}>
        <div class="ed-topic-panel-header">
          <span>{vi?'Khám phá theo chủ đề':'Explore by topic'}</span>
          <span class="ed-panel-visual" aria-hidden="true">✳</span>
        </div>
        <div class="ed-topic-grid">
          {topics.map(topic=>(
            <a class="ed-topic-card" href={topic.href}>
              <span class="ed-topic-icon"><Icon name={topic.icon} width="25" height="25" /></span>
              <span class="ed-topic-name">{topic.label}</span>
              <span class="ed-topic-note">{topic.small} <span aria-hidden="true">↗</span></span>
            </a>
          ))}
        </div>
        <p class="ed-topic-panel-caption">{vi
          ? 'Kiến thức nền tảng, những phân tích sâu, và bài học từ việc xây dựng hệ thống.'
          : 'First principles, deep dives, and lessons from building real systems.'}</p>
      </div>
    </div>
  </section>

  <section class="ed-container ed-home-section" aria-labelledby="featured-title">
    <div class="ed-section-top">
      <div><div class="ed-kicker">{vi?'BÀI VIẾT ĐƯỢC CHỌN LỌC':'FEATURED WRITING'}</div>
        <h2 id="featured-title">{vi?'Đọc những bài nổi bật':'Start with these ideas'}</h2>
        <p class="ed-section-lead">{vi?'Các phân tích và ghi chép kỹ thuật đáng khám phá.':'Selected deep dives into architecture and engineering.'}</p>
      </div>
      <a href={`/${lang}/blog`}>{vi?'Tất cả bài viết':'Browse all articles'} <span aria-hidden="true">→</span></a>
    </div>
    <div class="ed-grid ed-featured-grid">
      {featured.map((post,i)=>(
        <article class="ed-card ed-feature-card">
          <a class="ed-card-link" href={getPostUrl(post)}>
            <div class="ed-feature-graphic" data-art={post.data.category} aria-hidden="true">
              <div class="ed-feature-glyph">{String(i+1).padStart(2,'0')}</div>
              <span class="ed-feature-graphic-caption">{post.data.series ? 'ENGINEERING DEEP DIVE' : 'FIELD NOTES'}</span>
            </div>
            <div class="ed-card-body">
              <div class="ed-card-top"><span class="ed-card-topic">{post.data.category}</span><span>·</span>
                <time datetime={post.data.pubDate.toISOString()}>{dateLabel(post.data.pubDate)}</time></div>
              <h3>{post.data.title}</h3><p>{post.data.description}</p>
            </div>
            <div class="ed-card-foot"><span>{post.data.series?'Read the series':'Read article'}</span><span class="arrow" aria-hidden="true">↗</span></div>
          </a>
        </article>
      ))}
    </div>
  </section>

  {series.length>0 && <section class="ed-container ed-home-section" aria-labelledby="series-title">
    <div class="ed-section-top">
      <div><div class="ed-kicker">{vi?'ĐỌC THEO LỘ TRÌNH':'CURATED LEARNING PATHS'}</div>
        <h2 id="series-title">{vi?'Khám phá các chuyên đề':'Go deeper, one topic at a time'}</h2>
        <p class="ed-section-lead">{vi?'Các bài viết kết nối với nhau theo một lộ trình.':'Connected articles that build understanding chapter by chapter.'}</p>
      </div>
    </div>
    <div class="ed-series-grid">
      {series.map((s,i)=>(
        <a class="ed-series-card" href={`/${lang}/blog?series=${encodeURIComponent(s.id)}`}>
          <span class="ed-series-icon" aria-hidden="true">{String(i+1).padStart(2,'0')}</span>
          <h3>{s.title}</h3><p>{s.description}</p>
          <small>{s.count} {vi?'bài viết':'articles'} <span aria-hidden="true">→</span></small>
        </a>
      ))}
    </div>
  </section>}

  <section class="ed-container ed-home-section" aria-labelledby="latest-title">
    <div class="ed-section-top">
      <div><div class="ed-kicker">{vi?'MỚI XUẤT BẢN':'RECENT WRITING'}</div>
        <h2 id="latest-title">{vi?'Bài viết gần đây':'Latest notes from the desk'}</h2></div>
      <a href={`/${lang}/blog`}>{vi?'Xem tất cả':'All writing'} <span aria-hidden="true">→</span></a>
    </div>
    <div class="ed-archive-list">
      {recent.map(post=>(
        <a href={getPostUrl(post)} class="ed-archive-post">
          <time class="ed-archive-date" datetime={post.data.pubDate.toISOString()}>{dateLabel(post.data.pubDate)}</time>
          <div><div class="ed-kicker" style="font-size:.63rem">{post.data.category}</div><h2>{post.data.title}</h2><p>{post.data.description}</p></div>
          <span class="ed-archive-arrow" aria-hidden="true">↗</span>
        </a>
      ))}
    </div>
  </section>

  <section class="ed-container ed-home-section" id="projects" aria-labelledby="about-title">
    <div class="ed-about">
      <div>
        <div class="ed-kicker">{vi?'VỀ TÁC GIẢ':'ABOUT THE AUTHOR'}</div>
        <h2 id="about-title">{vi?'Viết để hiểu sâu hơn.':'Curiosity, clarity, and engineering craft.'}</h2>
        <p>{vi
          ? 'Tôi ghi lại những kiến thức, thử nghiệm và đánh đổi kiến trúc trong quá trình xây dựng phần mềm và tìm hiểu hạ tầng AI. Viết giúp tôi hiểu sâu hơn và chia sẻ những gì hữu ích.'
          : 'I document the systems, experiments, and architectural trade-offs I encounter while building software and exploring AI infrastructure. Writing is how I learn, and how I share what I find.'}</p>
      </div>
      <a href={'/'+lang+'/about/'} class="ed-btn ed-btn-quiet">{vi?'Đọc giới thiệu':'More about me'} ↗</a>
    </div>
  </section>
</div>
