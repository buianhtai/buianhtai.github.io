<script>
(()=>{
 const root=document.querySelector('#agno-diagram-explorer');if(!root||root.dataset.initialized==='yes')return;root.dataset.initialized='yes';
 const $=s=>root.querySelector(s),$$=s=>[...root.querySelectorAll(s)];
 const scenes=$$('[data-scene]'),tabs=$$('[data-diagram]'),stage=$('#de-stage');
 const defaultSource='https://github.com/agno-agi/agno/tree/1f2aac51eb28dc9c0970836d3b7ae046bae81bbb';
 let current='system',only=false,fullscreen=false,prevOverflow='',view={x:0,y:0,w:1300,h:650},drag=null,pointers=new Map(),pinch=null;
 function svg(){return $('[data-scene="'+current+'"] .de-svg')}
 function update(){svg()?.setAttribute('viewBox',[view.x,view.y,view.w,view.h].join(' '))}
 function reset(){
  const ratio=stage.clientWidth/stage.clientHeight;
  if(stage.clientWidth<620){view={x:0,y:80,w:500,h:Math.round(500/ratio)}}
  else view={x:0,y:0,w:1300,h:650};
  update()
 }
 function choose(name){
  const tab=tabs.find(t=>t.dataset.diagram===name);if(!tab)return;
  current=name;tabs.forEach(b=>{const yes=b===tab;b.setAttribute('aria-selected',String(yes));b.tabIndex=yes?0:-1});
  scenes.forEach(s=>s.hidden=s.dataset.scene!==name);
  $$('.de-mobile-card').forEach(el=>el.classList.remove('is-selected'));
  $('#de-heading-label').textContent=String(tabs.indexOf(tab)+1).padStart(2,'0')+' / '+tab.querySelector('strong').textContent.toUpperCase();
  $('#de-heading-title').textContent=tab.querySelector('small').textContent;
  $('#de-summary').textContent={system:'AgentOS is a configurable FastAPI app; databases, providers and tools are configured dependencies.',assembly:'Agent definitions → AgentOS(...) → get_app() → routes + lifespans → serve().',request:'Router → agent.arun() → model/tools → SSE events.',durable:'Optional queue admission → persisted ticket → worker lease → agent run → optional event replay.'}[name];
  $('#de-inspect-title').textContent='Select a node';$('#de-inspect-detail').textContent='Choose a component to inspect the real implementation.';$('#de-inspect-source').href=defaultSource;$('#de-relationships').replaceChildren();
  $$$('.de-node').forEach(n=>n.classList.remove('is-selected','is-muted'));$$('.de-edge').forEach(n=>n.classList.remove('is-focused','is-muted'));
  reset()
 }
 function inspect(n){
  const scene=n.closest('[data-scene]');const id=n.dataset.node;
  scene.querySelectorAll('.de-node').forEach(el=>{el.classList.toggle('is-selected',el===n);el.classList.toggle('is-muted',el!==n)});
  scene.querySelectorAll('.de-edge').forEach(el=>{
   const focus=el.dataset.from===id||el.dataset.to===id;el.classList.toggle('is-focused',focus);el.classList.toggle('is-muted',!focus)
  });
  $('#de-inspect-title').textContent=n.dataset.title;$('#de-inspect-detail').textContent=n.dataset.detail;
  $('#de-inspect-meta').textContent='Boundaries: '+n.dataset.kind+'. Select another node to follow its relations.';
  $('#de-inspect-source').href='https://github.com/agno-agi/agno/blob/1f2aac51eb28dc9c0970836d3b7ae046bae81bbb/libs/agno/agno/'+n.dataset.source;
  const relationships=$('#de-relationships');relationships.replaceChildren();
  scene.querySelectorAll('.de-edge').forEach(edge=>{
   if(edge.dataset.from!==id&&edge.dataset.to!==id)return;
   const incoming=edge.dataset.to===id,otherId=incoming?edge.dataset.from:edge.dataset.to;
   const other=scene.querySelector('[data-node="'+otherId+'"]');
   const btn=document.createElement('button');btn.type='button';
   btn.textContent=(incoming?'← From ':'→ To ')+(other?.dataset.title||otherId);
   const hint=document.createElement('small');hint.textContent=edge.dataset.type.toUpperCase()+' · '+edge.querySelector('title')?.textContent.split(': ').pop();
   btn.append(hint);btn.addEventListener('click',()=>{if(other)inspect(other)});relationships.append(btn);
  });
  if(only){$('#de-only').title=n.dataset.title+' · source linked in inspector (exit diagram-only to read)'}
 }
 function zoom(f,cx=stage.clientWidth/2,cy=stage.clientHeight/2){
  const next=Math.max(225,Math.min(1800,view.w*f)),r=next/view.w;
  const bounds=stage.getBoundingClientRect(),localX=cx/bounds.width,localY=cy/bounds.height;
  view.x+=(view.w-next)*localX;view.y+=(view.h-view.h*r)*localY;
  view.w=next;view.h*=r;update()
 }
 tabs.forEach(t=>{t.addEventListener('click',()=>choose(t.dataset.diagram));t.addEventListener('keydown',e=>{if(e.key!=='ArrowRight'&&e.key!=='ArrowLeft')return;e.preventDefault();let i=tabs.indexOf(t);const next=tabs[(i+(e.key==='ArrowRight'?1:tabs.length-1))%tabs.length];next.click();next.focus()})});
 $('.de-node').forEach(n=>{n.addEventListener('click',()=>inspect(n));n.addEventListener('keydown',e=>{if(e.key==='Enter'||e.key===' '){e.preventDefault();inspect(n)}})});
 $$('[data-mobile-node]').forEach(b=>b.addEventListener('click',()=>{
  const scene=b.closest('[data-scene]'),n=scene?.querySelector('.de-node[data-node="'+b.dataset.mobileNode+'"]');
  if(n)inspect(n);
  scene?.querySelectorAll('[data-mobile-card]').forEach(card=>card.classList.toggle('is-selected',card.dataset.mobileCard===b.dataset.mobileNode));
 }));
 $('#de-mobile-canvas').addEventListener('click',()=>{
  const on=!root.classList.contains('is-mobile-canvas');root.classList.toggle('is-mobile-canvas',on);
  $('#de-mobile-canvas').setAttribute('aria-pressed',String(on));
  $('#de-mobile-canvas').textContent=on?'← Readable map':'View diagram canvas →';
  if(on)reset()
 });
 $('#de-zoom-in').addEventListener('click',()=>zoom(.8));$('#de-zoom-out').addEventListener('click',()=>zoom(1.25));$('#de-fit').addEventListener('click',()=>{view={x:0,y:0,w:1300,h:650};update()});
 $('#de-only').addEventListener('click',()=>{only=!only;root.classList.toggle('is-only',only);$('#de-only').setAttribute('aria-pressed',String(only));$('#de-only').textContent=only?'▣ Show details':'▣ Diagram only';reset()});
 function exitFull(){if(!fullscreen)return;fullscreen=false;root.classList.remove('is-fullscreen');$('#de-full').setAttribute('aria-pressed','false');$('#de-full').textContent='⛶ Fullscreen';document.body.style.overflow=prevOverflow;if(document.fullscreenElement===root&&document.exitFullscreen)document.exitFullscreen().catch(()=>{});reset()}
 $('#de-full').addEventListener('click',async()=>{if(fullscreen){exitFull();return}fullscreen=true;prevOverflow=document.body.style.overflow;document.body.style.overflow='hidden';root.classList.add('is-fullscreen');$('#de-full').setAttribute('aria-pressed','true');$('#de-full').textContent='✕ Exit fullscreen';reset();if(root.requestFullscreen){try{await root.requestFullscreen()}catch{}}reset()});
 document.addEventListener('fullscreenchange',()=>{if(fullscreen&&!document.fullscreenElement)exitFull()});
 document.addEventListener('keydown',e=>{if(!fullscreen||e.key!=='Escape')return;e.preventDefault();exitFull()});
 stage.addEventListener('wheel',e=>{e.preventDefault();const r=stage.getBoundingClientRect();zoom(e.deltaY<0?.89:1.12,e.clientX-r.left,e.clientY-r.top)},{passive:false});
 stage.addEventListener('pointerdown',e=>{if(e.target.closest('.de-mobile-flow,.de-mobile-switch,.de-canvas-controls,.de-legend,[role=button]'))return;if(e.pointerType==='mouse'&&e.button!==0)return;
  pointers.set(e.pointerId,{x:e.clientX,y:e.clientY});
  drag={pointer:e.pointerId,x:e.clientX,y:e.clientY,vx:view.x,vy:view.y};stage.setPointerCapture(e.pointerId)
 });
 stage.addEventListener('pointermove',e=>{if(!pointers.has(e.pointerId))return;pointers.set(e.pointerId,{x:e.clientX,y:e.clientY});
  if(pointers.size===2){const p=[...pointers.values()],dist=Math.hypot(p[0].x-p[1].x,p[0].y-p[1].y);if(pinch&&dist)zoom(pinch/dist);pinch=dist;return}
  if(!drag||drag.pointer!==e.pointerId)return;
  const r=stage.getBoundingClientRect();view.x=drag.vx-(e.clientX-drag.x)*view.w/r.width;view.y=drag.vy-(e.clientY-drag.y)*view.h/r.height;update();stage.classList.add('is-panning')
 });
 function end(e){pointers.delete(e.pointerId);if(pointers.size<2)pinch=null;if(drag?.pointer===e.pointerId)drag=null;stage.classList.remove('is-panning')}
 stage.addEventListener('pointerup',end);stage.addEventListener('pointercancel',end);
 stage.addEventListener('keydown',e=>{if(e.target!==stage)return;if(e.key==='+'||e.key==='='){e.preventDefault();zoom(.8)}else if(e.key==='-'){e.preventDefault();zoom(1.25)}else if(e.key==='0'){e.preventDefault();view={x:0,y:0,w:1300,h:650};update()}else if(['ArrowUp','ArrowDown','ArrowLeft','ArrowRight'].includes(e.key)){e.preventDefault();const s=35;view.x+=(e.key==='ArrowLeft'?-s:e.key==='ArrowRight'?s:0);view.y+=(e.key==='ArrowUp'?-s:e.key==='ArrowDown'?s:0);update()}});
 window.addEventListener('resize',reset);
 choose('system')
})();
</script>