const lookup={};for(const p of panels){for(const n of p.nodes)lookup[p.id+':'+n.id]=n}
function edgeCaption(scene,e){
 const a=lookup[scene.id+':'+e[0]],b=lookup[scene.id+':'+e[1]];
 const ax=a.x+a.w/2,ay=a.y+a.h/2,bx=b.x+b.w/2,by=b.y+b.h/2;
 const horizontal=Math.abs(bx-ax)>Math.abs(by-ay)*1.25;
 return {x:(ax+bx)/2,y:(ay+by)/2-(horizontal?8:10)}
}
function connection(scene,edge){
 const [aId,bId]=edge;const a=lookup[scene.id+':'+aId],b=lookup[scene.id+':'+bId];if(!a||!b)return '';
 const ax=a.x+a.w/2,ay=a.y+a.h/2,bx=b.x+b.w/2,by=b.y+b.h/2;
 const horizontal=Math.abs(bx-ax)>Math.abs(by-ay)*1.25;
 if(horizontal){let right=bx>ax,x1=right?a.x+a.w:a.x,x2=right?b.x:b.x+b.w,mid=(x1+x2)/2;
   return 'M'+x1+' '+ay+' L'+mid+' '+ay+' L'+mid+' '+by+' L'+x2+' '+by}
 const down=by>ay,y1=down?a.y+a.h:a.y,y2=down?b.y:b.y+b.h,mid=(y1+y2)/2;
 return 'M'+ax+' '+y1+' L'+ax+' '+mid+' L'+bx+' '+mid+' L'+bx+' '+y2
}
