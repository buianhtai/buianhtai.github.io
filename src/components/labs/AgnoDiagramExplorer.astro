@media(prefers-reduced-motion:reduce){.de *{scroll-behavior:auto!important}}

.de-mobile-flow,.de-mobile-switch{display:none}
@media(max-width:580px){
 .de-stage{touch-action:pan-y;cursor:default}
 .de-scene .de-svg{display:none}
 .de-mobile-switch{position:absolute;top:0;left:0;right:0;z-index:4;background:#16273a;display:flex;align-items:center;justify-content:space-between;gap:6px;padding:8px 9px;border-bottom:1px solid #38506a}
 .de-mobile-switch span{font:700 .62rem ui-monospace,monospace;color:#b8cbdc}
 .de-mobile-switch button{font:720 .67rem system-ui;color:#6addce;background:#243d51;padding:7px 9px;border:1px solid #456780;border-radius:7px;white-space:nowrap}
