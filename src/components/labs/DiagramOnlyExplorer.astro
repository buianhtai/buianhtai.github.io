---
interface Props { model:any; zones:any[]; snippets:any }
const {model,zones,snippets}=Astro.props;
---
<diagram-only-explorer class="de">
  <script type="application/json" data-payload set:html={JSON.stringify({model,zones,excerpts:snippets.excerpts}).replace(/</g,'\\u003c')} />
  <div class="de-shell">
    <header class="de-top">
      <div><span class="de-overline">SOURCE-GROUNDED ARCHITECTURE</span><h1>DeepSeek Harness</h1></div>
      <nav class="de-tabs" aria-label="Select diagram mode">
        <button type="button" data-mode="architecture" aria-pressed="true">◇ Architecture</button>
        <button type="button" data-mode="flow" aria-pressed="false">⇢ Agent turn flow</button>
      </nav>
      <a href={model.repository+'/tree/'+model.revision} target="_blank" rel="noopener noreferrer">Pinned source ↗</a>
    </header>
    <div class="de-tools">
      <nav class="de-crumbs" aria-label="Architecture levels"></nav>
      <div class="de-tour" hidden><button type="button" data-action="previous-step" aria-label="Previous stage">←</button><span data-step-status>Step 1 / 6</span><button type="button" data-action="next-step" aria-label="Next stage">→</button></div>
      <div class="de-buttons"><button type="button" data-action="back" disabled>← Back</button><button type="button" data-action="fit">Fit</button><button type="button" data-action="focus">Focus</button><button type="button" data-action="reset">100%</button><button type="button" data-action="connections" aria-pressed="false" title="Show source-backed dependency connections">Dependencies</button><button type="button" data-action="minimap" aria-pressed="true">Map</button><button type="button" data-action="fullscreen" aria-pressed="false">⛶ Expand</button></div>
    </div>
    <div class="de-board">
      <div class="de-viewport" role="region" tabindex="0" aria-label="Interactive diagram; select any node for details and expand its dependencies">
        <div class="de-stage"><div class="de-zones"></div><svg class="de-edges" aria-hidden="true"></svg><div class="de-nodes"></div></div>
      </div>
      <div class="de-hint">Select a node → inspect → expand its direct relationships</div><button type="button" data-action="mapjump" class="de-map-control" aria-label="Diagram minimap: click to navigate"><svg class="de-minimap" viewBox="0 0 150 86" preserveAspectRatio="none" aria-hidden="true"><g class="de-mini-zones"></g><g class="de-mini-nodes"></g><rect class="de-mini-window" x="0" y="0" width="10" height="10" rx="2"></rect></svg><span>OVERVIEW MAP</span></button>
      <aside class="de-detail" hidden aria-label="Selected diagram element">
        <div class="de-detail-head"><span class="de-overline" data-kind></span><button type="button" data-action="close" aria-label="Close node information">✕</button></div>
        <h2 data-title></h2><p data-summary></p><p class="de-stats" data-stats></p>
        <div class="de-detail-actions"><button type="button" class="de-primary" data-action="expand">Expand related ↗</button><button type="button" data-action="collapse" hidden>Collapse</button><button type="button" data-action="inside" hidden>Explore inside ↳</button></div>
        <h3>Related components</h3><div class="de-related"></div>
        <h3>Verified source evidence</h3><div class="de-sources"></div>
        <section class="de-source-preview" hidden aria-label="Source file excerpt"><h3>Source preview</h3><p class="de-source-path"></p><a class="de-preview-link" target="_blank" rel="noopener noreferrer">Open pinned implementation ↗</a><pre><code class="de-source-code"></code></pre></section>
      </aside>
    </div>
    <footer class="de-footer"><span data-status></span><span class="de-legend"><span>┄ Source imports / package dependencies</span><span>→ Source-linked reading order</span></span><span data-disclaimer></span></footer>
  </div>
</diagram-only-explorer>
<script>
type Src={path:string;line:number;url:string};
type N={id:string;label:string;view:string;kind:string;summary:string;child?:string|null;sources:Src[]};
type E={view:string;from:string;to:string;label:string;evidence:string;sources:Src[]};
type Step={node:string;title:string;description:string;source:Src};
type D={model:{revision:string;repository:string;nodes:N[];edges:E[];views:{id:string;label:string;parent:string|null}[];journey:Step[]};zones:{label:string;note:string;nodes:string[]}[];excerpts:Record<string,{code:string;startLine:number;path:string;url:string}>};
class DiagramOnlyExplorer extends HTMLElement {
 connectedCallback(){
  if(this.dataset.ready)return;this.dataset.ready='true';
  const data=JSON.parse(this.querySelector('[data-payload]')!.textContent!) as D,model=data.model;
  const q=<T extends Element=HTMLElement>(s:string):T=>this.querySelector<T>(s)!;
  const app=q<HTMLElement>('.de-shell'),viewport=q<HTMLElement>('.de-viewport'),stage=q<HTMLElement>('.de-stage'),detail=q<HTMLElement>('.de-detail');
  const lookup=new Map(model.nodes.map(n=>[n.id,n]));
  const el=(tag:string,cls:string,label:string)=>{const e=document.createElement(tag);e.className=cls;e.textContent=label;return e;};
  const btn=(label:string,run:()=>void,cls='')=>{const e=el('button',cls,label) as HTMLButtonElement;e.type='button';e.onclick=run;return e;};
  const evidence=(s:Src)=>{const a=el('a','de-source',s.path.split('/').slice(-2).join('/')+' : '+s.line+' ↗') as HTMLAnchorElement;a.href=s.url;a.target='_blank';a.rel='noopener noreferrer';return a;};
  let mode:'architecture'|'flow'='architecture',view='system',selected:string|null=null,expanded=false,zoom=1,step=0,w=1300,h=640;
  let positions=new Map<string,{x:number;y:number;width:number;height:number}>();
  let connections=false,showMap=true;
  const history:{view:string;selected:string|null;expanded:boolean}[]=[];
  const scoped=()=>model.edges.filter(e=>e.view===view);
  const show=()=>{detail.hidden=false;},hide=()=>{detail.hidden=true;};
  const setZoom=()=>{stage.style.zoom=String(zoom);updateMinimap();};
  const canvas=(width:number,height:number)=>{w=width;h=height;stage.style.width=width+'px';stage.style.height=height+'px';const svg=q<SVGSVGElement>('.de-edges');svg.setAttribute('viewBox','0 0 '+width+' '+height);svg.setAttribute('width',String(width));svg.setAttribute('height',String(height));};
  const reset=()=>{q('.de-nodes').replaceChildren();q('.de-zones').replaceChildren();q('.de-edges').replaceChildren();positions=new Map();};
  const updateMinimap=()=>{
    const svg=q<SVGSVGElement>('.de-minimap'),ns='http://www.w3.org/2000/svg';
    svg.setAttribute('viewBox','0 0 '+w+' '+h);
    const z=q('.de-mini-zones'),n=q('.de-mini-nodes');z.replaceChildren();n.replaceChildren();
    this.querySelectorAll<HTMLElement>('.de-group').forEach(group=>{
      const rect=document.createElementNS(ns,'rect');
      rect.setAttribute('x',String(parseFloat(group.style.left)||0));rect.setAttribute('y',String(parseFloat(group.style.top)||0));
      rect.setAttribute('width',String(parseFloat(group.style.width)||0));rect.setAttribute('height',String(parseFloat(group.style.height)||0));rect.setAttribute('rx','16');z.append(rect);
    });
    for(const [id,p] of positions){
      const r=document.createElementNS(ns,'rect');
      r.setAttribute('x',String(p.x));r.setAttribute('y',String(p.y));r.setAttribute('width',String(p.width));r.setAttribute('height',String(p.height));r.setAttribute('rx','10');
      if(id===selected||(mode==='flow'&&id==='stage-'+step))r.classList.add('is-selected');n.append(r);
    }
    const window=q<SVGRectElement>('.de-mini-window');
    window.setAttribute('x',String(viewport.scrollLeft/zoom));window.setAttribute('y',String(viewport.scrollTop/zoom));
    window.setAttribute('width',String(Math.min(w,viewport.clientWidth/zoom)));window.setAttribute('height',String(Math.min(h,viewport.clientHeight/zoom)));
  };
  const wire=(x1:number,y1:number,x2:number,y2:number,dashed=false,edge?:E)=>{
    const svg=q<SVGSVGElement>('.de-edges'),ns='http://www.w3.org/2000/svg',p=document.createElementNS(ns,'path');
    const xmid=(x1+x2)/2;
    p.setAttribute('d','M '+x1+' '+y1+' L '+xmid+' '+y1+' L '+xmid+' '+y2+' L '+(x2-10)+' '+y2);
    p.classList.add('de-edge');if(dashed)p.classList.add('de-incoming');
    if(edge){
      p.dataset.edgeFrom=edge.from;p.dataset.edgeTo=edge.to;p.setAttribute('tabindex','0');
      p.setAttribute('role','button');p.setAttribute('aria-label','Dependency: '+edge.from+' uses '+edge.to);
      p.onclick=()=>inspectEdge(edge);
      p.onkeydown=ev=>{if(ev.key==='Enter'||ev.key===' '){ev.preventDefault();inspectEdge(edge);}};
    }
    svg.append(p);
    const tip=document.createElementNS(ns,'path');tip.classList.add('de-tip');
    tip.setAttribute('d','M '+(x2-19)+' '+(y2-6)+' L '+(x2-10)+' '+y2+' L '+(x2-19)+' '+(y2+6));svg.append(tip);
  };
  const group=(label:string,note:string,x:number,y:number,width:number,height:number)=>{
    const box=el('div','de-group','');box.style.cssText='left:'+x+'px;top:'+y+'px;width:'+width+'px;height:'+height+'px';
    box.append(el('h3','',label),el('p','',note));q('.de-zones').append(box);
  };
  const add=(n:N,x:number,y:number,width:number,height:number,focus=false)=>{
    const b=btn('',()=>inspect(n.id),'de-node');b.dataset.node=n.id;
    b.style.cssText='left:'+x+'px;top:'+y+'px;width:'+width+'px;height:'+height+'px';
    b.append(el('span','de-kind',n.kind==='Source file'?'{ } SOURCE FILE':'◇ '+n.kind.toUpperCase()),el('strong','',n.label),el('span','de-description',n.summary));
    if(focus||selected===n.id)b.classList.add('is-selected');
    q('.de-nodes').append(b);positions.set(n.id,{x,y,width,height});
  };
  const architecture=()=>{
    reset();const ns=model.nodes.filter(n=>n.view===view);
    if(view==='system'){
      canvas(1300,640);
      data.zones.forEach((z,i)=>{
        const x=27+i*426;group(z.label,z.note,x,28,397,556);
        z.nodes.forEach((id,j)=>{const n=lookup.get(id);if(n)add(n,x+31,167+j*179,333,132);});
      });
    }else{
      canvas(1180,Math.max(570,Math.ceil(ns.length/3)*184+138));
      ns.forEach((n,i)=>add(n,28+(i%3)*388,93+Math.floor(i/3)*184,338,138));
    }
    if(connections)scoped().forEach(e=>{
      const a=positions.get(e.from),b=positions.get(e.to);
      if(a&&b)wire(a.x+a.width,a.y+a.height/2,b.x,b.y+b.height/2,false,e);
    });
    q('[data-status]').textContent=ns.length+' components · '+(connections?'source dependencies visible':'click to inspect');
    q('[data-disclaimer]').textContent='Editorial grouping, not runtime boundaries.';
  };
  const neighborhood=()=>{
    if(!selected)return architecture();
    const center=lookup.get(selected)!;
    const incoming=scoped().filter(e=>e.to===selected),outgoing=scoped().filter(e=>e.from===selected);
    reset();canvas(1310,Math.max(640,190+Math.max(incoming.length,outgoing.length)*163));
    group('USED BY','Incoming declarations',20,24,371,h-50);
    group('FOCUS','Current component',469,24,367,h-50);
    group('USES','Outgoing declarations',914,24,373,h-50);
    const cy=(h-112)/2;add(center,488,cy,333,112,true);
    incoming.forEach((e,i)=>{const n=lookup.get(e.from);if(n)add(n,37,148+i*163,331,112);});
    outgoing.forEach((e,i)=>{const n=lookup.get(e.to);if(n)add(n,930,148+i*163,333,112);});
    incoming.forEach(e=>{const a=positions.get(e.from),b=positions.get(selected!);if(a&&b)wire(a.x+a.width,a.y+a.height/2,b.x,b.y+b.height/2,true,e);});
    outgoing.forEach(e=>{const a=positions.get(selected!),b=positions.get(e.to);if(a&&b)wire(a.x+a.width,a.y+a.height/2,b.x,b.y+b.height/2,false,e);});
    q('[data-status]').textContent=incoming.length+' incoming · '+outgoing.length+' outgoing · select another node to recenter';
    q('[data-disclaimer]').textContent='Arrows mean declared dependency/import, NOT runtime calls.';
  };
  // Responsive editorial graph: single-column mobile, two-column tablet, 3x2 desktop.
  let flowSlots:{x:number;y:number;w:number;h:number}[]=[];
  const flow=()=>{
    reset();
    const available=viewport.clientWidth,mobile=available<680,tablet=available<1100;
    if(mobile){
      const width=Math.max(325,available-4),card=Math.min(302,width-34);
      flowSlots=model.journey.map((_,i)=>({x:(width-card)/2,y:105+i*173,w:card,h:112}));
      canvas(width,flowSlots[5].y+206);
      const labels=['01 · INPUT & ADMISSION','02 · MODEL & STREAM','03 · TOOLS & CONTINUATION'];
      [0,1,2].forEach(i=>group(labels[i],'Editorial phase · source-backed steps',8,25+i*375,width-16,365));
    }else if(tablet){
      const left=37,right=393,top=143,middle=336,bottom=529;
      flowSlots=[
        {x:left,y:top,w:295,h:114},{x:right,y:top,w:295,h:114},
        {x:right,y:middle,w:295,h:114},{x:left,y:middle,w:295,h:114},
        {x:left,y:bottom,w:295,h:114},{x:right,y:bottom,w:295,h:114}
      ];
      canvas(725,735);
      group('01 · INPUT & ADMISSION','Claim and prepare',17,20,690,256);
      group('02 · MODEL & STREAM','Assemble model output',17,280,690,230);
      group('03 · TOOLS & CONTINUATION','Results and control',17,513,690,195);
    }else{
      flowSlots=[
        {x:75,y:150,w:300,h:115},{x:430,y:150,w:300,h:115},{x:785,y:150,w:300,h:115},
        {x:785,y:458,w:300,h:115},{x:430,y:458,w:300,h:115},{x:75,y:458,w:300,h:115}
      ];
      canvas(1180,700);
      group('01 · INPUT & ADMISSION','Claim and assemble turn context',35,30,715,308);
      group('02 · MODEL & STREAM','Prepare and settle assistant output',755,30,389,588);
      group('03 · TOOLS & CONTINUATION','Execute and decide whether to loop',35,349,715,290);
    }
    const ns='http://www.w3.org/2000/svg',svg=q<SVGSVGElement>('.de-edges');
    const arrow=(d:string,tip:string,index:number)=>{
      const line=document.createElementNS(ns,'path');line.setAttribute('d',d);line.classList.add('de-edge','de-flow-edge');line.dataset.stepEdge=String(index);line.setAttribute('aria-label','Source-guided order: '+model.journey[index].title+' then '+model.journey[index+1].title);svg.append(line);
      const head=document.createElementNS(ns,'path');head.setAttribute('d',tip);head.classList.add('de-tip','de-flow-tip');head.dataset.stepEdge=String(index);svg.append(head);
    };
    model.journey.forEach((story,i)=>{
      const slot=flowSlots[i],b=btn('',()=>inspectFlow(i),'de-flow-node');b.dataset.step=String(i);
      b.style.cssText='left:'+slot.x+'px;top:'+slot.y+'px;width:'+slot.w+'px;height:'+slot.h+'px';
      b.append(el('span','de-flow-no',String(i+1).padStart(2,'0')),el('strong','',story.title),el('span','de-inspect','↗'));
      const sourceName=lookup.get(story.node)?.label||story.node;
      b.append(el('span','de-stage-owner','◈ '+sourceName));
      if(step===i)b.classList.add('is-selected');q('.de-nodes').append(b);
      positions.set('stage-'+i,{x:slot.x,y:slot.y,width:slot.w,height:slot.h});
      if(i>=model.journey.length-1)return;
      const next=flowSlots[i+1];
      if(Math.abs(slot.y-next.y)<4){
        const right=next.x>slot.x,from=right?slot.x+slot.w:slot.x,to=right?next.x-11:next.x+next.w+11;
        const y=slot.y+slot.h/2;
        arrow('M '+from+' '+y+' H '+to,right
          ?'M '+(to-8)+' '+(y-6)+' L '+to+' '+y+' L '+(to-8)+' '+(y+6)
          :'M '+(to+8)+' '+(y-6)+' L '+to+' '+y+' L '+(to+8)+' '+(y+6),i);
      }else{
        const x=slot.x+slot.w/2,from=slot.y+slot.h,to=next.y-11;
        arrow('M '+x+' '+from+' V '+to,'M '+(x-6)+' '+(to-8)+' L '+x+' '+to+' L '+(x+6)+' '+(to-8),i);
      }
    });
    const last=flowSlots[5],note=el('div','de-loop','↶ Pending input or tool work may continue the loop');
    note.style.cssText='left:'+last.x+'px;top:'+(last.y+last.h+26)+'px;width:'+Math.max(270,last.w)+'px';q('.de-nodes').append(note);
    q('[data-status]').textContent='All 6 sourced stages · click any step for its implementation';
    q('[data-disclaimer]').textContent='Curated code walkthrough, not a measured network trace.';
  };
  const render=()=>{
    const c=q('.de-crumbs');c.replaceChildren();
    if(mode==='flow')c.append(el('span','','Agent turn / ordered stages'));
    else{
      let v=model.views.find(x=>x.id===view);
      const stack:typeof model.views=[];
      while(v){stack.unshift(v);v=model.views.find(x=>x.id===v!.parent);}
      stack.forEach((item,i)=>{if(i)c.append(el('span','de-separator','/'));c.append(btn(item.label,()=>{view=item.id;selected=null;expanded=false;hide();render();},'de-crumb'));});
    }
    if(mode==='flow')flow();else if(expanded)neighborhood();else architecture();
    app.dataset.activeMode=mode;
    q<HTMLElement>('.de-tour').hidden=mode!=='flow';
    q<HTMLElement>('[data-step-status]').textContent='Stage '+(step+1)+' / '+model.journey.length;
    updateMinimap();
    q<HTMLElement>('.de-hint').hidden=(mode==='flow'||expanded);
    q<HTMLButtonElement>('[data-action="back"]').disabled=history.length===0;setZoom();
  };
  const sources=(refs:Src[])=>{const box=q('.de-sources');box.replaceChildren(...refs.slice(0,5).map(evidence));if(!refs.length)box.textContent='No direct evidence for this node in this view.';};
  const preview=(id:string)=>{
    const sample=data.excerpts?.[id],panel=q<HTMLElement>('.de-source-preview');panel.hidden=!sample;
    if(!sample)return;
    q('.de-source-path').textContent=sample.path+' · starting line '+sample.startLine;
    q<HTMLAnchorElement>('.de-preview-link').href=sample.url;
    const code=q('.de-source-code');code.replaceChildren();
    sample.code.replace(/\n$/,'').split('\n').forEach((line,i)=>{
      const row=el('span','de-code-row','');row.append(el('span','de-code-number',String(sample.startLine+i)),el('span','',line||' '));code.append(row);
    });
  };
  const inspectEdge=(edge:E)=>{
    show();q('[data-kind]').textContent='SOURCE-DECLARED RELATIONSHIP';
    q('[data-title]').textContent=(lookup.get(edge.from)?.label||edge.from)+' → '+(lookup.get(edge.to)?.label||edge.to);
    q('[data-summary]').textContent=edge.evidence||edge.label;
    q('[data-stats]').textContent='Dependent → dependency; not an observed runtime call';
    const rel=q('.de-related');rel.replaceChildren();
    rel.append(btn('Inspect '+(lookup.get(edge.from)?.label||edge.from),()=>inspect(edge.from),'de-related-button'));
    rel.append(btn('Inspect '+(lookup.get(edge.to)?.label||edge.to),()=>inspect(edge.to),'de-related-button'));
    sources(edge.sources);preview('');
    for(const a of ['expand','collapse','inside'])q<HTMLButtonElement>('[data-action="'+a+'"]').hidden=true;
  };
  const inspect=(id:string)=>{
    const n=lookup.get(id);if(!n)return;
    if(expanded&&selected!==id){selected=id;render();}else selected=id;
    this.querySelectorAll<HTMLElement>('[data-node]').forEach(x=>x.classList.toggle('is-selected',x.dataset.node===id));
    show();q('[data-kind]').textContent=n.kind.toUpperCase();
    q('[data-title]').textContent=n.label;q('[data-summary]').textContent=n.summary;
    const incoming=scoped().filter(e=>e.to===id),outgoing=scoped().filter(e=>e.from===id);
    q('[data-stats]').textContent=incoming.length+' incoming · '+outgoing.length+' outgoing';
    const rel=q('.de-related');rel.replaceChildren();
    [...incoming,...outgoing].forEach(e=>{
      const other=lookup.get(e.from===id?e.to:e.from);
      if(other)rel.append(btn((e.from===id?'→ Uses ':'← Used by ')+other.label,()=>inspect(other.id),'de-related-button'));
    });
    if(!incoming.length&&!outgoing.length)rel.textContent='No direct relationships shown in this view.';
    sources(n.sources);preview(id);
    q<HTMLButtonElement>('[data-action="expand"]').hidden=expanded||(!incoming.length&&!outgoing.length);
    q<HTMLButtonElement>('[data-action="collapse"]').hidden=!expanded;
    q<HTMLButtonElement>('[data-action="inside"]').hidden=!n.child;
  };
  const inspectFlow=(i:number)=>{
    step=i;const s=model.journey[i],owner=lookup.get(s.node);
    this.querySelectorAll<HTMLElement>('[data-step]').forEach(x=>x.classList.toggle('is-selected',Number(x.dataset.step)===i));
    this.querySelectorAll<SVGElement>('[data-step-edge]').forEach(x=>x.classList.toggle('is-active',Number(x.dataset.stepEdge)===i||Number(x.dataset.stepEdge)===i-1));
    q<HTMLElement>('[data-step-status]').textContent='Stage '+(i+1)+' / '+model.journey.length;
    show();q('[data-kind]').textContent='CURATED STEP '+(i+1)+' / '+model.journey.length;
    q('[data-title]').textContent=s.title;q('[data-summary]').textContent=s.description;
    q('[data-stats]').textContent='Implementation · '+(owner?.label||s.node);
    const rel=q('.de-related');rel.replaceChildren();
    if(i>0)rel.append(btn('← Previous: '+model.journey[i-1].title,()=>inspectFlow(i-1),'de-related-button'));
    if(i<model.journey.length-1)rel.append(btn('Next: '+model.journey[i+1].title+' →',()=>inspectFlow(i+1),'de-related-button'));
    sources([s.source]);preview(s.node);
    q<HTMLButtonElement>('[data-action="expand"]').hidden=true;
    q<HTMLButtonElement>('[data-action="collapse"]').hidden=true;
    q<HTMLButtonElement>('[data-action="inside"]').hidden=true;
  };
  const focus=()=>{
    const pos=selected?positions.get(selected):null;
    zoom=Math.max(.65,Math.min(1.1,(viewport.clientWidth-25)/420));setZoom();
    const px=mode==='flow'?flowSlots[step].x:pos?.x||0,py=mode==='flow'?flowSlots[step].y:pos?.y||0;
    viewport.scrollTo({left:Math.max(0,px*zoom-45),top:Math.max(0,py*zoom-40)});
  };
  this.querySelectorAll<HTMLButtonElement>('button[data-mode]').forEach(b=>b.addEventListener('click',()=>{
    mode=b.dataset.mode as 'architecture'|'flow';selected=null;expanded=false;zoom=1;hide();
    this.querySelectorAll<HTMLButtonElement>('button[data-mode]').forEach(x=>x.setAttribute('aria-pressed',String(x.dataset.mode===mode)));
    render();viewport.scrollTo(0,0);
  }));
  app.addEventListener('click',event=>{
    const action=(event.target as HTMLElement).closest<HTMLElement>('[data-action]')?.dataset.action;
    if(!action)return;
    if(action==='close'){hide();return;}
    if(action==='previous-step'){inspectFlow(Math.max(0,step-1));return;}
    if(action==='next-step'){inspectFlow(Math.min(model.journey.length-1,step+1));return;}
    if(action==='expand'&&selected){expanded=true;zoom=1;render();inspect(selected);viewport.scrollTo(0,0);return;}
    if(action==='collapse'){expanded=false;render();if(selected)inspect(selected);return;}
    if(action==='inside'&&selected){
      const next=lookup.get(selected)?.child;
      if(next){history.push({view,selected,expanded});view=next;selected=null;expanded=false;zoom=1;hide();render();viewport.scrollTo(0,0);}
      return;
    }
    if(action==='back'){
      const prior=history.pop();
      if(prior){view=prior.view;selected=prior.selected;expanded=prior.expanded;hide();render();}
      return;
    }
    if(action==='fit'){zoom=Math.max(.25,Math.min(1,(viewport.clientWidth-24)/w,(viewport.clientHeight-24)/h));setZoom();viewport.scrollTo(0,0);return;}
    if(action==='focus'){focus();return;}
    if(action==='reset'){zoom=1;setZoom();viewport.scrollTo(0,0);return;}
    if(action==='connections'){
      connections=!connections;q<HTMLButtonElement>('[data-action="connections"]').setAttribute('aria-pressed',String(connections));
      if(mode==='architecture'&&!expanded)render();return;
    }
    if(action==='minimap'){
      showMap=!showMap;q<HTMLButtonElement>('[data-action="minimap"]').setAttribute('aria-pressed',String(showMap));
      q<HTMLElement>('.de-map-control').hidden=!showMap;return;
    }
    if(action==='mapjump'){
      const rect=q<SVGSVGElement>('.de-minimap').getBoundingClientRect();
      const x=Math.max(0,Math.min(1,(event.clientX-rect.left)/rect.width)),y=Math.max(0,Math.min(1,(event.clientY-rect.top)/rect.height));
      viewport.scrollTo({left:Math.max(0,x*w*zoom-viewport.clientWidth/2),top:Math.max(0,y*h*zoom-viewport.clientHeight/2)});return;
    }
    if(action==='fullscreen'){
      const on=app.classList.toggle('de-fullscreen'),b=q<HTMLButtonElement>('[data-action="fullscreen"]');
      b.setAttribute('aria-pressed',String(on));b.textContent=on?'✕ Exit fullscreen':'⛶ Expand';return;
    }
  });
  document.addEventListener('keydown',event=>{if(event.key==='Escape'){if(app.classList.contains('de-fullscreen'))q<HTMLButtonElement>('[data-action="fullscreen"]').click();else hide();}});
  let drag:{x:number;y:number;left:number;top:number}|null=null;
  viewport.addEventListener('pointerdown',event=>{if(event.pointerType!=='mouse'||event.button!==0||(event.target as HTMLElement).closest('button'))return;drag={x:event.clientX,y:event.clientY,left:viewport.scrollLeft,top:viewport.scrollTop};viewport.setPointerCapture(event.pointerId);});
  viewport.addEventListener('pointermove',event=>{if(drag){viewport.scrollLeft=drag.left+drag.x-event.clientX;viewport.scrollTop=drag.top+drag.y-event.clientY;}});
  for(const e of ['pointerup','pointercancel','lostpointercapture'])viewport.addEventListener(e,()=>drag=null);
  viewport.addEventListener('scroll',()=>updateMinimap(),{passive:true});
  const resizeWatcher=new ResizeObserver(()=>updateMinimap());resizeWatcher.observe(viewport);
  render();
 }
}
if(!customElements.get('diagram-only-explorer'))customElements.define('diagram-only-explorer',DiagramOnlyExplorer);
</script>
