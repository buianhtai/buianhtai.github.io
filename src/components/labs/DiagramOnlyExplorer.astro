---
interface Props { model:any; zones:any[]; snippets:any }
const {model,zones,snippets}=Astro.props;
---
<diagram-only-explorer class="de">
  <script type="application/json" data-payload set:html={JSON.stringify({model,zones,excerpts:snippets.excerpts}).replace(/</g,'\\u003c')} />
  <div class="de-shell">
    <header class="de-top">
      <div><span class="de-overline">SOURCE-GROUNDED ARCHITECTURE</span><h1>DeepSeek Harness</h1></div>
      <nav class="de-tabs" aria-label="Select diagram mode">
        <button type="button" data-mode="full" aria-pressed="false">▦ Full model</button><button type="button" data-mode="architecture" aria-pressed="true">◇ Focus</button>
        <button type="button" data-mode="flow" aria-pressed="false">⇢ Agent turn flow</button>
      </nav>
      <a href={model.repository+'/tree/'+model.revision} target="_blank" rel="noopener noreferrer">Pinned source ↗</a>
    </header>
    <div class="de-tools">
      <nav class="de-crumbs" aria-label="Architecture levels"></nav>
      <div class="de-tour" hidden><button type="button" data-action="previous-step" aria-label="Previous stage">←</button><span data-step-status>Step 1 / 6</span><button type="button" data-action="next-step" aria-label="Next stage">→</button></div>
      <div class="de-buttons"><button type="button" data-action="back" disabled>← Back</button><button type="button" data-action="mobile-tools" aria-expanded="false" aria-controls="de-extra-actions">Options <span aria-hidden="true">⌄</span></button><button type="button" data-action="fit">Fit</button><button type="button" data-action="focus">Focus</button><button type="button" data-action="reset">100%</button><button type="button" data-action="connections" aria-pressed="false" title="Show source-backed dependency connections">Dependencies</button><button type="button" data-action="minimap" aria-pressed="true">Map</button><button type="button" data-action="fullscreen" aria-pressed="false">⛶ Expand</button></div>
    </div>
    <div class="de-board">
      <button type="button" class="de-backdrop" data-action="dismiss" aria-label="Close component details" hidden></button>
      <div class="de-viewport" role="region" tabindex="0" aria-label="Interactive diagram; select any node for details and expand its dependencies">
        <div class="de-stage"><div class="de-zones"></div><svg class="de-edges" aria-hidden="true"></svg><div class="de-nodes"></div></div>
      </div>
      <div class="de-hint">Select a node → inspect → expand its direct relationships</div><div class="de-full-help">One connected map · swipe sideways to explore all three areas · tap a package for details</div><button type="button" data-action="mapjump" class="de-map-control" aria-label="Diagram minimap: click to navigate"><svg class="de-minimap" viewBox="0 0 150 86" preserveAspectRatio="none" aria-hidden="true"><g class="de-mini-zones"></g><g class="de-mini-nodes"></g><rect class="de-mini-window" x="0" y="0" width="10" height="10" rx="2"></rect></svg><span>OVERVIEW MAP</span></button>
      <aside class="de-detail" hidden aria-label="Selected diagram element">
        <div class="de-detail-head"><span class="de-overline" data-kind></span><button type="button" data-action="close" aria-label="Close node information">✕</button></div>
        <h2 data-title></h2><p data-summary></p><p class="de-stats" data-stats></p>
        <div class="de-detail-actions"><button type="button" class="de-primary" data-action="expand">Expand related ↗</button><button type="button" data-action="collapse" hidden>Collapse</button><button type="button" data-action="inside" hidden>Explore inside ↳</button></div>
        <h3>How this component connects</h3><p class="de-connect-explain">Arrows represent declared package or file imports. They are not measured runtime calls.</p>
        <div class="de-connect-summary" aria-label="Dependency direction summary"></div>
        <div class="de-related"></div>
        <h3>Verified source evidence</h3><div class="de-sources"></div>
        <section class="de-source-preview" hidden aria-label="Source code reader">
          <div class="de-editor-top"><h3>Code reader</h3><span class="de-editor-tag">READ ONLY · PINNED REVISION</span></div>
          <div class="de-editor-title"><span class="de-source-path"></span><a class="de-preview-link" target="_blank" rel="noopener noreferrer">GitHub ↗</a></div>
          <div class="de-editor-toolbar">
            <label>Find <input class="de-editor-search" type="search" placeholder="symbol / text" aria-label="Find in cached source"/></label>
            <label>Line <input class="de-editor-line" type="number" min="1" aria-label="Go to source line"/></label>
            <button type="button" data-action="go-line">Go</button>
            <button type="button" data-action="copy-source">Copy</button>
            <button type="button" data-action="expand-editor" aria-pressed="false">Expand editor ↗</button>
          </div>
          <p class="de-editor-note"></p><p class="de-editor-status" role="status"></p>
          <pre class="de-editor-window" tabindex="0" aria-label="Read-only TypeScript code with line numbers"><code class="de-source-code"></code></pre>
          <div class="de-editor-related" aria-label="Code imports and linked components"></div>
        </section>
      </aside>
    </div>
    <footer class="de-footer"><span data-status></span><span class="de-legend"><span>┄ Source imports / package dependencies</span><span>→ Source-linked reading order</span></span><span data-disclaimer></span></footer>
  </div>
</diagram-only-explorer>
<script>
type Src={path:string;line:number;url:string};
type N={id:string;label:string;view:string;kind:string;summary:string;child?:string|null;sources:Src[]};
type E={view:string;from:string;to:string;label:string;evidence:string;sources:Src[]};
type Step={node:string;title:string;description:string;source:Src};
type D={model:{revision:string;repository:string;nodes:N[];edges:E[];views:{id:string;label:string;parent:string|null}[];journey:Step[]};zones:{label:string;note:string;nodes:string[]}[];excerpts:Record<string,{code:string;startLine:number;path:string;url:string}>};
class DiagramOnlyExplorer extends HTMLElement {
 connectedCallback(){
  if(this.dataset.ready)return;this.dataset.ready='true';
  const data=JSON.parse(this.querySelector('[data-payload]')!.textContent!) as D,model=data.model;
  const q=<T extends Element=HTMLElement>(s:string):T=>this.querySelector<T>(s)!;
  const app=q<HTMLElement>('.de-shell'),viewport=q<HTMLElement>('.de-viewport'),stage=q<HTMLElement>('.de-stage'),detail=q<HTMLElement>('.de-detail');
  const lookup=new Map(model.nodes.map(n=>[n.id,n]));
  const el=(tag:string,cls:string,label:string)=>{const e=document.createElement(tag);e.className=cls;e.textContent=label;return e;};
  const btn=(label:string,run:()=>void,cls='')=>{const e=el('button',cls,label) as HTMLButtonElement;e.type='button';e.onclick=run;return e;};
  const evidence=(s:Src)=>{const a=el('a','de-source',s.path.split('/').slice(-2).join('/')+' : '+s.line+' ↗') as HTMLAnchorElement;a.href=s.url;a.target='_blank';a.rel='noopener noreferrer';return a;};
  let mode:'full'|'architecture'|'flow'=viewport.clientWidth>700?'full':'architecture',view='system',selected:string|null=null,expanded=false,zoom=1,step=0,w=1300,h=640;
  let positions=new Map<string,{x:number;y:number;width:number;height:number}>();
  let activeSnippet:{id:string;path:string;code:string;startLine:number;url:string}|null=null;
  let editorQuery='';
  let connections=false,showMap=viewport.clientWidth>=700;
  q<HTMLElement>('.de-map-control').hidden=!showMap;
  q<HTMLButtonElement>('[data-action="minimap"]').setAttribute('aria-pressed',String(showMap));
  const history:{mode:'full'|'architecture'|'flow';view:string;selected:string|null;expanded:boolean}[]=[];
  const scoped=()=>model.edges.filter(e=>e.view===view);
  const sourceEdges=(id:string)=>model.edges.filter(e=>e.view===lookup.get(id)?.view);
  const fullArcs=[['boot','core'],['api','core'],['api','session'],['core','llm'],['core','session'],['core','capabilities']] as const;
  const show=()=>{detail.hidden=false;if(viewport.clientWidth<=700)q<HTMLElement>('.de-backdrop').hidden=false;};
  const hide=()=>{detail.hidden=true;q<HTMLElement>('.de-backdrop').hidden=true;};
  const setZoom=()=>{stage.style.zoom=String(zoom);updateMinimap();};
  const canvas=(width:number,height:number)=>{w=width;h=height;stage.style.width=width+'px';stage.style.height=height+'px';const svg=q<SVGSVGElement>('.de-edges');svg.setAttribute('viewBox','0 0 '+width+' '+height);svg.setAttribute('width',String(width));svg.setAttribute('height',String(height));};
  const reset=()=>{q('.de-nodes').replaceChildren();q('.de-zones').replaceChildren();q('.de-edges').replaceChildren();positions=new Map();};
  const updateMinimap=()=>{
    const svg=q<SVGSVGElement>('.de-minimap'),ns='http://www.w3.org/2000/svg';
    svg.setAttribute('viewBox','0 0 '+w+' '+h);
    const z=q('.de-mini-zones'),n=q('.de-mini-nodes');z.replaceChildren();n.replaceChildren();
    this.querySelectorAll<HTMLElement>('.de-group').forEach(group=>{
      const rect=document.createElementNS(ns,'rect');
      rect.setAttribute('x',String(parseFloat(group.style.left)||0));rect.setAttribute('y',String(parseFloat(group.style.top)||0));
      rect.setAttribute('width',String(parseFloat(group.style.width)||0));rect.setAttribute('height',String(parseFloat(group.style.height)||0));rect.setAttribute('rx','16');z.append(rect);
    });
    for(const [id,p] of positions){
      const r=document.createElementNS(ns,'rect');
      r.setAttribute('x',String(p.x));r.setAttribute('y',String(p.y));r.setAttribute('width',String(p.width));r.setAttribute('height',String(p.height));r.setAttribute('rx','10');
      if(id===selected||(mode==='flow'&&id==='stage-'+step))r.classList.add('is-selected');n.append(r);
    }
    const window=q<SVGRectElement>('.de-mini-window');
    window.setAttribute('x',String(viewport.scrollLeft/zoom));window.setAttribute('y',String(viewport.scrollTop/zoom));
    window.setAttribute('width',String(Math.min(w,viewport.clientWidth/zoom)));window.setAttribute('height',String(Math.min(h,viewport.clientHeight/zoom)));
  };
  const wire=(x1:number,y1:number,x2:number,y2:number,dashed=false,edge?:E)=>{
    const svg=q<SVGSVGElement>('.de-edges'),ns='http://www.w3.org/2000/svg',p=document.createElementNS(ns,'path');
    const xmid=(x1+x2)/2;
    p.setAttribute('d','M '+x1+' '+y1+' L '+xmid+' '+y1+' L '+xmid+' '+y2+' L '+(x2-10)+' '+y2);
    p.classList.add('de-edge');if(dashed)p.classList.add('de-incoming');
    if(edge){
      p.dataset.edgeFrom=edge.from;p.dataset.edgeTo=edge.to;p.setAttribute('tabindex','0');
      p.setAttribute('role','button');p.setAttribute('aria-label','Dependency: '+edge.from+' uses '+edge.to);
      p.onclick=()=>inspectEdge(edge);
      p.onkeydown=ev=>{if(ev.key==='Enter'||ev.key===' '){ev.preventDefault();inspectEdge(edge);}};
    }
    svg.append(p);
    const tip=document.createElementNS(ns,'path');tip.classList.add('de-tip');
    tip.setAttribute('d','M '+(x2-19)+' '+(y2-6)+' L '+(x2-10)+' '+y2+' L '+(x2-19)+' '+(y2+6));svg.append(tip);
  };
  const wireOverlay=(edge:E)=>{
    const a=positions.get(edge.from),b=positions.get(edge.to);if(!a||!b)return;
    const ac={x:a.x+a.width/2,y:a.y+a.height/2},bc={x:b.x+b.width/2,y:b.y+b.height/2};
    const dx=bc.x-ac.x,dy=bc.y-ac.y;
    const horizontal=Math.abs(dx)>=Math.max(a.width,b.width)*.63;
    const svg=q<SVGSVGElement>('.de-edges'),ns='http://www.w3.org/2000/svg';
    const p=document.createElementNS(ns,'path'),tip=document.createElementNS(ns,'path');
    let d='',t='';
    if(horizontal){
      const dir=dx>=0?1:-1;
      const sx=ac.x+dir*a.width/2,ex=bc.x-dir*b.width/2,ey=bc.y,mid=(sx+ex)/2;
      d='M '+sx+' '+ac.y+' L '+mid+' '+ac.y+' L '+mid+' '+ey+' L '+(ex-dir*10)+' '+ey;
      t='M '+(ex-dir*19)+' '+(ey-6)+' L '+(ex-dir*10)+' '+ey+' L '+(ex-dir*19)+' '+(ey+6);
    }else{
      const dir=dy>=0?1:-1;
      const sy=ac.y+dir*a.height/2,ey=bc.y-dir*b.height/2,mid=(sy+ey)/2;
      d='M '+ac.x+' '+sy+' L '+ac.x+' '+mid+' L '+bc.x+' '+mid+' L '+bc.x+' '+(ey-dir*10);
      t='M '+(bc.x-6)+' '+(ey-dir*19)+' L '+bc.x+' '+(ey-dir*10)+' L '+(bc.x+6)+' '+(ey-dir*19);
    }
    p.setAttribute('d',d);tip.setAttribute('d',t);p.classList.add('de-edge','de-overlay-edge');
    tip.classList.add('de-tip','de-overlay-tip');
    p.dataset.edgeFrom=edge.from;p.dataset.edgeTo=edge.to;
    p.setAttribute('role','button');p.setAttribute('tabindex','0');
    p.setAttribute('aria-label','Source dependency: '+edge.from+' uses '+edge.to);
    p.addEventListener('click',()=>inspectEdge(edge));
    p.addEventListener('keydown',ev=>{if(ev.key==='Enter'||ev.key===' '){ev.preventDefault();inspectEdge(edge);}});
    svg.append(p,tip);
  };
  const group=(label:string,note:string,x:number,y:number,width:number,height:number)=>{
    const box=el('div','de-group','');box.style.cssText='left:'+x+'px;top:'+y+'px;width:'+width+'px;height:'+height+'px';
    box.append(el('h3','',label),el('p','',note));q('.de-zones').append(box);
  };
  const add=(n:N,x:number,y:number,width:number,height:number,focus=false)=>{
    const b=btn('',()=>inspect(n.id),'de-node');b.dataset.node=n.id;
    b.style.cssText='left:'+x+'px;top:'+y+'px;width:'+width+'px;height:'+height+'px';
    b.append(el('span','de-kind',n.kind==='Source file'?'{ } SOURCE FILE':'◇ '+n.kind.toUpperCase()),el('strong','',n.label),el('span','de-description',n.summary));
    if(focus||selected===n.id)b.classList.add('is-selected');
    q('.de-nodes').append(b);positions.set(n.id,{x,y,width,height});return b;
  };
  const architecture=()=>{
    reset();
    const ns=model.nodes.filter(n=>n.view===view);
    const grouped=view==='system'?data.zones:
      view==='core'?[
        {label:'Contracts & prompts',note:'Agent interfaces, scope and prompts',nodes:['core-agent','core-scope','core-system-prompt']},
        {label:'Execution & tools',note:'Loop driver and execution machinery',nodes:['core-agent-loop','core-tools']},
        {label:'Session context',note:'Session contract and event history',nodes:['core-session']}
      ]:
      view==='loop'?[
        {label:'Lifecycle & input',note:'Entry points and queued work',nodes:['file-index.ts','file-inbox.ts']},
        {label:'Agent turn & tools',note:'Driver, streaming and scheduling',nodes:['file-agent.ts','file-assistant-stream.ts','file-tool-calls.ts']},
        {label:'Context & policy',note:'Runtime assembly and limits',nodes:['file-runtime-context.ts','file-constants.ts']}
      ]:null;
    if(viewport.clientWidth<=700){
      // Mobile is a single vertically-scannable drawing, not a clipped, shrunken desktop artboard.
      const width=Math.max(290,viewport.clientWidth-2),margin=12,zoneWidth=width-24;
      const sections=grouped||[{
        label:(model.views.find(v=>v.id===view)?.label||view)+' components',
        note:'Source-backed implementation units',nodes:ns.map(n=>n.id)
      }];
      let top=16;
      const cardH=102,gap=12,header=91,footer=18;
      const layouts=sections.map(z=>{
        const count=z.nodes.filter(id=>lookup.get(id)?.view===view).length;
        const height=header+count*(cardH+gap)+footer;
        const out={zone:z,top,height};top+=height+12;return out;
      });
      canvas(width,top+8);
      layouts.forEach(({zone,top,height})=>{
        group(zone.label,zone.note,margin,top,zoneWidth,height);
        zone.nodes.forEach((id,i)=>{
          const n=lookup.get(id);
          if(n&&n.view===view)add(n,margin+13,top+header+i*(cardH+gap),zoneWidth-26,cardH);
        });
      });
    }else if(grouped){
      const tallest=Math.max(...grouped.map(g=>g.nodes.length));
      const stageH=Math.max(640,180+tallest*159);
      canvas(1300,stageH);
      grouped.forEach((zone,i)=>{
        const x=27+i*426;
        group(zone.label,zone.note,x,28,397,stageH-77);
        zone.nodes.forEach((id,j)=>{
          const n=lookup.get(id);
          if(n&&n.view===view)add(n,x+31,150+j*159,333,124);
        });
      });
    }else{
      const rows=Math.ceil(ns.length/3),height=Math.max(580,180+rows*167);
      canvas(1210,height);
      const area=model.views.find(v=>v.id===view);
      group((area?.label||view).toUpperCase()+' · COMPONENT BOUNDARY',
        'Source-declared packages · click a component to inspect direct dependencies',23,28,1164,height-70);
      ns.forEach((n,i)=>add(n,41+(i%3)*386,153+Math.floor(i/3)*167,337,127));
    }
    if(connections)scoped().forEach(wireOverlay);
    q('[data-status]').textContent=ns.length+' components · '+(connections?'source dependency overlay ON':'click a component to inspect');
    q('[data-disclaimer]').textContent='Conceptual boundaries; not separate deployment or network processes.';
  };
  // Full model = one coherent, source-grounded map with nested system and package boundaries.
  // Never infer execution hops from package-import arrows.
  const fullModel=()=>{
    reset();
    const columns=[
      {label:'01 · ENTRY & ASSEMBLY',note:'Bootstrapping and remote access',ids:['boot','api']},
      {label:'02 · EXECUTION CORE',note:'Default agent runtime and its capability plugins',ids:['core','capabilities']},
      {label:'03 · SERVICES & STATE',note:'Model adapters and session persistence',ids:['llm','session']}
    ];
    canvas(1790,1090);
    columns.forEach((col,i)=>{
      const x=26+i*590;
      group(col.label,col.note,x,24,566,1038);
      col.ids.forEach((subId,j)=>{
        const top=108+j*463;
        const n=lookup.get(subId);
        if(!n)return;
        const sub=document.createElement('section');sub.className='de-model-subsystem';
        sub.style.cssText='left:'+(x+17)+'px;top:'+top+'px;width:530px;height:436px';
        sub.append(el('span','de-model-boundary','SUBSYSTEM / '+String(j+1).padStart(2,'0')));
        q('.de-zones').append(sub);
        const header=add(n,x+32,top+23,500,83,true);
        header.classList.add('de-model-header');
        const packages=model.nodes.filter(p=>p.view===subId);
        packages.forEach((pkg,k)=>{
          const row=Math.floor(k/2),colIndex=k%2;
          const bx=x+31+colIndex*252,by=top+123+row*102;
          const card=add(pkg,bx,by,244,91,false);
          card.classList.add('de-model-package');
        });
      });
    });
    const evidence=model.edges.filter(e=>e.view==='system');
    const key=(e:E)=>fullArcs.some(p=>p[0]===e.from&&p[1]===e.to);
    evidence.filter(e=>connections||key(e)).forEach(e=>{
      const a=positions.get(e.from),b=positions.get(e.to);
      if(a&&b)wireOverlay(e);
    });
    q('[data-status]').textContent='6 subsystems · '+model.nodes.filter(n=>n.view!=='system'&&n.view!=='loop').length+' packages · '+(connections?evidence.length:'6 highlighted')+' verified dependency arrows';
    q('[data-disclaimer]').textContent='Full model: source-backed architecture. Arrow = declared package dependency, not request order. Tap any component to inspect.';
  };
  const neighborhood=()=>{
    if(!selected)return architecture();
    const center=lookup.get(selected)!;
    const incoming=scoped().filter(e=>e.to===selected),outgoing=scoped().filter(e=>e.from===selected);
    if(viewport.clientWidth<=700){
      reset();
      const width=Math.max(290,viewport.clientWidth-2),margin=12,zoneW=width-24;
      const cardH=95,gap=9;
      const zones=[
        {label:'SELECTED COMPONENT',note:'Currently focused · tap a neighbor to explore',items:[{node:center,edge:null as E|null,type:'focus'}]},
        {label:'USED BY  ·  '+incoming.length,note:'These components declare a dependency on '+center.label,items:incoming.map(e=>({node:lookup.get(e.from)!,edge:e,type:'in'}))},
        {label:'USES  ·  '+outgoing.length,note:center.label+' declares a dependency on these components',items:outgoing.map(e=>({node:lookup.get(e.to)!,edge:e,type:'out'}))}
      ];
      let top=16;
      const drawn=zones.map(z=>{
        const height=85+Math.max(1,z.items.length)*(cardH+gap)+18;
        const rect={...z,y:top,height};top+=height+12;return rect;
      });
      canvas(width,top+8);
      drawn.forEach(zone=>{
        group(zone.label,zone.note,margin,zone.y,zoneW,zone.height);
        zone.items.forEach((item,i)=>{
          if(!item.node)return;
          const x=margin+13,y=zone.y+82+i*(cardH+gap);
          const card=add(item.node,x,y,zoneW-26,cardH,item.type==='focus');
          if(card&&item.edge){
            const caption=el('span','de-mobile-direction',item.type==='in'?'← USED BY · IMPORTS THIS':'→ USES · DECLARED DEPENDENCY');
            card.prepend(caption);
          }
        });
      });
      q('[data-status]').textContent=incoming.length+' used-by · '+outgoing.length+' uses · tap any node to recenter';
      q('[data-disclaimer]').textContent='Each relationship comes from a pinned manifest or source import; not a runtime call.';
      return;
    }
    reset();canvas(1310,Math.max(680,170+Math.max(incoming.length,outgoing.length)*117));
    group('USED BY','Incoming declarations',20,24,371,h-50);
    group('FOCUS','Current component',469,24,367,h-50);
    group('USES','Outgoing declarations',914,24,373,h-50);
    const cy=(h-105)/2;add(center,488,cy,333,105,true);
    incoming.forEach((e,i)=>{const n=lookup.get(e.from);if(n)add(n,37,143+i*117,331,105);});
    outgoing.forEach((e,i)=>{const n=lookup.get(e.to);if(n)add(n,930,143+i*117,333,105);});
    incoming.forEach(e=>{const a=positions.get(e.from),b=positions.get(selected!);if(a&&b)wire(a.x+a.width,a.y+a.height/2,b.x,b.y+b.height/2,true,e);});
    outgoing.forEach(e=>{const a=positions.get(selected!),b=positions.get(e.to);if(a&&b)wire(a.x+a.width,a.y+a.height/2,b.x,b.y+b.height/2,false,e);});
    q('[data-status]').textContent=incoming.length+' incoming · '+outgoing.length+' outgoing · select another node to recenter';
    q('[data-disclaimer]').textContent='Arrows mean declared dependency/import, NOT runtime calls.';
  };
  // Responsive editorial graph: single-column mobile, two-column tablet, 3x2 desktop.
  let flowSlots:{x:number;y:number;w:number;h:number}[]=[];
  const flow=()=>{
    reset();
    const available=viewport.clientWidth,mobile=available<=700,tablet=available<1100;
    if(mobile){
      const width=Math.max(325,available-4),card=Math.min(302,width-34);
      flowSlots=model.journey.map((_,i)=>({x:(width-card)/2,y:116+Math.floor(i/2)*405+(i%2)*160,w:card,h:112}));
      canvas(width,flowSlots[5].y+194);
      const labels=['01 · INPUT & ADMISSION','02 · MODEL & STREAM','03 · TOOLS & CONTINUATION'];
