---
interface Props { model: any }
const { model } = Astro.props;
---
<architecture-explorer>
  <script type="application/json" data-model set:html={JSON.stringify(model).replace(/</g, '\\u003c')} />
  <section class="ae-shell" aria-label={`${model.title} architecture explorer`}>
    <header class="ae-header">
      <div><span class="ae-eyebrow">CODE → ARCHITECTURE</span><h1>{model.title}</h1><p>Explore the system. Open a component. Follow the code.</p></div>
      <div class="ae-header-actions"><a href={`${model.repository}/tree/${model.revision}`} target="_blank" rel="noopener">Source · {model.revision.slice(0,7)} ↗</a><button data-action="expand">Expand view ↗</button></div>
    </header>
    <div class="ae-modebar">
      <div class="ae-mode-label"><strong>Explore the implementation</strong><span>Choose how to read this architecture</span></div>
      <nav class="ae-modes" aria-label="Architecture exploration mode">
        <button type="button" data-mode="overview" aria-pressed="true">Overview</button>
        <button type="button" data-mode="dependencies" aria-pressed="false">Dependencies</button>
        <button type="button" data-mode="execution" aria-pressed="false">Execution</button>
        <button type="button" data-mode="source" aria-pressed="false">Source</button>
      </nav>
    </div>
    <div class="ae-toolbar">
      <nav class="ae-crumbs" aria-label="Architecture breadcrumb"></nav>
      <div class="ae-controls"><button data-action="back" disabled>← Back</button><button data-action="out" aria-label="Zoom out">−</button><output aria-label="Zoom level">100%</output><button data-action="in" aria-label="Zoom in">+</button><button data-action="fit">Fit</button><button data-action="reset">100%</button><button data-action="navigation" aria-pressed="true">Hide navigation</button><button data-action="inspector" aria-pressed="true">Hide inspector</button><button data-action="only" aria-pressed="false">Diagram only</button></div>
    </div>
    <div class="ae-workbench">
      <aside class="ae-nav" aria-label="Component navigation"><label>Find a component<input type="search" placeholder="Try agent, stream, tools…" /></label><div class="ae-results" aria-live="polite"></div><h2>Subsystems</h2><div class="ae-tree"></div><button class="ae-tour-start" data-action="tour">▶ Follow one agent turn</button><p class="ae-small">Select to inspect.<br/>Open a component to drill down.<br/>Drag empty canvas to pan.</p></aside>
      <section class="ae-map" aria-label="Architecture canvas">
        <div class="ae-map-heading"><div><h2 data-view-title></h2><p data-view-description></p></div><div class="ae-edge-legend" aria-label="Dependency direction"><span><i class="ae-legend-line"></i> Uses</span><span><i class="ae-legend-line is-inbound"></i> Used by</span></div></div><div class="ae-zone-jumps" role="group" aria-label="Jump to architecture area" hidden></div><p class="ae-mode-explainer" data-mode-explainer>Conceptual subsystem boundaries. Select a component to inspect its declared dependencies.</p>
        <div class="ae-canvas-wrap">
          <div class="ae-viewport" tabindex="0" role="region" aria-label="Architecture map; scroll or drag background to pan"><div class="ae-stage"><div class="ae-zones" aria-hidden="true"></div><svg class="ae-edges" aria-hidden="true"></svg><div class="ae-nodes"></div></div></div>
          <button type="button" class="ae-minimap-button" data-action="minimap" aria-label="Architecture minimap; click to move the viewport" title="Click to navigate the diagram"><svg class="ae-minimap" viewBox="0 0 320 180" preserveAspectRatio="none" aria-hidden="true"><g class="ae-mini-zones"></g><g class="ae-mini-nodes"></g><rect class="ae-mini-window" x="0" y="0" width="20" height="20" rx="7"></rect></svg><span>Overview map</span></button>
        </div>
        <div class="ae-journey" hidden><div class="ae-journey-overview"><span data-step-count></span><button data-action="stop">Exit walkthrough ×</button></div><div class="ae-journey-rail" role="group" aria-label="Six-step agent turn"></div><div class="ae-journey-detail"><div><h3 data-step-title></h3><p data-step-description></p><a data-step-source target="_blank" rel="noopener">View this implementation ↗</a></div><div class="ae-tour-controls"><button data-action="previous">← Previous</button><button data-action="next">Next →</button></div></div></div>
        <div class="ae-map-footer"><span data-map-count></span><span>Zones organize concepts, not execution order. Arrows show declared dependencies/imports. Select a node to isolate them.</span></div>
      </section>
      <aside class="ae-inspector" aria-label="Selected component"><span class="ae-eyebrow">INSPECT · SOURCE GROUNDED</span><h2 data-detail-title></h2><p data-detail-summary></p><p class="ae-detail-stats" data-detail-stats></p><button data-action="drill" hidden>Explore inside →</button><h3>Source evidence</h3><div class="ae-sources"></div><h3>Connections</h3><div class="ae-connections"></div>
        <section class="ae-source-preview" hidden aria-label="Pinned implementation excerpt"><div class="ae-preview-title"><span>CODE READER</span><a class="ae-preview-link" target="_blank" rel="noopener">Open pinned file ↗</a></div><h3 class="ae-preview-note"></h3><p class="ae-preview-path"></p><pre class="ae-preview-code"><code></code></pre><p class="ae-preview-disclaimer">Read-only source excerpt from the pinned upstream commit, not a live execution trace.</p></section>
      </aside>
    </div>
    <footer class="ae-scope">{model.scope} <a href={`${model.repository}/blob/${model.revision}/docs/architecture.md`} target="_blank" rel="noopener">Upstream architecture notes ↗</a></footer>
  </section>
  <dialog aria-label={`${model.title} expanded architecture view`}></dialog>
  <noscript><p>The interactive map needs JavaScript. <a href={`${model.repository}/blob/${model.revision}/docs/architecture.md`}>Read the upstream architecture guide.</a></p></noscript>
</architecture-explorer>
<script>
  type Source = { path: string; line: number; url: string };
  type Node = { id: string; view: string; label: string; summary: string; kind: string; child?: string; sources: Source[] };
  type Edge = { view: string; from: string; to: string; label: string; evidence: string; sources: Source[] };
  type View = { id: string; label: string; parent?: string; description: string };
  type Zone = { label: string; note: string; nodes: string[] };
  type Model = { nodes: Node[]; edges: Edge[]; views: View[]; journey: { node: string; title: string; description: string; source: Source }[]; visualZones?: Record<string, Zone[]> };
  class ArchitectureExplorer extends HTMLElement {
    connectedCallback() {
      if (this.dataset.ready) return;
      const model: Model = JSON.parse(this.querySelector('[data-model]')!.textContent!);
      const q = <T extends HTMLElement = HTMLElement>(s: string) => this.querySelector<T>(s)!;
      const shell = q('.ae-shell'), dialog = q<HTMLDialogElement>('dialog');
      const viewport = q('.ae-viewport'), stage = q('.ae-stage');
      const button = (label: string, fn: () => void, className = '') => { const el = document.createElement('button'); el.textContent = label; el.className = className; el.type = 'button'; el.onclick = fn; return el; };
      const link = (src: Source) => { const a = document.createElement('a'); a.textContent = `${src.path} : ${src.line} ↗`; a.href = src.url; a.target = '_blank'; a.rel = 'noopener'; return a; };
      const getNode = (id: string) => model.nodes.find(n => n.id === id)!;
      let view = 'system', selected = 'core', zoom = 1, step = -1;
      const history: {view: string; selected: string; zoom: number; x: number; y: number}[] = [];
      let positions = new Map<string, {x:number;y:number}>();
      let restoring = false;
      const setHash = () => { if (!restoring) window.history.replaceState(null, '', `#view=${encodeURIComponent(view)}&node=${encodeURIComponent(selected)}`); };
      const updateZoom = () => {
        stage.style.zoom=String(zoom);
        q<HTMLOutputElement>('output').value=`${Math.round(zoom*100)}%`;
        // At small widths, a fitted, diagram-only canvas should not leave a huge blank viewport.
        if(shell.classList.contains('ae-only')&&window.innerWidth<=640){
          const drawingHeight=parseFloat(stage.style.height)||530;
          viewport.style.height=`${Math.max(270,Math.min(window.innerHeight*.7,drawingHeight*zoom+28))}px`;
        }else viewport.style.removeProperty('height');
      };
      const sources = (refs: Source[]) => { q('.ae-sources').replaceChildren(...refs.map(link)); };
      const inspect = (id: string) => {
        selected = id; const node = getNode(id);
        q('[data-detail-title]').textContent = node.label; q('[data-detail-summary]').textContent = node.summary;
        q<HTMLButtonElement>('[data-action="drill"]').hidden = !node.child;
        sources(node.sources);
        const edges = model.edges.filter(e => e.view === view && (e.from === id || e.to === id));
        const inbound = edges.filter(e => e.to === id).length;
        const outbound = edges.filter(e => e.from === id).length;
        q('[data-detail-stats]').textContent = `${outbound} outgoing · ${inbound} incoming · ${node.sources.length} source references`;
        const connected = new Set([id,...edges.flatMap(e=>[e.from,e.to])]);
        this.querySelectorAll<HTMLElement>('[data-node]').forEach(el => {el.classList.toggle('is-selected',el.dataset.node===id);el.classList.toggle('is-muted',!connected.has(el.dataset.node!));el.setAttribute('aria-pressed', String(el.dataset.node===id));});
        this.querySelectorAll<SVGElement>('[data-edge]').forEach(el=>{
          const e=model.edges[Number(el.dataset.edge)];
          const outgoing=e.from===id,incoming=e.to===id;
          el.classList.toggle('is-outgoing',outgoing);
          el.classList.toggle('is-incoming',incoming);
          el.setAttribute('marker-end',outgoing||incoming?`url(#arrow-${this.dataset.instance}-${incoming?'in':'out'})`:'none');
        });
        this.querySelectorAll<HTMLElement>('.ae-zone').forEach(el=>el.classList.toggle('is-zone-active',el.dataset.zoneNodes?.split(',').includes(id)??false));
        this.querySelectorAll<HTMLElement>('.ae-zone-jump').forEach(el=>el.classList.toggle('is-current',el.dataset.zoneNodes?.split(',').includes(id)??false));
        const list = q('.ae-connections'); list.replaceChildren();
        if(!edges.length) list.textContent = 'No dependencies shown in this focused view. This does not imply the component has none.';
        for(const e of edges){ const other=getNode(e.from===id?e.to:e.from); const row=document.createElement('div');row.className='ae-connection';row.append(button(`${e.from===id?'→ Uses':'← Used by'} ${other.label}`,()=>inspect(other.id)));const p=document.createElement('p');p.textContent=e.evidence;row.append(p,...e.sources.slice(0,2).map(link));list.append(row); }
        setHash();
      };
      const navigate = (next: string, node?: string, remember=true) => {
        if(remember) history.push({view,selected,zoom,x:viewport.scrollLeft,y:viewport.scrollTop});
        view=next; selected=node || model.nodes.find(n=>n.view===view)!.id; zoom=1; step=-1; q('.ae-journey').hidden=true;
        render(); viewport.scrollTo(0,0); q('[data-view-title]').scrollIntoView({block:'start'});
      };
      const render = () => {
        const current=model.views.find(v=>v.id===view)!;
        q('[data-view-title]').textContent=current.label;q('[data-view-description]').textContent=current.description;
        const crumbs:View[]=[];let cursor:View|undefined=current;while(cursor){crumbs.unshift(cursor);cursor=model.views.find(v=>v.id===cursor!.parent);}
        q('.ae-crumbs').replaceChildren(...crumbs.map(v=>button(v.label,()=>navigate(v.id))));
        q<HTMLButtonElement>('[data-action="back"]').disabled=history.length===0;
        const nodes=model.nodes.filter(n=>n.view===view);
        const edges=model.edges.filter(e=>e.view===view);
        const configured=model.visualZones?.[view] || [];
        const groups=configured.map(z=>({...z,nodes:z.nodes.filter(id=>nodes.some(n=>n.id===id))})).filter(z=>z.nodes.length);
        const assigned=new Set(groups.flatMap(z=>z.nodes));
        const remaining=nodes.filter(n=>!assigned.has(n.id)).map(n=>n.id);
        if(groups.length&&remaining.length)groups.push({label:'Additional modules',note:'Not assigned to an editorial zone',nodes:remaining});
        const zoned=groups.length>0;
        const width=zoned?groups.length*410+20:900;
        const height=zoned?Math.max(460,130+Math.max(...groups.map(z=>z.nodes.length))*160):Math.max(430,Math.ceil(nodes.length/3)*190+70);
        const cardW=zoned?330:230,cardH=zoned?132:130;
        stage.style.width=width+'px';stage.style.height=height+'px';
        stage.classList.toggle('has-zones',zoned);positions=new Map();
        const zoneLayer=q('.ae-zones');zoneLayer.replaceChildren();
        const zoneJumps=q('.ae-zone-jumps');zoneJumps.replaceChildren();zoneJumps.hidden=!zoned;
        if(zoned){
          groups.forEach((zone,index)=>{
            const x=24+index*410;
            const panel=document.createElement('section');panel.className='ae-zone';
            panel.dataset.zoneNodes=zone.nodes.join(',');panel.style.left=x+'px';panel.style.width='386px';panel.style.height=(height-28)+'px';
            const heading=document.createElement('div');heading.className='ae-zone-heading';
            const number=document.createElement('span');number.className='ae-zone-mark';number.textContent='◈';
            const copy=document.createElement('div');const title=document.createElement('h3');title.textContent=zone.label;
            const note=document.createElement('p');note.textContent=zone.note;copy.append(title,note);heading.append(number,copy);panel.append(heading);zoneLayer.append(panel);
            zone.nodes.forEach((id,row)=>positions.set(id,{x:x+27,y:130+row*160}));
            const jump=button(zone.label,()=>{
              const focusId=zone.nodes[0];inspect(focusId);
              const pos=positions.get(focusId)!;
              viewport.scrollTo({left:Math.max(0,pos.x-30),top:0,behavior:'smooth'});
            },'ae-zone-jump');
            jump.dataset.zoneNodes=zone.nodes.join(',');
            jump.setAttribute('aria-label',`Show ${zone.label} on the architecture map`);
            zoneJumps.append(jump);
          });
        }else nodes.forEach((n,i)=>positions.set(n.id,{x:40+(i%3)*290,y:45+Math.floor(i/3)*190}));
        const layer=q('.ae-nodes');layer.replaceChildren();
        nodes.forEach((n)=>{
          const place=positions.get(n.id)!;
          const card=button('',()=>inspect(n.id),'ae-node');card.dataset.node=n.id;
          card.style.left=place.x+'px';card.style.top=place.y+'px';
          const top=document.createElement('span');top.className='ae-node-top';
          const glyph=document.createElement('span');glyph.className='ae-node-glyph';
          glyph.textContent=n.kind==='Source file'?'{ }':n.kind==='Subsystem'?'◇':'▦';
          const type=document.createElement('span');type.className='ae-node-kind';type.textContent=n.kind;
          top.append(glyph,type);
          const title=document.createElement('strong');title.textContent=n.label;
          const summary=document.createElement('span');summary.className='ae-node-summary';summary.textContent=n.summary;
          card.append(top,title,summary);
          if(n.child){const hint=document.createElement('span');hint.className='ae-node-hint';hint.textContent='Explore inside ↗';card.append(hint);card.ondblclick=()=>navigate(n.child!);}
          layer.append(card);
        });
        const svg=this.querySelector<SVGSVGElement>('.ae-edges')!;
        svg.setAttribute('viewBox',`0 0 ${width} ${height}`);
        svg.setAttribute('width',String(width));svg.setAttribute('height',String(height));
        svg.replaceChildren();const ns='http://www.w3.org/2000/svg';
        const markerId=`arrow-${this.dataset.instance}`;
        const defs=document.createElementNS(ns,'defs');
        for(const [suffix,paint] of [['out','var(--color-accent)'],['in','var(--ae-incoming)']] as const){
          const marker=document.createElementNS(ns,'marker');marker.id=`${markerId}-${suffix}`;
          for(const [k,v]of Object.entries({viewBox:'0 0 10 10',refX:'9',refY:'5',markerWidth:'7',markerHeight:'7',orient:'auto-start-reverse'}))marker.setAttribute(k,v);
          const tip=document.createElementNS(ns,'path');tip.setAttribute('d','M 0 0 L 10 5 L 0 10 z');tip.setAttribute('fill',paint);marker.append(tip);defs.append(marker);
        }
        svg.append(defs);
        edges.forEach(e=>{
          const a=positions.get(e.from)!,b=positions.get(e.to)!;
          const dx=b.x-a.x,dy=b.y-a.y;
          const horizontal=Math.abs(dx)>Math.abs(dy)*.6;
          const sign=horizontal?(dx>=0?1:-1):(dy>=0?1:-1);
          const reciprocal=edges.some(other=>other.from===e.to&&other.to===e.from);
          const spread=reciprocal?(e.from<e.to?-9:9):0;
          let x1:number,y1:number,x2:number,y2:number;
          if(horizontal){x1=a.x+cardW/2+sign*cardW/2;y1=a.y+cardH/2+spread;x2=b.x+cardW/2-sign*cardW/2;y2=b.y+cardH/2+spread;}
          else{x1=a.x+cardW/2+spread;y1=a.y+cardH/2+sign*cardH/2;x2=b.x+cardW/2+spread;y2=b.y+cardH/2-sign*cardH/2;}
          const d=horizontal?`M${x1},${y1} C${(x1+x2)/2},${y1} ${(x1+x2)/2},${y2} ${x2},${y2}`:`M${x1},${y1} C${x1},${(y1+y2)/2} ${x2},${(y1+y2)/2} ${x2},${y2}`;
          const path=document.createElementNS(ns,'path');path.setAttribute('d',d);
          path.dataset.edge=String(model.edges.indexOf(e));
          path.setAttribute('marker-end',`url(#${markerId}-out)`);svg.append(path);
        });
        q('[data-map-count]').textContent=`${nodes.length} components · ${edges.length} declared relationships`;
        updateZoom();inspect(selected);
        if(zoned && viewport.clientWidth<650)viewport.scrollLeft=Math.max(0,(positions.get(selected)?.x||0)-32);
      };
      const showStep = () => {
        const item=model.journey[step];q('.ae-journey').hidden=false;
        q('[data-step-count]').textContent=`CURATED SOURCE WALKTHROUGH · ${step+1} / ${model.journey.length}`;
        q('[data-step-title]').textContent=item.title;
        q('[data-step-description]').textContent=item.description;
        q<HTMLAnchorElement>('[data-step-source]').href=item.source.url;
        q<HTMLButtonElement>('[data-action="previous"]').disabled=step===0;
        q<HTMLButtonElement>('[data-action="next"]').disabled=step===model.journey.length-1;
        q('.ae-journey-rail').replaceChildren(...model.journey.map((j,i)=>{
          const chip=button(`${String(i+1).padStart(2,'0')}  ${j.title}`,()=>{step=i;showStep();},'ae-step');
          chip.classList.toggle('is-current',i===step);
          chip.classList.toggle('is-done',i<step);
          chip.setAttribute('aria-current',i===step?'step':'false');
          return chip;
        }));
        inspect(item.node);
        const p=positions.get(item.node)!;
        viewport.scrollTo({left:Math.max(0,p.x*zoom-40),top:Math.max(0,p.y*zoom-40),behavior:'smooth'});
      };
      q('.ae-tree').replaceChildren(...model.views.filter(v=>v.id!=='loop').map(v=>button(v.label,()=>navigate(v.id))));
      q<HTMLInputElement>('input').addEventListener('input',event=>{const term=(event.target as HTMLInputElement).value.trim().toLowerCase();const results=q('.ae-results');results.replaceChildren();if(!term)return;const matches=model.nodes.filter(n=>(n.label+' '+n.summary).toLowerCase().includes(term)).slice(0,12);if(!matches.length)results.textContent='No matching components.';for(const n of matches)results.append(button(`${n.label} · ${model.views.find(v=>v.id===n.view)!.label}`,()=>{navigate(n.view,n.id);results.replaceChildren();q<HTMLInputElement>('input').value='';}));});
      shell.addEventListener('click',event=>{const action=(event.target as HTMLElement).closest<HTMLElement>('[data-action]')?.dataset.action;if(!action)return;
        if(action==='in'||action==='out'){zoom=Math.min(2,Math.max(.35,zoom+(action==='in'?.15:-.15)));updateZoom();}
        if(action==='fit'){zoom=Math.min(1,(viewport.clientWidth-20)/900);updateZoom();viewport.scrollTo(0,0);}
        if(action==='reset'){zoom=1;updateZoom();viewport.scrollTo(0,0);}
        if(action==='drill'){const child=getNode(selected).child;if(child)navigate(child);}
        if(action==='back'){const prior=history.pop();if(prior){navigate(prior.view,prior.selected,false);zoom=prior.zoom;updateZoom();viewport.scrollTo(prior.x,prior.y);}}
        if(action==='only'){const on=shell.classList.toggle('ae-only');q('[data-action="only"]').setAttribute('aria-pressed',String(on));updateZoom();}
        if(action==='expand'){if(dialog.open)dialog.close();else{dialog.append(shell);q('[data-action="expand"]').textContent='Close view ×';dialog.showModal();q('[data-action="expand"]').focus();}}
        if(action==='tour'){navigate('loop','file-inbox.ts');step=0;showStep();}
        if(action==='next'&&step<model.journey.length-1){step++;showStep();}
        if(action==='previous'&&step>0){step--;showStep();}
        if(action==='stop'){step=-1;q('.ae-journey').hidden=true;}
      });
      dialog.addEventListener('close',()=>{this.insertBefore(shell,dialog);q('[data-action="expand"]').textContent='Expand view ↗';q('[data-action="expand"]').focus();});
      let drag: {x:number;y:number;left:number;top:number}|null=null;
      viewport.addEventListener('pointerdown',event=>{if(event.pointerType!=='mouse'||event.button!==0||(event.target as HTMLElement).closest('button'))return;drag={x:event.clientX,y:event.clientY,left:viewport.scrollLeft,top:viewport.scrollTop};viewport.setPointerCapture(event.pointerId);});
      viewport.addEventListener('pointermove',event=>{if(drag){viewport.scrollLeft=drag.left+drag.x-event.clientX;viewport.scrollTop=drag.top+drag.y-event.clientY;}});
      for(const event of ['pointerup','pointercancel','lostpointercapture'])viewport.addEventListener(event,()=>drag=null);
      this.dataset.instance=crypto.randomUUID();
      const hash=new URLSearchParams(location.hash.slice(1));const initialView=hash.get('view'),initialNode=hash.get('node');
      if(model.views.some(v=>v.id===initialView)){view=initialView!;selected=model.nodes.find(n=>n.view===view&&n.id===initialNode)?.id||model.nodes.find(n=>n.view===view)!.id;}
      restoring=true;render();restoring=false;this.dataset.ready='true';
    }
  }
  if(!customElements.get('architecture-explorer'))customElements.define('architecture-explorer',ArchitectureExplorer);
</script>
<style is:global>
  architecture-explorer {display:block;color:var(--color-text);--ae-line:var(--color-border);}
  architecture-explorer * {box-sizing:border-box;}
  .ae-shell {background:var(--color-bg);border:1px solid var(--ae-line);border-radius:18px;overflow:hidden;}
  .ae-header {display:flex;justify-content:space-between;gap:1rem;padding:1.5rem 1.5rem 1rem;background:var(--color-surface);}
  .ae-eyebrow {font:600 .68rem var(--font-mono,monospace);letter-spacing:.12em;color:var(--color-accent);}
  .ae-header h1 {font-size:1.75rem;margin:.3rem 0;letter-spacing:-.04em;}.ae-header p{margin:0;color:var(--color-text-muted);font-size:.85rem;}
  .ae-header-actions{display:flex;align-items:center;gap:1rem;flex-wrap:wrap;}
  architecture-explorer button, architecture-explorer input {font:inherit;color:var(--color-text);}
  architecture-explorer button {min-height:42px;padding:.55rem .7rem;border:1px solid var(--ae-line);border-radius:7px;background:var(--color-surface);font-size:.75rem;cursor:pointer;text-align:left;}
  architecture-explorer button:hover {border-color:var(--color-accent);}
  architecture-explorer button:disabled {opacity:.4;cursor:default;}
  architecture-explorer :is(button,input,a):focus-visible {outline:2px solid var(--color-accent);outline-offset:3px;}
  architecture-explorer a {color:var(--color-accent);font-size:.75rem;text-decoration:none;overflow-wrap:anywhere;}
  .ae-toolbar{display:flex;justify-content:space-between;gap:.7rem;flex-wrap:wrap;padding:.7rem 1rem;border-block:1px solid var(--ae-line);}
