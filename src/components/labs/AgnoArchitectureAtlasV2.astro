---
import AgnoArchitectureFlowCanvas from './AgnoArchitectureFlowCanvas.astro';
/**
 * An opt-in design prototype: a single readable system map, guided execution
 * and separately navigable code evidence. No dependency on the old atlas.
 */
const revision='1f2aac51eb28dc9c0970836d3b7ae046bae81bbb';
const base='https://github.com/agno-agi/agno/blob/'+revision+'/libs/agno/agno/';
const boundaries=[
 {name:'CLIENT + INGRESS',x:20,y:78,w:446,h:478,description:'Your application and deployment edge',tone:'edge'},
 {name:'AGENTOS APPLICATION',x:485,y:78,w:388,h:478,description:'Python modules inside the same logical process',tone:'runtime'},
 {name:'CONFIGURED INTEGRATIONS',x:894,y:78,w:288,h:478,description:'Outside AgentOS: providers and systems',tone:'external'},
 {name:'OPERATIONAL STATE',x:485,y:581,w:388,h:146,description:'Persistent job/run state and optional coordination',tone:'state'}
];
const nodes=[
 {id:'client',name:'App / SDK',sub:'Browser · HTTP client',x:60,y:252,w:170,h:78,tone:'edge',kind:'External client',desc:'Creates an agent run request and consumes the streamed response. Authentication is the application’s responsibility.',file:'os/routers/agents/router.py'},
 {id:'gateway',name:'Ingress',sub:'Reverse proxy / LB',x:272,y:252,w:170,h:78,tone:'edge',kind:'Deployment infrastructure',desc:'Optional routing infrastructure terminates TLS and forwards requests to AgentOS. This is not an Agno microservice.',file:'os/app.py'},
 {id:'api',name:'AgentOS API',sub:'FastAPI endpoint',x:506,y:164,w:156,h:84,tone:'runtime',kind:'HTTP interface',desc:'AgentOS exposes routes for agents, teams, workflows and run/event operations.',file:'os/app.py'},
 {id:'registry',name:'Registry',sub:'Agents · Teams · Flows',x:692,y:164,w:156,h:84,tone:'runtime',kind:'In-process resolution',desc:'Configured components are registered and resolved in the application. A registry is not an independent service hop.',file:'os/app.py'},
 {id:'worker',name:'Queue worker',sub:'Claim · lease · retry',x:506,y:322,w:156,h:84,tone:'runtime',kind:'Optional background execution',desc:'The durable worker claims jobs using leases and attempt fencing. Automatic replay requires a deliberate policy.',file:'os/job_queue.py'},
 {id:'agent',name:'Agent runtime',sub:'Model + tool loop',x:692,y:322,w:156,h:84,tone:'runtime',kind:'Python execution',desc:'The agent builds context, calls a model, executes configured tools and produces run events.',file:'agent/agent.py'},
 {id:'events',name:'Run event delivery',sub:'SSE · stream adapter',x:506,y:464,w:342,h:62,tone:'runtime',kind:'Output transport',desc:'Streams generated run events to the client; SSE is not a durable job queue.',file:'os/routers/agents/router.py'},
 {id:'model',name:'LLM provider',sub:'Inference API',x:919,y:159,w:236,h:85,tone:'external',kind:'External provider',desc:'Configured model implementation runs inference. The provider is not deployed automatically by AgentOS.',file:'agent/agent.py'},
 {id:'tools',name:'Tool integrations',sub:'Python · API · MCP',x:919,y:319,w:236,h:85,tone:'external',kind:'External effects possible',desc:'Tools may invoke local or remote services. Side-effecting operations require authorization and idempotency.',file:'agent/agent.py'},
 {id:'knowledge',name:'Retrieval / knowledge',sub:'Optional vector / search',x:919,y:464,w:236,h:62,tone:'external',kind:'Optional retrieval',desc:'Knowledge backends add retrieved context when configured; the actual store is a separate integration.',file:'knowledge/knowledge.py'},
 {id:'postgres',name:'PostgreSQL',sub:'Runs · sessions · jobs',x:506,y:633,w:156,h:70,tone:'state',kind:'Configured persistent store',desc:'Stores run/session records and durable queue tickets when the PostgreSQL adapter is used.',file:'db/postgres/schemas.py'},
 {id:'redis',name:'Redis / Valkey',sub:'Streams · coordination',x:692,y:633,w:156,h:70,tone:'state',kind:'Optional coordination',desc:'Coordinates retained events and signals in multi-replica streaming modes. It does not replace persistent final state.',file:'os/event_streams/redis.py'}
];
const lines=[
 {id:'submit',from:'client',to:'gateway',kind:'http',route:'M230 290 H272'},
 {id:'route',from:'gateway',to:'api',kind:'http',route:'M442 290 H462 V206 H506'},
 {id:'resolve',from:'api',to:'registry',kind:'call',route:'M662 205 H692'},
 {id:'enqueue',from:'api',to:'worker',kind:'call',route:'M584 248 V322'},
 {id:'dispatch',from:'registry',to:'agent',kind:'call',route:'M770 248 V322'},
 {id:'execute',from:'worker',to:'agent',kind:'call',route:'M662 362 H692'},
 {id:'inference',from:'agent',to:'model',kind:'http',route:'M848 350 H883 V203 H919'},
 {id:'tool',from:'agent',to:'tools',kind:'http',route:'M848 362 H919'},
 {id:'retrieve',from:'agent',to:'knowledge',kind:'data',route:'M848 380 H884 V494 H919'},
 {id:'run-events',from:'agent',to:'events',kind:'event',route:'M770 406 V464'},
 {id:'persist',from:'worker',to:'postgres',kind:'data',route:'M506 380 H480 V668 H506'},
 {id:'replay',from:'events',to:'redis',kind:'event',route:'M770 526 V633'}
];
const byId=Object.fromEntries(nodes.map(n=>[n.id,n]));
const story=[
 {id:'answer',title:'Ask a question',summary:'The simplest synchronous request: HTTP ingress → in-process agent → provider → stream.',links:['submit','route','resolve','dispatch','inference','run-events'],captions:['The client submits a run request.','Ingress forwards the HTTP request to AgentOS.','The API resolves a registered component.','The registered agent begins executing in Python.','The agent calls the configured model provider.','Run events are streamed as the answer is produced.']},
 {id:'background',title:'Run in background',summary:'A durable ticket makes worker execution independent of a client socket.',links:['route','enqueue','persist','execute','inference','run-events'],captions:['AgentOS receives a background request.','The request is admitted to the durable queue.','The queue ticket is persisted for claim and recovery.','A worker runs the resolved agent.','The agent invokes the configured model.','Run output is emitted; persistence and event delivery are separate concerns.']},
 {id:'tools',title:'Use an external tool',summary:'A tool call can cross a security boundary and cause a side effect.',links:['route','resolve','dispatch','inference','tool','run-events'],captions:['API receives a run request.','The registered agent is selected.','Execution enters the agent runtime.','The model may request a tool call.','The tool executes against a configured external integration.','Output is returned through run-event transport.']}
];
const code=[
 {symbol:'AgentOS.get_app()',label:'Application composition',where:'os/app.py',detail:'How FastAPI routes and runtime components are wired. Start here to separate modules from processes.',related:'api'},
 {symbol:'agent_response_streamer',label:'Request / SSE',where:'os/routers/agents/router.py',detail:'Streams an inline agent run and handles the response connection.',related:'events'},
 {symbol:'agent.arun()',label:'Agent execution',where:'agent/agent.py',detail:'Agent invocation, context preparation and model/tool execution.',related:'agent'},
 {symbol:'QueueWorker',label:'Durable execution',where:'os/job_queue.py',detail:'Worker claim, lease, heartbeat, cancellation and attempt fencing.',related:'worker'},
 {symbol:'QueuedJob',label:'Job persistence',where:'db/schemas/jobs.py',detail:'Queue ticket and its persisted execution metadata.',related:'postgres'},
 {symbol:'Redis event streams',label:'Event coordination',where:'os/event_streams/redis.py',detail:'Optional retained stream events for cross-replica readers.',related:'redis'}
];
---
<section id="agno-atlas-v2" class="atlas" aria-labelledby="atlas-title">
  <header class="atlas-hero">
    <div class="atlas-hero-copy">
      <p class="atlas-kicker">SYSTEM DESIGN FIELD GUIDE / AGENTOS</p>
      <h1 id="atlas-title">From a question to an answer.<br/><span>Inside the agent runtime.</span></h1>
      <p class="atlas-intro">Understand the system in three passes: see its boundaries, follow one request, and open the implementation. No tangled line network or competing navigation systems.</p>
      <p class="atlas-revision">Grounded in <a href={'https://github.com/agno-agi/agno/tree/'+revision} target="_blank" rel="noopener noreferrer">Agno source {revision.slice(0,8)}</a> · annotated architecture, not a captured production trace</p>
    </div>
    <div class="atlas-hero-mark" aria-hidden="true"><span>01</span><div class="atlas-mark-square"><b>A</b><i></i><i></i></div><span>AGENTOS</span></div>
  </header>
  <div class="atlas-nav" role="tablist" aria-label="Explore Agno architecture">
    <button type="button" role="tab" id="atlas-tab-overview" aria-controls="atlas-overview" aria-selected="true" data-tab="overview"><span>01</span><strong>Architecture</strong><small>System boundaries</small></button>
    <button type="button" role="tab" id="atlas-tab-walkthrough" aria-controls="atlas-walkthrough" aria-selected="false" tabindex="-1" data-tab="walkthrough"><span>02</span><strong>Request journey</strong><small>Explain each hop</small></button>
    <button type="button" role="tab" id="atlas-tab-code" aria-controls="atlas-code" aria-selected="false" tabindex="-1" data-tab="code"><span>03</span><strong>Code explorer</strong><small>Find implementation</small></button>
  </div>
  <section class="atlas-panel" role="tabpanel" id="atlas-overview" aria-labelledby="atlas-tab-overview" data-panel="overview">
    <div class="atlas-section-title"><div><p>01 / ARCHITECTURE</p><h2>Explore the architecture as a flow</h2><span>Pan, zoom, drag, follow directional connectors, and inspect components—without treating Python modules as separate services.</span></div><div class="atlas-actions"><a href="/en/labs/agno-diagrams/" class="atlas-secondary">↗ Diagram-only viewer</a><button type="button" id="atlas-open-walk" class="atlas-primary">Follow a request <span aria-hidden="true">→</span></button></div></div>
    <AgnoArchitectureFlowCanvas />
    <div class="atlas-legacy-model" hidden aria-hidden="true">
    <div class="atlas-diagram-shell">
      <div class="atlas-diagram-scroll">
        <svg id="atlas-diagram" viewBox="0 0 1200 752" role="group" aria-label="Interactive system boundary diagram: client and ingress connect to AgentOS application, state and external providers">
          <defs><pattern id="atlas-dot-grid" width="20" height="20" patternUnits="userSpaceOnUse"><circle cx="1" cy="1" r=".75" fill="currentColor" opacity=".16"/></pattern><marker id="atlas-arrow" markerWidth="8" markerHeight="8" refX="7" refY="4" orient="auto" markerUnits="userSpaceOnUse"><path d="M0 0 L8 4 L0 8Z" fill="context-stroke"/></marker></defs>
          <rect width="1200" height="752" class="atlas-surface"/>
          <rect width="1200" height="752" fill="url(#atlas-dot-grid)" class="atlas-grid"/>
          <g>
            {boundaries.map(b=><g class={'atlas-bound atlas-bound-'+b.tone}><rect x={b.x} y={b.y} width={b.w} height={b.h} rx="16"/><text x={b.x+18} y={b.y+31} class="atlas-bound-title">{b.name}</text><text x={b.x+18} y={b.y+51} class="atlas-bound-sub">{b.description}</text></g>)}
          </g>
          <g>
            {lines.map(l=><path class={'atlas-wire atlas-wire-'+l.kind} data-wire={l.id} data-source={l.from} data-target={l.to} data-kind={l.kind} d={l.route} marker-end="url(#atlas-arrow)" vector-effect="non-scaling-stroke"><title>{byId[l.from].name+' → '+byId[l.to].name+' ('+l.kind+')'}</title></path>)}
          </g>
          <g>
            {nodes.map(n=><g class={'atlas-node atlas-node-'+n.tone} data-node={n.id} data-component={n.id} data-title={n.name} data-detail={n.desc} data-kind={n.kind} data-file={n.file} role="button" tabindex="0" aria-label={'Inspect '+n.name}>
              <rect x={n.x} y={n.y} width={n.w} height={n.h} rx="10" class="atlas-node-rect"/>
              <rect x={n.x+10} y={n.y+12} width="6" height={n.h-24} rx="3" class="atlas-node-accent"/>
              <text x={n.x+26} y={n.y+32} class="atlas-node-name">{n.name}</text>
              <text x={n.x+26} y={n.y+53} class="atlas-node-sub">{n.sub}</text>
              <title>{n.desc}</title>
            </g>)}
          </g>
          <text x="40" y="737" class="atlas-diagram-foot">Representative topology · lines are logical dependencies, not guaranteed individual network services</text>
        </svg>
      </div>
      <div class="atlas-diagram-bar"><div><span class="atlas-legend"><i class="atlas-legend-http"></i>HTTP</span><span class="atlas-legend"><i class="atlas-legend-call"></i>In-process</span><span class="atlas-legend"><i class="atlas-legend-data"></i>Persistence / retrieval</span><span class="atlas-legend"><i class="atlas-legend-event"></i>Events</span></div><small>Tap a component to inspect it</small></div>
    </div>
    <aside class="atlas-inspector" id="atlas-inspector" aria-live="polite">
      <div><span class="atlas-inspector-tag" id="atlas-component-kind">START HERE</span><h3 id="atlas-component-title">A system boundary is not a microservice</h3><p id="atlas-component-description">AgentOS composes HTTP routes, agent execution and optional queue workers in the application. PostgreSQL, Redis and model providers are configured dependencies, not necessarily bundled services.</p></div>
      <div class="atlas-inspector-actions"><a id="atlas-component-source" href={'https://github.com/agno-agi/agno/tree/'+revision} target="_blank" rel="noopener noreferrer">Explore source <span aria-hidden="true">↗</span></a></div>
    </aside>
    </div>
    <div class="atlas-editorial-notes"><div><span>DEPLOYMENT</span><h3>One application can contain many modules.</h3><p>Agent, team, workflow and router boundaries are primarily programming concepts. Independent scaling needs an explicit deployment decision.</p></div><div><span>STATE</span><h3>Connections are not always durable.</h3><p>An SSE stream, a persisted run and a queue ticket solve different problems. The failure walkthrough explains where recovery lives.</p></div></div>
  </section>
  <section class="atlas-panel" role="tabpanel" id="atlas-walkthrough" aria-labelledby="atlas-tab-walkthrough" data-panel="walkthrough" hidden>
    <div class="atlas-section-title"><div><p>02 / REQUEST JOURNEY</p><h2>One request. One connection at a time.</h2><span>Choose a scenario. Use the numbered steps to see exactly which part of the architecture is involved.</span></div></div>
    <div class="atlas-walk-head">
      <div class="atlas-examples" role="group" aria-label="Choose request scenario">
        {story.map((s,i)=><button type="button" data-example={s.id} aria-pressed={i===0}>{s.title}</button>)}
      </div>
      <button type="button" class="atlas-present" id="atlas-present" aria-pressed="false">Presentation view <span aria-hidden="true">↗</span></button>
    </div>
    <p class="atlas-scenario-summary" id="atlas-scenario-summary">The simplest synchronous request: HTTP ingress → in-process agent → provider → stream.</p>
    <div class="atlas-walk-layout">
      <div class="atlas-stepboard">
        <div class="atlas-step-head"><span>REQUEST EXECUTION</span><strong id="atlas-step-counter">01 / 06</strong></div>
        <div class="atlas-travel" aria-live="polite">
          <div><small>FROM</small><strong id="atlas-step-from">App / SDK</strong><p id="atlas-step-from-desc">Browser · HTTP client</p></div>
          <div class="atlas-transfer"><span id="atlas-step-protocol">HTTP</span><b aria-hidden="true">→</b><small>RELATION</small></div>
          <div><small>TO</small><strong id="atlas-step-to">Ingress</strong><p id="atlas-step-to-desc">Reverse proxy / LB</p></div>
        </div>
        <div class="atlas-step-text"><span>WHAT HAPPENS HERE</span><p id="atlas-step-message">The client submits a run request.</p></div>
        <div class="atlas-step-trail" id="atlas-step-trail" role="group" aria-label="Request sequence stages"></div>
        <div class="atlas-step-footer"><button type="button" id="atlas-back">← Back</button><span id="atlas-step-progress">1 of 6</span><button type="button" class="atlas-primary" id="atlas-forward">Next step →</button></div>
      </div>
      <aside class="atlas-step-detail">
        <p class="atlas-pane-eyebrow">WHY THIS STEP MATTERS</p><h3 id="atlas-why-title">What the connection means</h3><p id="atlas-why-description">Follow the request one hop at a time instead of interpreting a large graph.</p>
        <div class="atlas-step-mini" aria-label="Current connection"><span id="atlas-mini-from">App / SDK</span><b>→</b><span id="atlas-mini-to">Ingress</span></div>
        <div class="atlas-source-note"><span>IMPLEMENTATION</span><a id="atlas-step-source" href={base+'os/routers/agents/router.py'} target="_blank" rel="noopener noreferrer">Inspect pinned source ↗</a></div>
        <button type="button" class="atlas-secondary" id="atlas-open-code">Explore code behind this step →</button>
      </aside>
    </div>
    <p class="atlas-lab-note">Educational flow. Durability, stream replay, and external side effects depend on deployment configuration; examples are not recorded packets or measured traces.</p>
  </section>
  <section class="atlas-panel" role="tabpanel" id="atlas-code" aria-labelledby="atlas-tab-code" data-panel="code" hidden>
    <div class="atlas-section-title"><div><p>03 / SOURCE IMPLEMENTATION</p><h2>From the diagram to the real repository.</h2><span>Verified source landmarks, without pretending a hand-authored diagram is an AST call graph.</span></div></div>
    <div class="atlas-code-layout">
      <div class="atlas-code-list" role="group" aria-label="Source entry points">
        {code.map((item,i)=><button type="button" class="atlas-code-choice" data-symbol={item.symbol} data-path={item.where} data-description={item.detail} data-label={item.label} data-related={item.related} aria-pressed={i===0}><span>{item.label}</span><strong>{item.symbol}</strong><small>{item.where}</small></button>)}
      </div>
      <div class="atlas-code-content">
        <p class="atlas-pane-eyebrow">SOURCE MAP / AGNO</p><h3 id="atlas-code-label">Application composition</h3><code id="atlas-code-symbol">AgentOS.get_app()</code><p id="atlas-code-description">How FastAPI routes and runtime components are wired. Start here to separate modules from processes.</p>
        <div class="atlas-code-file"><span>FILE IN PINNED REPOSITORY</span><code id="atlas-code-path">libs/agno/agno/os/app.py</code></div>
        <a id="atlas-code-open" class="atlas-primary atlas-code-link" href={base+'os/app.py'} target="_blank" rel="noopener noreferrer">Open source file ↗</a>
        <div class="atlas-code-footer"><strong>Architecture link</strong><p id="atlas-code-linked">AgentOS API is an application module, not necessarily an individually deployed microservice.</p></div>
      </div>
    </div>
  </section>
  <footer class="atlas-footer"><span>PROTOTYPE / v2</span><p>A reader-first alternative to the current Agno lab. Source-linked and intentionally limited to three views; the existing lab remains available for comparison.</p></footer>
</section>
<style>
.atlas{--ink:var(--color-text,#152538);--muted:var(--color-text-dim,#52667e);--quiet:var(--color-text-muted,#7f93aa);--surface:var(--color-surface,#fff);--subtle:var(--color-surface-2,#f0f4f8);--border:var(--color-border,#dfe6ef);--teal:var(--color-accent,#087e79);--blue:#4e86da;--violet:#9581dd;--amber:#d7a451;color:var(--ink);width:100%;margin:0 auto;font-family:inherit;min-width:0}
.atlas *{box-sizing:border-box}.atlas button{cursor:pointer}.atlas button:focus-visible,.atlas a:focus-visible,.atlas [role=button]:focus-visible{outline:2px solid var(--teal);outline-offset:3px}.atlas [hidden]{display:none!important}.atlas-legacy-model{display:none!important}
.atlas-hero{display:grid;grid-template-columns:minmax(0,1fr) 160px;gap:26px;align-items:center;padding:44px 42px 38px;border:1px solid var(--border);border-radius:18px 18px 0 0;background:radial-gradient(circle at 92% 12%,color-mix(in srgb,var(--teal) 9%,var(--surface)),var(--surface) 45%)}
.atlas-kicker,.atlas-section-title>div>p,.atlas-pane-eyebrow{color:var(--teal);font:750 .68rem/1.4 ui-monospace,monospace;letter-spacing:.11em!important;margin:0!important}
.atlas-hero h1{font-size:clamp(2rem,4vw,3.35rem);line-height:1.13;letter-spacing:-.055em;margin:12px 0 18px!important;font-weight:770}
.atlas-hero h1 span{color:var(--teal)}.atlas-intro{font-size:.99rem;color:var(--muted);line-height:1.7;max-width:645px;margin:0!important}
.atlas-revision{font:.69rem/1.6 ui-monospace,monospace;color:var(--quiet);margin:24px 0 0!important}.atlas-revision a{color:var(--teal);text-decoration:underline;text-underline-offset:3px}
.atlas-hero-mark{display:grid;justify-items:center;gap:13px;font:800 .62rem ui-monospace,monospace;letter-spacing:.16em;color:var(--quiet)}
.atlas-mark-square{height:114px;width:114px;border:1px solid var(--border);border-radius:24px;position:relative;background:var(--subtle);display:grid;place-items:center}
.atlas-mark-square b{font-size:3.8rem;font-weight:780;letter-spacing:-.09em;color:var(--teal)}.atlas-mark-square i{position:absolute;width:11px;height:11px;border:2px solid var(--teal);border-radius:50%;background:var(--surface);right:-6px;top:33px}.atlas-mark-square i:last-child{left:-5px;right:auto;top:73px;border-color:var(--blue)}
.atlas-nav{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));background:var(--surface);border:1px solid var(--border);border-top:0}
.atlas-nav button{display:grid;grid-template-columns:auto minmax(0,1fr);align-items:start;gap:0 10px;padding:18px 24px;border:0;border-right:1px solid var(--border);border-bottom:3px solid transparent;background:transparent;color:var(--ink);text-align:left}
.atlas-nav button:last-child{border-right:0}.atlas-nav button[aria-selected=true]{background:color-mix(in srgb,var(--teal) 5%,var(--surface));border-bottom-color:var(--teal)}.atlas-nav button>span{grid-row:span 2;font:750 .68rem ui-monospace,monospace;color:var(--teal);margin-top:2px}
.atlas-nav strong{font-size:.95rem}.atlas-nav small{font-size:.7rem;color:var(--muted);margin-top:5px}
.atlas-panel{border:1px solid var(--border);border-top:0;padding:34px;background:var(--surface);min-width:0}
.atlas-section-title{display:flex;align-items:end;justify-content:space-between;flex-wrap:wrap;gap:14px;margin-bottom:21px}.atlas-section-title h2{font-size:clamp(1.35rem,2.5vw,2rem);line-height:1.25;letter-spacing:-.04em;margin:7px 0 8px}.atlas-section-title>div>span{font-size:.84rem;color:var(--muted);line-height:1.6}.atlas-actions{display:flex;gap:8px;flex-wrap:wrap;align-items:center}
.atlas-primary,.atlas-secondary{display:inline-flex;align-items:center;justify-content:center;gap:8px;border-radius:8px;padding:10px 16px;font:750 .78rem system-ui;text-decoration:none!important;white-space:nowrap}
.atlas-primary{background:var(--teal)!important;color:var(--surface)!important;border:1px solid var(--teal)!important}.atlas-secondary{background:var(--surface);color:var(--teal);border:1px solid var(--border)}.atlas-primary:hover{filter:brightness(1.1)}.atlas-diagram-shell{border:1px solid var(--border);background:var(--subtle);border-radius:13px;overflow:hidden}
.atlas-diagram-scroll{overflow-x:auto}.atlas-diagram-scroll svg{display:block;width:100%;min-width:830px;height:auto;max-height:680px;cursor:default}
.atlas-surface{fill:var(--surface)}.atlas-grid{color:var(--border)}.atlas-bound rect{fill:var(--subtle);stroke:var(--border);stroke-width:1.6}.atlas-bound-runtime rect{fill:color-mix(in srgb,var(--teal) 5%,var(--subtle));stroke:color-mix(in srgb,var(--teal) 40%,var(--border))}.atlas-bound-state rect{fill:color-mix(in srgb,var(--violet) 5%,var(--subtle))}
.atlas-bound-title{font:750 11px ui-monospace,monospace;letter-spacing:1px;fill:var(--ink)}.atlas-bound-sub{font:11px system-ui;fill:var(--muted)}
.atlas-wire{fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;stroke:var(--blue);opacity:.43;pointer-events:none}.atlas-wire-call{stroke:var(--teal)}.atlas-wire-data{stroke:var(--violet)}.atlas-wire-event{stroke:var(--amber)}.atlas-wire.is-active{opacity:1;stroke-width:4;filter:drop-shadow(0 0 2px var(--surface))}.atlas-wire.is-dimmed{opacity:.065}
