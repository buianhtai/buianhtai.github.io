 $$('[data-tab]').forEach(b=>{b.addEventListener('click',()=>selectTab(b.dataset.tab));b.addEventListener('keydown',e=>{if(!['ArrowLeft','ArrowRight'].includes(e.key))return;e.preventDefault();const names=['overview','walkthrough','code'];const idx=names.indexOf(b.dataset.tab);const next=names[(idx+(e.key==='ArrowRight'?1:2))%3];selectTab(next);$('[data-tab="'+next+'"]').focus()})});
