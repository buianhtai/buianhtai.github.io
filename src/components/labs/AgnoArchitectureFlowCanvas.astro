---
/**
 * React Flow-style architecture canvas without introducing a React runtime:
 * semantic DOM nodes + dynamically routed SVG edges in a pan/zoom world.
 * Representative Agno topology. No interactive topology editing/persistence.
 */
const rev='1f2aac51eb28dc9c0970836d3b7ae046bae81bbb';
const source='https://github.com/agno-agi/agno/blob/'+rev+'/libs/agno/agno/';
const groups=[
 {id:'edge',title:'CLIENT & INGRESS',sub:'Deployment boundary · HTTPS',x:24,y:94,w:319,h:544},
 {id:'app',title:'AGENTOS APPLICATION',sub:'Logical modules · typically one Python process',x:365,y:94,w:650,h:544},
 {id:'ext',title:'CONFIGURED INTEGRATIONS',sub:'External models, services & knowledge',x:1040,y:94,w:429,h:544},
 {id:'state',title:'OPERATIONAL STATE',sub:'Persistence and optional event coordination',x:365,y:662,w:650,h:168}
];
const nodes=[
 {id:'client',group:'edge',label:'Client / SDK',desc:'Application · user request',kind:'Caller',x:60,y:206,w:242,h:90,source:'os/routers/agents/router.py',detail:'The application submits a run request and consumes an HTTP or SSE response. This node is outside the AgentOS server.'},
 {id:'gateway',group:'edge',label:'Ingress / Load Balancer',desc:'TLS · routing · optional',kind:'Edge infrastructure',x:60,y:387,w:242,h:90,source:'os/app.py',detail:'A reverse proxy forwards client requests to AgentOS replicas. This is optional deployment infrastructure rather than a separate built-in Agno service.'},
 {id:'api',group:'app',label:'AgentOS HTTP API',desc:'FastAPI routes',kind:'Application module',x:404,y:197,w:240,h:88,source:'os/app.py',detail:'FastAPI exposes agent/team/workflow routes and dispatches requests into registered Python components.'},
 {id:'registry',group:'app',label:'Component Registry',desc:'Agent · Team · Workflow',kind:'In-process module',x:731,y:197,w:240,h:88,source:'os/app.py',detail:'AgentOS resolves configured components in-process. Registering an agent does not create an independent network service.'},
 {id:'worker',group:'app',label:'Durable Queue Worker',desc:'Claim · lease · retry',kind:'Optional execution mode',x:404,y:392,w:240,h:88,source:'os/job_queue.py',detail:'An enabled durable worker claims database-backed tickets, maintains a lease, and fences stale completion attempts.'},
 {id:'agent',group:'app',label:'Agent Execution',desc:'Context · model · tools',kind:'Python runtime',x:731,y:392,w:240,h:88,source:'agent/agent.py',detail:'The configured Agent performs model/tool loops and emits run events. Its call graph depends on configuration.'},
 {id:'events',group:'app',label:'SSE / Run Events',desc:'Stream transport',kind:'Output transport',x:731,y:529,w:240,h:76,source:'os/routers/agents/router.py',detail:'Run events can be streamed to clients; streamed events are not the authoritative database state.'},
 {id:'model',group:'ext',label:'Model Provider',desc:'Inference requests · cost',kind:'External model API',x:1080,y:182,w:344,h:90,source:'agent/agent.py',detail:'The configured LLM provider performs inference. It may be cloud hosted or deliberately self-hosted outside AgentOS.'},
 {id:'tools',group:'ext',label:'Tools / MCP / APIs',desc:'External operations',kind:'Integration boundary',x:1080,y:365,w:344,h:90,source:'agent/agent.py',detail:'Agent tools may invoke Python functions and remote services. Side effects require explicit authorization and safe retries.'},
 {id:'knowledge',group:'ext',label:'Knowledge / Retrieval',desc:'Optional search / vector DB',kind:'Optional integration',x:1080,y:519,w:344,h:76,source:'knowledge/knowledge.py',detail:'Configured retrieval backends supply context. Vector/search infrastructure is not automatically embedded in AgentOS.'},
 {id:'postgres',group:'state',label:'PostgreSQL',desc:'Runs · jobs · sessions',kind:'Persistent store',x:404,y:711,w:240,h:90,source:'db/postgres/schemas.py',detail:'When configured, PostgreSQL holds durable run/session records and queue tickets. Claims and retries are persisted here.'},
 {id:'redis',group:'state',label:'Redis / Valkey',desc:'Replayable event streams',kind:'Optional coordination',x:731,y:711,w:240,h:90,source:'os/event_streams/redis.py',detail:'Optional shared event streams support cross-replica readers. Stream retention is finite; final run state belongs to persistent storage.'}
];
const edges=[
 {id:'submit',from:'client',to:'gateway',kind:'http',label:'HTTPS',segment:'request'},
 {id:'route',from:'gateway',to:'api',kind:'http',label:'HTTP',segment:'request'},
 {id:'resolve',from:'api',to:'registry',kind:'call',label:'Resolve',segment:'request'},
 {id:'dispatch',from:'registry',to:'agent',kind:'call',label:'Invoke',segment:'request'},
 {id:'inference',from:'agent',to:'model',kind:'http',label:'Inference',segment:'request'},
 {id:'stream',from:'agent',to:'events',kind:'event',label:'Run event',segment:'request'},
 {id:'enqueue',from:'api',to:'worker',kind:'call',label:'Enqueue',segment:'queue'},
 {id:'claim',from:'worker',to:'postgres',kind:'data',label:'Ticket / claim',segment:'queue'},
 {id:'execute',from:'worker',to:'agent',kind:'call',label:'Execute',segment:'queue'},
 {id:'replay',from:'events',to:'redis',kind:'event',label:'Stream / replay',segment:'queue'},
 {id:'tools',from:'agent',to:'tools',kind:'http',label:'Tool invoke',segment:'integrations'},
 {id:'retrieval',from:'agent',to:'knowledge',kind:'data',label:'Retrieve',segment:'integrations'}
];
---
<section class="ag-flow" id="agno-flow-canvas" aria-label="Interactive Agno component architecture canvas">
 <header class="ag-flow-top">
  <div><span class="ag-flow-kicker">INTERACTIVE SYSTEM MAP</span><h3>AgentOS · Component Architecture</h3><p>Drag the canvas or nodes. Zoom and inspect dependencies. Connection colors distinguish HTTP, in-process calls, data and events.</p></div>
  <span class="ag-flow-revision">SOURCE <a href={'https://github.com/agno-agi/agno/tree/'+rev} target="_blank" rel="noopener noreferrer">{rev.slice(0,8)} ↗</a></span>
 </header>
 <div class="ag-flow-modes" role="group" aria-label="Show architecture connections">
  <button type="button" data-mode="request" aria-pressed="true"><b>01</b> Request path</button>
  <button type="button" data-mode="queue" aria-pressed="false"><b>02</b> Durable worker</button>
  <button type="button" data-mode="integrations" aria-pressed="false"><b>03</b> Integrations</button>
  <button type="button" data-mode="all" aria-pressed="false"><b>04</b> All connections</button>
  <span class="ag-flow-mode-hint" id="ag-flow-mode-hint">Core: user → API → agent → model + output</span>
 </div>
 <div class="ag-flow-layout" id="ag-flow-layout">
  <div class="ag-flow-stage" id="ag-flow-stage" aria-label="Pannable and zoomable node and edge diagram" tabindex="0">
   <div class="ag-flow-world" id="ag-flow-world" style="width:1500px;height:850px">
    {groups.map(g=><div class={'ag-flow-group ag-flow-group-'+g.id} data-group={g.id} style={'left:'+g.x+'px;top:'+g.y+'px;width:'+g.w+'px;height:'+g.h+'px'}>
      <strong>{g.title}</strong><span>{g.sub}</span>
    </div>)}
    <svg class="ag-flow-wires" id="ag-flow-wires" width="1500" height="850" viewBox="0 0 1500 850" aria-hidden="true">
      <defs>
        <marker id="ag-arr-http" markerWidth="9" markerHeight="9" refX="8" refY="4.5" orient="auto" markerUnits="userSpaceOnUse"><path d="M0 0 L9 4.5 L0 9Z" fill="#448bd1"/></marker>
        <marker id="ag-arr-call" markerWidth="9" markerHeight="9" refX="8" refY="4.5" orient="auto" markerUnits="userSpaceOnUse"><path d="M0 0 L9 4.5 L0 9Z" fill="#24a69b"/></marker>
        <marker id="ag-arr-data" markerWidth="9" markerHeight="9" refX="8" refY="4.5" orient="auto" markerUnits="userSpaceOnUse"><path d="M0 0 L9 4.5 L0 9Z" fill="#aa83d8"/></marker>
        <marker id="ag-arr-event" markerWidth="9" markerHeight="9" refX="8" refY="4.5" orient="auto" markerUnits="userSpaceOnUse"><path d="M0 0 L9 4.5 L0 9Z" fill="#d99c45"/></marker>
      </defs>
      {edges.map(e=><path class={'ag-flow-edge edge-'+e.kind} data-flow-edge={e.id} data-from={e.from} data-to={e.to} data-kind={e.kind} data-segment={e.segment} data-label={e.label} marker-end={'url(#ag-arr-'+e.kind+')'} d="M0 0" vector-effect="non-scaling-stroke"><title>{e.from+' → '+e.to+': '+e.label}</title></path>)}
    </svg>
    <div class="ag-flow-label-layer" id="ag-flow-label-layer" aria-hidden="true"></div>
    {nodes.map(n=><button type="button" class={'ag-flow-node ag-flow-node-'+n.group} data-flow-node={n.id} data-group={n.group} data-title={n.label} data-kind={n.kind} data-detail={n.detail} data-source={n.source} data-w={n.w} data-h={n.h} style={'left:'+n.x+'px;top:'+n.y+'px;width:'+n.w+'px;height:'+n.h+'px'} aria-label={'Inspect '+n.label}>
      <span class="ag-flow-node-kind">{n.kind}</span>
      <strong>{n.label}</strong><small>{n.desc}</small>
      <i class="ag-flow-port ag-flow-port-in"></i><i class="ag-flow-port ag-flow-port-out"></i>
    </button>)}
   </div>
   <div class="ag-flow-canvas-tools" role="group" aria-label="Diagram navigation">
    <button type="button" id="ag-flow-plus" aria-label="Zoom in">+</button>
    <button type="button" id="ag-flow-minus" aria-label="Zoom out">−</button>
    <button type="button" id="ag-flow-fit" aria-label="Fit full architecture">Fit</button>
    <button type="button" id="ag-flow-expand" aria-label="Expand architecture fullscreen" aria-pressed="false" title="Fullscreen">⛶</button>
    <button type="button" id="ag-flow-reset" aria-label="Reset node positions">Reset</button>
   </div>
   <div class="ag-flow-map" id="ag-flow-map" aria-label="Architecture minimap">
    <svg viewBox="0 0 1500 850" id="ag-flow-mini-svg" aria-label="Mini map of architecture">
      {groups.map(g=><rect x={g.x} y={g.y} width={g.w} height={g.h} rx="15" class={'mini-group-'+g.id}/>)}
      {nodes.map(n=><rect x={n.x} y={n.y} width={n.w} height={n.h} rx="12" class="mini-node" data-mini={n.id}/>)}
      <rect id="ag-flow-viewport" x="0" y="0" width="1500" height="850" rx="5"/>
    </svg>
    <span>MINIMAP</span>
   </div>
   <p class="ag-flow-stage-tip" id="ag-flow-tip">Drag empty space to pan · drag a component to rearrange · wheel or pinch to zoom</p>
  </div>
  <aside class="ag-flow-inspector" aria-live="polite">
    <span class="ag-flow-inspector-top">COMPONENT EXPLORER</span>
    <h4 id="ag-flow-inspect-title">Follow a connection</h4>
    <p id="ag-flow-inspect-detail">Select a node to highlight upstream and downstream relationships and inspect its source.</p>
    <div class="ag-flow-inspect-row"><span>TYPE</span><strong id="ag-flow-inspect-type">Logical architecture</strong></div>
    <div class="ag-flow-neighbors"><span>DIRECT RELATIONSHIPS</span><div id="ag-flow-neighbors"><p>Select any component on the diagram.</p></div></div>
    <a id="ag-flow-source" href={'https://github.com/agno-agi/agno/tree/'+rev} target="_blank" rel="noopener noreferrer">Browse pinned source ↗</a>
    <div class="ag-flow-note"><strong>Boundary matters</strong><p>AgentOS modules do not automatically become microservices. Queueing and Redis are optional configured execution / coordination choices.</p></div>
  </aside>
 </div>
 <footer class="ag-flow-footer"><div class="ag-flow-legend"><span><i class="l-http"></i> HTTP</span><span><i class="l-call"></i> In-process</span><span><i class="l-data"></i> Data</span><span><i class="l-event"></i> Events</span></div><p>This map is source-linked and explanatory, not a captured distributed trace. Node positions are local to this session.</p></footer>
</section>
<style>
.ag-flow{--af-text:var(--color-text,#e8eff7);--af-sub:var(--color-text-dim,#b0bdcb);--af-bg:var(--color-surface,#121c2a);--af-panel:var(--color-surface-2,#182536);--af-line:var(--color-border,#29394b);--af-accent:var(--color-accent,#71e0d0);--af-http:#448bd1;--af-call:#24a69b;--af-data:#aa83d8;--af-event:#d99c45;border:1px solid var(--af-line);border-radius:15px;background:var(--af-bg);color:var(--af-text);overflow:hidden;margin:16px 0 12px}
.ag-flow *{box-sizing:border-box}.ag-flow button{cursor:pointer}.ag-flow :is(button,a):focus-visible{outline:2px solid var(--af-accent);outline-offset:3px}
.ag-flow-top{padding:17px 20px;display:flex;align-items:start;gap:15px;justify-content:space-between;border-bottom:1px solid var(--af-line)}
.ag-flow-kicker,.ag-flow-inspector-top{font:750 .63rem ui-monospace,monospace;letter-spacing:.09em;color:var(--af-accent)}
.ag-flow-top h3{font-size:1.25rem!important;letter-spacing:-.025em;margin:6px 0!important;color:var(--af-text)}
.ag-flow-top p{font-size:.76rem!important;line-height:1.55;color:var(--af-sub);margin:0!important}
.ag-flow-revision{font:700 .66rem ui-monospace,monospace;white-space:nowrap;color:var(--af-sub)}.ag-flow-revision a{color:var(--af-accent)}
.ag-flow-modes{display:flex;align-items:center;flex-wrap:wrap;gap:6px;padding:10px 16px;border-bottom:1px solid var(--af-line)}
.ag-flow-modes button{display:inline-flex;align-items:center;gap:7px;border:1px solid var(--af-line);border-radius:7px;color:var(--af-sub);background:var(--af-bg);padding:9px 12px;font-size:.72rem;font-weight:720;line-height:1.15}
.ag-flow-modes button b{font:.65rem ui-monospace,monospace;color:var(--af-accent)}
.ag-flow-modes button[aria-pressed=true]{border-color:var(--af-accent);background:color-mix(in srgb,var(--af-accent) 9%,var(--af-bg));color:var(--af-text)}
.ag-flow-mode-hint{margin-left:auto;color:var(--af-sub);font-size:.69rem}
.ag-flow-layout{display:grid;grid-template-columns:minmax(0,1fr) 268px;min-height:580px}
.ag-flow-layout.is-expanded,.ag-flow-layout:fullscreen{position:fixed!important;inset:0!important;z-index:2147482600;background:var(--af-bg);width:100vw;height:100dvh;max-width:none;grid-template-columns:minmax(0,1fr) minmax(260px,330px);overflow:auto}
.ag-flow-layout.is-expanded .ag-flow-stage,.ag-flow-layout:fullscreen .ag-flow-stage{height:100dvh;min-height:0}
.ag-flow-layout.is-expanded .ag-flow-inspector,.ag-flow-layout:fullscreen .ag-flow-inspector{min-height:100%;overflow-y:auto}
.ag-flow-layout #ag-flow-expand[aria-pressed=true]{background:var(--af-accent);color:var(--af-bg)}
.ag-flow-stage{position:relative;min-width:0;min-height:580px;height:600px;overflow:hidden;cursor:grab;background:radial-gradient(circle,var(--af-line) .85px,transparent 1.2px);background-size:20px 20px;touch-action:none;user-select:none;isolation:isolate}
.ag-flow-stage.is-panning{cursor:grabbing}.ag-flow-world{position:absolute;top:0;left:0;transform-origin:0 0;will-change:transform}
.ag-flow-group{position:absolute;background:color-mix(in srgb,var(--af-panel) 84%,transparent);border:1.5px solid var(--af-line);border-radius:18px;display:flex;flex-direction:column;align-items:flex-start;gap:8px;padding:16px 18px;pointer-events:none}
.ag-flow-group strong{font:770 16px ui-monospace,monospace;letter-spacing:1.2px;color:var(--af-text)}.ag-flow-group>span{font:13px system-ui;color:var(--af-sub)}
.ag-flow-group-app{border-color:color-mix(in srgb,var(--af-call) 55%,var(--af-line));background:color-mix(in srgb,var(--af-call) 4%,var(--af-panel))}
.ag-flow-group-state{border-color:color-mix(in srgb,var(--af-data) 45%,var(--af-line))}
.ag-flow-wires{position:absolute;left:0;top:0;overflow:visible;pointer-events:none}
.ag-flow-edge{stroke:var(--af-http);stroke-width:2.6;fill:none;opacity:.1;stroke-linecap:round;stroke-linejoin:round;transition:opacity .15s,stroke-width .15s}
.ag-flow-edge.edge-call{stroke:var(--af-call)}.ag-flow-edge.edge-data{stroke:var(--af-data)}.ag-flow-edge.edge-event{stroke:var(--af-event)}
.ag-flow-edge.is-visible{stroke-width:3.1;opacity:.88;filter:drop-shadow(0 1px 1px var(--af-bg))}
.ag-flow-edge.is-focused{opacity:1;stroke-width:4.2}.ag-flow-edge.is-muted{opacity:.045}
.ag-flow-node{position:absolute;z-index:2;background:var(--af-bg);border:1.6px solid var(--af-line);border-left:5px solid var(--af-http);border-radius:12px;padding:11px 16px;display:flex;flex-direction:column;text-align:left;justify-content:center;gap:4px;color:var(--af-text);box-shadow:0 4px 15px #00000019;cursor:grab!important;touch-action:none}
.ag-flow-node:active{cursor:grabbing!important}.ag-flow-node-app{border-left-color:var(--af-call)}.ag-flow-node-state{border-left-color:var(--af-data)}.ag-flow-node-ext{border-left-color:var(--af-event)}
.ag-flow-node-kind{font:700 10px ui-monospace,monospace;letter-spacing:.035em;color:var(--af-accent);text-transform:uppercase}
.ag-flow-node strong{font-size:15px;line-height:1.32;font-weight:750;white-space:nowrap}.ag-flow-node small{font-size:11px;color:var(--af-sub);white-space:nowrap}
.ag-flow-node.is-active{border-color:var(--af-accent);box-shadow:0 0 0 3px color-mix(in srgb,var(--af-accent) 18%,transparent),0 6px 24px #0003}
.ag-flow-node.is-muted{opacity:.43}
.ag-flow-port{position:absolute;top:calc(50% - 5px);height:10px;width:10px;background:var(--af-bg);border:2px solid var(--af-call);border-radius:50%;pointer-events:none}.ag-flow-port-in{left:-6px}.ag-flow-port-out{right:-6px}
.ag-flow-label-layer{position:absolute;inset:0;pointer-events:none}
.ag-flow-label{position:absolute;z-index:3;font:750 10px ui-monospace,monospace;white-space:nowrap;border:1px solid var(--af-line);border-radius:6px;background:var(--af-bg);padding:4px 6px;color:var(--af-text);transform:translate(-50%,-50%);box-shadow:0 2px 5px #0002}
.ag-flow-canvas-tools{position:absolute;z-index:6;bottom:16px;left:15px;display:flex;gap:5px;padding:5px;border:1px solid var(--af-line);border-radius:10px;background:var(--af-bg);box-shadow:0 3px 14px #0003}
.ag-flow-canvas-tools button{border:0;background:var(--af-panel);color:var(--af-text);font-size:.75rem;font-weight:750;min-width:36px;border-radius:6px;padding:9px}
.ag-flow-map{position:absolute;right:15px;bottom:15px;width:172px;z-index:5;border:1px solid var(--af-line);padding:5px 5px 2px;border-radius:10px;background:var(--af-bg);box-shadow:0 3px 14px #0002}
.ag-flow-map svg{display:block;width:100%;height:auto}.ag-flow-map svg rect{fill:var(--af-panel);stroke:var(--af-line);stroke-width:10}.ag-flow-map svg .mini-group-app{stroke:var(--af-call)}.ag-flow-map svg .mini-group-state{stroke:var(--af-data)}.ag-flow-map svg .mini-node{fill:var(--af-http);stroke:none}.ag-flow-map svg #ag-flow-viewport{fill:color-mix(in srgb,var(--af-accent) 10%,transparent);stroke:var(--af-accent);stroke-width:11}
.ag-flow-map>span{font:700 .52rem ui-monospace,monospace;color:var(--af-sub);padding:3px 4px}
.ag-flow-stage-tip{position:absolute;z-index:5;top:10px;left:14px;margin:0!important;font:650 .62rem system-ui;color:var(--af-sub);background:var(--af-bg);padding:6px 9px;border:1px solid var(--af-line);border-radius:7px;pointer-events:none}
.ag-flow-inspector{background:var(--af-panel);border-left:1px solid var(--af-line);padding:18px;display:flex;flex-direction:column;gap:15px}
.ag-flow-inspector h4{font-size:1.14rem;margin:0;color:var(--af-text)}.ag-flow-inspector>p{color:var(--af-sub);font-size:.77rem;line-height:1.65;margin:0}
.ag-flow-inspect-row{display:grid;gap:6px;border-top:1px solid var(--af-line);padding-top:12px}.ag-flow-inspect-row>span,.ag-flow-neighbors>span{font:700 .62rem ui-monospace,monospace;color:var(--af-accent);letter-spacing:.06em}
.ag-flow-inspect-row strong{font-size:.8rem}.ag-flow-neighbors{display:grid;gap:8px;border-top:1px solid var(--af-line);padding-top:12px}
#ag-flow-neighbors{display:grid;gap:6px}
#ag-flow-neighbors>p{font-size:.75rem;color:var(--af-sub);line-height:1.5}
.ag-flow .ag-flow-inspector :global(.ag-flow-neighbor){background:var(--af-bg);color:var(--af-text);font-size:.7rem;line-height:1.5;text-align:left;border:1px solid var(--af-line);padding:9px;border-radius:7px}
.ag-flow .ag-flow-inspector :global(.ag-flow-neighbor) :global(small){display:block;color:var(--af-sub);font-size:.64rem;margin-top:2px}
.ag-flow-inspector>a{color:var(--af-accent);font-size:.76rem;font-weight:700;overflow-wrap:anywhere}
.ag-flow-note{margin-top:auto;border-top:1px solid var(--af-line);padding-top:13px}
.ag-flow-note strong{font-size:.77rem}.ag-flow-note p{font-size:.71rem;line-height:1.6;color:var(--af-sub);margin:5px 0 0}
.ag-flow-footer{padding:12px 16px;display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;border-top:1px solid var(--af-line)}
.ag-flow-legend{display:flex;gap:12px;flex-wrap:wrap}.ag-flow-legend span{font-size:.68rem;color:var(--af-sub);display:flex;align-items:center;gap:6px}
.ag-flow-legend i{height:3px;width:20px;display:inline-block;border-radius:5px}.ag-flow-legend .l-http{background:var(--af-http)}.ag-flow-legend .l-call{background:var(--af-call)}.ag-flow-legend .l-data{background:var(--af-data)}.ag-flow-legend .l-event{background:var(--af-event)}
.ag-flow-footer p{font-size:.67rem;color:var(--af-sub);margin:0;line-height:1.5}
@media(max-width:1000px){.ag-flow-layout{grid-template-columns:1fr}.ag-flow-inspector{border-left:0;border-top:1px solid var(--af-line);gap:9px}.ag-flow-inspector .ag-flow-note{display:none}.ag-flow-stage{height:565px;min-height:565px}.ag-flow-inspector{display:grid;grid-template-columns:1fr 1fr;align-items:start}.ag-flow-inspector .ag-flow-inspector-top,.ag-flow-inspector #ag-flow-inspect-title,.ag-flow-inspector #ag-flow-inspect-detail{grid-column:1}.ag-flow-neighbors{grid-column:2;grid-row:1 / span 4;border-top:0;padding-top:0}.ag-flow-inspector>a{grid-column:1}}
@media(max-width:620px){
 .ag-flow-layout.is-expanded,.ag-flow-layout:fullscreen{display:flex;flex-direction:column}
 .ag-flow-layout.is-expanded .ag-flow-stage,.ag-flow-layout:fullscreen .ag-flow-stage{height:70dvh;min-height:70dvh;flex:none}
 .ag-flow-layout.is-expanded .ag-flow-inspector,.ag-flow-layout:fullscreen .ag-flow-inspector{overflow:visible;min-height:0}
 .ag-flow-top{padding:13px 14px}.ag-flow-top h3{font-size:1.08rem!important}.ag-flow-top p{font-size:.71rem!important}.ag-flow-revision{display:none}.ag-flow-modes{padding:8px 10px;flex-wrap:nowrap;overflow-x:auto}.ag-flow-modes button{white-space:nowrap;padding:8px;font-size:.65rem}.ag-flow-mode-hint{display:none}.ag-flow-stage{height:480px;min-height:480px}.ag-flow-map{width:120px;right:8px;bottom:8px}.ag-flow-canvas-tools{left:8px;bottom:8px}.ag-flow-canvas-tools button{padding:7px;min-width:31px}.ag-flow-stage-tip{font-size:.6rem;max-width:74%}.ag-flow-inspector{display:flex;gap:8px;padding:13px}.ag-flow-neighbors{border-top:1px solid var(--af-line);padding-top:10px}}
@media(prefers-reduced-motion:reduce){.ag-flow-edge{transition:none}}
</style>
<script>
(()=>{
 const root=document.querySelector('#agno-flow-canvas');if(!root||root.dataset.ready==='1')return;root.dataset.ready='1';
 const $=id=>root.querySelector('#'+id);
 const stage=$('ag-flow-stage'),world=$('ag-flow-world'),mini=$('ag-flow-mini-svg'),layout=$('ag-flow-layout');
 let expanded=false,storedOverflow='';
 const parts=[...root.querySelectorAll('[data-flow-node]')],links=[...root.querySelectorAll('[data-flow-edge]')];
 const nodes=Object.fromEntries(parts.map(el=>[el.dataset.flowNode,{el,id:el.dataset.flowNode,x:parseFloat(el.style.left),y:parseFloat(el.style.top),w:Number(el.dataset.w),h:Number(el.dataset.h)}]));
 const names=Object.fromEntries(parts.map(el=>[el.dataset.flowNode,el.dataset.title]));
 const modeDesc={request:'Core: user → API → agent → model + output',queue:'Durable: API → ticket → worker → state',integrations:'External: model, tools and retrieval',all:'All relationships shown — select a component'};
 const activeByMode={
  request:['submit','route','resolve','dispatch','inference','stream'],
  queue:['route','enqueue','claim','execute','stream','replay'],
  integrations:['inference','tools','retrieval'],
  all:links.map(el=>el.dataset.flowEdge)
 };
 const W=1500,H=850;
 let mode='request',selected=null,scale=.62,panX=0,panY=0,capture=null,skipClick=null;
 function place(){
  world.style.transform='translate('+panX+'px,'+panY+'px) scale('+scale+')';
  const vw=stage.clientWidth/scale,vh=stage.clientHeight/scale;
  const marker=$('ag-flow-viewport');marker.setAttribute('x',String(-panX/scale));marker.setAttribute('y',String(-panY/scale));
  marker.setAttribute('width',String(vw));marker.setAttribute('height',String(vh));
 }
 function fit(){
  const zoom=Math.min((stage.clientWidth-46)/W,(stage.clientHeight-46)/H,1.0);
  scale=Math.max(.2,zoom);panX=(stage.clientWidth-W*scale)/2;panY=(stage.clientHeight-H*scale)/2;place();
 }
 function focusNode(n){
  if(!n)return;const requested=stage.clientWidth<=600?Math.min(1,.75):.95;
  scale=Math.max(scale,requested);panX=stage.clientWidth*.45-(n.x+n.w/2)*scale;panY=stage.clientHeight*.43-(n.y+n.h/2)*scale;place()
 }
 function getPos(n){return {x:n.x,y:n.y,w:n.w,h:n.h,midX:n.x+n.w/2,midY:n.y+n.h/2}}
 function route(a,b){
  const A=getPos(a),B=getPos(b),dx=B.midX-A.midX,dy=B.midY-A.midY;
  let sx,sy,tx,ty,d,mx,my;
  if(Math.abs(dx)>Math.abs(dy)*1.1){
   sx=dx>0?A.x+A.w:A.x;sy=A.midY;tx=dx>0?B.x:B.x+B.w;ty=B.midY;
   mx=(sx+tx)/2;d='M'+sx+' '+sy+' L'+mx+' '+sy+' L'+mx+' '+ty+' L'+tx+' '+ty;
   return {d,labelX:mx,labelY:(sy+ty)/2};
  }
  sy=dy>0?A.y+A.h:A.y;sx=A.midX;ty=dy>0?B.y:B.y+B.h;tx=B.midX;
  my=(sy+ty)/2;d='M'+sx+' '+sy+' L'+sx+' '+my+' L'+tx+' '+my+' L'+tx+' '+ty;
  return {d,labelX:(sx+tx)/2,labelY:my}
 }
 function draw(){
  const labels=$('ag-flow-label-layer');labels.replaceChildren();
  const keep=new Set(activeByMode[mode]),related=new Set(selected?links.filter(e=>e.dataset.from===selected||e.dataset.to===selected).map(e=>e.dataset.flowEdge):[]);
  const highlight=selected?related:keep;
  links.forEach(edge=>{
   const a=nodes[edge.dataset.from],b=nodes[edge.dataset.to];if(!a||!b)return;
   const {d,labelX,labelY}=route(a,b);edge.setAttribute('d',d);
   const showing=selected?related.has(edge.dataset.flowEdge):keep.has(edge.dataset.flowEdge);
   edge.classList.toggle('is-visible',showing);edge.classList.toggle('is-focused',!!selected&&showing);edge.classList.toggle('is-muted',!showing);
   if(showing){
    const span=document.createElement('span');span.className='ag-flow-label';span.textContent=edge.dataset.label;
    span.style.left=labelX+'px';span.style.top=labelY+'px';
    labels.append(span)
   }
  });
  const adjacent=new Set([selected]);if(selected){links.forEach(e=>{if(e.dataset.from===selected||e.dataset.to===selected){adjacent.add(e.dataset.from);adjacent.add(e.dataset.to)}})}
  parts.forEach(p=>{const id=p.dataset.flowNode,active=selected?adjacent.has(id):true;p.classList.toggle('is-active',id===selected);p.classList.toggle('is-muted',!active)});
  root.querySelectorAll('[data-mini]').forEach(el=>{const n=nodes[el.dataset.mini];if(n){el.setAttribute('x',String(n.x));el.setAttribute('y',String(n.y))}});
 }
 function inspect(id){
  selected=id||null;draw();
  const el=nodes[id]?.el;
  if(!el){$('ag-flow-inspect-title').textContent='Follow a connection';$('ag-flow-inspect-detail').textContent='Select a component to see upstream and downstream dependencies.';$('ag-flow-inspect-type').textContent='Logical architecture';$('ag-flow-source').href='https://github.com/agno-agi/agno/tree/1f2aac51eb28dc9c0970836d3b7ae046bae81bbb';$('ag-flow-neighbors').replaceChildren();return}
  $('ag-flow-inspect-title').textContent=el.dataset.title;$('ag-flow-inspect-detail').textContent=el.dataset.detail;$('ag-flow-inspect-type').textContent=el.dataset.kind;
  $('ag-flow-source').href='https://github.com/agno-agi/agno/blob/1f2aac51eb28dc9c0970836d3b7ae046bae81bbb/libs/agno/agno/'+el.dataset.source;
  const where=$('ag-flow-neighbors');where.replaceChildren();
  links.filter(e=>e.dataset.from===id||e.dataset.to===id).forEach(e=>{
   const outgoing=e.dataset.from===id,other=outgoing?e.dataset.to:e.dataset.from;
   const btn=document.createElement('button');btn.type='button';btn.className='ag-flow-neighbor';
   const label=document.createElement('span');label.textContent=(outgoing?'→ ':'← ')+names[other];
   const caption=document.createElement('small');caption.textContent=e.dataset.kind.toUpperCase()+' · '+e.dataset.label;
   btn.append(label,caption);btn.addEventListener('click',()=>{inspect(other);focusNode(nodes[other])});where.append(btn)
  })
 }
 function selectMode(next){
  mode=next;root.querySelectorAll('[data-mode]').forEach(b=>b.setAttribute('aria-pressed',String(b.dataset.mode===next)));
  $('ag-flow-mode-hint').textContent=modeDesc[next];selected=null;draw();
 }
 function zoom(f,x=stage.clientWidth/2,y=stage.clientHeight/2){
  const next=Math.max(.2,Math.min(1.8,scale*f)),factor=next/scale;
  panX=x-(x-panX)*factor;panY=y-(y-panY)*factor;scale=next;place();
 }
 root.querySelectorAll('[data-mode]').forEach(btn=>btn.addEventListener('click',()=>selectMode(btn.dataset.mode)));
 $('ag-flow-plus').addEventListener('click',()=>zoom(1.25));$('ag-flow-minus').addEventListener('click',()=>zoom(.8));$('ag-flow-fit').addEventListener('click',fit);
 $('ag-flow-reset').addEventListener('click',()=>{root.querySelectorAll('[data-flow-node]').forEach(p=>{const n=nodes[p.dataset.flowNode];const def=defaults[p.dataset.flowNode];n.x=def.x;n.y=def.y;p.style.left=n.x+'px';p.style.top=n.y+'px'});draw();fit()});
 const defaults=Object.fromEntries(Object.values(nodes).map(n=>[n.id,{x:n.x,y:n.y}]));
 function exitExpand(){
  if(!expanded)return;expanded=false;layout.classList.remove('is-expanded');
  $('ag-flow-expand').setAttribute('aria-pressed','false');$('ag-flow-expand').textContent='⛶';
  document.body.style.overflow=storedOverflow;
  if(document.fullscreenElement===layout&&document.exitFullscreen)document.exitFullscreen().catch(()=>{});
  place()
 }
 $('ag-flow-expand').addEventListener('click',async()=>{
  if(expanded){exitExpand();return}
  expanded=true;storedOverflow=document.body.style.overflow;document.body.style.overflow='hidden';layout.classList.add('is-expanded');
  $('ag-flow-expand').setAttribute('aria-pressed','true');$('ag-flow-expand').textContent='✕';
  if(stage.clientWidth<650){
    scale=Math.max(scale,.78);
    panX=24-60*scale;
    panY=140-206*scale;
  }
  place();
  if(layout.requestFullscreen){try{await layout.requestFullscreen()}catch{/* CSS immersive fallback */}}
  place()
 });
 document.addEventListener('fullscreenchange',()=>{if(expanded&&!document.fullscreenElement)exitExpand()});
 document.addEventListener('keydown',e=>{if(expanded&&e.key==='Escape'){e.preventDefault();exitExpand()}});
 stage.addEventListener('wheel',e=>{if(e.target.closest('.ag-flow-canvas-tools,.ag-flow-map'))return;e.preventDefault();const b=stage.getBoundingClientRect();zoom(e.deltaY<0?1.12:.89,e.clientX-b.left,e.clientY-b.top)},{passive:false});
 const activePointers=new Map();let pinchDistance=0;
 function pointerDown(e){
  if(e.button!==0&&e.pointerType==='mouse')return;
  if(e.target.closest('.ag-flow-canvas-tools,.ag-flow-map'))return;
  const target=e.target.closest('[data-flow-node]');const n=target?nodes[target.dataset.flowNode]:null;
  capture={id:e.pointerId,startX:e.clientX,startY:e.clientY,x:panX,y:panY,node:n,nodeX:n?.x,nodeY:n?.y,moved:false};
  activePointers.set(e.pointerId,{x:e.clientX,y:e.clientY});stage.setPointerCapture(e.pointerId)
 }
 stage.addEventListener('pointerdown',pointerDown);
 stage.addEventListener('pointermove',e=>{
  if(!activePointers.has(e.pointerId))return;activePointers.set(e.pointerId,{x:e.clientX,y:e.clientY});
  if(activePointers.size===2){
   const pair=[...activePointers.values()],dist=Math.hypot(pair[0].x-pair[1].x,pair[0].y-pair[1].y);
   if(pinchDistance){const r=stage.getBoundingClientRect(),x=(pair[0].x+pair[1].x)/2-r.left,y=(pair[0].y+pair[1].y)/2-r.top;zoom(dist/pinchDistance,x,y)}
   pinchDistance=dist;return
  }
  if(!capture||capture.id!==e.pointerId)return;
  const dx=e.clientX-capture.startX,dy=e.clientY-capture.startY;
  if(Math.abs(dx)+Math.abs(dy)>5)capture.moved=true;
  if(!capture.moved)return;
  if(capture.node){
   const n=capture.node;n.x=capture.nodeX+dx/scale;n.y=capture.nodeY+dy/scale;
   n.el.style.left=n.x+'px';n.el.style.top=n.y+'px';draw();
  }else{panX=capture.x+dx;panY=capture.y+dy;place();stage.classList.add('is-panning')}
 });
 function finish(e){
  if(!activePointers.has(e.pointerId))return;activePointers.delete(e.pointerId);
  if(activePointers.size<2)pinchDistance=0;
  if(capture&&capture.id===e.pointerId){
   if(capture.node){if(capture.moved){skipClick=capture.node.id;const draggedId=skipClick;setTimeout(()=>{if(skipClick===draggedId)skipClick=null},60)}else inspect(capture.node.id)}
   else if(!capture.moved&&e.target===stage)inspect(null);
   capture=null;
  }
  stage.classList.remove('is-panning')
 }
 stage.addEventListener('pointerup',finish);stage.addEventListener('pointercancel',finish);
 parts.forEach(part=>part.addEventListener('click',e=>{e.preventDefault();const id=part.dataset.flowNode;if(skipClick===id){skipClick=null;return}inspect(id)}));
 stage.addEventListener('keydown',e=>{
  if(e.target!==stage)return;
  if(e.key==='+'){e.preventDefault();zoom(1.25)}else if(e.key==='-'){e.preventDefault();zoom(.8)}
  else if(e.key==='0'){e.preventDefault();fit()}
  else if(['ArrowLeft','ArrowRight','ArrowUp','ArrowDown'].includes(e.key)){
   e.preventDefault();panX+=(e.key==='ArrowLeft'?45:e.key==='ArrowRight'?-45:0);panY+=(e.key==='ArrowUp'?45:e.key==='ArrowDown'?-45:0);place()
  }
 });
 mini.addEventListener('click',e=>{const bounds=mini.getBoundingClientRect();const mx=(e.clientX-bounds.left)/bounds.width*W,my=(e.clientY-bounds.top)/bounds.height*H;panX=stage.clientWidth/2-mx*scale;panY=stage.clientHeight/2-my*scale;place()});
 const ro=new ResizeObserver(()=>{if(stage.clientWidth>0){if(!stage.dataset.fitted){stage.dataset.fitted='1';fit();scale=Math.max(scale,stage.clientWidth<600?.80:.76);panX=26-60*scale;panY=(stage.clientWidth<600?142:170)-206*scale;place()}else place()}});
 ro.observe(stage);draw();
})();
</script>