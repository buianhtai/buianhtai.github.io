---
interface Props { headings: { depth: number; slug: string; text: string }[]; }
const { headings } = Astro.props;
const filtered = headings.filter(h => h.depth >= 2 && h.depth <= 3);
---
{filtered.length > 0 && (
  <nav class="toc">
    <div class="toc-header">
      <span class="toc-prompt">$</span>
      <span>cat TABLE_OF_CONTENTS</span>
    </div>
    <ul class="toc-list">
      {filtered.map(h => (
        <li class={`toc-item toc-depth-${h.depth}`}>
          <span class="toc-bullet">{h.depth === 2 ? '▸' : '·'}</span>
          <a href={`#${h.slug}`} class="toc-link">{h.text}</a>
        </li>
      ))}
    </ul>
  </nav>
)}

<style>
  .toc {
    margin-bottom: 2.5rem;
    border: 1px solid var(--color-border);
    background: var(--color-surface);
  }
  .toc-header {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    padding: 0.45rem 0.875rem;
    border-bottom: 1px solid var(--color-border);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--color-text-muted);
    background: var(--color-surface-2);
  }
  .toc-prompt { color: var(--color-accent); font-weight: 700; }
  .toc-list {
    list-style: none;
    margin: 0;
    padding: 0.5rem 0;
  }
  .toc-item {
    display: flex;
    align-items: baseline;
    gap: 0.4rem;
    padding: 0.18rem 0.875rem;
  }
  .toc-depth-3 { padding-left: 2rem; }
  .toc-bullet {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: var(--color-accent);
    flex-shrink: 0;
  }
  .toc-link {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--color-text-dim);
    text-decoration: none;
    transition: color 0.15s;
    line-height: 1.5;
  }
  .toc-link:hover { color: var(--color-accent); }
</style>
