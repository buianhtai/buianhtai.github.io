.drx-inspector-head span{margin-left:auto;color:var(--drx-dim);font-variant-numeric:tabular-nums}
.drx-detail{min-width:0;flex:1;padding-top:1rem}
.drx-detail-id{font:700 .63rem var(--font-mono,monospace);color:var(--drx-accent);letter-spacing:.03em}
.drx-detail h4{color:var(--drx-ink)!important;line-height:1.32!important;font-size:1.18rem!important;margin:.65rem 0 1rem!important}
.drx-endpoints{display:grid;grid-template-columns:minmax(0,1fr) 20px minmax(0,1fr);align-items:center;gap:.6rem;border:1px solid var(--drx-line);border-radius:9px;padding:.65rem;background:var(--drx-bg)}
.drx-endpoints>div{min-width:0}.drx-endpoints small{display:block;color:var(--drx-dim);font:600 .58rem var(--font-mono,monospace);margin-bottom:.3rem}
.drx-endpoints strong{font-size:.72rem;line-height:1.35;color:var(--drx-ink);overflow-wrap:anywhere}.drx-endpoints svg{color:var(--drx-accent)}
.drx-field{padding:.8rem 0;border-bottom:1px solid var(--drx-line)}
.drx-field>span{display:flex;align-items:center;gap:.35rem;font:750 .63rem var(--font-mono,monospace);color:var(--drx-accent)}
.drx-field p{font-size:.75rem;line-height:1.65;color:var(--drx-ink);margin:.38rem 0 0;overflow-wrap:anywhere}
.drx-storage{display:flex;align-items:flex-start;gap:.45rem;margin:.95rem 0;border:1px solid color-mix(in srgb,var(--drx-orange) 32%,var(--drx-line));border-radius:7px;background:var(--drx-bg);padding:.65rem;font-size:.69rem;line-height:1.55;color:var(--drx-dim)}
.drx-storage svg{flex-shrink:0;color:var(--drx-orange)}
.drx-code-link{display:flex;align-items:center;gap:.4rem;color:var(--drx-accent)!important;font:700 .72rem var(--font-mono,monospace);text-decoration:none!important;padding:.45rem 0}
.drx-code-link:hover{text-decoration:underline!important}
.drx-path{font:500 .6rem/1.5 var(--font-mono,monospace);color:var(--drx-dim);overflow-wrap:anywhere;display:block}
.drx-nav{display:flex;gap:.6rem;margin-top:auto;padding-top:1.1rem}
.drx-nav button{display:flex;flex:1;justify-content:center;align-items:center;gap:.35rem;border:1px solid var(--drx-line);border-radius:7px;padding:.65rem .45rem;font:700 .7rem var(--font-mono,monospace);background:var(--drx-card);color:var(--drx-ink);cursor:pointer}
.drx-nav button:hover:not(:disabled){border-color:var(--drx-accent)}.drx-nav button:disabled{opacity:.35;cursor:default}
.drx-lower{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.6rem;padding:.85rem;border-top:1px solid var(--drx-line)}
.drx-lower>div{display:grid;grid-template-columns:20px minmax(0,1fr);align-content:start;column-gap:.6rem;row-gap:.25rem;border:1px solid var(--drx-line);padding:.7rem;border-radius:8px}
.drx-lower svg{color:var(--drx-accent);grid-row:span 2}.drx-lower strong{font-size:.72rem;color:var(--drx-ink)}.drx-lower span{font-size:.68rem;line-height:1.6;color:var(--drx-dim)}
.drx-footer{padding:.8rem 1rem;border-top:1px solid var(--drx-line);color:var(--drx-dim);font:.62rem/1.65 var(--font-mono,monospace)}
.drx-footer a{color:var(--drx-accent)!important;text-decoration:underline}
:global(html.theme-light) .drx{--drx-bg:#f7fbff;--drx-surface:#edf5fb;--drx-card:#ffffff;--drx-ink:#182c44;--drx-dim:#536b80;--drx-line:#d2e0ec;--drx-accent:#087873;--drx-selected:#dcefeb;--drx-blue:#246aab;--drx-orange:#af722c;--drx-green:#147c67;--drx-purple:#7762b9;--drx-pink:#ae476a;box-shadow:0 15px 36px #1b39531c}
:global(html.theme-light) .drx-heading{background:radial-gradient(ellipse at top left,#cfeae55c,transparent 65%),var(--drx-bg)}
@media(max-width:1100px){.drx-main{grid-template-columns:minmax(0,1fr)}.drx-map{border-right:0;border-bottom:1px solid var(--drx-line)}.drx-inspector{padding:.95rem}.drx-detail{flex:none}.drx-scenarios{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:540px){.drx-heading{padding:1rem}.drx-tab{padding:.5rem}.drx-tab strong{font-size:.69rem}.drx-tab small{font-size:.53rem}.drx-scenarios{gap:.25rem;padding:.45rem}.drx-scenario-overview{padding:.75rem}.drx-lower{grid-template-columns:minmax(0,1fr)}.drx-map-toolbar{font-size:.55rem}}
@media(prefers-reduced-motion:reduce){.drx *{scroll-behavior:auto!important}}
</style>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-drx-root]')) {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-drx-tab]')];
    const views = [...root.querySelectorAll<HTMLElement>('[data-drx-view]')];
    const overview = [...root.querySelectorAll<HTMLElement>('[data-drx-overview]')];
    const detailPanels = [...root.querySelectorAll<HTMLElement>('[data-drx-detail]')];
    const prev = root.querySelector<HTMLButtonElement>('[data-drx-prev]');
    const next = root.querySelector<HTMLButtonElement>('[data-drx-next]');
    const count = root.querySelector<HTMLElement>('[data-drx-count]');
    if (!tabs.length || !prev || !next || !count) continue;
    let scenario = tabs[0].dataset.drxTab || 'chat';
    let selected = 0;
    let focusedLane: string | null = null;
    function activate(index: number) {
      const view = views.find(x => x.dataset.drxView === scenario);
      if (!view) return;
      const arrows = [...view.querySelectorAll<HTMLButtonElement>('[data-drx-step]')];
      selected = Math.max(0, Math.min(arrows.length - 1, index));
      arrows.forEach((button,i) => {
        const current = i === selected;
        button.classList.toggle('is-current', current);
        button.setAttribute('aria-pressed', String(current));
      });
      detailPanels.forEach(panel => { panel.hidden = panel.dataset.drxDetail !== scenario+'-'+selected; });
      count.textContent = String(selected+1).padStart(2,'0')+' / '+String(arrows.length).padStart(2,'0');
      // Keep the currently selected protocol hop visible inside the diagram
      // scroller. Never scroll the entire blog horizontally on mobile.
      const scroll = view.querySelector<HTMLElement>('.drx-scroll');
      const wire = arrows[selected]?.querySelector<HTMLElement>('.drx-wire');
      if (scroll && wire) {
        const box = wire.getBoundingClientRect();
        const frame = scroll.getBoundingClientRect();
        const center = (box.left + box.width / 2) - frame.left + scroll.scrollLeft;
        scroll.scrollLeft = Math.max(0, center - scroll.clientWidth / 2);
      }
      prev.disabled = selected === 0;
      next.disabled = selected === arrows.length - 1;
    }
    function updateFocus() {
      const view = views.find(x => x.dataset.drxView === scenario);
      if (!view) return;
      view.querySelectorAll<HTMLButtonElement>('[data-drx-lane]').forEach(button => {
        const yes = button.dataset.drxLane === focusedLane;
        button.classList.toggle('is-focused', yes);
        button.setAttribute('aria-pressed', String(yes));
      });
      view.querySelectorAll<HTMLElement>('[data-drx-step]').forEach(row => {
        const related = row.dataset.drxFrom === focusedLane || row.dataset.drxTo === focusedLane;
        row.classList.toggle('is-muted', !!focusedLane && !related);
      });
    }
    tabs.forEach(button => button.addEventListener('click', () => {
      scenario = button.dataset.drxTab || 'chat';
      selected = 0;
      focusedLane = null;
      tabs.forEach(tab => {
        const active = tab === button;
        tab.classList.toggle('is-current', active);
        tab.setAttribute('aria-pressed', String(active));
      });
      views.forEach(view => { view.hidden = view.dataset.drxView !== scenario; });
      overview.forEach(item => { item.hidden = item.dataset.drxOverview !== scenario; });
      activate(0);
      updateFocus();
    }));
    for (const view of views) {
      view.querySelectorAll<HTMLButtonElement>('[data-drx-step]').forEach(button => {
        button.addEventListener('click', () => activate(Number(button.dataset.drxStep)));
      });
      view.querySelectorAll<HTMLButtonElement>('[data-drx-lane]').forEach(button => {
        button.addEventListener('click', () => {
          const lane = button.dataset.drxLane || null;
          focusedLane = focusedLane === lane ? null : lane;
          updateFocus();
        });
      });
    }
    prev.addEventListener('click', () => activate(selected - 1));
    next.addEventListener('click', () => activate(selected + 1));
    activate(0);
  }
</script>
