---
/**
 * Interactive Agno / AgentOS reference architecture and illustrative
 * execution trace. Source files were inspected at revision
 * agno-agi/agno@1f2aac51eb28dc9c0970836d3b7ae046bae81bbb.
 */
const revision = '1f2aac51eb28dc9c0970836d3b7ae046bae81bbb';
---
<section class="al" id="agno-lab" aria-labelledby="agno-lab-heading">
  <header class="al-header">
    <div><p class="al-kicker">INTERACTIVE ARCHITECTURE LAB / AGNO</p><h3 id="agno-lab-heading">Explore the platform from request to runtime</h3><p>Architecture boundaries, run lifecycle, protocols, and verified source-code entry points.</p></div>
    <span class="al-revision" title="Upstream repository revision">SOURCE · {revision.slice(0, 8)}</span>
  </header>

  <div class="al-bar" role="tablist" aria-label="Explorer views">
    <button type="button" data-view="architecture" role="tab" aria-selected="true">01 / Architecture</button>
    <button type="button" data-view="execution" role="tab" aria-selected="false">02 / Request lifecycle</button>
    <button type="button" data-view="code" role="tab" aria-selected="false">03 / Code map</button>
  </div>

  <div class="al-scenario" aria-label="Illustrative request scenarios">
    <span class="al-mini-label">TRACE SCENARIO</span>
    <div class="al-scenario-buttons" role="group" aria-label="Choose a request">
      <button type="button" data-scenario="direct" aria-pressed="true">Direct answer</button>
      <button type="button" data-scenario="tools" aria-pressed="false">Tool loop</button>
      <button type="button" data-scenario="team" aria-pressed="false">Team delegation</button>
      <button type="button" data-scenario="failure" aria-pressed="false">Failure &amp; recovery</button>
    </div>
  </div>

  <div class="al-view" data-pane="architecture">
    <div class="al-grid">
      <div class="al-diagram">
        <div class="al-panel-top"><span>CONTAINER &amp; EXECUTION BOUNDARIES</span><span>SELECT A NODE · SCROLL ON MOBILE</span></div>
        <div class="al-canvas" tabindex="0" aria-label="Scrollable interactive architecture diagram">
          <svg id="al-svg" viewBox="0 0 970 472" aria-label="AgentOS architecture with clients, runtime, execution objects, and dependencies" role="group">
            <defs><marker id="al-arrow" orient="auto" markerWidth="8" markerHeight="8" refX="6" refY="3"><path d="M0 0L6 3L0 6" fill="none" stroke="currentColor" stroke-width="1.2"/></marker></defs>
            <g id="al-back"></g><g id="al-edges"></g><g id="al-nodes"></g>
          </svg>
        </div>
        <div class="al-legend"><span><i class="al-dot al-api"></i>API / control</span><span><i class="al-dot al-exec"></i>Execution</span><span><i class="al-dot al-state"></i>Storage</span><span><i class="al-dot al-external"></i>External</span></div>
      </div>
      <aside class="al-inspector" aria-live="polite">
        <p class="al-mini-label">COMPONENT INSPECTOR</p>
        <h4 id="al-selected-title">AgentOS API</h4>
        <p id="al-selected-desc">FastAPI entry point for registered agents, teams, and workflows.</p>
        <dl><dt>Engineering boundary</dt><dd id="al-selected-why">The API handles request transport; application policy must still guard tools.</dd><dt>Underlying source</dt><dd id="al-selected-path">os/app.py</dd></dl>
        <a id="al-selected-link" href="https://github.com/agno-agi/agno" target="_blank" rel="noopener noreferrer">Inspect implementation ↗</a>
      </aside>
    </div>
  </div>

  <div class="al-view" data-pane="execution" hidden>
    <div class="al-execution-grid">
      <div class="al-diagram">
        <div class="al-panel-top"><span>PHYSICAL REQUEST / EVENT PATH</span><span>SELECT A STEP BELOW</span></div>
        <div class="al-canvas" tabindex="0" aria-label="Scrollable request execution topology">
          <svg id="al-svg-exec" viewBox="0 0 970 472" role="group" aria-label="Highlighted runtime execution path">
            <defs><marker id="al-arrow-exec" orient="auto" markerWidth="8" markerHeight="8" refX="6" refY="3"><path d="M0 0L6 3L0 6" fill="none" stroke="currentColor" stroke-width="1.2"/></marker></defs>
            <g id="al-back-exec"></g><g id="al-edges-exec"></g><g id="al-nodes-exec"></g>
          </svg>
        </div>
      </div>
      <aside class="al-inspector al-side-trace" aria-live="polite"><p class="al-mini-label">CURRENT STEP</p><h4 id="al-step-title">01 / HTTP request</h4><span class="al-protocol" id="al-protocol">HTTPS</span><p id="al-step-desc"></p><p class="al-mini-label">WHY THIS EXISTS</p><p id="al-step-why"></p><a id="al-step-source" target="_blank" rel="noopener noreferrer" href="https://github.com/agno-agi/agno">Open supporting source ↗</a></aside>
    </div>
  </div>

  <div class="al-view" data-pane="code" hidden>
    <div class="al-code-grid">
      <div class="al-file-list" id="al-files" aria-label="Verified source files"></div>
      <section class="al-file-detail" aria-live="polite">
        <p class="al-mini-label">SOURCE CLASS / MODULE</p>
        <h4 id="al-file-title">AgentOS runtime</h4>
        <p id="al-file-desc"></p>
        <pre id="al-file-snippet"></pre>
        <a id="al-file-link" href="https://github.com/agno-agi/agno" target="_blank" rel="noopener noreferrer">Read source on GitHub ↗</a>
      </section>
    </div>
    <p class="al-note">Code fragments are explanatory pseudocode, not verbatim excerpts. File paths are verified against the linked revision.</p>
  </div>

  <div class="al-timeline">
    <div class="al-timeline-head"><div><p class="al-mini-label">EXECUTION SCRUBBER</p><strong id="al-scenario-heading">Direct answer — one model call</strong></div><div class="al-timeline-actions"><button type="button" id="al-prev" aria-label="Previous step">←</button><span id="al-counter" aria-live="polite">01 / 06</span><button type="button" id="al-next" aria-label="Next step">→</button><button type="button" id="al-play" aria-pressed="false">▶ Play</button></div></div>
    <input id="al-range" type="range" min="0" max="5" value="0" step="1" aria-label="Scrub execution timeline"/>
    <div class="al-step-list" id="al-step-list" aria-label="Execution steps"></div>
    <div class="al-event"><div><span class="al-mini-label">PROTOCOL / EVENT</span><p id="al-event-description">Select a step to inspect the execution transition.</p></div><pre id="al-event-code"></pre></div>
  </div>
  <noscript><p class="al-disclaimer">Enable JavaScript to use the interactive architecture and execution inspector. The full article remains readable without scripts.</p></noscript>
  <p class="al-disclaimer"><strong>How to read this:</strong> each scenario is an explanatory model, not a captured trace. SSE streaming may overlap execution and persistence; the step numbers are narrative checkpoints, not a guarantee of serialization. Durable recovery depends on explicit runtime and queue configuration.</p>
</section>

<style is:global>
