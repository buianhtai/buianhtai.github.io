nt;background:none;color:var(--al-muted);padding:11px 10px;border-radius:7px;cursor:pointer;font-size:.74rem;overflow-wrap:anywhere}.al-file-list button[aria-pressed=true]{border-color:var(--al-accent);background:var(--al-panel);color:var(--al-text)}.al-file-list button span{display:block;color:var(--al-accent);font:.65rem ui-monospace,monospace;margin-bottom:5px}.al-file-detail{padding:18px;display:flex;flex-direction:column;align-items:start;gap:12px;min-height:310px}.al-file-detail pre{width:100%}.al-note{padding:10px 0 0!important}.al-side-trace{min-height:310px}
