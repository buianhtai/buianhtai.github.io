<script is:inline>
(function () {
  const root = document.getElementById('agno-lab');
  if (!root || root.dataset.hydrated === '1') return;
  root.dataset.hydrated = '1';
  const $ = id => root.querySelector('#' + id);
  const sha = '1f2aac51eb28dc9c0970836d3b7ae046bae81bbb';
  const base = 'https://github.com/agno-agi/agno/blob/' + sha + '/libs/agno/agno/';
  const files = [
    {id:'os',name:'AgentOS API / FastAPI',path:'os/app.py',desc:'AgentOS assembles the application, registered execution objects and API surface. It is the transport/service boundary.',code:'agent_os = AgentOS(agents=[agent], db=db)\napp = agent_os.get_app()\nagent_os.serve(app=app)'},
    {id:'agent',name:'Agent executor',path:'agent/agent.py',desc:'Agent implementation defines execution behavior, model integration, tool lifecycle, session context and streaming options.',code:'agent = Agent(model=..., tools=[...], db=db)\nresult = await agent.arun(message, stream=True)'},
    {id:'run',name:'Run event contracts',path:'run/agent.py',desc:'Structured event types and run state, including RunStarted, RunContent, ToolCallStarted and RunCompleted.',code:'RunStartedEvent\nToolCallStartedEvent / ToolCallCompletedEvent\nRunContentEvent\nRunCompletedEvent'},
    {id:'team',name:'Team orchestration',path:'team/team.py',desc:'Coordinates agents under a team execution model; dynamic delegation differs from an explicitly sequenced workflow.',code:'team = Team(members=[researcher, writer], ...)\n# Team owns delegation and response synthesis.'},
    {id:'workflow',name:'Workflow orchestration',path:'workflow/workflow.py',desc:'Provides explicitly structured sequencing for components and functions; most suitable when the operation order matters.',code:'workflow = Workflow(steps=[...])\n# Deterministic structure; agent calls where useful.'},
    {id:'tool',name:'Tool execution contract',path:'tools/function.py',desc:'Describes callable tool functions and invocation metadata. Business permissions still belong at trusted tool boundaries.',code:'def lookup_record(record_id: str):\n    return approved_read_only_service(record_id)'},
    {id:'db',name:'Persistence interface',path:'db/base.py',desc:'Storage interface for persisted application data. Persistence configuration, retention and deployment semantics remain important.',code:'db = SqliteDb(db_file="agent.db")\n# Production: assess Postgres, retention and backup.'}
  ];
  const nodes = [
    {id:'client',name:'Client / Web UI',sub:'HTTP + SSE consumer',x:26,y:95,w:188,h:60,type:'api',desc:'The browser or SDK submits run requests and consumes responses and events.',why:'Presentation owns interaction state, not permission checks or authoritative execution.',file:'os'},
    {id:'control',name:'Control Plane',sub:'Inspect + operate',x:26,y:289,w:188,h:60,type:'api',desc:'Operational UI used to inspect runs and sessions and manage the deployed runtime.',why:'The management interface is not an obligatory middle hop for each model request.',file:'os'},
    {id:'api',name:'AgentOS API',sub:'FastAPI / REST / SSE',x:252,y:95,w:199,h:60,type:'api',desc:'Network-facing API for registered agents, teams, and workflows.',why:'Transport, configured auth and run dispatch are separate from reasoning and tool authorization.',file:'os'},
    {id:'registry',name:'Run dispatch',sub:'Agent / Team / Workflow',x:252,y:289,w:199,h:60,type:'api',desc:'Invocation selects an explicitly registered component and prepares the requested run.',why:'A general semantic router between arbitrary agents is not implied by selecting a registered endpoint.',file:'os'},
    {id:'agent',name:'Agent',sub:'Model + tools + context',x:489,y:95,w:188,h:60,type:'exec',desc:'A model-driven unit of execution using configured instructions, state and tools.',why:'The model may choose to call a tool; application code runs it under trusted controls.',file:'agent'},
    {id:'team',name:'Team',sub:'Specialist delegation',x:489,y:217,w:188,h:60,type:'exec',desc:'Coordinates multiple agents according to the configured team execution mode.',why:'Delegation adds cost and latency; use a team only if specialization helps.',file:'team'},
    {id:'workflow',name:'Workflow',sub:'Explicit execution order',x:489,y:340,w:188,h:60,type:'exec',desc:'Predefined control flow combining steps, agents and functions.',why:'Use code for deterministic steps rather than asking an LLM to rediscover a known order.',file:'workflow'},
    {id:'model',name:'Model provider',sub:'LLM inference',x:716,y:64,w:224,h:60,type:'external',desc:'External or hosted model endpoint providing inference and possible tool requests.',why:'Budget model requests, context tokens and provider rate limits separately.',file:'agent'},
    {id:'tools',name:'Tool / MCP adapter',sub:'Validated side effects',x:716,y:217,w:224,h:60,type:'external',desc:'Invokes registered Python functions or integrations, including external APIs and MCP.',why:'A tool request is not permission to act. Authorize, validate, isolate and audit.',file:'tool'},
    {id:'db',name:'Storage & traces',sub:'Runs / sessions / memory',x:716,y:371,w:224,h:60,type:'state',desc:'Configured persistent state and telemetry for run sessions and supporting data.',why:'Data persistence alone does not guarantee crash-safe execution recovery.',file:'db'}
  ];
  const edgeDefs = [['client','api'],['control','api'],['api','registry'],['registry','agent'],['registry','team'],['registry','workflow'],['agent','model'],['model','agent'],['agent','tools'],['tools','agent'],['agent','db'],['team','agent'],['workflow','agent'],['registry','db'],['api','client'],['agent','team'],['db','agent']];
  const S = (title,from,to,proto,desc,why,code,file) => ({title,from,to,proto,desc,why,code,file});
  const scenarios = {
    direct:{title:'Direct answer — one model call',steps:[
      S('HTTP request','client','api','HTTPS','Client submits a request to a registered AgentOS endpoint.','The client should never need direct access to the model credentials.','POST /agents/{agent_id}/runs\nstream=true','os'),
      S('Dispatch','api','registry','IN-PROC','The API validates the request and resolves the chosen execution component.','An endpoint selects a known agent; model-driven routing is a different design choice.','AgentOS(agents=[agent])\nresolve registered agent','os'),
      S('Load context','registry','db','DB','Configured session and history can be loaded before inference.','Session context, durable work state and traces have different lifecycles.','session_id → configured database','db'),
      S('Invoke agent','registry','agent','PYTHON','The registered Agent begins its run.','Framework abstraction separates invocation from transport.','Agent.run(...) / Agent.arun(...)','agent'),
      S('Model response','agent','model','HTTPS','The model produces a direct response without selecting a tool.','Tool execution is optional; not every request needs a tool loop.','Model request + configured context','agent'),
      S('Stream result','api','client','SSE','Incremental run output or a final response reaches the client.','Streaming can occur during model inference, not only when the run has finished.','RunContent / RunCompleted','run')]},
    tools:{title:'Tool loop — model, tool, continuation',steps:[
      S('Receive request','client','api','HTTPS','The client invokes a registered agent through AgentOS.','A run ID links subsequent events.','POST /agents/{agent_id}/runs','os'),
      S('Start agent','registry','agent','PYTHON','Execution constructs the model context and exposes approved tool schemas.','Only tools permitted by the application should be available.','Agent(model=..., tools=[...])','agent'),
      S('Model chooses','agent','model','HTTPS','The model returns a tool request rather than a final answer.','A model selecting a tool is not itself executing the tool.','ToolCallStarted event','run'),
      S('Tool invoked','agent','tools','PYTHON / HTTP','Application logic validates arguments and invokes a registered tool.','Enforce user scope, rate limits and idempotency at the tool boundary.','validated_tool(arguments)','tool'),
      S('Result returned','tools','agent','RESULT','The tool returns an observation to the agent loop.','Failures and unknown side-effect outcomes require explicit policies.','ToolCallCompleted / ToolCallError','run'),
      S('Model continues','agent','model','HTTPS','The agent may call the model again using the tool output.','One user request can involve multiple billable model calls.','context + tool result → model','agent'),
      S('Emit response','api','client','SSE','Content and terminal run events reach the client as configured.','The client must understand terminal, error and cancellation states.','RunContent → RunCompleted','run')]},
    team:{title:'Team delegation — leader and specialists',steps:[
      S('Submit request','client','api','HTTPS','A client invokes a registered Team endpoint.','A team is a runnable component rather than a new network service.','POST /teams/{team_id}/runs','os'),
      S('Select Team','registry','team','PYTHON','Execution enters the configured team behavior.','Coordination/routing models can add latency and token use.','Team(members=[...])','team'),
      S('Delegate','team','agent','PYTHON','A team hands relevant work to a member agent.','Member calls should inherit appropriate context and authorization.','team member execution','team'),
      S('Specialist inference','agent','model','HTTPS','The member agent handles its specialty with a model call.','Multiple specialists need not run if one agent can solve the request.','member → model inference','agent'),
      S('Collect outcome','agent','team','RESULT','The coordinator receives member output for synthesis or further delegation.','The team owns the aggregate response, not the client.','member output → team result','team'),
      S('Deliver answer','api','client','SSE','Results are returned through the runtime API.','The control plane is not on this request path.','run events → client','run')]},
    failure:{title:'Failure & recovery — side-effect ambiguity',steps:[
      S('Run admitted','client','api','HTTPS','The client starts an operation expected to involve an external write.','Write-capable tools require stronger guarantees than pure Q&A.','POST /agents/{id}/runs','os'),
      S('Record execution','registry','db','DB','Configured persistence records run state.','Durable queues/checkpoints must be enabled and evaluated separately.','run_id + state (+ queue if enabled)','db'),
      S('Invoke external tool','agent','tools','HTTP','A tool sends a write request to an external service.','Use idempotency keys and scoped credentials.','POST /external/resource\nIdempotency-Key: run:tool','tool'),
      S('Response lost','tools','agent','TIMEOUT','The downstream write might have committed while the response was lost.','Blind retry can duplicate business effects.','status = OUTCOME_UNKNOWN\n# application-level classification','tool'),
      S('Reconcile outcome','agent','db','DB','A recovery design should persist intent and reconcile with the external system.','Framework retries do not guarantee exactly-once side effects.','lookup(idempotency_key)\nreconcile before retry','db'),
      S('Report final state','api','client','SSE','The application surfaces resolved outcome or escalates the ambiguity.','Never report success simply because a request was retried.','RunError / terminal status','run')]}
  };
  const svgNS = 'http://www.w3.org/2000/svg';
  const colors = {api:'#499fea',exec:'#24a890',state:'#8c78d6',external:'#df9b56'};
  let scenario='direct',step=0,selected='api',file='os',view='architecture',timer=null;
  function setText(id,text){const el=$(id);if(el)el.textContent=text;}
  function sourceLink(id){const f=files.find(x=>x.id===id)||files[0];return base+f.path;}
  function createSvg(name,attrs,text){const el=document.createElementNS(svgNS,name);Object.entries(attrs||{}).forEach(([key,value])=>el.setAttribute(key,String(value)));if(text!==undefined)el.textContent=text;return el;}
  function findNode(id){return nodes.find(n=>n.id===id)||nodes[0];}
  function edgePath(a,b){const u=findNode(a),v=findNode(b);let x1=u.x+u.w/2,y1=u.y+u.h/2,x2=v.x+v.w/2,y2=v.y+v.h/2;
    if(u.x+u.w+5<v.x){x1=u.x+u.w;x2=v.x;}
    else if(v.x+v.w+5<u.x){x1=u.x;x2=v.x+v.w;}
    else if(y1<y2){y1=u.y+u.h;y2=v.y;}
    else{y1=u.y;y2=v.y+v.h;}
    return 'M'+x1+' '+y1+' C'+(x1+(x2-x1)*.52)+' '+y1+' '+(x2-(x2-x1)*.52)+' '+y2+' '+x2+' '+y2;
  }
  function renderMap(prefix){
    const back=$('al-back'+prefix), edges=$('al-edges'+prefix), layer=$('al-nodes'+prefix);
    back.replaceChildren();edges.replaceChildren();layer.replaceChildren();
    [{x:12,w:215,label:'CLIENT / CONTROL'},{x:238,w:227,label:'AGENTOS RUNTIME'},{x:475,w:219,label:'EXECUTION'},{x:704,w:253,label:'DEPENDENCIES'}].forEach(o=>{
      back.append(createSvg('rect',{x:o.x,y:13,width:o.w,height:444,rx:13,class:'al-boundary'}));
      back.append(createSvg('text',{x:o.x+11,y:37,class:'al-region'},o.label));
    });
    const current=scenarios[scenario].steps[step];
    edgeDefs.forEach(([a,b])=>{
      const active=current.from===a&&current.to===b;
      const p=createSvg('path',{d:edgePath(a,b),class:'al-edge'+(active?' al-active':''),'marker-end':'url(#al-arrow'+(prefix?'-exec':'')+')'});
      edges.append(p);
    });
    nodes.forEach(n=>{
      const active=selected===n.id;
      const group=createSvg('g',{class:'al-node'+(active?' al-selected':''),role:'button',tabindex:0,'aria-label':'Inspect '+n.name});
      const rect=createSvg('rect',{x:n.x,y:n.y,width:n.w,height:n.h,rx:9,fill:colors[n.type],'fill-opacity':active ? 0.20 : 0.11,stroke:colors[n.type],'stroke-width':active?2.8:1.2});
      group.append(rect,createSvg('rect',{x:n.x+2,y:n.y+9,width:3,height:n.h-18,rx:1.5,fill:colors[n.type]}),createSvg('text',{x:n.x+14,y:n.y+25,class:'al-node-title'},n.name),createSvg('text',{x:n.x+14,y:n.y+44,class:'al-node-sub'},n.sub));
      group.addEventListener('click',()=>{selected=n.id;renderAll();});
      group.addEventListener('keydown',e=>{if(e.key==='Enter'||e.key===' '){e.preventDefault();selected=n.id;renderAll();}});
      layer.append(group);
    });
  }
  function renderFile(){
    const f=files.find(x=>x.id===file)||files[0];
    setText('al-file-title',f.name);setText('al-file-desc',f.desc);setText('al-file-snippet',f.code);$('al-file-link').href=sourceLink(f.id);
    $('al-files').replaceChildren();
    files.forEach(it=>{const b=document.createElement('button');b.type='button';b.setAttribute('aria-pressed',String(it.id===file));const kicker=document.createElement('span');kicker.textContent=it.name;b.append(kicker,document.createTextNode(it.path));b.addEventListener('click',()=>{file=it.id;renderFile()});$('al-files').append(b);});
  }
  function renderAll(){
    root.querySelectorAll('[data-view]').forEach(b=>b.setAttribute('aria-selected',String(b.dataset.view===view)));
    root.querySelectorAll('[data-pane]').forEach(p=>p.hidden=p.dataset.pane!==view);
    root.querySelectorAll('[data-scenario]').forEach(b=>b.setAttribute('aria-pressed',String(b.dataset.scenario===scenario)));
    renderMap('');renderMap('-exec');
    const n=findNode(selected),s=scenarios[scenario],current=s.steps[step];
    setText('al-selected-title',n.name);setText('al-selected-desc',n.desc);setText('al-selected-why',n.why);
    setText('al-selected-path',files.find(f=>f.id===n.file).path);$('al-selected-link').href=sourceLink(n.file);
    setText('al-scenario-heading',s.title);setText('al-counter',String(step+1).padStart(2,'0')+' / '+String(s.steps.length).padStart(2,'0'));
    $('al-range').max=String(s.steps.length-1);$('al-range').value=String(step);
    setText('al-step-title',String(step+1).padStart(2,'0')+' / '+current.title);
    setText('al-protocol',current.proto);setText('al-step-desc',current.desc);setText('al-step-why',current.why);
    $('al-step-source').href=sourceLink(current.file);
    setText('al-event-description',current.desc+' '+current.why);setText('al-event-code',current.code);
    const row=$('al-step-list');row.replaceChildren();
    s.steps.forEach((e,i)=>{const b=document.createElement('button');b.type='button';b.setAttribute('aria-pressed',String(i===step));b.innerHTML='<span>'+String(i+1).padStart(2,'0')+' · '+e.proto.replace(/&/g,'&amp;').replace(/</g,'&lt;')+'</span><strong>'+e.title.replace(/&/g,'&amp;').replace(/</g,'&lt;')+'</strong>';b.addEventListener('click',()=>{step=i;renderAll();});row.append(b);});
    const activeStep=row.children[step];if(activeStep&&view==='execution')activeStep.scrollIntoView({block:'nearest',inline:'nearest'});
    renderFile();
  }
  function advance(delta){const max=scenarios[scenario].steps.length;step=(step+delta+max)%max;selected=scenarios[scenario].steps[step].to;renderAll();}
  function pause(){if(timer!==null){clearInterval(timer);timer=null;}$('al-play').textContent='▶ Play';$('al-play').setAttribute('aria-pressed','false');}
  root.querySelectorAll('[data-view]').forEach(b=>b.addEventListener('click',()=>{view=b.dataset.view;renderAll();}));
  root.querySelectorAll('[data-scenario]').forEach(b=>b.addEventListener('click',()=>{pause();scenario=b.dataset.scenario;step=0;selected=scenarios[scenario].steps[0].to;view='execution';renderAll();}));
  $('al-next').addEventListener('click',()=>{pause();advance(1);});
  $('al-prev').addEventListener('click',()=>{pause();advance(-1);});
  $('al-play').addEventListener('click',()=>{if(timer!==null){pause();return;}view='execution';$('al-play').textContent='Ⅱ Pause';$('al-play').setAttribute('aria-pressed','true');timer=setInterval(()=>advance(1),1850);renderAll();});
  $('al-range').addEventListener('input',e=>{pause();step=Number(e.target.value);selected=scenarios[scenario].steps[step].to;view='execution';renderAll();});
  $('al-range').addEventListener('keydown',e=>{if(e.key==='Home'){step=0;renderAll();}if(e.key==='End'){step=scenarios[scenario].steps.length-1;renderAll();}});
  $('al-step-list').addEventListener('keydown',e=>{if(e.key==='ArrowRight'){advance(1);}if(e.key==='ArrowLeft'){advance(-1);}});
  let gestureX=null;$('al-step-list').addEventListener('pointerdown',e=>{gestureX=e.clientX});$('al-step-list').addEventListener('pointerup',e=>{if(gestureX!==null&&Math.abs(gestureX-e.clientX)>90)advance(e.clientX<gestureX?1:-1);gestureX=null});
  window.addEventListener('pagehide',pause,{once:true});
  renderAll();
})();
</script>