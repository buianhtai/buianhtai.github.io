---
/**
 * DiagramEmbed — Responsive archify diagram embed.
 *
 * ≥640px: interactive iframe with pan/zoom/export
 * <640px: tappable card linking to the standalone diagram page
 *
 * Usage:
 *   <DiagramEmbed
 *     src="/diagrams/deepagents-middleware-stack.html"
 *     title="DeepAgents Middleware Stack"
 *     height={540}
 *   />
 */
interface Props {
  src?: string;
  svg?: string;
  drawio?: string;
  d2?: string;
  title: string;
  eyebrow?: string;
  description?: string;
  caption?: string;
  height?: number;
}
const { src, svg, drawio, d2, title, eyebrow, description, caption, height = 500 } = Astro.props;
const embedSrc = src ? src + (src.includes('?') ? '&' : '?') + 'embed=1' : '';
---

{svg ? (
  <figure class="de-drawing not-prose" aria-label={title}>
    <header class="de-drawing-head">
      {eyebrow && <div class="de-drawing-kicker">{eyebrow}</div>}
      <h3>{title}</h3>
      {description && <p>{description}</p>}
    </header>
    <div class="de-drawing-toolbar">
      <div class="de-drawing-zoom" role="group" aria-label={'Zoom controls: ' + title}>
        <button type="button" data-diagram-zoom="out" aria-label="Zoom out" disabled>−</button>
        <output class="de-drawing-zoom-level" aria-live="polite">100%</output>
        <button type="button" data-diagram-zoom="in" aria-label="Zoom in">+</button>
        <button type="button" data-diagram-zoom="fit" class="de-drawing-fit" aria-label="Fit diagram to available width">Fit</button>
      </div>
      <div class="de-drawing-actions">
        <a href={svg} target="_blank" rel="noopener">Open full-size SVG ↗</a>
        {d2 && <a href={d2} download>D2 source ↓</a>}
        {drawio && <a href={drawio} download>Editable .drawio ↓</a>}
      </div>
    </div>
    <div class="de-drawing-viewport" tabindex="0" role="region" aria-label={'Scrollable diagram: ' + title}>
      <img src={svg} alt={description || title} loading="lazy" decoding="async" draggable="false" />
    </div>
    <div class="de-drawing-help">Fit shows the whole diagram. Zoom in for readable labels, then swipe or scroll to pan.</div>
    {(caption || drawio) && <figcaption class="de-drawing-caption">
      {caption && <span>{caption}</span>}
      {drawio && <span>Open the downloaded file in <a href="https://app.diagrams.net/" target="_blank" rel="noopener noreferrer">diagrams.net ↗</a> to edit individual shapes.</span>}
    </figcaption>}
  </figure>
) : (
<div class="de-wrap">
  <!-- Desktop: interactive iframe -->
  <div class="de-iframe-wrap">
    <iframe
      src={embedSrc}
      style={`width:100%;height:${height}px;border:none;display:block;`}
      title={title}
      loading="lazy"
    />
  </div>

  <!-- Mobile: tappable card -->
  <a href={src} target="_blank" rel="noopener" class="de-card" aria-label={`Open ${title} in full`}>
    <div class="de-card-icon">⬡</div>
    <div class="de-card-body">
      <span class="de-card-title">{title}</span>
      <span class="de-card-cta">Tap to open interactive diagram ↗</span>
    </div>
  </a>

  <p class="de-open-link">
    <a href={src} target="_blank" rel="noopener">Open full diagram ↗</a>
  </p>
</div>
)}

<style>
  .de-wrap { margin: 1.25rem 0; }

  /* Desktop: show iframe, hide card */
  .de-iframe-wrap { border-radius: 8px; overflow: hidden; }
  .de-card { display: none; }

  .de-open-link {
    text-align: right;
    font-size: 0.8rem;
    margin-top: 0.3rem;
    margin-bottom: 0;
  }
  .de-open-link a { color: var(--color-accent); }

  /* Mobile: hide iframe, show card */
  @media (max-width: 639px) {
    .de-iframe-wrap { display: none; }

    .de-card {
      display: flex;
      align-items: center;
      gap: 1rem;
      padding: 1.25rem;
      border: 1px solid var(--color-border);
      border-left: 3px solid var(--color-accent);
      background: var(--color-surface);
      border-radius: 8px;
      text-decoration: none;
      color: inherit;
      transition: background 0.15s;
    }
    .de-card:hover { background: var(--color-surface-2); }

    .de-card-icon {
      font-size: 2rem;
      color: var(--color-accent);
      flex-shrink: 0;
      line-height: 1;
    }

    .de-card-body {
      display: flex;
      flex-direction: column;
      gap: 0.25rem;
    }

    .de-card-title {
      font-family: var(--font-mono, monospace);
      font-size: 0.85rem;
      font-weight: 600;
      color: var(--color-text);
    }

    .de-card-cta {
      font-size: 0.75rem;
      color: var(--color-accent);
    }

    /* Hide the text link on mobile — card is the CTA */
    .de-open-link { display: none; }
  }
</style>

<style>
  .de-drawing {
    width: 100%;
    max-width: 100%;
    min-width: 0;
    box-sizing: border-box;
    margin: 1.9rem 0;
    border: 1px solid var(--color-border);
    border-radius: 14px;
    overflow: hidden;
    background: var(--color-surface);
    box-shadow: 0 16px 36px rgba(6, 22, 42, 0.08);
  }
  .de-drawing-head {
    padding: 1.15rem 1.35rem 1rem;
    background: linear-gradient(110deg, color-mix(in srgb, var(--color-accent) 7%, var(--color-surface)), var(--color-surface) 65%);
    border-bottom: 1px solid var(--color-border);
  }
  .de-drawing-kicker {
    font: 700 0.67rem/1.4 var(--font-mono, monospace);
    color: var(--color-accent);
    letter-spacing: 0.12em; text-transform: uppercase; margin-bottom: 0.4rem;
  }
  .de-drawing-head h3 { color: var(--color-text); font-size: 1.14rem; line-height: 1.4; margin: 0; font-weight: 730; }
  .de-drawing-head p { color: var(--color-text-dim); font-size: 0.82rem; line-height: 1.6; margin: 0.4rem 0 0; }
  .de-drawing-toolbar {
    display: flex; justify-content: space-between; align-items: center;
    flex-wrap: wrap; gap: 0.55rem 1rem;
    padding: 0.65rem 1.35rem;
    background: var(--color-surface-2);
    border-bottom: 1px solid var(--color-border);
  }
  .de-drawing-mode { font: 700 0.65rem/1.4 var(--font-mono, monospace); color: var(--color-text-muted); letter-spacing: 0.09em; }
  .de-drawing-actions { display: flex; gap: 0.5rem 1rem; flex-wrap: wrap; }
  .de-drawing-actions a { font: 600 0.71rem/1.4 var(--font-mono, monospace); color: var(--color-accent); text-decoration: none; }
  .de-drawing-actions a:hover { text-decoration: underline; }
  .de-drawing-actions a:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 4px; }
  .de-drawing-viewport {
    width: 100%; min-width: 0; max-width: 100%;
    box-sizing: border-box; overflow-x: auto; overflow-y: hidden;
    padding: 1rem; background: #f8fafc;
    overscroll-behavior-inline: contain;
    -webkit-overflow-scrolling: touch;
  }
  .de-drawing-viewport img {
    display: block; width: 100%; min-width: 0;
    max-width: none; height: auto; margin: 0;
    user-select: none; -webkit-user-drag: none;
  }
  .de-drawing-help {
    color: var(--color-text-muted);
    padding: 0.55rem 1.35rem;
    font: 400 0.68rem/1.5 var(--font-mono, monospace);
  }
  .de-drawing-zoom { display: flex; align-items: center; gap: 0.28rem; flex-wrap: nowrap; }
  .de-drawing-zoom button {
    color: var(--color-text); border: 1px solid var(--color-border);
    background: var(--color-surface); border-radius: 5px; min-width: 29px;
    min-height: 29px; padding: 0.25rem 0.4rem; font: 700 0.82rem var(--font-mono, monospace);
    cursor: pointer;
  }
  .de-drawing-zoom button:disabled { opacity: 0.35; cursor: default; }
  .de-drawing-zoom button:hover:not(:disabled) { color: var(--color-accent); border-color: var(--color-accent); }
  .de-drawing-zoom button:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 2px; }
  .de-drawing-zoom .de-drawing-fit { font-size: 0.71rem; min-width: 40px; }
  .de-drawing-zoom-level {
    color: var(--color-text-dim); min-width: 43px; text-align: center;
    font: 500 0.68rem var(--font-mono, monospace);
    font-variant-numeric: tabular-nums;
  }
  .de-drawing-caption {
    display: flex; flex-direction: column; gap: 0.35rem;
    padding: 0.75rem 1.35rem;
    border-top: 1px solid var(--color-border);
    color: var(--color-text-dim);
    font: 400 0.71rem/1.55 var(--font-mono, monospace);
  }
  .de-drawing-caption a { color: var(--color-accent); text-decoration: underline; }
  @media (max-width: 640px) {
    .de-drawing-head, .de-drawing-caption { padding: 0.95rem; }
    .de-drawing-toolbar { padding: 0.8rem 0.95rem; }
    .de-drawing-viewport { padding: 0.35rem; }
    .de-drawing-help { padding: 0.5rem 0.95rem; }
    .de-drawing-actions { gap: 0.6rem; }
    .de-drawing-actions a { overflow-wrap: anywhere; }
  }
</style>

<script>
  // Astro client-side behavior for D2 previews only. Other embed modes are not affected.
  for (const figure of document.querySelectorAll<HTMLElement>('.de-drawing')) {
    const viewport = figure.querySelector<HTMLElement>('.de-drawing-viewport');
    const image = figure.querySelector<HTMLImageElement>('.de-drawing-viewport img');
    const status = figure.querySelector<HTMLOutputElement>('.de-drawing-zoom-level');
    const zoomIn = figure.querySelector<HTMLButtonElement>('[data-diagram-zoom="in"]');
    const zoomOut = figure.querySelector<HTMLButtonElement>('[data-diagram-zoom="out"]');
    const fit = figure.querySelector<HTMLButtonElement>('[data-diagram-zoom="fit"]');
    if (!viewport || !image || !status || !zoomIn || !zoomOut || !fit) continue;

    let scale = 1;
    function setZoom(value: number) {
      const next = Math.min(5, Math.max(1, Math.round(value * 100) / 100));
      const oldCenter = viewport.scrollLeft + viewport.clientWidth / 2;
      const factor = next / scale;
      scale = next;
      image.style.width = (scale * 100) + '%';
      status.textContent = Math.round(scale * 100) + '%';
      zoomOut.disabled = scale <= 1;
      zoomIn.disabled = scale >= 5;
      requestAnimationFrame(() => {
        viewport.scrollLeft = Math.max(0, oldCenter * factor - viewport.clientWidth / 2);
      });
    }
    zoomIn.addEventListener('click', () => setZoom(scale * 1.6));
    zoomOut.addEventListener('click', () => setZoom(scale / 1.6));
    fit.addEventListener('click', () => setZoom(1));
  }
</script>
