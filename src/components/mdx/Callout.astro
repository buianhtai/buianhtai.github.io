---
interface Props {
  color?: string;
}
const { color = 'teal' } = Astro.props;

const icons: Record<string, string> = {
  teal: '▶', green: '✔', amber: '⚠', rose: '✖',
  sky: '▶', cyan: '▶', blue: '▶', purple: '▶', violet: '▶',
  indigo: '▶', fuchsia: '✦', pink: '✦', orange: '⚠', red: '✖',
};
const colorMap: Record<string, string> = {
  teal:    'var(--color-accent)',
  green:   'var(--color-green)',
  amber:   'var(--color-amber)',
  rose:    'var(--color-rose)',
  sky:     '#0ea5e9',
  cyan:    '#06b6d4',
  blue:    '#2563eb',
  purple:  '#7c3aed',
  violet:  '#7c3aed',
  indigo:  '#4f46e5',
  fuchsia: '#c026d3',
  pink:    '#db2777',
  orange:  '#ea580c',
  red:     '#dc2626',
  yellow:  '#ca8a04',
  lime:    '#65a30d',
};
const icon = icons[color] ?? '▶';
const calloutColor = colorMap[color] ?? colorMap['teal'];
---

<div class="callout" style={`--callout-color: ${calloutColor};`}>
  <span class="callout-icon">{icon}</span>
  <div class="callout-body"><slot /></div>
</div>

<style>
  .callout {
    display: flex;
    gap: 0.625rem;
    align-items: flex-start;
    padding: 0.75rem 1rem;
    border-left: 3px solid var(--callout-color);
    background: color-mix(in srgb, var(--callout-color) 8%, var(--color-surface));
    margin: 1rem 0;
    font-size: 0.88rem;
    line-height: 1.6;
    font-family: var(--font-mono);
  }
  .callout-icon {
    color: var(--callout-color);
    font-size: 0.7rem;
    flex-shrink: 0;
    padding-top: 0.25rem;
  }
  .callout-body {
    color: var(--color-text-dim);
    flex: 1;
    min-width: 0;
  }
  /* Remove margin from nested prose elements */
  .callout-body :global(p) { margin: 0; }
  .callout-body :global(p + p) { margin-top: 0.4rem; }
</style>
