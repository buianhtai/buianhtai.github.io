---
/**
 * ArchDiagram — Annotated architecture / topology diagram.
 *
 * Renders nodes in named zones with directed edges between them.
 * Uses an SVG canvas auto-sized from the node/zone layout.
 *
 * Usage:
 *   <ArchDiagram
 *     zones={[
 *       { id: "client",   label: "Client",       color: "teal" },
 *       { id: "cluster",  label: "DB Cluster",   color: "blue" },
 *     ]}
 *     nodes={[
 *       { id: "app",   label: "App",      zone: "client",  row: 1, col: 1 },
 *       { id: "ldr",   label: "Leader",   zone: "cluster", row: 1, col: 1, color: "blue" },
 *       { id: "f1",    label: "Follower", zone: "cluster", row: 1, col: 2 },
 *       { id: "f2",    label: "Follower", zone: "cluster", row: 2, col: 2, faded: true },
 *     ]}
 *     edges={[
 *       { from: "app", to: "ldr", label: "write",     type: "solid" },
 *       { from: "ldr", to: "f1",  label: "sync rep",  type: "solid" },
 *       { from: "ldr", to: "f2",  label: "async rep", type: "dashed" },
 *     ]}
 *     caption="Single-leader replication topology"
 *   />
 *
 * node.color: 'blue'|'teal'|'amber'|'rose'|'violet'|'green' (default: accent)
 * edge.type:  'solid'|'dashed'|'dotted'|'bidirectional' (default: solid)
 */

interface Zone {
  id: string;
  label: string;
  color?: string;
  row?: number;
  col?: number;
}

interface Node {
  id: string;
  label: string;
  sub?: string;
  zone?: string;
  row?: number;   // row within zone grid
  col?: number;   // col within zone grid
  color?: string;
  faded?: boolean;
  shape?: 'rect' | 'cylinder' | 'diamond' | 'circle';
}

interface Edge {
  from: string;
  to: string;
  label?: string;
  type?: 'solid' | 'dashed' | 'dotted' | 'bidirectional' | 'error';
  color?: string;
  highlight?: boolean;
}

interface Props {
  zones?: Zone[];
  nodes: Node[];
  edges: Edge[];
  caption?: string;
  title?: string;
  annotations?: Array<{ text: string; color?: string }>;
}

const { zones = [], nodes, edges, caption, title, annotations } = Astro.props;

const NODE_W = 120;
const NODE_H_BASE = 44;    // height when no sub
const NODE_H_SUB_LINE = 13; // extra px per sub line
const PAD_X  = 28;
const PAD_Y  = 28;
const ZONE_PAD = 18;
const COL_GAP  = 36;
const ROW_GAP  = 32;

// Compute per-node height based on sub-line count
function nodeHeight(n: Node): number {
  if (!n.sub) return NODE_H_BASE;
  const lines = n.sub.split('\n').length;
  return NODE_H_BASE + lines * NODE_H_SUB_LINE;
}
// Max height for a zone row
function rowHeight(zoneNodes: Node[]): number {
  return Math.max(...zoneNodes.map(nodeHeight), NODE_H_BASE);
}

const COLORS: Record<string, string> = {
  blue:   'var(--color-accent)',
  teal:   '#0ea5e9',
  amber:  '#f59e0b',
  rose:   '#f43f5e',
  violet: '#8b5cf6',
  green:  '#16a34a',
  gray:   'var(--color-text-muted)',
};

function c(key?: string) { return key ? (COLORS[key] ?? key) : 'var(--color-accent)'; }

// Layout nodes into (x, y) positions.
// If zones defined, group nodes by zone, layout zones in a row.
// If no zones, layout nodes in a simple grid.
type LayoutNode = Node & { x: number; y: number };
type LayoutZone = Zone & { x: number; y: number; w: number; h: number };

let layoutNodes: LayoutNode[] = [];
let layoutZones: LayoutZone[] = [];
let svgW = 0, svgH = 0;

if (zones.length === 0) {
  // Simple grid — compute per-row max height
  const cols = Math.ceil(Math.sqrt(nodes.length));
  const numRows = Math.ceil(nodes.length / cols);

  // row Y offsets
  const rowYs: number[] = [];
  let curY = PAD_Y;
  for (let r = 0; r < numRows; r++) {
    rowYs.push(curY);
    const rowNodes = nodes.filter((_, i) => Math.floor(i / cols) === r);
    curY += Math.max(...rowNodes.map(nodeHeight), NODE_H_BASE) + ROW_GAP;
  }

  nodes.forEach((n, i) => {
    const col = i % cols;
    const row = Math.floor(i / cols);
    layoutNodes.push({
      ...n,
      x: PAD_X + col * (NODE_W + COL_GAP),
      y: rowYs[row],
    });
  });
  const maxCol = Math.min(nodes.length, cols);
  svgW = PAD_X * 2 + maxCol * NODE_W + (maxCol - 1) * COL_GAP;
  svgH = curY - ROW_GAP + PAD_Y;
} else {
  // Zone-grouped layout
  let cursorX = PAD_X;

  zones.forEach((z) => {
    const zoneNodes = nodes.filter((n) => n.zone === z.id);
    const maxRowIdx = Math.max(...zoneNodes.map((n) => n.row ?? 1));
    const maxCol    = Math.max(...zoneNodes.map((n) => n.col ?? 1));

    // Compute row heights within zone
    const zRowHeights: number[] = [];
    for (let r = 1; r <= maxRowIdx; r++) {
      const rNodes = zoneNodes.filter((n) => (n.row ?? 1) === r);
      zRowHeights.push(Math.max(...rNodes.map(nodeHeight), NODE_H_BASE));
    }
    const zW = ZONE_PAD * 2 + maxCol * NODE_W + (maxCol - 1) * COL_GAP;
    const totalRowH = zRowHeights.reduce((a, b) => a + b, 0) + (maxRowIdx - 1) * ROW_GAP;
    const zH = ZONE_PAD * 2 + 20 /* label */ + totalRowH;

    layoutZones.push({ ...z, x: cursorX, y: PAD_Y, w: zW, h: zH });

    // Compute cumulative Y for each row within zone
    const rowOffsets: number[] = [];
    let cumY = 0;
    for (let r = 0; r < zRowHeights.length; r++) {
      rowOffsets.push(cumY);
      cumY += zRowHeights[r] + ROW_GAP;
    }

    zoneNodes.forEach((n) => {
      const col = (n.col ?? 1) - 1;
      const row = (n.row ?? 1) - 1;
      layoutNodes.push({
        ...n,
        x: cursorX + ZONE_PAD + col * (NODE_W + COL_GAP),
        y: PAD_Y + ZONE_PAD + 20 + rowOffsets[row],
      });
    });

    cursorX += zW + COL_GAP;
  });

  svgW = cursorX - COL_GAP + PAD_X;
  svgH = PAD_Y * 2 + Math.max(...layoutZones.map((z) => z.h));
}

// Nodecentre lookup — use per-node height
const centres = Object.fromEntries(
  layoutNodes.map((n) => [n.id, { x: n.x + NODE_W / 2, y: n.y + nodeHeight(n) / 2 }])
);
---

<div class="ad-wrap">
  {title && <div class="ad-titlebar"><span class="ad-prompt">$</span> {title}</div>}

  <div class="ad-scroll">
    <svg
      class="ad-svg"
      width={svgW}
      height={svgH}
      viewBox={`0 0 ${svgW} ${svgH}`}
      xmlns="http://www.w3.org/2000/svg"
    >
      <defs>
        <marker id="ad-arr" markerWidth="8" markerHeight="6" refX="7" refY="3" orient="auto">
          <polygon points="0 0, 8 3, 0 6" fill="var(--color-accent)" />
        </marker>
        <marker id="ad-arr-err" markerWidth="8" markerHeight="6" refX="7" refY="3" orient="auto">
          <polygon points="0 0, 8 3, 0 6" fill="#f43f5e" />
        </marker>
        <marker id="ad-arr-back" markerWidth="8" markerHeight="6" refX="1" refY="3" orient="auto-start-reverse">
          <polygon points="8 0, 0 3, 8 6" fill="var(--color-accent)" />
        </marker>
      </defs>

      <!-- Zone backgrounds -->
      {layoutZones.map((z) => (
        <>
          <rect
            x={z.x} y={z.y}
            width={z.w} height={z.h}
            rx="6"
            fill="none"
            stroke={c(z.color)}
            stroke-width="1"
            stroke-dasharray="4 3"
            opacity="0.5"
          />
          <text
            x={z.x + 8} y={z.y + 14}
            font-family="var(--font-mono,'IBM Plex Mono',monospace)"
            font-size="9"
            fill={c(z.color)}
            opacity="0.8"
          >{z.label}</text>
        </>
      ))}

      <!-- Edges (draw before nodes so nodes appear on top) -->
      {edges.map((e) => {
        const fc = centres[e.from];
        const tc = centres[e.to];
        if (!fc || !tc) return null;
        const isErr = e.type === 'error';
        const isBi  = e.type === 'bidirectional';
        const edgeColor = e.color ? c(e.color) : isErr ? '#f43f5e' : 'var(--color-accent)';
        const dash = e.type === 'dashed' ? '6 4' : e.type === 'dotted' ? '2 4' : undefined;

        // midpoint for label
        const mx = (fc.x + tc.x) / 2;
        const my = (fc.y + tc.y) / 2;

        return (
          <>
            <line
              x1={fc.x} y1={fc.y}
              x2={tc.x} y2={tc.y}
              stroke={edgeColor}
              stroke-width={e.highlight ? '2' : '1.5'}
              stroke-dasharray={dash}
              marker-end={isErr ? 'url(#ad-arr-err)' : 'url(#ad-arr)'}
              marker-start={isBi ? 'url(#ad-arr-back)' : undefined}
              opacity={e.highlight ? '1' : '0.75'}
            />
            {e.label && (
              <>
                <rect
                  x={mx - 44} y={my - 9}
                  width="88" height="13"
                  rx="2"
                  fill="var(--color-surface)"
                  opacity="0.95"
                />
                <text
                  x={mx} y={my + 1}
                  text-anchor="middle"
                  font-family="var(--font-mono,'IBM Plex Mono',monospace)"
                  font-size="9"
                  fill={edgeColor}
                >{e.label}</text>
              </>
            )}
          </>
        );
      })}

      <!-- Nodes -->
      {layoutNodes.map((n) => {
        const color = c(n.color);
        const opacity = n.faded ? '0.45' : '1';
        const shape = n.shape ?? 'rect';
        const nh = nodeHeight(n);
        const subLines = n.sub ? n.sub.split('\n') : [];
        const cx = n.x + NODE_W / 2;
        // label Y: if sub exists, position label in upper portion; else center
        const labelY = subLines.length > 0 ? n.y + 16 : n.y + nh / 2 + 4;
        // first sub line starts below label
        const subStartY = labelY + 13;

        return (
          <g opacity={opacity}>
            {shape === 'cylinder' ? (
              <>
                <rect x={n.x} y={n.y + 6} width={NODE_W} height={nh - 6} rx="3" fill="var(--color-surface-2)" stroke={color} stroke-width="1.5" />
                <ellipse cx={cx} cy={n.y + 6} rx={NODE_W/2} ry="6" fill="var(--color-surface-2)" stroke={color} stroke-width="1.5" />
                <ellipse cx={cx} cy={n.y + 6} rx={NODE_W/2} ry="6" fill="none" stroke={color} stroke-width="1.5" />
              </>
            ) : shape === 'diamond' ? (
              <polygon
                points={`${cx},${n.y}  ${n.x + NODE_W},${n.y + nh/2}  ${cx},${n.y + nh}  ${n.x},${n.y + nh/2}`}
                fill="var(--color-surface-2)" stroke={color} stroke-width="1.5"
              />
            ) : shape === 'circle' ? (
              <ellipse cx={cx} cy={n.y + nh/2} rx={NODE_W/2} ry={nh/2} fill="var(--color-surface-2)" stroke={color} stroke-width="1.5" />
            ) : (
              <rect x={n.x} y={n.y} width={NODE_W} height={nh} rx="4" fill="var(--color-surface-2)" stroke={color} stroke-width="1.5" />
            )}

            <text
              x={cx}
              y={labelY}
              text-anchor="middle"
              font-family="var(--font-mono,'IBM Plex Mono',monospace)"
              font-size="11"
              font-weight="700"
              fill={color}
            >{n.label}</text>

            {subLines.map((line, li) => (
              <text
                x={cx}
                y={subStartY + li * 12}
                text-anchor="middle"
                font-family="var(--font-mono,'IBM Plex Mono',monospace)"
                font-size="9"
                fill="var(--color-text-muted)"
              >{line}</text>
            ))}
          </g>
        );
      })}
    </svg>
  </div>

  {annotations && annotations.length > 0 && (
    <div class="ad-annotations">
      {annotations.map((a) => (
        <div class="ad-annotation" style={a.color ? `border-left-color: ${c(a.color)}` : ''}>
          {a.text}
        </div>
      ))}
    </div>
  )}

  {caption && <div class="ad-caption"><span class="ad-prompt">▶</span> {caption}</div>}
</div>

<style>
  .ad-wrap {
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    margin: 1.5rem 0;
    overflow: hidden;
    font-family: var(--font-mono, 'IBM Plex Mono', monospace);
  }

  .ad-titlebar {
    padding: 0.4rem 0.875rem;
    border-bottom: 1px solid var(--color-border);
    background: var(--color-surface-2);
    font-size: 0.65rem;
    color: var(--color-text-muted);
  }
  .ad-prompt { color: var(--color-accent); font-weight: 700; margin-right: 0.35rem; }

  .ad-scroll {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    padding: 1rem;
    display: flex;
    justify-content: center;
  }

  .ad-svg {
    max-width: 100%;
    height: auto;
  }

  .ad-annotations {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 0.5rem 0.875rem;
    border-top: 1px solid var(--color-border);
    background: var(--color-surface-2);
  }

  .ad-annotation {
    font-size: 0.63rem;
    color: var(--color-text-dim);
    border-left: 2px solid var(--color-accent);
    padding-left: 0.5rem;
    line-height: 1.4;
  }

  .ad-caption {
    padding: 0.45rem 0.875rem;
    border-top: 1px solid var(--color-border);
    font-size: 0.62rem;
    color: var(--color-text-dim);
    background: var(--color-bg);
    line-height: 1.5;
  }
</style>
