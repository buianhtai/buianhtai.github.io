---
/**
 * ControlLoop — Sensor → Spec → Actuator cyclic feedback diagram.
 *
 * Renders three nodes in a triangle/cycle layout with labeled directional
 * arrows between them. Each node has a title, subtitle, and accent color.
 * Edge labels describe what flows on each connection.
 *
 * Usage:
 *   <ControlLoop
 *     nodes={[
 *       { id: "sensor",   title: "Sensor",   subtitle: "sentrux",     color: "teal" },
 *       { id: "spec",     title: "Spec",     subtitle: "rules.toml",  color: "amber" },
 *       { id: "actuator", title: "Actuator", subtitle: "AI agent",    color: "green" },
 *     ]}
 *     edges={[
 *       { from: "sensor",   to: "actuator", label: "quality signal" },
 *       { from: "actuator", to: "sensor",   label: "code change → rescan" },
 *       { from: "spec",     to: "actuator", label: "constraints" },
 *       { from: "sensor",   to: "spec",     label: "rule evaluation" },
 *     ]}
 *     caption="Architecture feedback loop — sensor closes the loop the compiler and linter never could."
 *   />
 */
interface LoopNode {
  id: string;
  title: string;
  subtitle: string;
  color?: 'teal' | 'green' | 'amber' | 'rose';
}

interface LoopEdge {
  from: string;
  to: string;
  label: string;
}

interface Props {
  nodes: LoopNode[];
  edges?: LoopEdge[];
  caption?: string;
}

const { nodes, edges = [], caption } = Astro.props;

const fgColors = {
  teal:  '#0891b2',
  green: '#059669',
  amber: '#d97706',
  rose:  '#be123c',
} as const;
const bgColors = {
  teal:  'rgba(8,145,178,0.12)',
  green: 'rgba(5,150,105,0.12)',
  amber: 'rgba(217,119,6,0.12)',
  rose:  'rgba(190,18,60,0.12)',
} as const;
const borderColors = {
  teal:  'rgba(8,145,178,0.45)',
  green: 'rgba(5,150,105,0.45)',
  amber: 'rgba(217,119,6,0.45)',
  rose:  'rgba(190,18,60,0.45)',
} as const;

// Node positions: 0=top-center, 1=bottom-left, 2=bottom-right
const NODE_POSITIONS: Array<[number, number]> = [[240, 52], [80, 234], [400, 234]];

// Build index: node id → position index
const nodeIndex: { [key: string]: number } = {};
nodes.slice(0, 3).forEach((n, i) => { nodeIndex[n.id] = i; });

// Pre-compute SVG path data for each edge in the frontmatter (no generics in JSX)
interface EdgeRender {
  path: string;
  lx: number;
  ly: number;
  label: string;
  fg: string;
  markerId: string;
}
const edgeRenders: EdgeRender[] = edges.map((edge) => {
  const fi = nodeIndex[edge.from] ?? 0;
  const ti = nodeIndex[edge.to] ?? 1;
  const [fx, fy] = NODE_POSITIONS[fi] ?? [240, 52];
  const [tx, ty] = NODE_POSITIONS[ti] ?? [240, 52];

  const dx = tx - fx, dy = ty - fy;
  const dist = Math.sqrt(dx * dx + dy * dy) || 1;
  const nx = dx / dist, ny = dy / dist;
  const pad = 64;
  const sx = fx + nx * pad, sy = fy + ny * 30;
  const ex = tx - nx * pad, ey = ty - ny * 30;

  const midX = (sx + ex) / 2, midY = (sy + ey) / 2;
  const cpX = midX - ny * 32, cpY = midY + nx * 32;
  const lx = 0.25 * sx + 0.5 * cpX + 0.25 * ex;
  const ly = 0.25 * sy + 0.5 * cpY + 0.25 * ey;

  const fromNode = nodes.find(n => n.id === edge.from);
  const c = fromNode?.color ?? 'teal';
  const fg = fgColors[c as keyof typeof fgColors] ?? '#0891b2';

  return {
    path: `M ${sx} ${sy} Q ${cpX} ${cpY} ${ex} ${ey}`,
    lx, ly,
    label: edge.label,
    fg,
    markerId: `arr-${c}`,
  };
});
---

<div class="cl-wrap">
  <!-- Desktop: SVG-based cycle diagram -->
  <div class="cl-diagram" aria-hidden="true">
    <svg class="cl-svg" viewBox="0 0 480 300" xmlns="http://www.w3.org/2000/svg">
      <!-- Defs: arrowheads per color -->
      <defs>
        <marker id="arr-teal"  markerWidth="8" markerHeight="6" refX="7" refY="3" orient="auto">
          <polygon points="0 0, 8 3, 0 6" fill="#0891b2" opacity="0.8"/>
        </marker>
        <marker id="arr-amber" markerWidth="8" markerHeight="6" refX="7" refY="3" orient="auto">
          <polygon points="0 0, 8 3, 0 6" fill="#d97706" opacity="0.8"/>
        </marker>
        <marker id="arr-green" markerWidth="8" markerHeight="6" refX="7" refY="3" orient="auto">
          <polygon points="0 0, 8 3, 0 6" fill="#059669" opacity="0.8"/>
        </marker>
        <marker id="arr-rose"  markerWidth="8" markerHeight="6" refX="7" refY="3" orient="auto">
          <polygon points="0 0, 8 3, 0 6" fill="#be123c" opacity="0.8"/>
        </marker>
        <marker id="arr-default" markerWidth="8" markerHeight="6" refX="7" refY="3" orient="auto">
          <polygon points="0 0, 8 3, 0 6" fill="var(--color-accent)" opacity="0.7"/>
        </marker>
      </defs>

      {/* --- Positions for up to 3 nodes in an equilateral triangle --- */}
      {/* Node 0 → top-center, Node 1 → bottom-left, Node 2 → bottom-right */}
      {/* Positions: [240,48]  [80,230]  [400,230] */}

      {nodes.slice(0, 3).map((node, i) => {
        const positions = [[240, 52], [80, 234], [400, 234]];
        const [cx, cy] = positions[i] ?? [240, 140];
        const c = (node.color ?? 'teal') as keyof typeof fgColors;
        const fg = fgColors[c];
        const bg = bgColors[c];
        const bd = borderColors[c];
        return (
          <g>
            <rect
              x={cx - 60} y={cy - 28}
              width="120" height="56"
              rx="4"
              fill={bg}
              stroke={bd}
              stroke-width="1.5"
            />
            <text
              x={cx} y={cy - 5}
              text-anchor="middle"
              font-family="'IBM Plex Mono', 'Fira Code', monospace"
              font-size="13"
              font-weight="700"
              fill={fg}
            >{node.title}</text>
            <text
              x={cx} y={cy + 13}
              text-anchor="middle"
              font-family="'IBM Plex Mono', 'Fira Code', monospace"
              font-size="10"
              fill="var(--color-text-dim)"
              opacity="0.85"
            >{node.subtitle}</text>
          </g>
        );
      })}

      {/* --- Edges --- */}
      {/* We render edges as curved paths between the three fixed positions */}
      {/* Edge set for 3-node triangle: 0→2, 2→1, 1→0 (clockwise outer loop) */}
      {/* Plus optional cross-edges 0→1, 1→2, etc. */}

      {edgeRenders.map((er) => (
        <g>
          <path
            d={er.path}
            fill="none"
            stroke={er.fg}
            stroke-width="1.5"
            stroke-opacity="0.7"
            marker-end={`url(#${er.markerId})`}
          />
          <rect
            x={er.lx - 42} y={er.ly - 9}
            width="84" height="16"
            rx="3"
            fill="var(--color-surface)"
            opacity="0.92"
          />
          <text
            x={er.lx} y={er.ly + 4}
            text-anchor="middle"
            font-family="'IBM Plex Mono', 'Fira Code', monospace"
            font-size="8.5"
            fill="var(--color-text-dim)"
          >{er.label}</text>
        </g>
      ))}
    </svg>
  </div>

  <!-- Mobile: compact node list -->
  <div class="cl-list">
    {nodes.map((node, i) => {
      const c = (node.color ?? 'teal') as keyof typeof fgColors;
      return (
        <div class="cl-list-node" style={`border-left: 3px solid ${fgColors[c]}; background: ${bgColors[c]};`}>
          <span class="cl-list-title" style={`color: ${fgColors[c]};`}>{node.title}</span>
          <span class="cl-list-sub">{node.subtitle}</span>
          {i < nodes.length - 1 && (
            <div class="cl-list-arrow" style={`color: ${fgColors[c]};`}>
              {edges[i] ? `↓ ${edges[i].label}` : '↓'}
            </div>
          )}
        </div>
      );
    })}
  </div>

  {caption && <div class="cl-caption">{caption}</div>}
</div>

<style>
  .cl-wrap {
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    margin: 1.25rem 0;
    overflow: hidden;
  }

  .cl-diagram {
    display: flex;
    justify-content: center;
    padding: 0.5rem 0;
  }

  .cl-svg {
    width: 100%;
    max-width: 480px;
    height: auto;
  }

  .cl-list {
    display: none;
    flex-direction: column;
    gap: 0;
    padding: 1rem;
  }

  .cl-list-node {
    padding: 0.5rem 0.875rem;
    margin-bottom: 0;
  }

  .cl-list-title {
    display: block;
    font-family: var(--font-mono, 'IBM Plex Mono', monospace);
    font-size: 0.8rem;
    font-weight: 700;
    line-height: 1.3;
  }

  .cl-list-sub {
    display: block;
    font-family: var(--font-mono, 'IBM Plex Mono', monospace);
    font-size: 0.65rem;
    color: var(--color-text-dim);
    margin-top: 0.1rem;
  }

  .cl-list-arrow {
    font-family: var(--font-mono, 'IBM Plex Mono', monospace);
    font-size: 0.65rem;
    padding: 0.375rem 0 0;
    opacity: 0.7;
  }

  .cl-caption {
    padding: 0.45rem 1rem;
    border-top: 1px solid var(--color-border);
    font-family: var(--font-mono, 'IBM Plex Mono', monospace);
    font-size: 0.65rem;
    color: var(--color-text-dim);
    background: var(--color-bg);
    line-height: 1.5;
  }

  @media (max-width: 520px) {
    .cl-diagram { display: none; }
    .cl-list { display: flex; }
  }
</style>
