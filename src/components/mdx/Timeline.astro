---
/**
 * Timeline — events positioned on a horizontal time axis.
 *
 * Usage:
 *   <Timeline
 *     title="LSM-Tree evolution"
 *     events={[
 *       { label: "LevelDB", date: "2011", sub: "Google" },
 *       { label: "RocksDB", date: "2012", sub: "Facebook fork", major: true },
 *       { label: "Cassandra 2.0", date: "2013" },
 *       { label: "WiscKey", date: "2016", sub: "key-val separation", color: "teal" },
 *     ]}
 *     caption="Key milestones in LSM-tree adoption"
 *   />
 *
 * event.major: true — larger coral dot, bold label
 * event.color: 'teal'|'amber'|'green'|'rose'|'violet'  — overrides dot color
 */

interface TimelineEvent {
  label: string;
  date: string;
  sub?: string;
  major?: boolean;
  color?: string;
}

interface TimelineItem {
  title: string;
  body: string;
  accent?: string;
}

interface Props {
  events?: TimelineEvent[];
  items?: TimelineItem[];
  title?: string;
  caption?: string;
}

const { events: suppliedEvents, items, title, caption } = Astro.props;

const events: TimelineEvent[] = suppliedEvents ?? (items ?? []).map((item, index) => ({
  label: item.title,
  date: `KAFKA ${index + 1}`,
  sub: item.body,
  color: item.accent,
  major: index === (items?.length ?? 1) - 1,
}));

const COLORS: Record<string, string> = {
  teal:   '#0ea5e9',
  amber:  '#f59e0b',
  green:  '#16a34a',
  rose:   '#f43f5e',
  violet: '#8b5cf6',
};

const PAD_X   = 40;
const PAD_Y   = 20;
const AXIS_Y  = 80;          // baseline y
const LABEL_ABOVE = 48;       // label clearance above axis
const LABEL_BELOW = 28;       // date clearance below axis
const EVENT_SPACING = 120;    // px between events

const svgW = PAD_X * 2 + Math.max(events.length - 1, 0) * EVENT_SPACING;
const svgH = PAD_Y + AXIS_Y + LABEL_BELOW + 32;

function eventX(i: number) { return PAD_X + i * EVENT_SPACING; }

// Alternate labels above/below to prevent collision
function isAbove(i: number) { return i % 2 === 0; }
---

<div class="tl-wrap">
  {title && <div class="tl-titlebar"><span class="tl-prompt">$</span> {title}</div>}
  <div class="tl-body">
    <svg
      width={svgW}
      height={svgH}
      viewBox={`0 0 ${svgW} ${svgH}`}
      style="display:block; overflow:visible; max-width:100%; height:auto;"
      aria-label={title ?? 'Timeline'}
    >
      <!-- Axis line -->
      <line
        x1={PAD_X - 16} y1={AXIS_Y}
        x2={svgW - PAD_X + 16} y2={AXIS_Y}
        stroke="var(--color-border)"
        stroke-width="1.5"
      />

      <!-- Events -->
      {events.map((ev, i) => {
        const x = eventX(i);
        const above = isAbove(i);
        const dotColor = ev.color ? (COLORS[ev.color] ?? ev.color)
                       : ev.major ? 'var(--color-accent)'
                       : 'var(--color-text-muted)';
        const dotR = ev.major ? 6 : 4;

        // Label sits above or below
        const labelY = above ? AXIS_Y - LABEL_ABOVE : AXIS_Y + LABEL_BELOW;
        const dropY1 = above ? AXIS_Y - dotR : AXIS_Y + dotR;
        const dropY2 = above ? labelY + 4    : labelY - 4;

        return (
          <>
            {/* Drop line */}
            <line
              x1={x} y1={dropY1}
              x2={x} y2={dropY2}
              stroke="var(--color-border)"
              stroke-width="1"
            />

            {/* Dot */}
            <circle cx={x} cy={AXIS_Y} r={dotR}
              fill={dotColor}
            />

            {/* Event label */}
            <text
              x={x} y={above ? labelY - 14 : labelY}
              text-anchor="middle"
              font-family="var(--font-mono,'IBM Plex Mono',monospace)"
              font-size="11"
              font-weight={ev.major ? '700' : '600'}
              fill={ev.major ? 'var(--color-accent)' : 'var(--color-text)'}
            >{ev.label}</text>

            {/* Sub label */}
            {ev.sub && (
              <text
                x={x} y={above ? labelY - 2 : labelY + 13}
                text-anchor="middle"
                font-family="var(--font-mono,'IBM Plex Mono',monospace)"
                font-size="8.5"
                fill="var(--color-text-muted)"
              >{ev.sub}</text>
            )}

            {/* Date label below axis */}
            <text
              x={x} y={AXIS_Y + 18}
              text-anchor="middle"
              font-family="var(--font-mono,'IBM Plex Mono',monospace)"
              font-size="8"
              fill="var(--color-text-muted)"
            >{ev.date}</text>
          </>
        );
      })}
    </svg>
  </div>
  {caption && <div class="tl-caption"><span class="tl-prompt">▶</span> {caption}</div>}
</div>

<style>
  .tl-wrap {
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    margin: 1.5rem 0;
    overflow: hidden;
    font-family: var(--font-mono, 'IBM Plex Mono', monospace);
  }
  .tl-titlebar {
    padding: 0.4rem 0.875rem;
    border-bottom: 1px solid var(--color-border);
    background: var(--color-surface-2);
    font-size: 0.65rem;
    color: var(--color-text-muted);
  }
  .tl-prompt { color: var(--color-accent); font-weight: 700; margin-right: 0.35rem; }
  .tl-body {
    padding: 1.25rem;
    overflow-x: auto;
    display: flex;
    justify-content: center;
  }
  .tl-caption {
    padding: 0.45rem 0.875rem;
    border-top: 1px solid var(--color-border);
    font-size: 0.62rem;
    color: var(--color-text-dim);
    background: var(--color-bg);
    line-height: 1.5;
  }
</style>
