---
interface Props {
  badge: string;
  badgeColor?: 'teal' | 'amber' | 'green' | 'rose';
  label: string;
  items: string[];
}
const { badge, badgeColor = 'teal', label, items } = Astro.props;

const cssVars = {
  teal:  '--color-accent',
  green: '--color-green',
  amber: '--color-amber',
  rose:  '--color-rose',
};
const cssVar = cssVars[badgeColor];
---

<div class="arch-layer" style={`--layer-color: var(${cssVar});`}>
  <span class="arch-badge">{badge}</span>
  <span class="arch-label">{label}</span>
  <div class="arch-chips">
    {items.map((item) => <span class="arch-chip">{item}</span>)}
  </div>
</div>

<style>
  .arch-layer {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding: 0.6rem 0.875rem;
    border: 1px solid var(--color-border);
    border-left: 3px solid var(--layer-color);
    background: var(--color-surface);
    margin: 0.3rem 0;
    font-family: var(--font-mono);
  }
  .arch-badge {
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--layer-color);
    background: color-mix(in srgb, var(--layer-color) 12%, transparent);
    padding: 0.15rem 0.5rem;
    white-space: nowrap;
    flex-shrink: 0;
  }
  .arch-label {
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--color-text);
    white-space: nowrap;
    margin-right: 0.25rem;
  }
  .arch-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
  }
  .arch-chip {
    font-size: 0.68rem;
    color: var(--color-text-muted);
    border: 1px solid var(--color-border);
    padding: 0.1rem 0.45rem;
    background: var(--color-bg);
    white-space: nowrap;
  }

  @media (max-width: 480px) {
    .arch-layer { flex-direction: column; align-items: flex-start; }
  }
</style>
