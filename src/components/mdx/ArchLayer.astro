---
interface Props {
  badge: string;
  badgeColor?: string;
  label: string;
  items: string[];
}
const { badge, badgeColor = 'teal', label, items } = Astro.props;

// Map color names to CSS variables or hex fallbacks
const colorMap: Record<string, string> = {
  teal:    'var(--color-accent)',
  green:   'var(--color-green)',
  amber:   'var(--color-amber)',
  rose:    'var(--color-rose)',
  purple:  '#7c3aed',
  violet:  '#7c3aed',
  blue:    '#2563eb',
  sky:     '#0ea5e9',
  cyan:    '#06b6d4',
  orange:  '#ea580c',
  fuchsia: '#c026d3',
  pink:    '#db2777',
  indigo:  '#4f46e5',
  red:     '#dc2626',
  yellow:  '#ca8a04',
  lime:    '#65a30d',
};
const layerColor = colorMap[badgeColor] ?? colorMap['teal'];
---

<div class="arch-layer" style={`--layer-color: ${layerColor};`}>
  <span class="arch-badge">{badge}</span>
  <span class="arch-label">{label}</span>
  <div class="arch-chips">
    {items.map((item) => <span class="arch-chip">{item}</span>)}
  </div>
</div>

<style>
  .arch-layer {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding: 0.6rem 0.875rem;
    border: 1px solid var(--color-border);
    border-left: 3px solid var(--layer-color);
    background: var(--color-surface);
    margin: 0.3rem 0;
    font-family: var(--font-mono);
  }
  .arch-badge {
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--layer-color);
    background: color-mix(in srgb, var(--layer-color) 12%, transparent);
    padding: 0.15rem 0.5rem;
    white-space: nowrap;
    flex-shrink: 0;
  }
  .arch-label {
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--color-text);
    white-space: nowrap;
    margin-right: 0.25rem;
  }
  .arch-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
  }
  .arch-chip {
    font-size: 0.68rem;
    color: var(--color-text-muted);
    border: 1px solid var(--color-border);
    padding: 0.1rem 0.45rem;
    background: var(--color-bg);
    white-space: nowrap;
  }

  @media (max-width: 480px) {
    .arch-layer { flex-direction: column; align-items: flex-start; }
  }
</style>
