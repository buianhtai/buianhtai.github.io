---
interface Props {
  chart: string;
  caption?: string;
}
const { chart, caption } = Astro.props;
---

<figure class="mermaid-figure">
  <div class="mermaid-scroll">
    <pre class="mermaid" set:html={chart}></pre>
  </div>
  {caption && <figcaption class="mermaid-caption">{caption}</figcaption>}
</figure>

<style>
  .mermaid-figure {
    margin: 1.5rem 0;
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
    overflow: hidden;
    background: var(--color-surface);
  }

  /* Scrollable wrapper — horizontally scrollable on narrow screens,
     full-width on desktop. No height cap so the diagram is always visible. */
  .mermaid-scroll {
    overflow-x: auto;
    overflow-y: visible;
    padding: 1.5rem;
    /* Smooth scroll on iOS */
    -webkit-overflow-scrolling: touch;
  }

  /* Let the pre/SVG breathe at natural size */
  .mermaid-scroll pre.mermaid {
    background: transparent !important;
    border: none !important;
    padding: 0 !important;
    margin: 0 auto !important;
    /* Center the diagram, don't stretch it */
    display: flex;
    justify-content: center;
  }

  /* Mermaid injects an <svg> directly into the pre — make it responsive */
  .mermaid-scroll pre.mermaid > svg {
    max-width: 100%;
    height: auto !important;
    display: block;
    margin: 0 auto;
  }

  .mermaid-caption {
    padding: 0.625rem 1.5rem;
    border-top: 1px solid var(--color-border);
    font-size: 0.8rem;
    color: var(--color-text-dim);
    font-family: 'IBM Plex Mono', monospace;
    text-align: center;
    margin: 0;
  }
</style>
