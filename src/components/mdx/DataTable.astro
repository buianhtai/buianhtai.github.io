---
interface Props {
  headers: string[];
  rows: Array<Record<string, string>>;
  caption?: string;
  accent?: string;
}

const { headers, rows, caption, accent = 'teal' } = Astro.props;

const accentVars: Record<string, string> = {
  teal:   '--color-accent',
  green:  '--color-green',
  amber:  '--color-amber',
  rose:   '--color-rose',
  purple: '--color-accent',
};
const cssVar = accentVars[accent] || '--color-accent';
---

<div class="dt-wrap" style={`--dt-color: var(${cssVar});`}>
  {caption && (
    <div class="dt-caption">
      <span class="dt-dot"></span>
      {caption}
    </div>
  )}
  <div class="dt-scroll">
    <table class="dt">
      <thead>
        <tr>
          {headers.map((h) => <th>{h}</th>)}
        </tr>
      </thead>
      <tbody>
        {rows.map((row) => (
          <tr>
            {headers.map((h, j) => (
              <td>
                {j === 0
                  ? <code class="dt-code">{row[h]}</code>
                  : <Fragment set:html={row[h] ?? ''} />
                }
              </td>
            ))}
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</div>

<style>
  .dt-wrap {
    margin: 1.5rem 0;
    border: 1px solid var(--color-border);
    border-left: 3px solid var(--dt-color);
    background: var(--color-surface);
    overflow: hidden;
  }

  .dt-caption {
    padding: 0.5rem 1rem;
    border-bottom: 1px solid var(--color-border);
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--dt-color);
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    background: var(--color-surface-2);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .dt-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--dt-color);
    flex-shrink: 0;
    opacity: 0.7;
  }

  .dt-scroll { overflow-x: auto; -webkit-overflow-scrolling: touch; }

  .dt {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.82rem;
    font-family: var(--font-mono);
  }

  .dt th {
    text-align: left;
    padding: 0.5rem 1rem;
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--dt-color);
    border-bottom: 1px solid var(--color-border);
    background: var(--color-surface-2);
    white-space: nowrap;
  }

  .dt td {
    padding: 0.5rem 1rem;
    border-bottom: 1px solid var(--color-border);
    color: var(--color-text);
    line-height: 1.5;
    vertical-align: top;
  }

  .dt tbody tr:last-child td { border-bottom: none; }
  .dt tbody tr:nth-child(even) td { background: color-mix(in srgb, var(--color-surface-2) 40%, transparent); }
  .dt tbody tr:hover td { background: var(--color-accent-glow); }

  .dt-code {
    font-family: var(--font-mono);
    font-size: 0.77rem;
    background: var(--color-bg);
    padding: 0.1rem 0.4rem;
    border: 1px solid var(--color-border);
    white-space: nowrap;
    color: var(--color-accent);
  }
</style>
