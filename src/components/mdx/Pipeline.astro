---
interface Props {
  nodes: Array<{ title: string; subtitle: string }>;
  arrows: Array<{ label: string; direction: 'right' | 'left' }>;
  footer?: string;
}
const { nodes, arrows, footer } = Astro.props;

const elements: Array<{ type: 'node'; data: (typeof nodes)[0] } | { type: 'arrow'; data: (typeof arrows)[0] }> = [];
for (let i = 0; i < nodes.length; i++) {
  elements.push({ type: 'node', data: nodes[i] });
  if (i < arrows.length) {
    elements.push({ type: 'arrow', data: arrows[i] });
  }
}
---

<div class="pipeline-wrap">
  <div class="pipeline-bar">
    <span class="pipeline-prompt">$</span> pipeline
  </div>
  <div class="pipeline-flow">
    {elements.map((el) => {
      if (el.type === 'node') {
        const node = el.data as (typeof nodes)[0];
        return (
          <div class="pipeline-node">
            <div class="pipeline-node-title">{node.title}</div>
            <div class="pipeline-node-sub">{node.subtitle}</div>
          </div>
        );
      } else {
        const arrow = el.data as (typeof arrows)[0];
        return (
          <div class="pipeline-arrow">
            <span class="pipeline-arrow-label">{arrow.label}</span>
            <span class="pipeline-arrow-icon">{arrow.direction === 'right' ? '→' : '←'}</span>
          </div>
        );
      }
    })}
  </div>
  {footer && (
    <div class="pipeline-footer">
      <span class="pipeline-prompt">▶</span> {footer}
    </div>
  )}
</div>

<style>
  .pipeline-wrap {
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    margin: 1.25rem 0;
    overflow: hidden;
  }
  .pipeline-bar {
    padding: 0.4rem 0.875rem;
    border-bottom: 1px solid var(--color-border);
    background: var(--color-surface-2);
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: var(--color-text-muted);
  }
  .pipeline-prompt { color: var(--color-accent); font-weight: 700; }

  .pipeline-flow {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: nowrap;
    padding: 1.25rem;
    overflow-x: auto;
  }

  .pipeline-node {
    padding: 0.6rem 0.875rem;
    border: 1px solid var(--color-border);
    border-left: 3px solid var(--color-accent);
    background: var(--color-bg);
    text-align: center;
    flex-shrink: 0;
    min-width: 6rem;
  }
  .pipeline-node-title {
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 0.78rem;
    color: var(--color-text);
  }
  .pipeline-node-sub {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    color: var(--color-text-muted);
    margin-top: 0.15rem;
  }

  .pipeline-arrow {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.1rem;
    padding: 0 0.5rem;
    flex-shrink: 0;
  }
  .pipeline-arrow-label {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    color: var(--color-text-muted);
    white-space: nowrap;
  }
  .pipeline-arrow-icon {
    font-size: 1rem;
    color: var(--color-accent);
  }

  .pipeline-footer {
    padding: 0.5rem 0.875rem;
    border-top: 1px solid var(--color-border);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-text-dim);
    background: var(--color-surface-2);
  }

  @media (max-width: 640px) {
    .pipeline-flow { flex-direction: column; padding: 0.875rem; }
    .pipeline-arrow { padding: 0.25rem 0; flex-direction: row; gap: 0.375rem; }
    .pipeline-arrow-icon { transform: rotate(90deg); }
    .pipeline-node { width: 100%; min-width: auto; }
  }
</style>
