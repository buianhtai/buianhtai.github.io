  .summary-kicker, .deck-header p, .scene-label { color: var(--color-accent); font: 700 0.7rem/1.4 var(--font-mono); letter-spacing: 0.05em; text-transform: uppercase; }
  .names-deck > summary strong { color: var(--color-text); font: 700 1rem/1.4 var(--font-mono); }
  .summary-action { color: var(--color-text-muted); font: 0.75rem/1.4 var(--font-mono); }
  .names-deck[open] .summary-action { display: none; }
  .deck-shell { outline: none; border-top: 1px solid var(--color-border); }
  .deck-header, .deck-controls { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 0.85rem 1rem; background: var(--color-bg); }
  .deck-header { border-bottom: 1px solid var(--color-border); }
