  .scene { min-height: 430px; padding: clamp(1rem, 4vw, 2rem); display: grid; grid-template-columns: minmax(0, 1fr) minmax(16rem, 0.85fr); gap: clamp(1rem, 4vw, 2rem); align-items: center; }
  .scene[hidden], [data-model-answer][hidden] { display: none; }
