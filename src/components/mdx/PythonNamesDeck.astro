  .answer-grid button, .operation-tabs button, .run-edge, .reveal-model, .deck-controls > button { border: 1px solid var(--color-border); background: var(--color-bg); color: var(--color-text-dim); padding: 0.55rem 0.7rem; cursor: pointer; text-align: left; }
  button:hover:not(:disabled), button:focus-visible { border-color: var(--color-accent); color: var(--color-text); outline: none; }
  button:disabled { cursor: default; opacity: 0.45; }
  .answer-grid button.is-correct { border-color: var(--color-green); color: var(--color-green); }
  .answer-grid button.is-wrong { border-color: var(--color-rose); color: var(--color-rose); }
  .answer-feedback { min-height: 2.8rem; font: 0.75rem/1.5 var(--font-mono); }
  .terminal-card, .invariant-card { min-height: 170px; display: grid; place-content: center; gap: 1rem; padding: 1rem; border: 1px solid var(--color-border); background: var(--color-bg); text-align: center; }
  .terminal-card span, .invariant-card span { color: var(--color-text-muted); font: 0.72rem/1.4 var(--font-mono); }
  .terminal-card strong { color: var(--color-green); font: 700 1.1rem/1.4 var(--font-mono); }
  .invariant-card strong { color: var(--color-text); font: 700 1rem/1.6 var(--font-mono); }
  .object-graph { min-height: 230px; display: grid; grid-template-columns: auto 2.5rem minmax(10rem, 1fr); align-items: center; gap: 0.5rem; padding: 1rem; border: 1px solid var(--color-border); background: var(--color-bg); }
  .name-stack, .object-pair { display: grid; gap: 1rem; }
  .name-node, .object-node { border: 1px solid var(--color-border); background: var(--color-surface); color: var(--color-text); padding: 0.65rem; font-family: var(--font-mono); }
  .name-node { border-color: var(--color-accent); text-align: center; }
  .object-node small { display: block; margin-bottom: 0.35rem; color: var(--color-text-muted); }
  .object-node strong { font-size: 0.78rem; }
  .arrows { display: grid; gap: 0.65rem; color: var(--color-accent); font: 1.4rem/1 var(--font-mono); }
  .graph-operation[data-operation-graph='mutate'] .object-b { display: none; }
  .graph-operation[data-operation-graph='rebind'] .object-a strong { font-size: 0; }
  .graph-operation[data-operation-graph='rebind'] .object-a strong::after { content: '["java"]'; font-size: 0.78rem; }
  .operation-tabs { grid-template-columns: 1fr 1fr; }
  .operation-tabs button[aria-selected='true'] { border-color: var(--color-accent); color: var(--color-text); box-shadow: inset 0 -2px var(--color-accent); }
  .edge-trace { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.65rem; }
  .edge-trace li { display: grid; grid-template-columns: 1.8rem 1fr; gap: 0.65rem; align-items: start; opacity: 0.38; }
  .edge-trace li.is-active { opacity: 1; }
  .edge-trace span { display: grid; place-items: center; width: 1.8rem; height: 1.8rem; border: 1px solid var(--color-border); color: var(--color-text-muted); font: 0.72rem/1 var(--font-mono); }
  .edge-trace li.is-active span { border-color: var(--color-accent); color: var(--color-accent); }
  .edge-trace p { margin: 0; color: var(--color-text-dim); font-size: 0.85rem; line-height: 1.55; }
  .language-lanes { display: grid; grid-template-columns: 1fr 1fr; gap: 0.65rem; }
  .language-lanes > div { border: 1px solid var(--color-border); background: var(--color-bg); padding: 0.75rem; min-width: 0; }
  .language-lanes strong { color: var(--color-accent); font-family: var(--font-mono); }
  .language-lanes p { margin-bottom: 0; color: var(--color-text-dim); font-size: 0.78rem; line-height: 1.5; }
  blockquote { margin: 0.75rem 0 0; padding: 0.8rem; border-left: 3px solid var(--color-accent); background: var(--color-bg); color: var(--color-text-dim); line-height: 1.6; }
  .deck-controls { border-top: 1px solid var(--color-border); }
  .deck-controls > button { padding: 0.45rem 0.65rem; }
  .scene-dots { display: flex; gap: 0.4rem; }
  .scene-dots button { width: 0.65rem; height: 0.65rem; padding: 0; border: 1px solid var(--color-border-bright); border-radius: 50%; background: transparent; cursor: pointer; }
  .scene-dots button[aria-selected='true'] { border-color: var(--color-accent); background: var(--color-accent); }
  .deck-hint { margin: 0; padding: 0 1rem 0.85rem; background: var(--color-bg); color: var(--color-text-muted); font: 0.68rem/1.4 var(--font-mono); text-align: center; }
  @media (max-width: 720px) {
    .scene { min-height: 0; grid-template-columns: 1fr; }
    .operation-tabs, .language-lanes { grid-template-columns: 1fr; }
    .object-graph { min-height: 190px; }
    .deck-header p { display: none; }
    .deck-controls { position: sticky; bottom: 0; z-index: 3; }
  }
  @media (prefers-reduced-motion: reduce) { * { scroll-behavior: auto !important; transition: none !important; } }
</style>
