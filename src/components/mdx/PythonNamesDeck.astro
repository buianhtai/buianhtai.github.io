  .scene-copy p { color: var(--color-text-dim); line-height: 1.65; }
  pre { overflow-x: auto; margin: 0.75rem 0; padding: 0.8rem; border: 1px solid var(--color-border); background: var(--color-bg); color: var(--color-text); font: 0.78rem/1.65 var(--font-mono); }
