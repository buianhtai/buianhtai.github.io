/**
 * Illustrated system/container map, grounded in pinned Agno source.
 * Replica diagram is a recommended example, not Agno's mandatory deployment.
 */
const revision = '1f2aac51eb28dc9c0970836d3b7ae046bae81bbb';
const sourceRoot = 'https://github.com/agno-agi/agno/blob/' + revision + '/libs/agno/agno/';
const bounds = [
  {name:'01 / EXPERIENCE & INGRESS',x:20,y:56,w:260,h:457,tone:'client',summary:'Outside AgentOS'},
  {name:'02 / AGENTOS REPLICA FLEET',x:298,y:56,w:570,h:457,tone:'runtime',summary:'Co-deployed modules ≠ microservices'},
  {name:'03 / EXTERNAL DEPENDENCIES',x:885,y:56,w:295,h:457,tone:'external',summary:'Configured providers and integrations'},
  {name:'04 / DURABLE STATE & COORDINATION',x:298,y:535,w:570,h:204,tone:'data',summary:'Operational store + optional transport'},
  {name:'05 / OPERATIONS & GOVERNANCE',x:885,y:535,w:295,h:204,tone:'ops',summary:'Not required in inference data path'}
];
const nodes = [
 {id:'client',label:'Application / SDK',sub:'Browser · API clients',tag:'UI',layer:'client',x:44,y:118,w:211,h:70,detail:'Client application submits a run, consumes output, and may reconnect to the runtime.',why:'The user interface does not execute Python agent work.',source:'os/routers/agents/router.py'},
 {id:'edge',label:'Ingress / Gateway',sub:'Load balancer · TLS',tag:'LB',layer:'client',x:44,y:236,w:211,h:70,detail:'Illustrative infrastructure forwards requests to available AgentOS replicas.',why:'A load balancer is deployment infrastructure, not an Agno SDK microservice.',source:'os/app.py'},
 {id:'api',label:'AgentOS API',sub:'FastAPI · HTTP endpoints',tag:'API',layer:'runtime',x:327,y:117,w:240,h:69,detail:'FastAPI application composes agent, team, workflow, session, queue and operations routers.',why:'API routing is typically part of the AgentOS process, not a separate service per router.',source:'os/app.py'},
 {id:'auth',label:'Auth & User Scope',sub:'JWT · authorization gates',tag:'ID',layer:'runtime',x:598,y:117,w:240,h:69,detail:'Authentication and authorization guards enforce caller authority and scoped access.',why:'A supplied user/tenant ID must never be accepted as authorization by itself.',source:'os/auth.py'},
 {id:'registry',label:'Component Registry',sub:'Agent · Team · Workflow',tag:'REG',layer:'runtime',x:327,y:215,w:240,h:69,detail:'Runtime resolves registered agent, team, and workflow components for execution.',why:'Component registration and selection are not necessarily a new network hop.',source:'os/app.py'},
 {id:'agent',label:'Agent Runtime',sub:'Model · tools · session',tag:'AG',layer:'runtime',x:598,y:215,w:240,h:69,detail:'Agent implementation prepares context, calls models, executes tools, and emits run events.',why:'Agent logic is a Python component within configured execution, not an obligatory microservice.',source:'agent/agent.py'},
 {id:'team',label:'Teams & Workflows',sub:'Delegation · ordered steps',tag:'WF',layer:'runtime',x:327,y:313,w:240,h:69,detail:'Teams coordinate agents; workflows orchestrate configured application steps.',why:'Multi-agent delegation and deterministic orchestration are distinct programming models.',source:'os/routers/teams/router.py'},
 {id:'worker',label:'Durable Queue Worker',sub:'Claim · lease · heartbeat',tag:'WK',layer:'runtime',x:598,y:313,w:240,h:69,detail:'Optional durable worker claims database-backed tickets and fences stale completions.',why:'One configured worker may run per replica; background in-process execution is a separate mode.',source:'os/job_queue.py'},
 {id:'sse',label:'Event / SSE Delivery',sub:'Live events · resume',tag:'SSE',layer:'runtime',x:327,y:411,w:240,h:69,detail:'AgentOS delivers streamed run content, including cross-replica resume with shared event transport.',why:'SSE is a client-facing connection, not the authoritative run database.',source:'os/routers/agents/router.py'},
 {id:'queue',label:'Queue Configuration',sub:'Admission · retry policy',tag:'Q',layer:'runtime',x:598,y:411,w:240,h:69,detail:'QueueConfig configures per-replica concurrency, durable acceptance, retries and optional Redis coordination.',why:'Queue configuration is not itself an independent message broker.',source:'job_queue/config.py'},
 {id:'model',label:'LLM Provider',sub:'Inference API · tokens',tag:'LLM',layer:'external',x:910,y:117,w:244,h:70,detail:'Configured model providers serve inference requests; throughput and cost may be limited externally.',why:'AgentOS does not automatically provide a self-hosted foundation model.',source:'agent/agent.py'},
 {id:'tools',label:'Tool Adapters',sub:'Python · HTTP · MCP',tag:'TOOL',layer:'external',x:910,y:215,w:244,h:70,detail:'Configured tools can invoke local code, protocols, or remote systems subject to application policy.',why:'Write-capable tools need authorization, idempotency, and secure execution boundaries.',source:'agent/agent.py'},
 {id:'knowledge',label:'Knowledge / Retrieval',sub:'Search · vector backend',tag:'KB',layer:'external',x:910,y:313,w:244,h:70,detail:'Optional knowledge and retrieval integrations query configured backends for relevant context.',why:'A knowledge interface does not imply every vector database is embedded inside AgentOS.',source:'knowledge/knowledge.py'},
 {id:'ext',label:'External Business APIs',sub:'Third-party state changes',tag:'EXT',layer:'external',x:910,y:411,w:244,h:70,detail:'Tool executions may create effects in independently owned external services.',why:'Run fencing does not reverse an external email, payment, or database write.',source:'os/job_queue.py'},
 {id:'postgres',label:'Operational Database',sub:'Sessions · runs · jobs',tag:'PG',layer:'data',x:330,y:598,w:239,h:94,detail:'PostgreSQL adapter persists normalized runs, sessions and optional durable queue tickets.',why:'Run state and job ownership are authoritative here when PostgreSQL is configured.',source:'db/postgres/schemas.py'},
 {id:'redis',label:'Redis / Valkey',sub:'Streams · cancellation',tag:'RED',layer:'data',x:598,y:598,w:239,h:94,detail:'Optional Redis coordination enables cross-replica event replay and cancellation signals.',why:'Events have retention limits; persisted final run state remains in the configured database.',source:'os/event_streams/redis.py'},
 {id:'tracing',label:'Trace & Metrics',sub:'Spans · run diagnostics',tag:'OBS',layer:'ops',x:910,y:598,w:244,h:56,detail:'Observability records and operational metrics help diagnose execution across requests and workers.',why:'Telemetry storage, cardinality and retention require explicit operational decisions.',source:'os/routers/traces/traces.py'},
 {id:'control',label:'Control Plane / Admin',sub:'Inspect · govern · manage',tag:'OPS',layer:'ops',x:910,y:672,w:244,h:56,detail:'Separate administration and operational tools may inspect or manage the runtime through its APIs.',why:'An operations interface is not automatically on every model inference request path.',source:'os/app.py'}
];
const edges = [
 {id:'client-edge',from:'client',to:'edge',kind:'http',label:'HTTPS'},
 {id:'edge-api',from:'edge',to:'api',kind:'http',label:'HTTP'},
 {id:'api-auth',from:'api',to:'auth',kind:'policy',label:'Auth gate'},
 {id:'api-registry',from:'api',to:'registry',kind:'invoke',label:'Resolve'},
 {id:'registry-agent',from:'registry',to:'agent',kind:'invoke',label:'Run'},
 {id:'registry-team',from:'registry',to:'team',kind:'invoke',label:'Dispatch'},
 {id:'team-agent',from:'team',to:'agent',kind:'invoke',label:'Delegate'},
 {id:'agent-model',from:'agent',to:'model',kind:'http',label:'Inference'},
 {id:'agent-tools',from:'agent',to:'tools',kind:'invoke',label:'Tool call'},
 {id:'agent-knowledge',from:'agent',to:'knowledge',kind:'data',label:'Retrieve'},
 {id:'tools-ext',from:'tools',to:'ext',kind:'http',label:'External call'},
 {id:'agent-postgres',from:'agent',to:'postgres',kind:'data',label:'Run state'},
 {id:'agent-sse',from:'agent',to:'sse',kind:'event',label:'Run events'},
 {id:'sse-edge',from:'sse',to:'edge',kind:'event',label:'SSE'},
 {id:'api-queue',from:'api',to:'queue',kind:'invoke',label:'Enqueue'},
 {id:'queue-postgres',from:'queue',to:'postgres',kind:'data',label:'Ticket'},
 {id:'worker-postgres',from:'worker',to:'postgres',kind:'data',label:'Lease / claim'},
 {id:'worker-agent',from:'worker',to:'agent',kind:'invoke',label:'Execute'},
 {id:'worker-redis',from:'worker',to:'redis',kind:'event',label:'XADD'},
 {id:'redis-sse',from:'redis',to:'sse',kind:'event',label:'Replay'},
 {id:'auth-postgres',from:'auth',to:'postgres',kind:'data',label:'Scope data'},
 {id:'agent-tracing',from:'agent',to:'tracing',kind:'event',label:'Spans'},
 {id:'worker-tracing',from:'worker',to:'tracing',kind:'event',label:'Worker state'},
 {id:'control-api',from:'control',to:'api',kind:'http',label:'Admin APIs'}
];
const iconFor = {
 client:'screen',edge:'network',api:'server',auth:'shield',registry:'boxes',agent:'chip',
 team:'users',worker:'worker',sse:'radio',queue:'list',model:'chip',tools:'wrench',
 knowledge:'book',ext:'plug',postgres:'database',redis:'layers',tracing:'activity',control:'sliders'
};
const byId = Object.fromEntries(nodes.map(node=>[node.id,node]));
function line(a,b){
 const u=byId[a],v=byId[b];
 const cx=u.x+u.w/2,cy=u.y+u.h/2,dx=v.x+v.w/2,dy=v.y+v.h/2;
 if(Math.abs(dx-cx)>Math.abs(dy-cy)*1.15){
   const right=dx>cx,sx=right?u.x+u.w:u.x,tx=right?v.x:v.x+v.w,k=Math.min(100,Math.abs(tx-sx)*.42);
   return 'M'+sx+' '+cy+' C'+(sx+(right?k:-k))+' '+cy+' '+(tx+(right?-k:k))+' '+dy+' '+tx+' '+dy;
 }
 const down=dy>cy,sy=down?u.y+u.h:u.y,ty=down?v.y:v.y+v.h,k=Math.min(90,Math.abs(ty-sy)*.4);
 return 'M'+cx+' '+sy+' C'+cx+' '+(sy+(down?k:-k))+' '+dx+' '+(ty+(down?-k:k))+' '+dx+' '+ty;
}
