/**
 * Illustrated system/container map, grounded in pinned Agno source.
 * Replica diagram is a recommended example, not Agno's mandatory deployment.
 */
const revision = '1f2aac51eb28dc9c0970836d3b7ae046bae81bbb';
const sourceRoot = 'https://github.com/agno-agi/agno/blob/' + revision + '/libs/agno/agno/';
const bounds = [
  {name:'01 / EXPERIENCE & INGRESS',x:20,y:56,w:260,h:457,tone:'client',summary:'Outside AgentOS'},
  {name:'02 / AGENTOS REPLICA FLEET',x:298,y:56,w:570,h:457,tone:'runtime',summary:'Co-deployed modules ≠ microservices'},
  {name:'03 / EXTERNAL DEPENDENCIES',x:885,y:56,w:295,h:457,tone:'external',summary:'Configured providers and integrations'},
  {name:'04 / DURABLE STATE & COORDINATION',x:298,y:535,w:570,h:204,tone:'data',summary:'Operational store + optional transport'},
  {name:'05 / OPERATIONS & GOVERNANCE',x:885,y:535,w:295,h:204,tone:'ops',summary:'Not required in inference data path'}
];
const nodes = [
 {id:'client',label:'Application / SDK',sub:'Browser · API clients',tag:'UI',layer:'client',x:44,y:118,w:211,h:70,detail:'Client application submits a run, consumes output, and may reconnect to the runtime.',why:'The user interface does not execute Python agent work.',source:'os/routers/agents/router.py'},
 {id:'edge',label:'Ingress / Gateway',sub:'Load balancer · TLS',tag:'LB',layer:'client',x:44,y:236,w:211,h:70,detail:'Illustrative infrastructure forwards requests to available AgentOS replicas.',why:'A load balancer is deployment infrastructure, not an Agno SDK microservice.',source:'os/app.py'},
 {id:'api',label:'AgentOS API',sub:'FastAPI · HTTP endpoints',tag:'API',layer:'runtime',x:327,y:117,w:240,h:69,detail:'FastAPI application composes agent, team, workflow, session, queue and operations routers.',why:'API routing is typically part of the AgentOS process, not a separate service per router.',source:'os/app.py'},
 {id:'auth',label:'Auth & User Scope',sub:'JWT · authorization gates',tag:'ID',layer:'runtime',x:598,y:117,w:240,h:69,detail:'Authentication and authorization guards enforce caller authority and scoped access.',why:'A supplied user/tenant ID must never be accepted as authorization by itself.',source:'os/auth.py'},
 {id:'registry',label:'Component Registry',sub:'Agent · Team · Workflow',tag:'REG',layer:'runtime',x:327,y:215,w:240,h:69,detail:'Runtime resolves registered agent, team, and workflow components for execution.',why:'Component registration and selection are not necessarily a new network hop.',source:'os/app.py'},
 {id:'agent',label:'Agent Runtime',sub:'Model · tools · session',tag:'AG',layer:'runtime',x:598,y:215,w:240,h:69,detail:'Agent implementation prepares context, calls models, executes tools, and emits run events.',why:'Agent logic is a Python component within configured execution, not an obligatory microservice.',source:'agent/agent.py'},
 {id:'team',label:'Teams & Workflows',sub:'Delegation · ordered steps',tag:'WF',layer:'runtime',x:327,y:313,w:240,h:69,detail:'Teams coordinate agents; workflows orchestrate configured application steps.',why:'Multi-agent delegation and deterministic orchestration are distinct programming models.',source:'os/routers/teams/router.py'},
 {id:'worker',label:'Durable Queue Worker',sub:'Claim · lease · heartbeat',tag:'WK',layer:'runtime',x:598,y:313,w:240,h:69,detail:'Optional durable worker claims database-backed tickets and fences stale completions.',why:'One configured worker may run per replica; background in-process execution is a separate mode.',source:'os/job_queue.py'},
 {id:'sse',label:'Event / SSE Delivery',sub:'Live events · resume',tag:'SSE',layer:'runtime',x:327,y:411,w:240,h:69,detail:'AgentOS delivers streamed run content, including cross-replica resume with shared event transport.',why:'SSE is a client-facing connection, not the authoritative run database.',source:'os/routers/agents/router.py'},
 {id:'queue',label:'Queue Configuration',sub:'Admission · retry policy',tag:'Q',layer:'runtime',x:598,y:411,w:240,h:69,detail:'QueueConfig configures per-replica concurrency, durable acceptance, retries and optional Redis coordination.',why:'Queue configuration is not itself an independent message broker.',source:'job_queue/config.py'},
 {id:'model',label:'LLM Provider',sub:'Inference API · tokens',tag:'LLM',layer:'external',x:910,y:117,w:244,h:70,detail:'Configured model providers serve inference requests; throughput and cost may be limited externally.',why:'AgentOS does not automatically provide a self-hosted foundation model.',source:'agent/agent.py'},
 {id:'tools',label:'Tool Adapters',sub:'Python · HTTP · MCP',tag:'TOOL',layer:'external',x:910,y:215,w:244,h:70,detail:'Configured tools can invoke local code, protocols, or remote systems subject to application policy.',why:'Write-capable tools need authorization, idempotency, and secure execution boundaries.',source:'agent/agent.py'},
 {id:'knowledge',label:'Knowledge / Retrieval',sub:'Search · vector backend',tag:'KB',layer:'external',x:910,y:313,w:244,h:70,detail:'Optional knowledge and retrieval integrations query configured backends for relevant context.',why:'A knowledge interface does not imply every vector database is embedded inside AgentOS.',source:'knowledge/knowledge.py'},
 {id:'ext',label:'External Business APIs',sub:'Third-party state changes',tag:'EXT',layer:'external',x:910,y:411,w:244,h:70,detail:'Tool executions may create effects in independently owned external services.',why:'Run fencing does not reverse an external email, payment, or database write.',source:'os/job_queue.py'},
 {id:'postgres',label:'Operational Database',sub:'Sessions · runs · jobs',tag:'PG',layer:'data',x:330,y:598,w:239,h:94,detail:'PostgreSQL adapter persists normalized runs, sessions and optional durable queue tickets.',why:'Run state and job ownership are authoritative here when PostgreSQL is configured.',source:'db/postgres/schemas.py'},
 {id:'redis',label:'Redis / Valkey',sub:'Streams · cancellation',tag:'RED',layer:'data',x:598,y:598,w:239,h:94,detail:'Optional Redis coordination enables cross-replica event replay and cancellation signals.',why:'Events have retention limits; persisted final run state remains in the configured database.',source:'os/event_streams/redis.py'},
 {id:'tracing',label:'Trace & Metrics',sub:'Spans · run diagnostics',tag:'OBS',layer:'ops',x:910,y:598,w:244,h:56,detail:'Observability records and operational metrics help diagnose execution across requests and workers.',why:'Telemetry storage, cardinality and retention require explicit operational decisions.',source:'os/routers/traces/traces.py'},
 {id:'control',label:'Control Plane / Admin',sub:'Inspect · govern · manage',tag:'OPS',layer:'ops',x:910,y:672,w:244,h:56,detail:'Separate administration and operational tools may inspect or manage the runtime through its APIs.',why:'An operations interface is not automatically on every model inference request path.',source:'os/app.py'}
];
const edges = [
 {id:'client-edge',from:'client',to:'edge',kind:'http',label:'HTTPS'},
 {id:'edge-api',from:'edge',to:'api',kind:'http',label:'HTTP'},
 {id:'api-auth',from:'api',to:'auth',kind:'policy',label:'Auth gate'},
 {id:'api-registry',from:'api',to:'registry',kind:'invoke',label:'Resolve'},
 {id:'registry-agent',from:'registry',to:'agent',kind:'invoke',label:'Run'},
 {id:'registry-team',from:'registry',to:'team',kind:'invoke',label:'Dispatch'},
 {id:'team-agent',from:'team',to:'agent',kind:'invoke',label:'Delegate'},
 {id:'agent-model',from:'agent',to:'model',kind:'http',label:'Inference'},
 {id:'agent-tools',from:'agent',to:'tools',kind:'invoke',label:'Tool call'},
 {id:'agent-knowledge',from:'agent',to:'knowledge',kind:'data',label:'Retrieve'},
 {id:'tools-ext',from:'tools',to:'ext',kind:'http',label:'External call'},
 {id:'agent-postgres',from:'agent',to:'postgres',kind:'data',label:'Run state'},
 {id:'agent-sse',from:'agent',to:'sse',kind:'event',label:'Run events'},
 {id:'sse-edge',from:'sse',to:'edge',kind:'event',label:'SSE'},
 {id:'api-queue',from:'api',to:'queue',kind:'invoke',label:'Enqueue'},
 {id:'queue-postgres',from:'queue',to:'postgres',kind:'data',label:'Ticket'},
 {id:'worker-postgres',from:'worker',to:'postgres',kind:'data',label:'Lease / claim'},
 {id:'worker-agent',from:'worker',to:'agent',kind:'invoke',label:'Execute'},
 {id:'worker-redis',from:'worker',to:'redis',kind:'event',label:'XADD'},
 {id:'redis-sse',from:'redis',to:'sse',kind:'event',label:'Replay'},
 {id:'auth-postgres',from:'auth',to:'postgres',kind:'data',label:'Scope data'},
 {id:'agent-tracing',from:'agent',to:'tracing',kind:'event',label:'Spans'},
 {id:'worker-tracing',from:'worker',to:'tracing',kind:'event',label:'Worker state'},
 {id:'control-api',from:'control',to:'api',kind:'http',label:'Admin APIs'}
];
const byId = Object.fromEntries(nodes.map(node=>[node.id,node]));
function line(a,b){
 const u=byId[a],v=byId[b];
 const cx=u.x+u.w/2,cy=u.y+u.h/2,dx=v.x+v.w/2,dy=v.y+v.h/2;
 if(Math.abs(dx-cx)>Math.abs(dy-cy)*1.15){
   const right=dx>cx,sx=right?u.x+u.w:u.x,tx=right?v.x:v.x+v.w,k=Math.min(100,Math.abs(tx-sx)*.42);
   return 'M'+sx+' '+cy+' C'+(sx+(right?k:-k))+' '+cy+' '+(tx+(right?-k:k))+' '+dy+' '+tx+' '+dy;
 }
 const down=dy>cy,sy=down?u.y+u.h:u.y,ty=down?v.y:v.y+v.h,k=Math.min(90,Math.abs(ty-sy)*.4);
 return 'M'+cx+' '+sy+' C'+cx+' '+(sy+(down?k:-k))+' '+dx+' '+(ty+(down?-k:k))+' '+dx+' '+ty;
}
---
<section id="agno-infographic" class="ai" aria-labelledby="ai-heading">
  <header class="ai-header">
    <div>
      <p class="ai-overline">AGNO / AGENTOS · ARCHITECTURE ATLAS</p>
      <h3 id="ai-heading">One platform. All the important connections.</h3>
      <p>Select any component to illuminate its dependencies. Switch execution paths to see <em>why</em> each relationship exists.</p>
    </div>
    <span class="ai-rev">SOURCE SNAPSHOT <strong>{revision.slice(0, 8)}</strong></span>
  </header>
  <div class="ai-stats" aria-label="Architecture metadata">
    <span><b>{nodes.length}</b> components</span><span><b>{edges.length}</b> modeled relationships</span><span><b>{bounds.length}</b> bounded areas</span>
    <span class="ai-stats-note">Representative multi-replica deployment · optional elements labeled</span>
  </div>
  <div class="ai-toolbar">
    <div class="ai-filter" role="group" aria-label="Highlight architecture layer">
      {['all','runtime','data','external','ops','client'].map(layer=><button type="button" data-layer={layer} aria-pressed={layer==='all'}>{layer==='all'?'All layers':layer==='external'?'Integrations':layer==='client'?'Ingress':layer==='ops'?'Operations':layer==='data'?'State': 'Runtime'}</button>)}
    </div>
    <div class="ai-zoom" role="group" aria-label="Diagram zoom controls">
      <button id="ai-lines" type="button" aria-pressed="false" aria-label="Show all modeled connections">Show all links</button>
      <button id="ai-zoom-out" aria-label="Zoom out" type="button">−</button>
      <button id="ai-zoom-in" aria-label="Zoom in" type="button">+</button>
      <button id="ai-fit" aria-label="Fit entire diagram" type="button">Fit</button>
      <button id="ai-clear" aria-label="Clear component focus" type="button">Reset</button>
    </div>
  </div>
  <div class="ai-reader" aria-label="Architecture navigation">
    <div class="ai-reader-message"><strong>Explore the system by subsystem.</strong><span>Start with the whole platform, then magnify a boundary to read the component labels and connections.</span></div>
    <label for="ai-region">View architecture area
      <select id="ai-region" aria-label="View architecture area">
        <option value="all">Complete architecture</option>
        <option value="client">Client and ingress</option>
        <option value="api">AgentOS · API and registry</option>
        <option value="runtime">AgentOS · runtime and worker</option>
        <option value="external">Models, tools and knowledge</option>
        <option value="data">PostgreSQL and Redis</option>
        <option value="ops">Operations and governance</option>
      </select>
    </label>
    <label for="ai-find">Find component
      <select id="ai-find" aria-label="Find architecture component">
        <option value="">Choose a component...</option>
        {nodes.map(node=><option value={node.id}>{node.label}</option>)}
      </select>
    </label>
  </div>
  <div class="ai-workspace">
    <div class="ai-map">
      <div class="ai-canvas" id="ai-canvas">
        <svg id="ai-svg" viewBox="0 0 1200 762" role="group" aria-label="Interactive architecture showing ingress, AgentOS runtime, external APIs, state, and operations. Select nodes to inspect relationships." tabindex="0">
          <defs>
            <pattern id="ai-grid" width="20" height="20" patternUnits="userSpaceOnUse"><circle cx="1" cy="1" r=".8" class="ai-dot"/></pattern>
            <marker id="ai-arrow" markerWidth="7" markerHeight="7" refX="6" refY="3.5" orient="auto" markerUnits="userSpaceOnUse"><path d="M0 0 L7 3.5 L0 7Z" class="ai-arrow-head"/></marker>
          </defs>
          <rect x="0" y="0" width="1200" height="762" class="ai-base"/>
          <rect x="0" y="0" width="1200" height="762" fill="url(#ai-grid)"/>
          {bounds.map(b=><g class={'ai-boundary ai-boundary-'+b.tone}>
            <rect x={b.x} y={b.y} width={b.w} height={b.h} rx="15"/>
            <text x={b.x+14} y={b.y+24} class="ai-boundary-title">{b.name}</text>
            <text x={b.x+14} y={b.y+44} class="ai-boundary-sub">{b.summary}</text>
          </g>)}
          <g id="ai-edges" class="ai-edge-layer">
            {edges.map(e=><path d={line(e.from,e.to)} class={'ai-edge ai-edge-'+e.kind} data-link={e.id} data-from={e.from} data-to={e.to} data-kind={e.kind} data-label={e.label} vector-effect="non-scaling-stroke" marker-end="url(#ai-arrow)"><title>{e.from+' → '+e.to+' · '+e.label}</title></path>)}
          </g>
          <g id="ai-nodes">
            {nodes.map(n=><g class={'ai-node ai-node-'+n.layer} data-node={n.id} data-layer={n.layer} data-detail={n.detail} data-why={n.why} data-source={n.source} data-label={n.label} role="button" tabindex="0" aria-label={'Inspect '+n.label}>
              <rect class="ai-node-rect" x={n.x} y={n.y} width={n.w} height={n.h} rx="10"/>
              <rect class="ai-node-symbol" x={n.x+11} y={n.y+13} width="43" height="43" rx="9"/>
              <text class="ai-node-symbol-text" x={n.x+32.5} y={n.y+39} text-anchor="middle">{n.tag}</text>
              <text class="ai-node-label" x={n.x+64} y={n.y+29}>{n.label}</text>
              <text class="ai-node-sub" x={n.x+64} y={n.y+47}>{n.sub}</text>
              <title>{n.label+': '+n.detail}</title>
            </g>)}
          </g>
          <g id="ai-step-annotation" visibility="hidden" pointer-events="none">
            <rect id="ai-step-bg" width="145" height="28" rx="8"/>
            <text id="ai-step-label" x="11" y="19">HTTP request</text>
          </g>
        </svg>
      </div>
      <div class="ai-map-caption" role="status" aria-live="polite">
        <span id="ai-view-status">Complete architecture · essential paths emphasized</span>
        <span id="ai-edge-status">Select a node or scenario to explore connections.</span>
      </div>
      <div class="ai-canvas-foot">
        <span>Drag empty canvas to pan · wheel/pinch to zoom · select a component to highlight relationships</span>
        <button type="button" id="ai-toggle-fit">Fit all / scroll</button>
      </div>
    </div>
    <aside class="ai-aside" aria-label="Architecture inspector">
      <p class="ai-inspector-kicker">CONNECTION INSPECTOR</p>
      <h4 id="ai-selected-title">Platform overview</h4>
      <p id="ai-selected-detail">AgentOS runs Python components behind a FastAPI application. Shared persistence and optional Redis coordination make a replicated deployment possible.</p>
      <div class="ai-inspector-section">
        <span class="ai-section-label">WHY IT MATTERS</span>
        <p id="ai-selected-why">Select an element to reveal real dependencies and source references. All nodes stay visible to maintain the big picture.</p>
      </div>
      <div class="ai-inspector-section">
        <span class="ai-section-label">DIRECT CONNECTIONS <span id="ai-rel-count"></span></span>
        <div id="ai-relations"><p class="ai-placeholder">Select a component on the map to inspect its incoming and outgoing relationships.</p></div>
      </div>
      <a id="ai-source" href={'https://github.com/agno-agi/agno/tree/'+revision} target="_blank" rel="noopener noreferrer">Browse pinned Agno source ↗</a>
    </aside>
  </div>
  <div class="ai-story">
    <div class="ai-story-head"><span>TRACE A RELATIONSHIP PATH</span><small>Scenarios highlight illustrative routing, not captured request traces.</small></div>
    <div class="ai-scenarios" role="group" aria-label="Architecture scenarios">
      {[
        {id:'overview',name:'All connections'},
        {id:'answer',name:'Direct answer'},
        {id:'tools',name:'Tool execution'},
        {id:'queue',name:'Durable background'},
        {id:'resume',name:'Reconnect / SSE'},
        {id:'failure',name:'Worker recovery'}
      ].map((s,i)=><button type="button" data-scenario={s.id} aria-pressed={i===0}>{s.name}</button>)}
    </div>
    <div class="ai-flow-row">
      <button type="button" id="ai-prev" aria-label="Previous relation">←</button>
      <div class="ai-story-copy"><strong id="ai-story-title">Explore the entire topology</strong><span id="ai-story-description">Select a scenario to highlight ordered relationships; select any component to inspect its code and dependencies.</span></div>
      <div class="ai-stepcounter" id="ai-step-count">—</div>
      <button type="button" id="ai-next" aria-label="Next relation">→</button>
    </div>
  </div>
  <div class="ai-legend">
    <span><i class="ai-key ai-k-http"></i> HTTP / API</span>
    <span><i class="ai-key ai-k-invoke"></i> In-process call</span>
    <span><i class="ai-key ai-k-data"></i> State / retrieval</span>
    <span><i class="ai-key ai-k-event"></i> Events / SSE</span>
    <span><i class="ai-key ai-k-policy"></i> Authorization</span>
  </div>
  <footer class="ai-foot">
    <b>Source versus topology:</b> Router, worker, queue, storage, and streaming modules are verified at
    <a href={'https://github.com/agno-agi/agno/tree/'+revision} target="_blank" rel="noopener noreferrer">Agno {revision.slice(0,8)}</a>.
    Boxes are logical/deployment boundaries; optional Redis, knowledge, control-plane connections and infrastructure are deployment choices, not separate built-in microservices. Flow paths are educational illustrations.
  </footer>
</section>
<style>
.ai{--a-bg:var(--color-surface,#0c1726);--a-panel:var(--color-surface-2,#142337);--a-text:var(--color-text,#eff6fc);--a-muted:var(--color-text-dim,#a4b7c8);--a-border:var(--color-border,#3c5066);--a-accent:var(--color-accent,#51d7ba);--a-link:#67a9ef;--a-call:#4cbca8;--a-db:#ad8ff3;--a-event:#dc9e58;--a-policy:#e38e95;position:relative;left:50%;transform:translateX(-50%);width:min(1190px,calc(100vw - 20px));max-width:none!important;margin:2.5rem 0;background:var(--a-bg);color:var(--a-text);border:1px solid var(--a-border);border-radius:20px;overflow:hidden;font-family:inherit;box-shadow:0 16px 52px #00000016}
.ai *{box-sizing:border-box}
.ai-reader{display:grid;grid-template-columns:minmax(200px,1fr) minmax(145px,198px) minmax(155px,214px);gap:12px;align-items:center;margin:0 15px 13px;padding:13px 15px;border:1px solid var(--a-border);border-radius:12px;background:linear-gradient(105deg,color-mix(in srgb,var(--a-link) 7%,var(--a-panel)),var(--a-panel))}
.ai-reader-message{display:grid;gap:4px}.ai-reader-message strong{font-size:.79rem;color:var(--a-text)}.ai-reader-message span{font-size:.69rem;color:var(--a-muted);line-height:1.45}
.ai-reader label{display:grid;gap:5px;font:700 .64rem ui-monospace,monospace;letter-spacing:.04em;color:var(--a-muted)}
.ai-reader select{width:100%;min-width:0;padding:9px 10px;border:1px solid var(--a-border);border-radius:8px;background:var(--a-bg);color:var(--a-text);font:600 .73rem system-ui}
.ai-reader select:focus-visible{outline:2px solid var(--a-accent);outline-offset:2px}
