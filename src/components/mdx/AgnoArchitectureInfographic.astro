let focused=null,layer='all',scenario='overview',step=-1,showAll=false,playTimer=null;
const evidence={
 'client-edge':['HTTPS · browser → ingress','Client sends a request to the application gateway.','Ingress does not own agent run state.','os/routers/agents/router.py'],
 'edge-api':['HTTP · gateway → FastAPI','Request arrives at the selected AgentOS router.','The route chooses the configured execution mode.','os/routers/agents/router.py'],
 'api-auth':['Authorization · caller scope','Configured authentication and authorization checks run.','Never trust a client-supplied user ID as an access check.','os/auth.py'],
 'api-registry':['Python · resolve component','Registered agent/team/workflow is resolved.','Normally an in-process call, not an extra microservice hop.','os/app.py'],
 'registry-agent':['Python · agent.arun','AgentOS invokes the configured asynchronous agent.','Inline SSE may stop if the client disconnects.','os/routers/agents/router.py'],
 'agent-model':['Inference API · model','Model provider executes a generation request.','External quotas and latency can dominate throughput.','agent/agent.py'],
 'agent-tools':['Python · invoke tool','Agent executes a configured tool implementation.','Side-effecting tools need permissions and idempotency.','agent/agent.py'],
 'tools-ext':['Connector · external API','Tool executes against a downstream business service.','A timeout does not prove the downstream write failed.','agent/agent.py'],
 'agent-sse':['Event · run stream','Agent emits an SSE-formatted event.','A transient event is not a durable job record.','os/routers/agents/router.py'],
 'sse-edge':['SSE · client response','Gateway forwards event stream to the client.','Client disconnect is separate from durable worker ownership.','os/routers/agents/router.py'],
 'api-queue':['Queue · durable admission','HTTP request submits a durable queue ticket.','Committed ticket precedes durable acceptance response.','os/job_queue.py'],
 'queue-postgres':['PostgreSQL · job ticket','QueuedJob records an accepted run and retry metadata.','Database ticket drives worker claim and ownership.','db/schemas/jobs.py'],
 'worker-postgres':['PostgreSQL · claim / lease','Worker claims ticket and maintains lease heartbeat.','Attempt fencing rejects stale completion writes.','os/job_queue.py'],
 'worker-agent':['Python · execute agent','Worker resolves and executes the configured component.','External tool effects are outside the queue transaction.','os/job_queue.py'],
 'agent-postgres':['PostgreSQL · run state','Run/session status and output are persisted.','Final result outlives ephemeral Redis streaming keys.','db/postgres/schemas.py'],
 'worker-redis':['Redis Stream · XADD','Worker publishes run events to shared Redis stream.','Replay is time/length bounded, not indefinite.','os/event_streams/redis.py'],
 'redis-sse':['Redis Stream · XRANGE / XREAD','A replica replays or tails retained per-run events.','After expiry, clients need persisted terminal-state fallback.','os/event_streams/redis.py']
};
function stopPlayback(){if(playTimer!==null){clearInterval(playTimer);playTimer=null}get('ai-play').setAttribute('aria-pressed','false');get('ai-play').textContent='▶ Play walkthrough'}
function updateEvidence(edge){
 if(!edge){
  get('ai-runtime-protocol').textContent='Choose an execution scenario';
  get('ai-runtime-payload').textContent='HTTP · SSE · Python calls · database state';
  get('ai-runtime-state').textContent='No execution step selected. This map is explanatory, not production telemetry.';
  get('ai-runtime-source').href='https://github.com/agno-agi/agno/tree/'+revision;
  get('ai-runtime-proof').textContent='Each selected relationship links to pinned source.';
  return
 }
 const e=evidence[edge.dataset.link],a=nodeMap[edge.dataset.from],b=nodeMap[edge.dataset.to];
 get('ai-runtime-protocol').textContent=e?e[0]:edge.dataset.kind.toUpperCase()+' · '+edge.dataset.label;
 get('ai-runtime-payload').textContent=a.dataset.label+' → '+b.dataset.label+'\n'+(e?e[1]:'Conceptual relationship; not captured protocol traffic.');
 get('ai-runtime-state').textContent=e?e[2]:a.dataset.detail;
 const path=e?e[3]:a.dataset.source;
 get('ai-runtime-source').href='https://github.com/agno-agi/agno/blob/'+revision+'/libs/agno/agno/'+path;
 get('ai-runtime-proof').textContent='Pinned implementation · '+path;
}
function followEdge(edge){
 if(!edge||!get('ai-follow').checked)return;
 const to=nodeMap[edge.dataset.to].getBBox();
 const centerX=to.x+to.width/2,centerY=to.y+to.height/2;
 const small=window.matchMedia('(max-width:700px)').matches,w=small?355:650,h=small?315:470;
 view={x:centerX-w/2,y:centerY-h/2,w,h};updateView();canvas.classList.add('is-fit');
 get('ai-region').value='all';get('ai-view-status').textContent='Following active execution';
}
const majorEdges=new Set(['client-edge','edge-api','api-registry','registry-agent','agent-model','agent-tools','agent-postgres','agent-sse','sse-edge','worker-postgres','worker-agent','worker-redis','redis-sse']);
function connected(id){return edgeEls.filter(e=>e.dataset.from===id||e.dataset.to===id)}
function set(el,txt){el.textContent=txt}
function setFocus(id){
 focused=id||null;paint();
 get('ai-find').value=focused||'';
 set(get('ai-edge-status'),focused?'Inspecting incoming and outgoing connections for '+nodeMap[focused].dataset.label+'.':'Select a node or scenario to explore connections.');
 const target=nodeMap[id];if(!target){set(get('ai-selected-title'),'Platform overview');set(get('ai-selected-detail'),'AgentOS runs Python components behind a FastAPI application. Shared persistence and optional coordination allow multi-replica deployment.');set(get('ai-selected-why'),'Select a component to reveal connected services, relationships and source files.');get('ai-source').href='https://github.com/agno-agi/agno/tree/'+revision;get('ai-rel-count').textContent='';get('ai-relations').replaceChildren();return}
 set(get('ai-selected-title'),target.dataset.label);set(get('ai-selected-detail'),target.dataset.detail);set(get('ai-selected-why'),target.dataset.why);get('ai-source').href='https://github.com/agno-agi/agno/blob/'+revision+'/libs/agno/agno/'+target.dataset.source;
 const rel=connected(id);get('ai-rel-count').textContent='('+rel.length+')';
 const box=get('ai-relations');box.replaceChildren();rel.forEach(e=>{const out=e.dataset.from===id,other=out?e.dataset.to:e.dataset.from;
 const b=document.createElement('button');b.type='button';b.className='ai-rel-link';const label=document.createElement('span'),small=document.createElement('small');label.textContent=(out?'→ ':'← ')+nodeMap[other].dataset.label;small.textContent=e.dataset.kind.toUpperCase()+' · '+e.dataset.label;b.append(label,small);b.addEventListener('click',()=>setFocus(other));box.append(b)});
}
function paint(){
 const related=new Set([focused]);
 const incident=focused?new Set(connected(focused).map(e=>{related.add(e.dataset.from);related.add(e.dataset.to);return e.dataset.link})) : null;
 const path=scenarios[scenario].edges;
 const active=new Set(path.slice(0,step+1)),allPath=new Set(path);
 edgeEls.forEach(e=>{const match=focused?incident.has(e.dataset.link):scenario==='overview'?false:active.has(e.dataset.link);
 e.classList.toggle('is-active',!!match);
 e.classList.toggle('is-past',!focused&&scenario!=='overview'&&allPath.has(e.dataset.link)&&!match);
 e.style.opacity=focused?(match?'1':'.035'):scenario!=='overview'?(active.has(e.dataset.link)?'1':allPath.has(e.dataset.link)?'.30':'.04'):(showAll?'.36':majorEdges.has(e.dataset.link)?'.63':'.045');
 });
 const flowNodes=new Set();if(scenario!=='overview'){path.slice(0,Math.max(1,step+1)).forEach(id=>{let e=edgeEls.find(x=>x.dataset.link===id);if(e){flowNodes.add(e.dataset.from);flowNodes.add(e.dataset.to)}})}
 get('ai-step-annotation').setAttribute('visibility',(!focused&&scenario!=='overview')?'visible':'hidden');
 nodeEls.forEach(el=>{const id=el.dataset.node;const filter=layer==='all'||el.dataset.layer===layer;const eligible=focused?related.has(id):scenario==='overview'?true:flowNodes.has(id);
 el.classList.toggle('is-focused',focused===id);el.classList.toggle('is-adjacent',!!focused&&id!==focused&&related.has(id));el.classList.toggle('is-dimmed',(!eligible||!filter)&&id!==focused);
 });
}
function scenarioText(){
 const s=scenarios[scenario],ids=s.edges; if(scenario==='overview'){get('ai-step-annotation').setAttribute('visibility','hidden');set(get('ai-story-title'),s.title);set(get('ai-story-description'),s.description);set(get('ai-step-count'),'—');get('ai-play').disabled=true;get('ai-scrub').disabled=true;get('ai-scrub').max=0;get('ai-scrub').value=0;updateEvidence(null);return}
 const edge=edgeEls.find(e=>e.dataset.link===ids[step]);
 const from=edge?nodeMap[edge.dataset.from]?.dataset.label:'',to=edge?nodeMap[edge.dataset.to]?.dataset.label:'';
 if(edge){
  const distance=edge.getTotalLength(),position=edge.getPointAtLength(distance*.5);
  const label=(step+1)+' · '+edge.dataset.label;
  const w=Math.min(220,Math.max(90,20+label.length*6.3));
  get('ai-step-bg').setAttribute('width',String(w));
  get('ai-step-label').textContent=label;
  get('ai-step-annotation').setAttribute('transform','translate('+Math.max(4,Math.min(1200-w-4,position.x-w/2))+' '+Math.max(56,Math.min(720,position.y-33))+')');
 }
 set(get('ai-edge-status'),edge?'Step '+(step+1)+' · '+edge.dataset.kind.toUpperCase()+' · '+from+' → '+to:'Select a node or scenario to explore connections.');
 set(get('ai-story-title'),edge?from+' → '+to:s.title);
 set(get('ai-story-description'),edge?edge.dataset.label+' · '+s.description:s.description);
 set(get('ai-step-count'),String(step+1).padStart(2,'0')+' / '+String(ids.length).padStart(2,'0'));
 get('ai-play').disabled=false;get('ai-scrub').disabled=false;get('ai-scrub').max=ids.length-1;get('ai-scrub').value=step;
 updateEvidence(edge);followEdge(edge);
}
nodeEls.forEach(el=>{const activate=()=>{stopPlayback();setFocus(el.dataset.node)};el.addEventListener('click',activate);el.addEventListener('keydown',e=>{if(e.key==='Enter'||e.key===' '){e.preventDefault();activate()}})});
get('ai-lines').addEventListener('click',()=>{showAll=!showAll;get('ai-lines').setAttribute('aria-pressed',String(showAll));get('ai-lines').textContent=showAll?'Essential links':'Show all links';paint()});
root.querySelectorAll('.ai-filter [data-layer]').forEach(b=>b.addEventListener('click',()=>{layer=b.dataset.layer;root.querySelectorAll('.ai-filter [data-layer]').forEach(x=>x.setAttribute('aria-pressed',String(x===b)));paint()}));
root.querySelectorAll('[data-scenario]').forEach(b=>b.addEventListener('click',()=>{stopPlayback();scenario=b.dataset.scenario;step=scenario==='overview'?-1:0;focused=null;root.querySelectorAll('[data-scenario]').forEach(x=>x.setAttribute('aria-pressed',String(x===b)));setFocus(null);scenarioText()}));
function go(delta){const length=scenarios[scenario].edges.length;if(!length)return;step=Math.max(0,Math.min(length-1,step+delta));focused=null;setFocus(null);scenarioText()}
get('ai-prev').addEventListener('click',()=>{stopPlayback();go(-1)});get('ai-next').addEventListener('click',()=>{stopPlayback();go(1)});
get('ai-scrub').addEventListener('input',e=>{stopPlayback();step=Number(e.target.value);focused=null;setFocus(null);scenarioText()});
get('ai-play').addEventListener('click',()=>{
 if(playTimer!==null){stopPlayback();return}
 if(scenario==='overview')return;
 if(step===scenarios[scenario].edges.length-1){step=0;focused=null;setFocus(null);scenarioText()}
 get('ai-play').setAttribute('aria-pressed','true');get('ai-play').textContent='Ⅱ Pause walkthrough';
 playTimer=setInterval(()=>{
  if(step>=scenarios[scenario].edges.length-1){stopPlayback();return}
  go(1)
 },1700)
});
get('ai-follow').addEventListener('change',()=>{
 if(get('ai-follow').checked&&scenario!=='overview'){
  const e=edgeEls.find(e=>e.dataset.link===scenarios[scenario].edges[step]);followEdge(e)
 }
});
get('ai-clear').addEventListener('click',()=>{stopPlayback();scenario='overview';step=-1;layer='all';root.querySelectorAll('[data-scenario]').forEach(x=>x.setAttribute('aria-pressed',String(x.dataset.scenario==='overview')));root.querySelectorAll('.ai-filter [data-layer]').forEach(x=>x.setAttribute('aria-pressed',String(x.dataset.layer==='all')));setFocus(null);scenarioText()});
let view={x:0,y:0,w:1200,h:762};
const regions={
 all:{x:0,y:0,w:1200,h:762,label:'Complete architecture'},
 client:{x:5,y:54,w:285,h:475,label:'Clients and ingress'},
 api:{x:293,y:71,w:290,h:438,label:'AgentOS API and registry'},
 runtime:{x:584,y:71,w:291,h:438,label:'Agent runtime and worker'},
 external:{x:878,y:55,w:313,h:470,label:'External dependencies'},
 data:{x:291,y:527,w:585,h:215,label:'Operational data and streams'},
 ops:{x:878,y:528,w:313,h:215,label:'Operations and governance'}
};
function frameRegion(key){
 const region=regions[key]||regions.all;
 view={x:region.x,y:region.y,w:region.w,h:region.h};updateView();
 canvas.classList.add('is-fit');canvas.scrollLeft=0;canvas.scrollTop=0;
 get('ai-region').value=key;
 set(get('ai-view-status'),region.label+(key==='all'?' · essential paths emphasized':' · select nodes to explore'));
}
get('ai-region').addEventListener('change',e=>frameRegion(e.target.value));
get('ai-find').addEventListener('change',e=>{
 const id=e.target.value;if(!id){setFocus(null);return}
 setFocus(id);
 if(window.matchMedia('(max-width:700px)').matches){
  const target=nodeMap[id],type=target.dataset.layer;
  const x=Number(target.querySelector('rect').getAttribute('x'));
  const region=type==='runtime'?(x<590?'api':'runtime'):type==='client'?'client':type==='external'?'external':type==='data'?'data':'ops';
  frameRegion(region);get('ai-find').value=id;
 }
});
function updateView(){svg.setAttribute('viewBox',[view.x,view.y,view.w,view.h].join(' '))}
function zoom(factor,x=600,y=381){const scale=Math.min(1.5,Math.max(.42,view.w/1200*factor));const newW=1200*scale,newH=762*scale;view.x=x-(x-view.x)*newW/view.w;view.y=y-(y-view.y)*newH/view.h;view.w=newW;view.h=newH;updateView()}
get('ai-zoom-in').addEventListener('click',()=>zoom(.82));get('ai-zoom-out').addEventListener('click',()=>zoom(1.21));get('ai-fit').addEventListener('click',()=>frameRegion('all'));get('ai-toggle-fit').addEventListener('click',()=>{canvas.classList.toggle('is-fit');view={x:0,y:0,w:1200,h:762};updateView()});
svg.addEventListener('wheel',e=>{if(!e.ctrlKey&&!e.metaKey&&Math.abs(e.deltaY)<.1)return;e.preventDefault();const rect=svg.getBoundingClientRect();const x=view.x+(e.clientX-rect.left)/rect.width*view.w,y=view.y+(e.clientY-rect.top)/rect.height*view.h;zoom(e.deltaY>0?1.12:.88,x,y)},{passive:false});
let pointer=null;svg.addEventListener('pointerdown',e=>{if(e.target.closest('[data-node]')||e.button!==0)return;pointer={x:e.clientX,y:e.clientY,oldX:view.x,oldY:view.y};svg.classList.add('ai-grabbing');svg.setPointerCapture(e.pointerId)});
svg.addEventListener('pointermove',e=>{if(!pointer)return;const r=svg.getBoundingClientRect();view.x=pointer.oldX-(e.clientX-pointer.x)*view.w/r.width;view.y=pointer.oldY-(e.clientY-pointer.y)*view.h/r.height;updateView()});
function release(){pointer=null;svg.classList.remove('ai-grabbing')}svg.addEventListener('pointerup',release);svg.addEventListener('pointercancel',release);
let pinchDistance=null;
svg.addEventListener('touchstart',e=>{
 if(e.touches.length!==2)return;
 pointer=null;svg.classList.remove('ai-grabbing');
 pinchDistance=Math.hypot(e.touches[0].clientX-e.touches[1].clientX,e.touches[0].clientY-e.touches[1].clientY);
},{passive:true});
svg.addEventListener('touchmove',e=>{
 if(e.touches.length!==2||!pinchDistance)return;
 e.preventDefault();
 const distance=Math.hypot(e.touches[0].clientX-e.touches[1].clientX,e.touches[0].clientY-e.touches[1].clientY);
 if(distance<6)return;
 const rect=svg.getBoundingClientRect(),midX=(e.touches[0].clientX+e.touches[1].clientX)/2,midY=(e.touches[0].clientY+e.touches[1].clientY)/2;
 zoom(pinchDistance/distance,view.x+(midX-rect.left)/rect.width*view.w,view.y+(midY-rect.top)/rect.height*view.h);
 pinchDistance=distance;
},{passive:false});
svg.addEventListener('touchend',()=>{pinchDistance=null});
svg.addEventListener('keydown',e=>{if(e.target!==svg)return;if(e.key==='+'){e.preventDefault();zoom(.85)}else if(e.key==='-'){e.preventDefault();zoom(1.15)}else if(['ArrowLeft','ArrowRight','ArrowUp','ArrowDown'].includes(e.key)){e.preventDefault();view.x+=(e.key==='ArrowLeft'?-.08:e.key==='ArrowRight'?.08:0)*view.w;view.y+=(e.key==='ArrowUp'?-.08:e.key==='ArrowDown'?.08:0)*view.h;updateView()}});
if(window.matchMedia('(max-width:700px)').matches)frameRegion('all');
setFocus(null);scenarioText();paint();
})();
</script>