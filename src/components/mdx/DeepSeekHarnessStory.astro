/** Source-pinned interactive editorial story. No inferred transport/deployment boundaries. */
const commit = '1517a4dbca0a2789ff1d41ba439600f8547d23fa';
const upstream = (p:string,line?:number) => 'https://github.com/deepseek-ai/deepseek-harness/blob/'+commit+'/'+p+(line?'#L'+line:'');
const services = [
  {id:'agent',index:'01',name:'Agent loop',subtitle:'Turn & step driver',contract:'ctx.agentLoop',relation:'Coordinates the other capabilities',file:'packages/core/agent-loop/src/agent.ts',line:410},
  {id:'model',index:'02',name:'Model adapter',subtitle:'Prepare / stream',contract:'ctx.llm',relation:'Agent loop → model adapter',file:'packages/llm/llm/src/index.ts'},
  {id:'tools',index:'03',name:'Tool registry',subtitle:'Guard & dispatch',contract:'ctx.tools',relation:'Agent loop → tool scheduler',file:'packages/core/agent-loop/src/tool-calls.ts',line:174},
  {id:'session',index:'04',name:'Session log',subtitle:'Durable event facts',contract:'ctx.sessions',relation:'Loop → append-only session events',file:'packages/core/session/src/index.ts'},
  {id:'prompt',index:'05',name:'Prompt builder',subtitle:'Context + schemas',contract:'ctx.systemPrompt',relation:'Loop → assembled model context',file:'packages/core/system-prompt/src/index.ts'},
  {id:'policy',index:'06',name:'Policy hooks',subtitle:'Approvals & guards',contract:'tools/* events',relation:'Tool registry → policy interception',file:'docs/tool-execution-pipeline.md'}
];
const stages = [
  {id:'claim',n:'01',title:'Claim input',short:'Inbox → loop',owner:'Agent',kind:'live',code:'preStep() / inbox.claim()',proof:'packages/core/agent-loop/src/agent.ts',line:271,detail:'The loop accepts queued user work. A first rejected claim can close a turn without spending a model step.'},
  {id:'prepare',n:'02',title:'Prepare request',short:'Prompt + model',owner:'Agent + model',kind:'control',code:'prepareRequest()',proof:'packages/core/agent-loop/src/agent.ts',line:410,detail:'Request hooks and adapter preparation resolve the route before accepted user content is committed.'},
  {id:'admit',n:'03',title:'Admit context',short:'Session facts',owner:'Session',kind:'durable',code:'user/message · request/context',proof:'docs/architecture.md',detail:'The accepted model-visible messages and request context are projected from the log.'},
  {id:'stream',n:'04',title:'Stream model',short:'Transient chunks',owner:'Model',kind:'live',code:'llm.stream() · agent/assistant-stream',proof:'packages/core/agent-loop/src/agent.ts',line:453,detail:'The model stream produces live frames. Frames are distinct from a settled assistant message.'},
  {id:'settle',n:'05',title:'Settle attempt',short:'Durable answer',owner:'Session',kind:'durable',code:'assistant/message or assistant/attempt',proof:'docs/agent-lifecycle.md',detail:'A completed response becomes a durable event; settled errors and retries can be represented separately.'},
  {id:'dispatch',n:'06',title:'Run tools',short:'Guards → dispatch',owner:'Tools',kind:'conditional',code:'executeToolCalls()',proof:'packages/core/agent-loop/src/agent.ts',line:551,detail:'If the model requested tools, policy and the scheduler run them; no-tool replies skip this branch.'},
  {id:'continue',n:'07',title:'Continue / end',short:'Step / turn facts',owner:'Agent + session',kind:'durable',code:'tool/result · step/end · turn/end',proof:'packages/core/agent-loop/src/tool-calls.ts',line:282,detail:'Linked results and step boundaries are recorded; the driver continues only if work remains.'}
];
const cases = [
  {id:'coding',icon:'⌘',name:'Coding agent',need:'Controlled shell and filesystem access',parts:['Tool sandbox','Approvals','Durable transcript'],benefit:'Separate the agent policy from the model and shell implementation.',caveat:'Host security still needs isolation and least privilege.'},
  {id:'support',icon:'◎',name:'Support diagnosis',need:'Explain what evidence the agent retrieved',parts:['Read-only tools','Session log','Live UI events'],benefit:'Track tool inputs/results while the UI streams investigation progress.',caveat:'Add authorization, redaction, tenant boundaries and retention.'},
  {id:'evaluation',icon:'⟷',name:'Model evaluation',need:'Compare adapters without replacing the whole agent',parts:['Model seam','Profiles','Recorded outcomes'],benefit:'Hold the task and harness stable while swapping model providers.',caveat:'Performance and cost claims require actual evaluation data.'},
  {id:'platform',icon:'▣',name:'Agent platform',need:'Compose tools and policies for different customers',parts:['Plugin config','Capability contracts','Lifecycle cleanup'],benefit:'Compile a declarative agent definition into a controlled runtime composition.',caveat:'Distributed leases, billing and enterprise governance are not automatic.'}
];
---
<section class="hvs" data-harness-story aria-label="DeepSeek Harness visual architecture explorer">
  <header class="hvs-cover">
    <div class="hvs-meta"><span class="hvs-pulse"></span> FIELD GUIDE / SOURCE-PINNED <span>OCT 2026 · TYPESCRIPT</span></div>
    <div class="hvs-cover-grid">
      <div>
        <p class="hvs-eyebrow">DEEPSEEK HARNESS / ARCHITECTURE ATLAS</p>
        <h2>One agent.<br/><em>Everything pluggable.</em></h2>
        <p class="hvs-lead">Explore the execution system around the model. Tap the architecture, step through a request, and test how tool policies change its outcome.</p>
        <div class="hvs-actions">
          <a href="#hvs-system">Explore architecture <span aria-hidden="true">↘</span></a>
          <a class="hvs-secondary" href="/en/labs/deepseek-harness-clarity/">Open full code explorer ↗</a>
        </div>
      </div>
      <div class="hvs-cover-art" aria-label="Agent composition illustration">
        <div class="hvs-orbit hvs-orbit-a"></div><div class="hvs-orbit hvs-orbit-b"></div>
        <div class="hvs-satellite hvs-sat-model">MODEL <span>↘</span></div>
        <div class="hvs-satellite hvs-sat-tool">TOOLS <span>↗</span></div>
        <div class="hvs-satellite hvs-sat-state">SESSION <span>↖</span></div>
        <div class="hvs-satellite hvs-sat-policy">POLICY <span>↙</span></div>
        <div class="hvs-core"><span class="hvs-core-glyph">◇</span><strong>AGENT</strong><small>LOOP</small></div>
      </div>
    </div>
    <div class="hvs-cover-foot"><span>01 / SYSTEM</span><span>02 / REQUEST</span><span>03 / SECURITY</span><span>04 / DESIGN</span><span>05 / USE CASES</span></div>
  </header>

  <nav class="hvs-jump" aria-label="Explore visual chapters">
    <a href="#hvs-system">01 Architecture</a><a href="#hvs-journey">02 Request journey</a><a href="#hvs-policy">03 Tool policy</a><a href="#hvs-compare">04 Why plugins?</a><a href="#hvs-cases">05 Use cases</a>
  </nav>

  <section id="hvs-system" class="hvs-chapter" aria-labelledby="hvs-system-title">
    <div class="hvs-chapter-head"><div><p class="hvs-eyebrow">01 / WHAT IT IS</p><h3 id="hvs-system-title">A composed runtime, not six microservices</h3><p>Select a capability to inspect its contract and actual code.</p></div><span class="hvs-chapter-count">6 CAPABILITY SEAMS</span></div>
    <div class="hvs-system-layout">
      <div class="hvs-system-visual">
        <div class="hvs-boundary-label">HOST / IN-PROCESS COMPOSITION</div>
        <div class="hvs-system-entry"><span>USER · CLI · WEB</span><span class="hvs-down">↓</span><span>APPLICATION / AGENT API</span></div>
        <div class="hvs-cordis">
          <div class="hvs-cordis-title"><span class="hvs-grid-icon">▦</span> CORDIS PLUGIN CONTEXT <small>mounted services + typed events</small></div>
          <div class="hvs-model-grid">
            {services.map((s) => (
              <button type="button" class:list={['hvs-capability',s.id==='agent'?'is-active':'']} data-capability={s.id} aria-pressed={s.id==='agent'?'true':'false'}>
                <span class="hvs-cap-index">{s.index} · {s.contract}</span><strong>{s.name}</strong><small>{s.subtitle}</small>
              </button>
            ))}
          </div>
          <div class="hvs-cordis-end">Ordered bundles + profile patches → effective plugin tree</div>
        </div>
        <p class="hvs-graph-caption"><span class="hvs-key-square"></span> Nested boundary = logical code composition. Selecting a box explains its relationship to the agent loop.</p>
      </div>
      <aside class="hvs-inspect" aria-live="polite">
        <p class="hvs-eyebrow">SELECTED / CAPABILITY</p>
        <div class="hvs-inspect-icon">01</div>
        <h4 data-service-title>Agent loop</h4>
        <code data-service-contract>ctx.agentLoop</code>
        <p class="hvs-inspect-desc" data-service-desc>Turn & step driver</p>
        <div class="hvs-inspect-separator"></div>
        <p class="hvs-small-label">HOW IT CONNECTS</p>
        <strong class="hvs-relation" data-service-relation>Coordinates the other capabilities</strong>
        <p class="hvs-inspect-note">This is a service relationship inside Cordis. It is not automatically an HTTP request.</p>
        <a data-service-source href={upstream(services[0].file,services[0].line)} target="_blank" rel="noopener noreferrer">Inspect pinned source ↗</a>
      </aside>
    </div>
  </section>

  <section id="hvs-journey" class="hvs-chapter" aria-labelledby="hvs-journey-title">
    <div class="hvs-chapter-head"><div><p class="hvs-eyebrow">02 / HOW IT WORKS</p><h3 id="hvs-journey-title">Follow one agent turn</h3><p>Tap a stage or use the arrows. Conditional branches do not run on every request.</p></div><span class="hvs-chapter-count">7 CODE-ALIGNED STAGES</span></div>
    <div class="hvs-journey">
      <div class="hvs-timeline" role="group" aria-label="Select an execution stage">
        {stages.map((step,i)=>(<button type="button" class:list={['hvs-step',i===0?'is-active':'']} data-stage={i} aria-pressed={i===0?'true':'false'}>
          <span>{step.n}</span><strong>{step.title}</strong><small>{step.short}</small>
        </button>))}
      </div>
      <div class="hvs-stage-body">
        <div class="hvs-stage-graphic" aria-label="Selected stage data lanes">
          <div class="hvs-stage-rail"><div><span class="hvs-stage-dot"></span> AGENT</div><div><span class="hvs-stage-dot"></span> MODEL</div><div><span class="hvs-stage-dot"></span> TOOLS</div><div><span class="hvs-stage-dot"></span> SESSION</div></div>
          <div class="hvs-lane-vis">
            <div class="hvs-lane hvs-agent-lane"><span class="hvs-lane-bar"></span></div>
            <div class="hvs-lane hvs-model-lane"><span class="hvs-lane-bar"></span></div>
            <div class="hvs-lane hvs-tools-lane"><span class="hvs-lane-bar"></span></div>
            <div class="hvs-lane hvs-session-lane"><span class="hvs-lane-bar"></span></div>
            <div class="hvs-stage-bubble" data-stage-owner>AGENT / LIVE</div>
          </div>
        </div>
        <aside class="hvs-stage-detail">
          <div class="hvs-stage-counter"><span data-stage-number>01 / 07</span><span data-stage-kind>LIVE COORDINATION</span></div>
          <h4 data-stage-title>Claim input</h4>
          <p data-stage-description>The loop accepts queued user work. A first rejected claim can close a turn without spending a model step.</p>
          <code data-stage-code>preStep() / inbox.claim()</code>
          <div class="hvs-stage-controls"><button type="button" data-stage-prev aria-label="Previous execution stage" disabled>← Previous</button><button type="button" data-stage-next>Next stage →</button></div>
          <a data-stage-source href={upstream(stages[0].proof,stages[0].line)} target="_blank" rel="noopener noreferrer">Read source at line 271 ↗</a>
        </aside>
      </div>
      <p class="hvs-under-note"><span class="hvs-key-line"></span> Stage links are a source-guided reading order, not a captured trace. Live chunks and durable facts are different event types.</p>
    </div>
  </section>

  <section id="hvs-policy" class="hvs-chapter" aria-labelledby="hvs-policy-title">
    <div class="hvs-chapter-head"><div><p class="hvs-eyebrow">03 / WHY SECURITY LIVES OUTSIDE THE PROMPT</p><h3 id="hvs-policy-title">Try a tool policy</h3><p>Change the configured example to see how the same tool pipeline branches.</p></div><span class="hvs-chapter-count">INTERACTIVE / POLICY LAB</span></div>
    <div class="hvs-policy">
      <div class="hvs-policy-choices" role="group" aria-label="Choose an illustrative tool authorization scenario">
        <button type="button" data-scenario="read" aria-pressed="true" class="is-active"><span>01</span> Allowed read</button>
        <button type="button" data-scenario="approval" aria-pressed="false"><span>02</span> Approved write</button>
        <button type="button" data-scenario="denied" aria-pressed="false"><span>03</span> Blocked command</button>
      </div>
      <div class="hvs-policy-track">
        <div class="hvs-policy-row">
          <div class="hvs-policy-node" data-policy-node="intent"><small>01</small><strong>Tool call</strong><span>Model proposes</span></div>
          <i aria-hidden="true">→</i><div class="hvs-policy-node" data-policy-node="pre"><small>02</small><strong>Pre-execute</strong><span>Policy hooks</span></div>
          <i aria-hidden="true">→</i><div class="hvs-policy-node" data-policy-node="guard"><small>03</small><strong>Guard</strong><span>Allow / deny / ask</span></div>
          <i aria-hidden="true">→</i><div class="hvs-policy-node" data-policy-node="execute"><small>04</small><strong>Dispatch</strong><span>Tool body or skip</span></div>
          <i aria-hidden="true">→</i><div class="hvs-policy-node" data-policy-node="result"><small>05</small><strong>Result</strong><span>Durable event</span></div>
        </div>
        <div class="hvs-policy-outcome"><span data-outcome-icon>✓</span><div><strong data-outcome-title>Authorized read executed</strong><p data-outcome-text>Illustrative guard allows a read-only call; the tool result is recorded.</p></div></div>
      </div>
      <p class="hvs-under-note">These scenarios are **illustrative policies**, not DeepSeek Harness default permissions. See the <a href={upstream('docs/tool-execution-pipeline.md')} target="_blank" rel="noopener">documented tool pipeline ↗</a>.</p>
    </div>
  </section>

  <section id="hvs-compare" class="hvs-chapter" aria-labelledby="hvs-compare-title">
    <div class="hvs-chapter-head"><div><p class="hvs-eyebrow">04 / WHY THIS DESIGN</p><h3 id="hvs-compare-title">What changes when the harness is pluggable?</h3><p>Switch designs to see what is fixed and what can be replaced.</p></div><span class="hvs-chapter-count">DESIGN TRADE-OFF</span></div>
    <div class="hvs-compare">
      <div class="hvs-compare-toggle" role="group" aria-label="Compare agent architecture styles"><button type="button" data-compare="hardcoded" aria-pressed="false">Hard-coded agent</button><button type="button" class="is-active" data-compare="plugin" aria-pressed="true">DeepSeek-style composition</button></div>
      <div class="hvs-compare-visual" data-compare-visual="plugin">
        <div class="hvs-compare-stack"><div data-compare-center>CORDIS CONTEXT</div><span data-compare-slot>Loop</span><span data-compare-slot>Model</span><span data-compare-slot>Tools</span><span data-compare-slot>Session</span><span data-compare-slot>Policy</span></div>
        <div class="hvs-compare-explanation"><span class="hvs-eyebrow" data-compare-kicker>REPLACEABLE / COMPOSED</span><h4 data-compare-title>Change capabilities without forking the driver.</h4><p data-compare-detail>Providers register behind stable service keys. Profiles and patches decide what mounts. Reversible effects handle cleanup when plugins unload.</p><div class="hvs-tradeoff"><strong>Trade-off</strong><span data-compare-cost>More extension points mean more lifecycle and ordering complexity.</span></div></div>
      </div>
    </div>
  </section>

  <section id="hvs-cases" class="hvs-chapter" aria-labelledby="hvs-cases-title">
    <div class="hvs-chapter-head"><div><p class="hvs-eyebrow">05 / WHERE IT HELPS</p><h3 id="hvs-cases-title">Explore a use case</h3><p>Choose a scenario to see which harness capabilities matter—and what you still need to build.</p></div><span class="hvs-chapter-count">4 USE CASES</span></div>
    <div class="hvs-cases">
      <div class="hvs-case-list" role="group" aria-label="Choose a practical agent architecture use case">
        {cases.map((c,i)=>(<button type="button" data-case={c.id} class:list={['hvs-case',i===0?'is-active':'']} aria-pressed={i===0?'true':'false'}><span>{c.icon}</span><strong>{c.name}</strong><small>Explore ↗</small></button>))}
      </div>
      <div class="hvs-case-detail">
        <span class="hvs-eyebrow">PRACTICAL PATTERN / <span data-case-label>CODING AGENT</span></span>
        <h4 data-case-title>Controlled shell and filesystem access</h4>
        <div class="hvs-case-flow"><span data-part="0">Tool sandbox</span><i>→</i><span data-part="1">Approvals</span><i>→</i><span data-part="2">Durable transcript</span></div>
        <p class="hvs-why"><strong>What to borrow</strong><span data-case-benefit>Separate the agent policy from the model and shell implementation.</span></p>
        <p class="hvs-caution"><strong>Don't assume it's built-in</strong><span data-case-caveat>Host security still needs isolation and least privilege.</span></p>
      </div>
    </div>
  </section>

  <section class="hvs-takeaways" aria-label="What architects can learn">
    <p class="hvs-eyebrow">THE ARCHITECT'S TAKEAWAYS</p>
    <h3>Borrow the boundaries.<br/>Not the complexity blindly.</h3>
    <div class="hvs-takeaway-grid">
      <div><span>01 / COMPOSITION</span><strong>Swap capabilities, not the whole agent.</strong></div>
      <div><span>02 / DURABILITY</span><strong>Model-visible facts should be reconstructable.</strong></div>
      <div><span>03 / SAFETY</span><strong>Authorize at the tool boundary, not in a prompt.</strong></div>
      <div><span>04 / RECOVERY</span><strong>Separate live frames from committed outcomes.</strong></div>
    </div>
    <div class="hvs-bottom-links">
      <a href="/en/labs/deepseek-harness-clarity/">Inspect the complete implementation ↗</a>
      <a href={upstream('docs/architecture.md')} target="_blank" rel="noopener noreferrer">Read upstream architecture ↗</a>
      <a href={upstream('SAFETY.md')} target="_blank" rel="noopener noreferrer">Security and preview limitations ↗</a>
    </div>
    <p class="hvs-disclaimer">Source: DeepSeek Harness <a href={'https://github.com/deepseek-ai/deepseek-harness/tree/'+commit} target="_blank" rel="noopener noreferrer">1517a4d</a>. Logical code boundaries and documented behavior—not measured performance, production security certification, or separate deployments. Developer preview: use disposable environments and least privilege.</p>
  </section>
</section>
<script>
  const story=document.querySelector<HTMLElement>('[data-harness-story]');
  if(story){
    const pin='1517a4dbca0a2789ff1d41ba439600f8547d23fa';
    const link=(path:string,line?:number)=>'https://github.com/deepseek-ai/deepseek-harness/blob/'+pin+'/'+path+(line?'#L'+line:'');
    const services={
      agent:{index:'01',name:'Agent loop',contract:'ctx.agentLoop',desc:'Turn & step driver',relation:'Coordinates the other capabilities',path:'packages/core/agent-loop/src/agent.ts',line:410},
      model:{index:'02',name:'Model adapter',contract:'ctx.llm',desc:'Prepare and stream the model request',relation:'Agent loop → model adapter (service call)',path:'docs/architecture.md'},
      tools:{index:'03',name:'Tool registry',contract:'ctx.tools',desc:'Guard, approve, schedule and dispatch tools',relation:'Agent loop → guarded tool scheduler',path:'packages/core/agent-loop/src/tool-calls.ts',line:174},
      session:{index:'04',name:'Session log',contract:'ctx.sessions',desc:'Stores durable model-visible events',relation:'Agent loop → append-only session facts',path:'docs/architecture.md'},
      prompt:{index:'05',name:'Prompt builder',contract:'ctx.systemPrompt',desc:'Composes prompt sections and tool schemas',relation:'Agent loop → prompt assembly',path:'docs/architecture.md'},
      policy:{index:'06',name:'Policy hooks',contract:'tools/* events',desc:'Interception and authorization at tool boundaries',relation:'Tool registry → policy hooks; not HTTP',path:'docs/tool-execution-pipeline.md'}
    };
    const stages=[
      {title:'Claim input',kind:'LIVE / AGENT',owner:'AGENT',description:'The loop accepts queued user work. A first rejected claim can close a turn without spending a model step.',code:'preStep() / inbox.claim()',proof:'packages/core/agent-loop/src/agent.ts',line:271},
      {title:'Prepare request',kind:'CONTROL / MODEL',owner:'AGENT',description:'Request hooks and adapter preparation resolve the route before accepted user content is committed.',code:'prepareRequest()',proof:'packages/core/agent-loop/src/agent.ts',line:410},
      {title:'Admit context',kind:'DURABLE / SESSION',owner:'SESSION',description:'The accepted model-visible messages and request context are projected from the log.',code:'user/message · request/context',proof:'docs/architecture.md'},
      {title:'Stream model',kind:'LIVE / MODEL',owner:'MODEL',description:'The model stream produces live frames. Frames are distinct from a settled assistant message.',code:'llm.stream() · agent/assistant-stream',proof:'packages/core/agent-loop/src/agent.ts',line:453},
      {title:'Settle attempt',kind:'DURABLE / SESSION',owner:'SESSION',description:'A completed response becomes a durable event; settled errors and retries can be represented separately.',code:'assistant/message or assistant/attempt',proof:'docs/agent-lifecycle.md'},
      {title:'Run tools',kind:'CONDITIONAL / TOOLS',owner:'TOOLS',description:'If the model requested tools, policy and the scheduler run them; no-tool replies skip this branch.',code:'executeToolCalls()',proof:'packages/core/agent-loop/src/agent.ts',line:551},
      {title:'Continue / end',kind:'DURABLE / SESSION',owner:'SESSION',description:'Linked results and step boundaries are recorded; the driver continues only if work remains.',code:'tool/result · step/end · turn/end',proof:'packages/core/agent-loop/src/tool-calls.ts',line:282}
    ];
    const scenarios={
      read:{icon:'✓',title:'Authorized read executed',text:'Illustrative guard allows a read-only call. The tool result is recorded.',states:['complete','complete','allowed','complete','complete']},
      approval:{icon:'✓',title:'One-time approval granted',text:'The approval provider grants this write. Guards still apply before dispatch.',states:['complete','complete','review','complete','complete']},
      denied:{icon:'×',title:'Command rejected before execution',text:'Policy refuses the operation. The tool body is skipped; the denied outcome is recorded.',states:['complete','complete','denied','skipped','complete']}
    };
    const compare={
      hardcoded:{kicker:'TIGHTLY COUPLED / ONE IMPLEMENTATION',title:'Changes ripple through the central loop.',detail:'Model, tools, policy and storage are directly wired. Simple to begin with; hard to replace independently.',cost:'Fewer abstractions, but more integration changes as the product grows.',center:'FIXED AGENT RUNNER'},
      plugin:{kicker:'REPLACEABLE / COMPOSED',title:'Change capabilities without forking the driver.',detail:'Providers register behind stable service keys. Profiles and patches decide what mounts. Reversible effects handle cleanup when plugins unload.',cost:'More extension points mean more lifecycle and ordering complexity.',center:'CORDIS CONTEXT'}
    };
    const useCases={
      coding:{name:'CODING AGENT',need:'Controlled shell and filesystem access',parts:['Tool sandbox','Approvals','Durable transcript'],benefit:'Separate the agent policy from the model and shell implementation.',caveat:'Host security still needs isolation and least privilege.'},
      support:{name:'SUPPORT DIAGNOSIS',need:'Explain what evidence the agent retrieved',parts:['Read-only tools','Session log','Live UI events'],benefit:'Track tool inputs/results while the UI streams investigation progress.',caveat:'Add authorization, redaction, tenant boundaries and retention.'},
      evaluation:{name:'MODEL EVALUATION',need:'Compare adapters without replacing the whole agent',parts:['Model seam','Profiles','Recorded outcomes'],benefit:'Hold the task and harness stable while swapping model providers.',caveat:'Performance and cost claims require actual evaluation data.'},
      platform:{name:'AGENT PLATFORM',need:'Compose tools and policies for different customers',parts:['Plugin config','Capability contracts','Lifecycle cleanup'],benefit:'Compile a declarative agent definition into a controlled runtime composition.',caveat:'Distributed leases, billing and enterprise governance are not automatic.'}
    };
    const pick=<T extends HTMLElement>(selector:string)=>story.querySelector<T>(selector)!;
    const text=(selector:string,value:string)=>{pick<HTMLElement>(selector).textContent=value;};
    const updateGroup=(sel:string,key:string,value:string)=>{
      story.querySelectorAll<HTMLButtonElement>(sel).forEach(b=>{
        const on=b.dataset[key]===value;b.classList.toggle('is-active',on);b.setAttribute('aria-pressed',String(on));
      });
    };
    story.querySelectorAll<HTMLButtonElement>('[data-capability]').forEach(b=>b.addEventListener('click',()=>{
      const id=b.dataset.capability as keyof typeof services;const v=services[id];if(!v)return;
      updateGroup('[data-capability]','capability',id);
      text('.hvs-inspect-icon',v.index);text('[data-service-title]',v.name);text('[data-service-contract]',v.contract);
      text('[data-service-desc]',v.desc);text('[data-service-relation]',v.relation);
      pick<HTMLAnchorElement>('[data-service-source]').href=link(v.path,v.line);
    }));
    let stepIndex=0;
    const selectStage=(i:number)=>{
      stepIndex=Math.min(stages.length-1,Math.max(0,i));const v=stages[stepIndex];
      updateGroup('[data-stage]','stage',String(stepIndex));
      text('[data-stage-number]',String(stepIndex+1).padStart(2,'0')+' / 07');text('[data-stage-kind]',v.kind);
      text('[data-stage-title]',v.title);text('[data-stage-description]',v.description);text('[data-stage-code]',v.code);
      text('[data-stage-owner]',v.owner+' / '+v.kind.split(' / ')[0]);
      pick<HTMLAnchorElement>('[data-stage-source]').href=link(v.proof,v.line);
      text('[data-stage-source]',v.line?'Read source at line '+v.line+' ↗':'Read documented lifecycle ↗');
      const bars=story.querySelectorAll<HTMLElement>('.hvs-lane');const owners=['AGENT','MODEL','TOOLS','SESSION'];
      bars.forEach((bar,j)=>bar.classList.toggle('is-lit',owners[j]===v.owner));
      pick<HTMLButtonElement>('[data-stage-prev]').disabled=stepIndex===0;
      pick<HTMLButtonElement>('[data-stage-next]').disabled=stepIndex===stages.length-1;
      const active=pick<HTMLElement>('[data-stage="'+stepIndex+'"]');
      active.scrollIntoView({behavior:'auto',block:'nearest',inline:'nearest'});
    };
    story.querySelectorAll<HTMLButtonElement>('[data-stage]').forEach(b=>b.addEventListener('click',()=>selectStage(Number(b.dataset.stage))));
    pick<HTMLButtonElement>('[data-stage-prev]').addEventListener('click',()=>selectStage(stepIndex-1));
    pick<HTMLButtonElement>('[data-stage-next]').addEventListener('click',()=>selectStage(stepIndex+1));
    const selectScenario=(key:keyof typeof scenarios)=>{
      const v=scenarios[key];updateGroup('[data-scenario]','scenario',key);
      story.querySelectorAll<HTMLElement>('[data-policy-node]').forEach((node,i)=>{
        node.dataset.outcome=v.states[i];
      });
      text('[data-outcome-icon]',v.icon);text('[data-outcome-title]',v.title);text('[data-outcome-text]',v.text);
      pick<HTMLElement>('.hvs-policy-outcome').dataset.kind=key;
    };
    story.querySelectorAll<HTMLButtonElement>('[data-scenario]').forEach(b=>b.addEventListener('click',()=>selectScenario(b.dataset.scenario as keyof typeof scenarios)));
    const selectCompare=(key:keyof typeof compare)=>{
      const v=compare[key];updateGroup('[data-compare]','compare',key);
      pick<HTMLElement>('.hvs-compare-visual').dataset.compareVisual=key;
      text('[data-compare-center]',v.center);text('[data-compare-kicker]',v.kicker);text('[data-compare-title]',v.title);
      text('[data-compare-detail]',v.detail);text('[data-compare-cost]',v.cost);
    };
    story.querySelectorAll<HTMLButtonElement>('[data-compare]').forEach(b=>b.addEventListener('click',()=>selectCompare(b.dataset.compare as keyof typeof compare)));
    const selectCase=(key:keyof typeof useCases)=>{
      const v=useCases[key];updateGroup('[data-case]','case',key);
      text('[data-case-label]',v.name);text('[data-case-title]',v.need);
      v.parts.forEach((part,i)=>text('[data-part="'+i+'"]',part));
      text('[data-case-benefit]',v.benefit);text('[data-case-caveat]',v.caveat);
    };
    story.querySelectorAll<HTMLButtonElement>('[data-case]').forEach(b=>b.addEventListener('click',()=>selectCase(b.dataset.case as keyof typeof useCases)));
    selectScenario('read');
    story.dataset.ready='true';
  }
</script>
<style>
