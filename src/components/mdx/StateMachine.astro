---
/**
 * StateMachine — Directed state transition diagram with real SVG arrows.
 *
 * Renders states as rounded boxes in a grid, with SVG arrows drawn between
 * them for each transition. Arrows are labeled and have directional arrowheads.
 *
 * Usage:
 *   <StateMachine
 *     states={[
 *       { id: "follower",  label: "Follower",   sub: "receives heartbeats",  initial: true },
 *       { id: "candidate", label: "Candidate",  sub: "requesting votes",     color: "amber" },
 *       { id: "leader",    label: "Leader",     sub: "sends heartbeats",     color: "green" },
 *     ]}
 *     transitions={[
 *       { from: "follower",  to: "candidate", label: "timeout — no heartbeat" },
 *       { from: "candidate", to: "leader",    label: "majority votes" },
 *       { from: "candidate", to: "follower",  label: "higher term seen", type: "back" },
 *       { from: "leader",    to: "follower",  label: "higher term seen", type: "back" },
 *     ]}
 *     caption="Raft consensus node state machine"
 *   />
 *
 * state.color: 'blue'|'teal'|'amber'|'rose'|'violet'|'green'|'red' (default: blue/accent)
 * transition.type: 'forward'|'back'|'self'|'error' (default: forward)
 */

interface State {
  id: string;
  label: string;
  sub?: string;
  initial?: boolean;
  final?: boolean;
  color?: string;
  row?: number;
  col?: number;
}

interface Transition {
  from: string;
  to: string;
  label?: string;
  type?: 'forward' | 'back' | 'self' | 'error';
}

interface Props {
  states: State[];
  transitions: Transition[];
  caption?: string;
  title?: string;
  cols?: number;
}

const { states, transitions, caption, title, cols } = Astro.props;

const COLORS: Record<string, { border: string; bg: string; text: string }> = {
  blue:   { border: 'var(--color-accent)',  bg: 'rgba(69,137,255,0.10)',   text: 'var(--color-accent)' },
  teal:   { border: '#0ea5e9',              bg: 'rgba(14,165,233,0.10)',   text: '#0ea5e9' },
  amber:  { border: '#f59e0b',              bg: 'rgba(245,158,11,0.10)',   text: '#f59e0b' },
  rose:   { border: '#f43f5e',              bg: 'rgba(244,63,94,0.10)',    text: '#f43f5e' },
  red:    { border: '#ef4444',              bg: 'rgba(239,68,68,0.10)',    text: '#ef4444' },
  violet: { border: '#8b5cf6',              bg: 'rgba(139,92,246,0.10)',   text: '#8b5cf6' },
  green:  { border: '#16a34a',              bg: 'rgba(22,163,74,0.10)',    text: '#16a34a' },
};

function stateColor(s: State) {
  const c = s.color ?? 'blue';
  return COLORS[c] ?? COLORS['blue'];
}

// Assign grid positions if not explicit
// Use explicit max-col when any state has an explicit col, else auto-layout
const explicitMaxCol = states.some((s) => s.col != null)
  ? Math.max(...states.filter((s) => s.col != null).map((s) => s.col!))
  : 0;
const gridCols = cols ?? (explicitMaxCol > 0 ? explicitMaxCol : Math.ceil(Math.sqrt(states.length)));
states.forEach((s, i) => {
  if (!s.row) s.row = Math.floor(i / gridCols) + 1;
  if (!s.col) s.col = (i % gridCols) + 1;
});
const gridRows = Math.max(...states.map((s) => s.row!));

// Layout constants (px) — SVG is rendered at these dimensions, CSS scales it
const BOX_W = 140;
const BOX_H = 56;
const COL_GAP = 100;
const ROW_GAP = 100;  // larger gap gives diagonal labels more room
const PAD_X = 30;
// Extra vertical padding so labels above top-row boxes have room
const PAD_Y = 44;

const svgW = PAD_X * 2 + gridCols * BOX_W + (gridCols - 1) * COL_GAP;
const svgH = PAD_Y * 2 + gridRows * BOX_H + (gridRows - 1) * ROW_GAP;

// Centre of each state box
function boxCx(s: State) {
  return PAD_X + (s.col! - 1) * (BOX_W + COL_GAP) + BOX_W / 2;
}
function boxCy(s: State) {
  return PAD_Y + (s.row! - 1) * (BOX_H + ROW_GAP) + BOX_H / 2;
}
function boxTop(s: State)    { return boxCy(s) - BOX_H / 2; }
function boxBottom(s: State) { return boxCy(s) + BOX_H / 2; }
function boxLeft(s: State)   { return boxCx(s) - BOX_W / 2; }
function boxRight(s: State)  { return boxCx(s) + BOX_W / 2; }

// Intersection of line from (cx,cy) through (tx,ty) with box edge
function edgePoint(cx: number, cy: number, tx: number, ty: number, margin = 6): [number, number] {
  const dx = tx - cx;
  const dy = ty - cy;
  const hw = BOX_W / 2 + margin;
  const hh = BOX_H / 2 + margin;
  if (Math.abs(dx) < 0.01 && Math.abs(dy) < 0.01) return [cx, cy];
  const sx = dx !== 0 ? hw / Math.abs(dx) : Infinity;
  const sy = dy !== 0 ? hh / Math.abs(dy) : Infinity;
  const s = Math.min(sx, sy);
  return [cx + dx * s, cy + dy * s];
}

// Font metrics at font-size 9 monospace
const CHAR_W = 5.6;
const LABEL_PAD_H = 10; // horizontal padding total
const LABEL_H = 12;     // label rect height

// Build arrow path data for each transition
interface ArrowData {
  d: string;
  lx: number;
  ly: number;
  labelW: number;
  label?: string;
  color: string;
  id: string;
  dasharray?: string;
  markerId: string;
}

function getMarkerId(color: string) {
  return color === '#94a3b8' ? 'arr-back'
       : color === '#f43f5e' ? 'arr-error'
       : color === '#8b5cf6' ? 'arr-self'
       : 'arr-accent';
}

const arrows: ArrowData[] = [];
const pairCount: Record<string, number> = {};

// Track placed label bounding boxes for collision avoidance
interface LabelBBox { lx: number; ly: number; hw: number; hh: number; }
const placedLabels: LabelBBox[] = [];

function labelWidth(label: string) {
  return Math.max(label.length * CHAR_W + LABEL_PAD_H, 32);
}

// Check if a candidate position (lx, ly center) collides with any state box
// We only block positions where the label would land ON TOP OF a state box
function collidesWithBoxes(lx: number, ly: number, lw: number): boolean {
  const lhw = lw / 2;
  const lhh = LABEL_H / 2;
  for (const s of states) {
    const bl = boxLeft(s);
    const br = boxRight(s);
    const bt = boxTop(s);
    const bb = boxBottom(s);
    // Overlap: label rect [lx-lhw, lx+lhw] x [ly-lhh, ly+lhh] vs box rect [bl, br] x [bt, bb]
    const overlapX = lx + lhw > bl + 4 && lx - lhw < br - 4;
    const overlapY = ly + lhh > bt + 4 && ly - lhh < bb - 4;
    if (overlapX && overlapY) return true;
  }
  return false;
}

function collidesWithLabels(lx: number, ly: number, lw: number): boolean {
  const hw = lw / 2;
  const hh = LABEL_H / 2;
  for (const lb of placedLabels) {
    // Only flag collision if labels actually overlap (not just proximity)
    if (Math.abs(lx - lb.lx) < (hw + lb.hw) && Math.abs(ly - lb.ly) < (hh + lb.hh)) {
      return true;
    }
  }
  return false;
}

function findLabelPos(
  candidateLx: number,
  candidateLy: number,
  lw: number,
  nudgeX: number,  // direction to shift if collision
  nudgeY: number,
): [number, number] {
  const steps = [0, 16, -16, 32, -32, 48, -48, 64, -64];
  for (const step of steps) {
    const lx = candidateLx + nudgeX * step;
    const ly = candidateLy + nudgeY * step;
    if (!collidesWithBoxes(lx, ly, lw) && !collidesWithLabels(lx, ly, lw)) {
      return [lx, ly];
    }
  }
  // Fallback: place far enough in nudge direction to clear boxes
  return [candidateLx + nudgeX * 80, candidateLy + nudgeY * 80];
}

transitions.forEach((t) => {
  const fromS = states.find((s) => s.id === t.from);
  const toS   = states.find((s) => s.id === t.to);
  if (!fromS || !toS) return;

  const color =
    t.type === 'back'  ? '#94a3b8' :
    t.type === 'error' ? '#f43f5e' :
    t.type === 'self'  ? '#8b5cf6' :
    'var(--color-accent)';

  const arrowId = `arr-${t.from}-${t.to}`;
  const markerId = getMarkerId(color);
  const dasharray = t.type === 'back' ? '5 3' : undefined;
  const lw = t.label ? labelWidth(t.label) : 0;

  if (t.type === 'self' || t.from === t.to) {
    const cx = boxCx(fromS);
    const cy = boxCy(fromS);
    const r = 22;
    const sx = cx - r * 0.6;
    const ex = cx + r * 0.6;
    const sy = cy - BOX_H / 2 - 2;
    const ey = cy - BOX_H / 2 - 2;
    const loopTop = cy - BOX_H / 2 - 28;

    let lx = cx;
    let ly = loopTop - 4;
    if (t.label) {
      [lx, ly] = findLabelPos(lx, ly, lw, 1, -1);
      placedLabels.push({ lx, ly, hw: lw / 2, hh: LABEL_H / 2 });
    }

    arrows.push({
      d: `M ${sx} ${sy} Q ${cx} ${loopTop - 16} ${ex} ${ey}`,
      lx, ly, labelW: lw,
      label: t.label, color, id: arrowId, markerId, dasharray,
    });
    return;
  }

  const fcx = boxCx(fromS);
  const fcy = boxCy(fromS);
  const tcx = boxCx(toS);
  const tcy = boxCy(toS);

  const pairKey = [fromS.id, toS.id].sort().join('|');
  pairCount[pairKey] = (pairCount[pairKey] ?? 0) + 1;
  const pairIdx = pairCount[pairKey];

  const [sx, sy] = edgePoint(fcx, fcy, tcx, tcy, 4);
  const [ex, ey] = edgePoint(tcx, tcy, fcx, fcy, 4);

  const dx = ex - sx;
  const dy = ey - sy;
  const len = Math.sqrt(dx * dx + dy * dy);
  const perpX = -dy / len;
  const perpY =  dx / len;

  // Curve parallel edges to opposite sides
  const curveOffset = pairIdx === 1 ? 0 : (pairIdx % 2 === 0 ? 44 : -44);

  const mx = (sx + ex) / 2 + perpX * curveOffset;
  const my = (sy + ey) / 2 + perpY * curveOffset;

  // Bezier midpoint
  const bezMidX = 0.25 * sx + 0.5 * mx + 0.25 * ex;
  const bezMidY = 0.25 * sy + 0.5 * my + 0.25 * ey;

  // Determine label placement zone based on arrow direction:
  // Horizontal same-row: place above top edge of row or below bottom edge
  // Vertical same-col: place left or right of the column gap
  // Diagonal: push perpendicular from bezier midpoint
  let lx = bezMidX;
  let ly = bezMidY;
  let nudgeX = perpX;
  let nudgeY = perpY;

  const sameRow = fromS.row === toS.row;
  const sameCol = fromS.col === toS.col;

  if (sameRow) {
    // Horizontal arrow: prefer above row (negative Y direction)
    // "above" is safer: row top = PAD_Y + (row-1)*(BOX_H+ROW_GAP)
    const rowTop = PAD_Y + (fromS.row! - 1) * (BOX_H + ROW_GAP);
    const aboveY = rowTop - 10; // 10px above the box top
    lx = (sx + ex) / 2;
    // pairIdx 1 goes above, pairIdx 2 goes below
    if (pairIdx % 2 === 1) {
      ly = aboveY;
      nudgeX = 0; nudgeY = -1;
    } else {
      const rowBottom = rowTop + BOX_H + 10;
      ly = rowBottom;
      nudgeX = 0; nudgeY = 1;
    }
  } else if (sameCol) {
    // Vertical arrow: prefer in the column gap, nudge horizontally
    lx = bezMidX;
    ly = bezMidY;
    nudgeX = pairIdx % 2 === 1 ? 1 : -1;
    nudgeY = 0;
  } else {
    // Diagonal: push perpendicular from the bezier midpoint
    // Use a larger initial push to clear state boxes
    const push = curveOffset === 0 ? 20 : Math.abs(curveOffset) * 0.5 + 10;
    const side = pairIdx % 2 === 1 ? 1 : -1;
    lx = bezMidX + perpX * push * side;
    ly = bezMidY + perpY * push * side;
    nudgeX = perpX * side;
    nudgeY = perpY * side;
  }

  let finalLx = lx;
  let finalLy = ly;
  if (t.label) {
    [finalLx, finalLy] = findLabelPos(lx, ly, lw, nudgeX, nudgeY);
    placedLabels.push({ lx: finalLx, ly: finalLy, hw: lw / 2, hh: LABEL_H / 2 });
  }

  const d = curveOffset === 0
    ? `M ${sx} ${sy} L ${ex} ${ey}`
    : `M ${sx} ${sy} Q ${mx} ${my} ${ex} ${ey}`;

  arrows.push({ d, lx: finalLx, ly: finalLy, labelW: lw, label: t.label, color, id: arrowId, markerId, dasharray });
});
---

<div class="sm-wrap">
  {title && <div class="sm-titlebar"><span class="sm-prompt">$</span> {title}</div>}

  <div class="sm-body">
    <div class="sm-diagram" style={`max-width: ${svgW}px`}>
      <svg
        viewBox={`0 0 ${svgW} ${svgH}`}
        width="100%"
        style={`display:block; overflow:visible`}
        aria-label={title ?? 'State machine diagram'}
      >
        <defs>
          <!-- Arrowhead markers for each color -->
          <marker id="arr-accent" markerWidth="8" markerHeight="6" refX="7" refY="3" orient="auto">
            <path d="M0,0 L0,6 L8,3 z" fill="var(--color-accent)" />
          </marker>
          <marker id="arr-back" markerWidth="8" markerHeight="6" refX="7" refY="3" orient="auto">
            <path d="M0,0 L0,6 L8,3 z" fill="#94a3b8" />
          </marker>
          <marker id="arr-error" markerWidth="8" markerHeight="6" refX="7" refY="3" orient="auto">
            <path d="M0,0 L0,6 L8,3 z" fill="#f43f5e" />
          </marker>
          <marker id="arr-self" markerWidth="8" markerHeight="6" refX="7" refY="3" orient="auto">
            <path d="M0,0 L0,6 L8,3 z" fill="#8b5cf6" />
          </marker>
        </defs>

        <!-- Draw arrows first (behind boxes) -->
        {arrows.map((a) => {
          return (
            <>
              <path
                d={a.d}
                fill="none"
                stroke={a.color}
                stroke-width="1.5"
                stroke-dasharray={a.dasharray}
                marker-end={`url(#${a.markerId})`}
              />
              {a.label && (
                <>
                  <rect
                    x={a.lx - a.labelW / 2}
                    y={a.ly - LABEL_H + 3}
                    width={a.labelW}
                    height={LABEL_H}
                    rx="2"
                    fill="var(--color-surface)"
                    opacity="0.95"
                  />
                  <text
                    x={a.lx}
                    y={a.ly}
                    font-size="9"
                    font-family="var(--font-mono, monospace)"
                    fill="var(--color-text-muted)"
                    text-anchor="middle"
                    dominant-baseline="auto"
                  >{a.label}</text>
                </>
              )}
            </>
          );
        })}

        <!-- Draw state boxes on top -->
        {states.map((s) => {
          const c = stateColor(s);
          const cx = boxCx(s);
          const cy = boxCy(s);
          const x = cx - BOX_W / 2;
          const y = cy - BOX_H / 2;
          return (
            <>
              {/* Initial state indicator: small filled circle → arrow */}
              {s.initial && (
                <>
                  <circle cx={x - 14} cy={cy} r="5" fill="var(--color-accent)" />
                  <line
                    x1={x - 9} y1={cy} x2={x - 1} y2={cy}
                    stroke="var(--color-accent)" stroke-width="1.5"
                    marker-end="url(#arr-accent)"
                  />
                </>
              )}

              {/* Box */}
              <rect
                x={x} y={y}
                width={BOX_W} height={BOX_H}
                rx="6"
                fill={c.bg}
                stroke={c.border}
                stroke-width={s.final ? '2.5' : '1.5'}
                stroke-dasharray={s.final ? '6 2' : undefined}
              />

              {/* "start" badge */}
              {s.initial && (
                <rect x={cx - 13} y={y - 8} width="26" height="10" rx="2" fill="var(--color-accent)" />
              )}
              {s.initial && (
                <text x={cx} y={y - 1} font-size="7" font-family="var(--font-mono,monospace)"
                  fill="var(--color-bg)" text-anchor="middle" letter-spacing="0.04em">START</text>
              )}

              {/* "end" badge */}
              {s.final && (
                <rect x={cx - 10} y={y + BOX_H - 2} width="20" height="10" rx="2" fill="#16a34a" />
              )}
              {s.final && (
                <text x={cx} y={y + BOX_H + 7} font-size="7" font-family="var(--font-mono,monospace)"
                  fill="#fff" text-anchor="middle" letter-spacing="0.04em">END</text>
              )}

              {/* State label */}
              <text
                x={cx} y={s.sub ? cy - 6 : cy + 4}
                font-size="11.5"
                font-weight="700"
                font-family="var(--font-mono, monospace)"
                fill={c.text}
                text-anchor="middle"
                dominant-baseline="middle"
              >{s.label}</text>

              {/* Sub text */}
              {s.sub && (
                <text
                  x={cx} y={cy + 11}
                  font-size="8.5"
                  font-family="var(--font-mono, monospace)"
                  fill="var(--color-text-muted)"
                  text-anchor="middle"
                  dominant-baseline="middle"
                >{s.sub}</text>
              )}
            </>
          );
        })}
      </svg>
    </div>
  </div>

  {caption && <div class="sm-caption"><span class="sm-prompt">▶</span> {caption}</div>}
</div>

<style>
  .sm-wrap {
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    margin: 1.5rem 0;
    overflow: hidden;
    font-family: var(--font-mono, 'IBM Plex Mono', monospace);
  }

  .sm-titlebar {
    padding: 0.4rem 0.875rem;
    border-bottom: 1px solid var(--color-border);
    background: var(--color-surface-2);
    font-size: 0.65rem;
    color: var(--color-text-muted);
  }
  .sm-prompt { color: var(--color-accent); font-weight: 700; margin-right: 0.35rem; }

  .sm-body { padding: 1.25rem; }

  .sm-diagram {
    margin: 0 auto;
    width: 100%;
  }

  /* Caption */
  .sm-caption {
    padding: 0.45rem 0.875rem;
    border-top: 1px solid var(--color-border);
    font-size: 0.62rem;
    color: var(--color-text-dim);
    background: var(--color-bg);
    line-height: 1.5;
  }
</style>
