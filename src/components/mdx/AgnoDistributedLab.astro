---
const sha = '1f2aac51eb28dc9c0970836d3b7ae046bae81bbb';
---
<section class="dl" id="agno-distributed-lab" aria-label="Agno distributed execution explorer">
  <header class="dl-head">
    <div><p class="dl-kicker">DISTRIBUTED SYSTEMS / AGENTOS</p><h3>Explore a multi-replica agent runtime</h3><p>Deployment boundaries, persisted data, recovery paths, and capacity estimates.</p></div>
    <small>SOURCE · {sha.slice(0, 8)}</small>
  </header>
  <div class="dl-tabs" role="group" aria-label="Architecture perspectives">
    <button type="button" data-tab="topology" aria-pressed="true">01 · Architecture</button>
    <button type="button" data-tab="database" aria-pressed="false">02 · Data model</button>
    <button type="button" data-tab="lifecycle" aria-pressed="false">03 · Worker lifecycle</button>
    <button type="button" data-tab="capacity" aria-pressed="false">04 · Scaling model</button>
  </div>
  <div class="dl-page" data-page="topology">
    <p class="dl-legend">ILLUSTRATED TOPOLOGY <span>· Click a component to inspect the implementation</span></p>
    <div class="dl-split">
      <div class="dl-art">
        <svg viewBox="0 0 800 425" role="group" aria-label="Multi-replica AgentOS topology">
          <rect class="dl-box" x="18" y="11" width="760" height="399" rx="13"/>
          <rect class="dl-box" x="169" y="137" width="462" height="135" rx="13"/>
          <text class="dl-region" x="33" y="33">ILLUSTRATIVE DEPLOYMENT</text>
          <text class="dl-region" x="183" y="155">AGENTOS REPLICA FLEET</text>
          <g class="dl-lines"><path d="M400 96V116M250 116H550M250 116V173M400 116V173M550 116V173"/><path d="M250 238V310H140V330M400 238V330M550 238V310H655V330"/></g>
          <g data-node="client" class="dl-node" role="button" tabindex="0"><rect x="313" y="48" width="174" height="47" rx="8"/><text x="400" y="77">Web client / Load Balancer</text></g>
          <g data-node="replica" class="dl-node" role="button" tabindex="0"><rect x="184" y="173" width="132" height="65" rx="9"/><text x="250" y="196">Replica A</text><text class="dl-sub" x="250" y="214">API + execution</text></g>
          <g data-node="worker" class="dl-node" role="button" tabindex="0"><rect x="334" y="173" width="132" height="65" rx="9"/><text x="400" y="196">Replica B</text><text class="dl-sub" x="400" y="214">Queue worker*</text></g>
          <g data-node="reconnect" class="dl-node" role="button" tabindex="0"><rect x="484" y="173" width="132" height="65" rx="9"/><text x="550" y="196">Replica C</text><text class="dl-sub" x="550" y="214">SSE reconnect</text></g>
          <g data-node="db" class="dl-node dl-storage" role="button" tabindex="0"><rect x="55" y="330" width="169" height="53" rx="9"/><text x="139" y="352">PostgreSQL</text><text class="dl-sub" x="139" y="368">sessions · runs · jobs</text></g>
          <g data-node="redis" class="dl-node dl-storage" role="button" tabindex="0"><rect x="315" y="330" width="169" height="53" rx="9"/><text x="400" y="352">Redis Streams</text><text class="dl-sub" x="400" y="368">events · cancellation</text></g>
          <g data-node="tools" class="dl-node dl-storage" role="button" tabindex="0"><rect x="570" y="330" width="169" height="53" rx="9"/><text x="654" y="352">LLM + Tools</text><text class="dl-sub" x="654" y="368">external dependencies</text></g>
          <text x="35" y="404" class="dl-foot">* A worker executes on configured durable queue-enabled replicas; modules are not separate Agno services.</text>
        </svg>
      </div>
      <aside class="dl-inspector" aria-live="polite"><small>COMPONENT INSPECTOR</small><h4 id="dl-node-title">AgentOS replica</h4><p id="dl-node-info">FastAPI routes and agent execution can run in the same process.</p><p id="dl-node-why">Deploying more replicas increases available application capacity but introduces shared-state and coordination requirements.</p><a id="dl-node-link" href="https://github.com/agno-agi/agno" target="_blank" rel="noopener noreferrer">Inspect pinned source ↗</a></aside>
    </div>
  </div>
  <div class="dl-page" data-page="database" hidden>
    <p class="dl-legend">SOURCE-BASED DATA VIEW <span>· PostgreSQL schema; one physical FK is highlighted</span></p>
    <div class="dl-split">
      <div class="dl-erd" role="group" aria-label="Logical data model with physical database fields">
        <button data-table="sessions"><strong>agno_sessions</strong><span>PK session_id</span><span>user_id · session_type</span><span>session_data JSONB</span></button>
        <button data-table="runs"><strong>agno_runs</strong><span>PK run_id · FK session_id</span><span>status · run_index · run_type</span><span>run_data JSONB</span></button>
        <button data-table="jobs"><strong>agno_jobs</strong><span>id = run_id (logical link)</span><span>status · attempt · locked_by</span><span>idempotency_key · payload</span></button>
        <button data-table="memory"><strong>Memory records</strong><span>memory_id · user_id</span><span>memory JSONB · feedback</span></button>
        <button data-table="knowledge"><strong>Knowledge records</strong><span>id · user_id · linked_to</span><span>metadata · status</span></button>
        <p><b>Physical relation:</b> agno_runs.session_id → agno_sessions.session_id (ON DELETE CASCADE). Job.id uses the same run identifier by contract, but is not shown as a verified SQL foreign key.</p>
      </div>
      <aside class="dl-inspector" aria-live="polite"><small>DATA INSPECTOR</small><h4 id="dl-data-title">agno_runs</h4><p id="dl-data-info">A normalized run row stores run attributes and its JSON payload.</p><p id="dl-data-why">The composite session_id/run_index index serves ordered run history retrieval.</p><a id="dl-data-link" href="https://github.com/agno-agi/agno" target="_blank" rel="noopener noreferrer">Inspect pinned schema ↗</a></aside>
    </div>
  </div>
  <div class="dl-page" data-page="lifecycle" hidden>
    <p class="dl-legend">EVENT-LED EXECUTION WALKTHROUGH <span>· Illustrative sequence, grounded in source</span></p>
    <div class="dl-cases" role="group" aria-label="Execution scenario">
      <button data-scenario="healthy" aria-pressed="true">Healthy</button>
      <button data-scenario="crash" aria-pressed="false">Worker crash</button>
      <button data-scenario="reconnect" aria-pressed="false">SSE reconnect</button>
      <button data-scenario="sideeffect" aria-pressed="false">Unknown write outcome</button>
    </div>
    <div class="dl-split">
      <div class="dl-events"><div class="dl-events-head"><h4 id="dl-scenario-title">Healthy durable run</h4><small id="dl-position">1 / 5</small></div><div class="dl-event-grid" id="dl-event-buttons"></div><div class="dl-transport"><button type="button" id="dl-prev">←</button><input type="range" id="dl-timeline" min="0" max="4" value="0" aria-label="Scrub execution steps"/><button type="button" id="dl-next">→</button><button type="button" id="dl-play">▶ Play</button></div></div>
      <aside class="dl-inspector" aria-live="polite"><small>EVENT DETAILS</small><h4 id="dl-event-title">Durable acceptance</h4><p id="dl-event-info">Committed job ticket precedes HTTP acceptance.</p><pre id="dl-event-code">HTTP 202
status = queued</pre><a id="dl-event-link" href="https://github.com/agno-agi/agno" target="_blank" rel="noopener noreferrer">Inspect supporting source ↗</a></aside>
    </div>
  </div>
  <div class="dl-page" data-page="capacity" hidden>
    <p class="dl-legend">THEORETICAL CAPACITY SANDBOX <span>· Arithmetic estimate, not an Agno benchmark</span></p>
    <div class="dl-scale">
      <div class="dl-inputs">
        <label>Runtime replicas <output id="dl-n-rep">3</output><input id="dl-rep" type="range" min="1" max="8" value="3"/></label>
        <label>Concurrency / replica <output id="dl-n-cap">16</output><input id="dl-cap" type="range" min="4" max="64" step="4" value="16"/></label>
        <label>Average run duration (seconds) <output id="dl-n-dur">12</output><input id="dl-dur" type="range" min="3" max="60" value="12"/></label>
        <label>Arrival rate (runs / second) <output id="dl-n-rate">3</output><input id="dl-rate" type="range" min="1" max="24" value="3"/></label>
      </div>
      <div class="dl-output" aria-live="polite">
        <div><span>Idealized maximum</span><strong id="dl-max">4.0 runs/s</strong></div>
        <div><span>Offered load</span><strong id="dl-load">75%</strong></div>
        <div><span>Backlog growth</span><strong id="dl-growth">0 runs/min</strong></div>
        <div class="dl-meter"><i id="dl-bar"></i></div>
        <p id="dl-interpret">Under the simplified limit. External quotas and database contention can be tighter bottlenecks.</p>
      </div>
    </div>
    <p class="dl-note">Assumptions: steady independent jobs, uniform duration, no dispatch overhead, and no external rate limit. The actual ordinary-background limiter is per event loop, not fleet-wide. This model is not measured throughput.</p>
  </div>
  <footer class="dl-footer">Pinned to <a href={'https://github.com/agno-agi/agno/tree/' + sha} target="_blank" rel="noopener noreferrer">agno-agi/agno @ {sha.slice(0,8)} ↗</a>. Diagrams and run traces explain design patterns; they are not captured production telemetry.</footer>
</section>
<style>
.dl{--d-bg:var(--color-surface,#102030);--d-panel:var(--color-surface-2,#192b3b);--d-text:var(--color-text,#f2f5f8);--d-muted:var(--color-text-dim,#a9bbca);--d-border:var(--color-border,#455569);--d-accent:var(--color-accent,#4bd2b8);position:relative;left:50%;transform:translateX(-50%);width:min(1110px,calc(100vw - 28px));max-width:none!important;margin:2rem 0;color:var(--d-text);background:var(--d-bg);border:1px solid var(--d-border);border-radius:17px;overflow:hidden;box-shadow:0 10px 40px #0001;font-family:inherit}
.dl *{box-sizing:border-box}.dl-head{padding:23px;display:flex;justify-content:space-between;gap:14px}.dl-head h3{font-size:1.5rem;margin:5px 0}.dl-head p{margin:0;color:var(--d-muted);font-size:.82rem}.dl-kicker{font:.68rem ui-monospace,monospace!important;color:var(--d-accent)!important;letter-spacing:.12em}.dl-head small{font:.7rem ui-monospace,monospace;white-space:nowrap;color:var(--d-muted)}.dl-tabs{display:flex;flex-wrap:wrap;border-block:1px solid var(--d-border);padding-inline:12px}.dl-tabs button{padding:13px;border:0;border-bottom:2px solid transparent;background:none;color:var(--d-muted);font:700 .78rem system-ui;cursor:pointer}.dl-tabs button[aria-pressed=true]{border-bottom-color:var(--d-accent);color:var(--d-text)}.dl-page{padding:16px}.dl-page[hidden]{display:none!important}.dl-legend{font:700 .68rem ui-monospace,monospace;color:var(--d-accent);margin:0 0 12px}.dl-legend span{font-weight:400;color:var(--d-muted)}.dl-split{display:grid;grid-template-columns:minmax(0,1fr) 260px;gap:12px}.dl-art,.dl-erd,.dl-events,.dl-inputs,.dl-output,.dl-inspector{background:var(--d-panel);border:1px solid var(--d-border);border-radius:11px;min-width:0}.dl-art{overflow:auto}.dl-art svg{display:block;min-width:630px;width:100%;max-height:460px}.dl-art .dl-box{fill:var(--d-bg);stroke:var(--d-border);stroke-dasharray:5 5}.dl-region,.dl-foot{font:700 10px ui-monospace,monospace;fill:var(--d-muted)}.dl-foot{font-weight:400}.dl-lines{stroke:var(--d-muted);fill:none;opacity:.65;stroke-width:1.5}.dl-node{cursor:pointer;outline:none}.dl-node rect{fill:color-mix(in srgb,#2d88de 14%,var(--d-panel));stroke:#438ed9;stroke-width:1.5}.dl-node.dl-storage rect{fill:color-mix(in srgb,#9b7bdc 13%,var(--d-panel));stroke:#9377d0}.dl-node.active rect,.dl-node:focus-visible rect{stroke:var(--d-accent);stroke-width:3}.dl-node text{fill:var(--d-text);text-anchor:middle;font:700 12px system-ui}.dl-node .dl-sub{font:10px system-ui;fill:var(--d-muted)}.dl-inspector{padding:18px;display:flex;align-items:flex-start;flex-direction:column;gap:11px}.dl-inspector small{font:.68rem ui-monospace,monospace;color:var(--d-accent)}.dl-inspector h4{margin:0;font-size:1.09rem}.dl-inspector p,.dl-inspector pre{margin:0;color:var(--d-muted);font-size:.8rem;line-height:1.6}.dl-inspector pre{width:100%;background:var(--d-bg);padding:10px;border-radius:7px;white-space:pre-wrap;overflow-wrap:anywhere}.dl-inspector a{color:var(--d-accent);font-size:.78rem;margin-top:auto;overflow-wrap:anywhere}.dl-erd{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;padding:16px}.dl-erd button{text-align:left;cursor:pointer;background:var(--d-bg);color:var(--d-text);border:1px solid var(--d-border);border-radius:9px;padding:12px;display:flex;flex-direction:column;gap:5px}.dl-erd button.active{border-color:var(--d-accent)}.dl-erd strong{font:700 .82rem ui-monospace,monospace;margin-bottom:6px}.dl-erd span{font:.7rem ui-monospace,monospace;color:var(--d-muted)}.dl-erd p{grid-column:1/-1;margin:3px 0;color:var(--d-muted);font-size:.74rem;line-height:1.6}.dl-cases{display:flex;flex-wrap:wrap;gap:7px;margin-bottom:13px}.dl-cases button,.dl-transport button,.dl-event-grid button{cursor:pointer;background:var(--d-panel);color:var(--d-text);border:1px solid var(--d-border);border-radius:7px;padding:9px;font-size:.77rem}.dl-cases button[aria-pressed=true],.dl-event-grid button[aria-pressed=true]{border-color:var(--d-accent);background:color-mix(in srgb,var(--d-accent) 11%,var(--d-panel))}.dl-events{padding:17px}.dl-events-head{display:flex;justify-content:space-between;gap:10px;align-items:center}.dl-events-head h4{margin:0;font-size:1rem}.dl-events-head small{color:var(--d-muted)}.dl-event-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:7px;margin:17px 0}.dl-event-grid button{text-align:left;min-height:60px;font-size:.71rem}.dl-event-grid button span{display:block;color:var(--d-accent);font:700 .65rem ui-monospace,monospace;margin-bottom:5px}.dl-transport{display:flex;gap:8px;align-items:center}.dl-transport input{min-width:55px;flex:1;accent-color:var(--d-accent)}.dl-scale{display:grid;grid-template-columns:1.1fr 1fr;gap:12px}.dl-inputs,.dl-output{padding:20px}.dl-inputs label{display:block;color:var(--d-muted);font-size:.8rem;margin-bottom:17px}.dl-inputs output{float:right;color:var(--d-text);font-weight:700}.dl-inputs input{display:block;width:100%;accent-color:var(--d-accent);margin-top:12px}.dl-output{display:grid;grid-template-columns:1fr 1fr;gap:13px;align-content:start}.dl-output>div:not(.dl-meter){border:1px solid var(--d-border);background:var(--d-bg);padding:12px;border-radius:7px}.dl-output span{display:block;font-size:.71rem;color:var(--d-muted)}.dl-output strong{display:block;margin-top:8px;font-size:1.25rem}.dl-output p{grid-column:1/-1;font-size:.77rem;color:var(--d-muted);line-height:1.6}.dl-meter{height:8px;grid-column:1/-1;background:var(--d-bg);border-radius:10px;overflow:hidden}.dl-meter i{display:block;background:var(--d-accent);height:100%;width:75%}.dl-note,.dl-footer{font-size:.74rem;line-height:1.6;color:var(--d-muted)}.dl-footer{padding:13px 19px;border-top:1px solid var(--d-border)}.dl-footer a{color:var(--d-accent)}.dl button:focus-visible,.dl input:focus-visible,.dl a:focus-visible{outline:2px solid var(--d-accent);outline-offset:2px}@media(max-width:770px){.dl-split,.dl-scale{grid-template-columns:1fr}.dl-event-grid{grid-template-columns:repeat(2,1fr)}.dl-head{flex-wrap:wrap}.dl-tabs button{padding:11px 9px;font-size:.71rem}}@media(max-width:390px){.dl-erd{grid-template-columns:1fr}.dl-transport{flex-wrap:wrap}.dl-transport input{order:-1;flex-basis:100%}}
</style>
<script>
(()=>{
const root=document.querySelector('#agno-distributed-lab');if(!root||root.dataset.ready==='1')return;root.dataset.ready='1';
const $=id=>root.querySelector('#'+id);
const base='https://github.com/agno-agi/agno/blob/1f2aac51eb28dc9c0970836d3b7ae046bae81bbb/libs/agno/agno/';
const nodes={client:['Client ingress','A registered run endpoint receives the request through an HTTP server.','Clients may reconnect to a different replica.','os/routers/agents/router.py'],replica:['AgentOS replica','A FastAPI application serves routers and registered agent execution in one deployment.','These Python modules are not inherently independent microservices.','os/app.py'],worker:['Durable worker','A worker claims a committed job and executes it using lease and attempt ownership.','Configure QueueConfig(durable=True) to obtain durable background execution.','os/job_queue.py'],reconnect:['SSE on another replica','The reconnected client may land on another runtime container.','Redis Streams supports replay and live-tail across replicas.','os/event_streams/redis.py'],db:['PostgreSQL','Sessions, normalized runs and optionally durable job tickets persist here.','The run database—not the event stream—is the source of truth for completion.','db/postgres/schemas.py'],redis:['Redis coordination','Shared cancellation manager and event stream use a configured Redis backend.','Per-run streams are temporary; a final result may require DB fallback.','os/job_queue.py'],tools:['Model / external APIs','The agent calls model providers or external integrations.','Application code must protect external writes with proper idempotency.','agent/agent.py']};
const tables={sessions:['agno_sessions','PK session_id. Session type, component IDs, user ID, context and summary stored as columns/JSONB.','Deleting the session cascades to agno_runs through the verified FK.','db/postgres/schemas.py'],runs:['agno_runs','One row per run: run_id PK, session_id FK, run_type, status, run_index, JSONB payload.','An index on session_id and run_index supports recent-run retrieval.','db/postgres/schemas.py'],jobs:['agno_jobs','Durable ticket id equals run_id, with serialized payload, attempt, lock holder, and retry policy.','The job/run ID match is a logical invariant, not a verified FK.','db/schemas/jobs.py'],memory:['Memory records','Longer-lived user memories are stored independently of per-run state.','A memory is not a queue job, run history, or vector index.','db/postgres/schemas.py'],knowledge:['Knowledge records','Document metadata has id, status, user_id and linked_to fields.','Ingestion and vector retrieval remain separate responsibilities.','db/postgres/schemas.py']};
const traces={
healthy:{title:'Healthy durable run',steps:[['Accept','HTTP 202 / DB commit','Job acceptance becomes durable before response.','job_queue/config.py'],['Claim','queued → running','A worker claims the ticket with lease ownership.','os/job_queue.py'],['Execute','Agent / model / tools','The registered agent executes and may emit streaming events.','os/routers/agents/router.py'],['Publish','Redis XADD','Per-run stream makes events available across replicas.','os/event_streams/redis.py'],['Commit','completed','Final job/run state is persisted with attempt fencing.','db/schemas/jobs.py']]},
crash:{title:'Worker crash and recovery',steps:[['Accepted','queued','Committed ticket survives the worker process.','db/schemas/jobs.py'],['Claimed','running / locked_by=B','Worker B owns a lease and starts work.','os/job_queue.py'],['Crash','heartbeat lost','Worker dies; its downstream side effects may have happened.','os/job_queue.py'],['Sweep','stale lease','Sweeper decides whether to fail or reclaim.','os/job_queue.py'],['Policy','max_attempts=1 / 2+','Default: visible fail without silent replay. 2+: retry is possible.','job_queue/config.py'],['Fence','locked_by + attempt','Old worker cannot overwrite the newer attempt.','db/schemas/jobs.py']]},
reconnect:{title:'Cross-replica SSE reconnection',steps:[['Submit','Client → A','Background request enters through one replica.','os/routers/agents/router.py'],['Execute','Worker B','Different replica claims the queued work.','os/job_queue.py'],['Events','Redis XADD','Producer writes events into a per-run shared stream.','os/event_streams/redis.py'],['Disconnect','Client socket closes','The durable run may continue without the socket.','os/routers/agents/router.py'],['Reconnect','Client → C','Another replica replays/tails stream events.','os/event_streams/redis.py'],['Expire','DB fallback','After stream TTL expiry, persisted terminal state is authoritative.','os/event_streams/redis.py']]},
sideeffect:{title:'Ambiguous external tool write',steps:[['Check','Authorization','Tool must enforce caller permissions.','os/routers/agents/router.py'],['Write','HTTP POST external','External side effect is requested.','agent/agent.py'],['Timeout','OUTCOME_UNKNOWN (design)','Response is lost after the external system might have committed.','os/job_queue.py'],['Reconcile','External correlation','Use an idempotency key or operation lookup before retry.','db/schemas/jobs.py'],['Resolve','Avoid duplicate action','Declare success, failure, or escalation based on evidence.','os/job_queue.py']]}
};
let scenario='healthy',step=0,interval=null;
function bindPick(selector,fn){root.querySelectorAll(selector).forEach(el=>{el.addEventListener('click',()=>fn(el));el.addEventListener('keydown',e=>{if(e.key==='Enter'||e.key===' '){e.preventDefault();fn(el)}})})}
bindPick('[data-tab]',el=>{root.querySelectorAll('[data-tab]').forEach(e=>e.setAttribute('aria-pressed',String(e===el)));root.querySelectorAll('[data-page]').forEach(e=>e.hidden=e.dataset.page!==el.dataset.tab);pause()});
bindPick('[data-node]',el=>{root.querySelectorAll('[data-node]').forEach(e=>e.classList.toggle('active',e===el));const n=nodes[el.dataset.node];$('dl-node-title').textContent=n[0];$('dl-node-info').textContent=n[1];$('dl-node-why').textContent=n[2];$('dl-node-link').href=base+n[3]});
bindPick('[data-table]',el=>{root.querySelectorAll('[data-table]').forEach(e=>e.classList.toggle('active',e===el));const n=tables[el.dataset.table];$('dl-data-title').textContent=n[0];$('dl-data-info').textContent=n[1];$('dl-data-why').textContent=n[2];$('dl-data-link').href=base+n[3]});
function pause(){if(interval!==null){clearInterval(interval);interval=null}$('dl-play').textContent='▶ Play'}
function render(){const t=traces[scenario],s=t.steps[step];$('dl-scenario-title').textContent=t.title;$('dl-position').textContent=(step+1)+' / '+t.steps.length;$('dl-event-title').textContent=s[0];$('dl-event-info').textContent=s[2];$('dl-event-code').textContent=s[1];$('dl-event-link').href=base+s[3];$('dl-timeline').max=t.steps.length-1;$('dl-timeline').value=step;const host=$('dl-event-buttons');host.replaceChildren();t.steps.forEach((s,i)=>{const b=document.createElement('button');b.type='button';b.setAttribute('aria-pressed',String(i===step));const tag=document.createElement('span');tag.textContent=String(i+1).padStart(2,'0');b.append(tag,document.createTextNode(s[0]));b.addEventListener('click',()=>{pause();step=i;render()});host.append(b)})}
bindPick('[data-scenario]',el=>{pause();scenario=el.dataset.scenario;step=0;root.querySelectorAll('[data-scenario]').forEach(e=>e.setAttribute('aria-pressed',String(e===el)));render()});
$('dl-prev').addEventListener('click',()=>{pause();step=Math.max(0,step-1);render()});$('dl-next').addEventListener('click',()=>{pause();step=Math.min(traces[scenario].steps.length-1,step+1);render()});$('dl-timeline').addEventListener('input',e=>{pause();step=Number(e.target.value);render()});$('dl-play').addEventListener('click',()=>{if(interval!==null){pause();return}interval=setInterval(()=>{if(step===traces[scenario].steps.length-1){pause();return}step++;render()},1500);$('dl-play').textContent='Ⅱ Pause'});
function scale(){const values={};for(const id of ['rep','cap','dur','rate']){values[id]=Number($('dl-'+id).value);$('dl-n-'+id).textContent=values[id]}const max=values.rep*values.cap/values.dur,load=values.rate/max*100,growth=Math.max(0,(values.rate-max)*60);$('dl-max').textContent=max.toFixed(1)+' runs/s';$('dl-load').textContent=Math.round(load)+'%';$('dl-growth').textContent=Math.round(growth)+' runs/min';$('dl-bar').style.width=Math.min(100,load)+'%';$('dl-bar').style.background=load>100?'#e37e62':'var(--d-accent)';$('dl-interpret').textContent=load>100?'Offered load exceeds this simplified ceiling. A backlog would accumulate.':'Below the simple ceiling. Quotas, database contention and network overhead can still dominate.'}
for(const id of ['rep','cap','dur','rate'])$('dl-'+id).addEventListener('input',scale);
root.querySelector('[data-node="worker"]').click();root.querySelector('[data-table="runs"]').click();render();scale();
})();
</script>