---
/**
 * ScoreGauge — 5-metric architectural quality breakdown.
 *
 * Renders each root-cause metric as a labeled bar with an optional formula
 * annotation, then shows the combined score (geometric mean) as a summary row.
 *
 * Usage:
 *   <ScoreGauge
 *     metrics={[
 *       { label: "Modularity", formula: "Newman Q", value: 0.78, color: "teal" },
 *       { label: "Acyclicity", formula: "1/(1+cycles)", value: 1.0, color: "green" },
 *       { label: "Depth",      formula: "1/(1+d/8)",  value: 0.82, color: "amber" },
 *       { label: "Equality",   formula: "1 − Gini",   value: 0.71, color: "teal" },
 *       { label: "Redundancy", formula: "1 − waste",  value: 0.90, color: "green" },
 *     ]}
 *     combinedLabel="Quality signal"
 *     combinedValue={7342}
 *     combinedMax={10000}
 *   />
 */
interface Metric {
  label: string;
  formula?: string;
  /** Normalised score in [0, 1]. */
  value: number;
  color?: 'teal' | 'green' | 'amber' | 'rose';
}

interface Props {
  metrics: Metric[];
  /** Label shown in the combined-score row, e.g. "Quality signal". */
  combinedLabel?: string;
  /** Raw combined score shown as a number (e.g. 7342). */
  combinedValue?: number;
  /** Max value for the combined score bar (default 10000). */
  combinedMax?: number;
  title?: string;
}

const {
  metrics,
  combinedLabel = 'Quality signal',
  combinedValue,
  combinedMax = 10000,
  title,
} = Astro.props;

const fgColors: Record<string, string> = {
  teal:  '#0891b2',
  green: '#059669',
  amber: '#d97706',
  rose:  '#be123c',
};

const bgColors: Record<string, string> = {
  teal:  'rgba(8,145,178,0.15)',
  green: 'rgba(5,150,105,0.15)',
  amber: 'rgba(217,119,6,0.15)',
  rose:  'rgba(190,18,60,0.15)',
};

function pct(v: number, max = 1): number {
  return Math.min(100, Math.max(2, (v / max) * 100));
}

// Compute geometric mean from the metric values if combinedValue not supplied
const computedCombined = combinedValue !== undefined
  ? combinedValue
  : Math.round(metrics.reduce((p, m) => p * Math.max(m.value, 0.01), 1) ** (1 / metrics.length) * combinedMax);
---

<div class="sg-wrap">
  {title && <div class="sg-title">{title}</div>}

  <div class="sg-rows">
    {metrics.map((m) => {
      const c = (m.color ?? 'teal') as keyof typeof fgColors;
      const fg = fgColors[c];
      const bg = bgColors[c];
      const w = pct(m.value);
      const display = `${(m.value * 100).toFixed(0)}%`;

      return (
        <div class="sg-row">
          <div class="sg-label-col">
            <span class="sg-label">{m.label}</span>
            {m.formula && <span class="sg-formula">{m.formula}</span>}
          </div>
          <div class="sg-track">
            <div
              class="sg-fill"
              style={`width: ${w}%; background: linear-gradient(90deg, ${bg}, ${fg});`}
            />
          </div>
          <div class="sg-value" style={`color: ${fg};`}>{display}</div>
        </div>
      );
    })}
  </div>

  {/* Combined score row */}
  <div class="sg-combined">
    <div class="sg-combined-label">{combinedLabel}</div>
    <div class="sg-combined-track">
      <div
        class="sg-combined-fill"
        style={`width: ${pct(computedCombined, combinedMax)}%;`}
      />
    </div>
    <div class="sg-combined-value">{computedCombined.toLocaleString()}<span class="sg-combined-max"> / {combinedMax.toLocaleString()}</span></div>
  </div>
</div>

<style>
  .sg-wrap {
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    margin: 1.25rem 0;
    overflow: hidden;
  }

  .sg-title {
    padding: 0.45rem 1rem;
    border-bottom: 1px solid var(--color-border);
    background: var(--color-surface-2, var(--color-surface));
    font-family: var(--font-mono, 'IBM Plex Mono', monospace);
    font-size: 0.68rem;
    font-weight: 700;
    color: var(--color-text-muted, var(--color-text-dim));
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .sg-rows {
    display: flex;
    flex-direction: column;
    gap: 0;
    padding: 0.75rem 1rem 0;
  }

  .sg-row {
    display: grid;
    grid-template-columns: 9.5rem 1fr 3.5rem;
    gap: 0.75rem;
    align-items: center;
    padding: 0.35rem 0;
    border-bottom: 1px solid var(--color-border);
  }
  .sg-row:last-child {
    border-bottom: none;
  }

  .sg-label-col {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }

  .sg-label {
    font-family: var(--font-mono, 'IBM Plex Mono', monospace);
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--color-text);
    line-height: 1.2;
  }

  .sg-formula {
    font-family: var(--font-mono, 'IBM Plex Mono', monospace);
    font-size: 0.6rem;
    color: var(--color-text-dim);
    opacity: 0.7;
  }

  .sg-track {
    height: 1.1rem;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    overflow: hidden;
  }

  .sg-fill {
    height: 100%;
    min-width: 4px;
    transition: width 0.4s ease;
  }

  .sg-value {
    font-family: var(--font-mono, 'IBM Plex Mono', monospace);
    font-size: 0.72rem;
    font-weight: 700;
    text-align: right;
  }

  /* Combined score */
  .sg-combined {
    display: grid;
    grid-template-columns: 9.5rem 1fr 3.5rem;
    gap: 0.75rem;
    align-items: center;
    padding: 0.6rem 1rem;
    margin-top: 0;
    border-top: 2px solid var(--color-border);
    background: var(--color-bg);
  }

  .sg-combined-label {
    font-family: var(--font-mono, 'IBM Plex Mono', monospace);
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--color-accent);
    letter-spacing: 0.02em;
  }

  .sg-combined-track {
    height: 1.25rem;
    background: var(--color-surface);
    border: 1px solid var(--color-accent);
    overflow: hidden;
  }

  .sg-combined-fill {
    height: 100%;
    background: linear-gradient(90deg, rgba(8,145,178,0.2), var(--color-accent));
    transition: width 0.4s ease;
  }

  .sg-combined-value {
    font-family: var(--font-mono, 'IBM Plex Mono', monospace);
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--color-accent);
    text-align: right;
    white-space: nowrap;
  }

  .sg-combined-max {
    font-size: 0.6rem;
    opacity: 0.55;
  }

  @media (max-width: 520px) {
    .sg-row,
    .sg-combined {
      grid-template-columns: 1fr auto;
      grid-template-rows: auto auto;
      gap: 0.2rem 0.5rem;
    }
    .sg-label-col { grid-column: 1; grid-row: 1; }
    .sg-value, .sg-combined-value { grid-column: 2; grid-row: 1; }
    .sg-track, .sg-combined-track { grid-column: 1 / -1; grid-row: 2; }
  }
</style>
