---
/**
 * BenchmarkBar — Paired before/after bar comparison for benchmark results.
 *
 * Each row shows two bars side-by-side (baseline vs optimized) with a
 * reduction percentage badge. Ideal for "grep vs SocratiCode" style results.
 *
 * Usage:
 *   <BenchmarkBar
 *     baselineLabel="grep"
 *     optimizedLabel="SocratiCode"
 *     unit="bytes"
 *     rows={[
 *       { label: "Workspace trust", baseline: 56383, optimized: 2068, reduction: "96.3%", speedup: "37×" },
 *       { label: "Auth provider", baseline: 37250, optimized: 18932, reduction: "49.2%", speedup: "31×" },
 *     ]}
 *     totalRow={{ label: "Total", baseline: 250510, optimized: 96485, reduction: "61.5%", speedup: "37.2×" }}
 *   />
 */
interface BenchmarkRow {
  label: string;
  baseline: number;
  optimized: number;
  /** Displayed reduction text, e.g. "61.5%". */
  reduction: string;
  /** Optional speedup label, e.g. "37×". */
  speedup?: string;
}

interface Props {
  baselineLabel?: string;
  optimizedLabel?: string;
  /** Unit suffix shown in the legend, e.g. "bytes", "calls". */
  unit?: string;
  rows: BenchmarkRow[];
  totalRow?: BenchmarkRow;
  caption?: string;
}

const {
  baselineLabel = 'Before',
  optimizedLabel = 'After',
  unit = '',
  rows,
  totalRow,
  caption,
} = Astro.props;

const allRows = totalRow ? [...rows, { ...totalRow, isTotal: true }] : rows;
const globalMax = Math.max(...allRows.map((r) => r.baseline));

function pct(v: number): number {
  return Math.min(100, Math.max(1, (v / globalMax) * 100));
}

function fmt(n: number): string {
  return n >= 1000 ? `${(n / 1000).toFixed(1)}K` : String(n);
}
---

<div class="bb-wrap">
  <!-- Legend -->
  <div class="bb-legend">
    <span class="bb-legend-item">
      <span class="bb-swatch bb-swatch-baseline" />
      {baselineLabel}{unit ? ` (${unit})` : ''}
    </span>
    <span class="bb-legend-item">
      <span class="bb-swatch bb-swatch-optimized" />
      {optimizedLabel}{unit ? ` (${unit})` : ''}
    </span>
  </div>

  <!-- Rows -->
  <div class="bb-rows">
    {rows.map((row) => (
      <div class="bb-row">
        <div class="bb-label">{row.label}</div>
        <div class="bb-bars">
          <div class="bb-bar-pair">
            <div class="bb-bar-wrap">
              <div class="bb-bar bb-bar-baseline" style={`width: ${pct(row.baseline)}%;`} />
              <span class="bb-bar-val bb-val-baseline">{fmt(row.baseline)}</span>
            </div>
            <div class="bb-bar-wrap">
              <div class="bb-bar bb-bar-optimized" style={`width: ${pct(row.optimized)}%;`} />
              <span class="bb-bar-val bb-val-optimized">{fmt(row.optimized)}</span>
            </div>
          </div>
          <div class="bb-badges">
            <span class="bb-badge-reduction">{row.reduction} less</span>
            {row.speedup && <span class="bb-badge-speedup">{row.speedup} faster</span>}
          </div>
        </div>
      </div>
    ))}

    {totalRow && (
      <div class="bb-row bb-row-total">
        <div class="bb-label bb-label-total">{totalRow.label}</div>
        <div class="bb-bars">
          <div class="bb-bar-pair">
            <div class="bb-bar-wrap">
              <div class="bb-bar bb-bar-baseline" style={`width: ${pct(totalRow.baseline)}%;`} />
              <span class="bb-bar-val bb-val-baseline">{fmt(totalRow.baseline)}</span>
            </div>
            <div class="bb-bar-wrap">
              <div class="bb-bar bb-bar-optimized" style={`width: ${pct(totalRow.optimized)}%;`} />
              <span class="bb-bar-val bb-val-optimized">{fmt(totalRow.optimized)}</span>
            </div>
          </div>
          <div class="bb-badges">
            <span class="bb-badge-reduction bb-badge-total">{totalRow.reduction} less</span>
            {totalRow.speedup && <span class="bb-badge-speedup bb-badge-total">{totalRow.speedup} faster</span>}
          </div>
        </div>
      </div>
    )}
  </div>

  {caption && <div class="bb-caption">{caption}</div>}
</div>

<style>
  .bb-wrap {
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    margin: 1.25rem 0;
    overflow: hidden;
  }

  /* Legend */
  .bb-legend {
    display: flex;
    gap: 1.25rem;
    padding: 0.5rem 1rem;
    border-bottom: 1px solid var(--color-border);
    background: var(--color-surface-2, var(--color-surface));
  }

  .bb-legend-item {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-mono, 'IBM Plex Mono', monospace);
    font-size: 0.65rem;
    color: var(--color-text-dim);
  }

  .bb-swatch {
    display: inline-block;
    width: 0.75rem;
    height: 0.55rem;
    flex-shrink: 0;
  }

  .bb-swatch-baseline  { background: rgba(190, 18, 60, 0.55); }
  .bb-swatch-optimized { background: rgba(8, 145, 178, 0.75); }

  /* Rows */
  .bb-rows {
    display: flex;
    flex-direction: column;
    gap: 0;
    padding: 0.75rem 1rem;
  }

  .bb-row {
    display: grid;
    grid-template-columns: 12rem 1fr;
    gap: 0.75rem;
    align-items: center;
    padding: 0.4rem 0;
    border-bottom: 1px solid var(--color-border);
  }

  .bb-row:last-child {
    border-bottom: none;
  }

  .bb-row-total {
    border-top: 2px solid var(--color-border);
    margin-top: 0.25rem;
    padding-top: 0.5rem;
  }

  .bb-label {
    font-family: var(--font-mono, 'IBM Plex Mono', monospace);
    font-size: 0.7rem;
    color: var(--color-text);
    line-height: 1.3;
    padding-right: 0.5rem;
  }

  .bb-label-total {
    font-weight: 700;
    color: var(--color-accent);
  }

  .bb-bars {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .bb-bar-pair {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .bb-bar-wrap {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    height: 1rem;
  }

  .bb-bar {
    height: 100%;
    min-width: 3px;
    transition: width 0.3s ease;
    flex-shrink: 0;
  }

  .bb-bar-baseline  { background: rgba(190, 18, 60, 0.5); }
  .bb-bar-optimized { background: rgba(8, 145, 178, 0.75); }

  .bb-bar-val {
    font-family: var(--font-mono, 'IBM Plex Mono', monospace);
    font-size: 0.6rem;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .bb-val-baseline  { color: #be123c; opacity: 0.7; }
  .bb-val-optimized { color: #0891b2; }

  /* Badges */
  .bb-badges {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
  }

  .bb-badge-reduction,
  .bb-badge-speedup {
    font-family: var(--font-mono, 'IBM Plex Mono', monospace);
    font-size: 0.62rem;
    font-weight: 700;
    padding: 0.1rem 0.45rem;
  }

  .bb-badge-reduction {
    color: #059669;
    background: rgba(5, 150, 105, 0.12);
    border: 1px solid rgba(5, 150, 105, 0.3);
  }

  .bb-badge-speedup {
    color: #0891b2;
    background: rgba(8, 145, 178, 0.10);
    border: 1px solid rgba(8, 145, 178, 0.25);
  }

  .bb-badge-total {
    font-size: 0.68rem;
  }

  .bb-caption {
    padding: 0.45rem 1rem;
    border-top: 1px solid var(--color-border);
    font-family: var(--font-mono, 'IBM Plex Mono', monospace);
    font-size: 0.62rem;
    color: var(--color-text-dim);
    background: var(--color-bg);
    line-height: 1.5;
  }

  @media (max-width: 520px) {
    .bb-row {
      grid-template-columns: 1fr;
    }
    .bb-label {
      padding-right: 0;
    }
  }
</style>
