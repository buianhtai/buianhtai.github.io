---
/**
 * PatternLifecycle — Linear state machine diagram for lifecycle stages.
 *
 * Shows how an item progresses through ordered states, with optional
 * decay/regression arrow and per-state sublabels. No client JS required.
 *
 * Usage:
 *   <PatternLifecycle
 *     stages={[
 *       { id: "candidate",   label: "Candidate",   sublabel: "< 3 uses",       color: "amber" },
 *       { id: "established", label: "Established", sublabel: "3-10 uses",       color: "teal"  },
 *       { id: "proven",      label: "Proven",      sublabel: "> 10 uses",        color: "green" },
 *     ]}
 *     decayArrow={{ from: "proven", to: "candidate", label: "90-day decay" }}
 *     caption="Pattern maturity progression in the learning system."
 *   />
 */
interface Stage {
  id: string;
  label: string;
  sublabel?: string;
  color?: 'teal' | 'green' | 'amber' | 'rose';
}

interface DecayArrow {
  from: string;
  to: string;
  label?: string;
}

interface Props {
  stages: Stage[];
  decayArrow?: DecayArrow;
  caption?: string;
  label?: string;  // section label shown top-left
}

const { stages, decayArrow, caption, label } = Astro.props;

const colorMap: Record<string, string> = {
  teal:  'var(--lc-teal)',
  green: 'var(--lc-green)',
  amber: 'var(--lc-amber)',
  rose:  'var(--lc-rose)',
};
const bgMap: Record<string, string> = {
  teal:  'var(--lc-teal-bg)',
  green: 'var(--lc-green-bg)',
  amber: 'var(--lc-amber-bg)',
  rose:  'var(--lc-rose-bg)',
};
---

<div class="pl-wrap">
  {label && <div class="pl-label">{label}</div>}

  <div class="pl-track">
    {stages.map((stage, i) => {
      const c = stage.color ?? 'teal';
      return (
        <div class="pl-item">
          <div
            class="pl-node"
            style={`border-color: ${colorMap[c]}; background: ${bgMap[c]};`}
          >
            <div class="pl-node-label" style={`color: ${colorMap[c]};`}>{stage.label}</div>
            {stage.sublabel && <div class="pl-node-sub">{stage.sublabel}</div>}
          </div>
          {i < stages.length - 1 && (
            <div class="pl-arrow">
              <svg viewBox="0 0 40 20" class="pl-arrow-svg" aria-hidden="true">
                <line x1="2" y1="10" x2="30" y2="10" class="pl-arrow-line" />
                <polyline points="24,5 32,10 24,15" class="pl-arrow-head" />
              </svg>
            </div>
          )}
        </div>
      );
    })}
  </div>

  {decayArrow && (
    <div class="pl-decay">
      <div class="pl-decay-inner">
        <svg viewBox="0 0 100 32" preserveAspectRatio="none" class="pl-decay-svg" aria-hidden="true">
          <!-- curved return arrow -->
          <path d="M 95 8 Q 50 36 5 8" class="pl-decay-path" />
          <polyline points="10,3 5,8 12,11" class="pl-decay-head" />
        </svg>
        {decayArrow.label && <span class="pl-decay-label">{decayArrow.label}</span>}
      </div>
    </div>
  )}

  {caption && <div class="pl-caption">{caption}</div>}
</div>

<style>
  :root {
    --lc-teal:      #0891b2;
    --lc-teal-bg:   rgba(8, 145, 178, 0.08);
    --lc-green:     #059669;
    --lc-green-bg:  rgba(5, 150, 105, 0.08);
    --lc-amber:     #d97706;
    --lc-amber-bg:  rgba(217, 119, 6, 0.08);
    --lc-rose:      #e11d48;
    --lc-rose-bg:   rgba(225, 29, 72, 0.08);
  }

  .pl-wrap {
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    padding: 1rem 1.25rem 0.75rem;
    margin: 1.25rem 0;
    overflow: hidden;
  }

  .pl-label {
    font-family: var(--font-mono, 'IBM Plex Mono', monospace);
    font-size: 0.62rem;
    color: var(--color-text-dim);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 0.75rem;
  }

  .pl-track {
    display: flex;
    align-items: center;
    gap: 0;
    overflow-x: auto;
    padding-bottom: 0.25rem;
  }

  .pl-item {
    display: flex;
    align-items: center;
    gap: 0;
    flex-shrink: 0;
  }

  .pl-node {
    border: 1.5px solid;
    padding: 0.45rem 0.85rem;
    min-width: 7rem;
    text-align: center;
    flex-shrink: 0;
  }

  .pl-node-label {
    font-family: var(--font-mono, 'IBM Plex Mono', monospace);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  .pl-node-sub {
    font-family: var(--font-mono, 'IBM Plex Mono', monospace);
    font-size: 0.58rem;
    color: var(--color-text-dim);
    margin-top: 0.15rem;
  }

  .pl-arrow {
    width: 2.5rem;
    flex-shrink: 0;
  }

  .pl-arrow-svg {
    width: 100%;
    height: 1.25rem;
  }

  .pl-arrow-line {
    stroke: var(--color-text-dim);
    stroke-width: 1.5;
    fill: none;
  }

  .pl-arrow-head {
    stroke: var(--color-text-dim);
    stroke-width: 1.5;
    fill: none;
    stroke-linejoin: round;
    stroke-linecap: round;
  }

  /* Decay arrow — shown below the track */
  .pl-decay {
    margin-top: 0.25rem;
    padding: 0 0.5rem;
  }

  .pl-decay-inner {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .pl-decay-svg {
    width: 100%;
    height: 2rem;
  }

  .pl-decay-path {
    stroke: #e11d48;
    stroke-width: 1.5;
    fill: none;
    stroke-dasharray: 5 3;
  }

  .pl-decay-head {
    stroke: #e11d48;
    stroke-width: 1.5;
    fill: none;
    stroke-linejoin: round;
    stroke-linecap: round;
  }

  .pl-decay-label {
    font-family: var(--font-mono, 'IBM Plex Mono', monospace);
    font-size: 0.6rem;
    color: #e11d48;
    letter-spacing: 0.04em;
    margin-top: -0.25rem;
  }

  .pl-caption {
    border-top: 1px solid var(--color-border);
    margin-top: 0.75rem;
    padding-top: 0.45rem;
    font-family: var(--font-mono, 'IBM Plex Mono', monospace);
    font-size: 0.62rem;
    color: var(--color-text-dim);
    line-height: 1.5;
  }

  @media (max-width: 600px) {
    .pl-track {
      flex-direction: column;
      align-items: flex-start;
    }
    .pl-arrow {
      width: 1.25rem;
      transform: rotate(90deg);
    }
    .pl-decay {
      display: none;
    }
  }
</style>
