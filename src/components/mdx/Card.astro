---
interface Props {
  accent?: 'teal' | 'green' | 'amber' | 'rose';
  flush?: boolean;
}
const { accent, flush = false } = Astro.props;

const cssVars: Record<string, string> = {
  teal:  '--color-accent',
  green: '--color-green',
  amber: '--color-amber',
  rose:  '--color-rose',
};
const cssVar = accent ? cssVars[accent] : null;
---

<div
  class="card"
  style={cssVar && flush ? `--card-accent: var(${cssVar}); border-left: 3px solid var(${cssVar});` : ''}
>
  <slot />
</div>

<style>
  .card {
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    padding: 1.125rem;
    overflow: hidden;
    margin: 0.75rem 0;
  }
</style>
