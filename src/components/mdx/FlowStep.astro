---
interface Props {
  step: string | number;
  color?: 'teal' | 'green' | 'amber' | 'rose';
  title: string;
}
const { step, color = 'teal', title } = Astro.props;

const cssVars = {
  teal:  '--color-accent',
  green: '--color-green',
  amber: '--color-amber',
  rose:  '--color-rose',
};
const cssVar = cssVars[color];
---

<div class="flow-step" style={`--step-color: var(${cssVar});`}>
  <div class="flow-step-num">{step}</div>
  <div class="flow-step-body">
    <strong class="flow-step-title">{title}</strong>
    <div class="flow-step-content"><slot /></div>
  </div>
</div>

<style>
  .flow-step {
    display: flex;
    gap: 0.875rem;
    align-items: flex-start;
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--color-border);
    font-family: var(--font-mono);
  }
  .flow-step:last-child { border-bottom: none; }

  .flow-step-num {
    flex-shrink: 0;
    width: 2rem;
    height: 2rem;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--step-color);
    border: 1px solid var(--step-color);
    background: color-mix(in srgb, var(--step-color) 10%, transparent);
  }

  .flow-step-title {
    display: block;
    font-size: 0.82rem;
    color: var(--color-text);
    margin-bottom: 0.25rem;
    font-weight: 600;
  }

  .flow-step-content {
    font-size: 0.78rem;
    color: var(--color-text-dim);
    line-height: 1.6;
    font-family: var(--font-sans);
  }
  .flow-step-content :global(p) { margin: 0; }
</style>
