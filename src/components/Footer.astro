---
const year = new Date().getFullYear();
---

<footer style="border-top: 1px solid var(--color-border); margin-top: 4rem; background: var(--color-surface);">
  <!-- Status bar row -->
  <div class="footer-status-bar" style="display: flex; align-items: center; justify-content: space-between; padding: 0.4rem 1.25rem; border-bottom: 1px solid var(--color-border); font-family: var(--font-mono); font-size: 0.63rem; color: var(--color-text-muted);">
    <span class="footer-brand">
      <span style="color: var(--color-green);">●</span>
      &nbsp;tai.bui &mdash; learn in public
    </span>
    <span style="display: flex; gap: 1.25rem;">
      <a href="https://github.com/buianhtai" target="_blank" rel="noopener" style="color: var(--color-text-muted); text-decoration: none; transition: color 0.15s;" onmouseover="this.style.color='var(--color-accent)'" onmouseout="this.style.color='var(--color-text-muted)'">github</a>
      <a href="https://twitter.com/buianhtai90" target="_blank" rel="noopener" style="color: var(--color-text-muted); text-decoration: none; transition: color 0.15s;" onmouseover="this.style.color='var(--color-accent)'" onmouseout="this.style.color='var(--color-text-muted)'">x/twitter</a>
      <a href="/rss.xml" style="color: var(--color-text-muted); text-decoration: none; transition: color 0.15s;" onmouseover="this.style.color='var(--color-accent)'" onmouseout="this.style.color='var(--color-text-muted)'">rss</a>
    </span>
  </div>

  <!-- Bottom row -->
  <div style="display: flex; align-items: center; justify-content: space-between; max-width: 64rem; margin: 0 auto; padding: 0.6rem 1.25rem; font-family: var(--font-mono); font-size: 0.65rem; color: var(--color-text-muted);">
    <span>© {year} Tai Bui</span>
    <span style="opacity: 0.5;">built with astro</span>
  </div>
</footer>

<style>
  @media (max-width: 480px) {
    .footer-status-bar {
      flex-direction: column;
      gap: 0.5rem;
      align-items: flex-start !important;
    }
    .footer-brand {
      display: none;
    }
  }
</style>
