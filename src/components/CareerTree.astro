---
import cv from '../data/cv.json';
import CompanyLogo from './CompanyLogo.astro';
const themes = [
  { focus: 'Configurable platforms & AI', hub: 'Enterprise platforms', branches: ['AgentOS · deployed AI agents', 'PLM · dynamic models & rules', 'Workflows · tracking & reporting', 'Storage · configurable providers'], stack: ['Java / Quarkus', 'Neo4j', 'Camunda', 'AgentOS'] },
  { focus: 'Architecture across markets', hub: 'Embedded insurance', branches: ['Deployment · clouds & regions', 'Markets · country requirements', 'Constraints · GDPR & insurance', 'Engineering · refactoring & cost'], stack: ['Multi-cloud', 'Multi-region', 'Solution architecture', 'Hands-on refactoring'] },
  { focus: 'Commerce modernization', hub: 'Monolith to microservices', branches: ['Commerce · consignment & promotion', 'Operations · notifications & reports', 'Platform · files & data resolution', 'Delivery · APIs & code reviews'], stack: ['Java 17', 'Spring Boot / WebFlux', 'Kafka', 'AWS', 'Terraform'] },
  { focus: 'Enterprise integrations', hub: 'Connected business systems', branches: ['Housing · backend services', 'Healthcare · dental booking', 'Documents · bulk processing', 'Modernization · .NET to Java'], stack: ['Java', 'FileNet', 'PeopleSoft', 'Backend integrations'] },
  { focus: 'Payments & partners', hub: 'Payment gateway', branches: ['Partners · payment APIs', 'Wallet · payment acceptance', 'Banks · integrations'], stack: ['Java / Vert.x', 'Kafka / RabbitMQ', 'Redis', 'Cassandra / Oracle'] },
  { focus: 'Enterprise workflows', hub: 'ServiceNow integrations', branches: ['Automation · business rules', 'Integration · REST & web services', 'Governance · access controls'], stack: ['ServiceNow', 'REST', 'FTP', 'MID Server'] },
  { focus: 'Business software foundations', hub: 'Distribution management', branches: ['Operations · orders & invoices', 'Connectivity · ERP integrations', 'Delivery · teams of 3–5'], stack: ['SAP', 'Epicor', 'FAST / Effect', 'Team delivery'] },
];
---

<section class="career-explorer" aria-labelledby="career-tree-title" data-career-explorer>
  <header class="explorer-heading"><div><p class="eyebrow">01 / THE CAREER TREE</p><h2 id="career-tree-title">Growing systems. Expanding scope.</h2></div><p class="explorer-hint">Select a role to explore the platforms,<br class="desktop-break"/> contributions, and technologies behind it.</p></header>
  <div class="explorer-grid">
    <nav class="career-tree" id="career-tree" aria-label="Explore career roles">
      <div class="tree-cap"><span aria-hidden="true">↑</span> Most recent experience</div>
      <ol>
        {cv.jobs.map((job,index) => <li class:list={['tree-branch', { 'is-selected':index===0 }]}>
          <a class="role-node" href={`#career-panel-${index}`} data-career-role={index} aria-current={index===0?'true':undefined}>
            <span class="node-year">{job.dates.replace(' - ',' – ')}{index===0 && <span class="current-badge">CURRENT</span>}</span>
            <span class="node-company"><CompanyLogo company={job.company} /><strong>{job.company}</strong></span><span class="node-role">{job.role}</span>
            <span class="node-focus">{themes[index].focus}<span aria-hidden="true"> ↗</span></span>
          </a>
        </li>)}
      </ol>
      <div class="tree-root"><span aria-hidden="true">●</span> Foundations in enterprise software · 2012</div>
    </nav>
    <div class="career-panels">
      <p class="sr-only" data-career-announcement aria-live="polite" aria-atomic="true"></p>
      {cv.jobs.map((job,index) => <article class="career-panel" id={`career-panel-${index}`} data-career-panel={index} aria-labelledby={`career-company-${index}`} tabindex="-1">
        <div class="panel-topline"><span class="eyebrow">{index===0 ? 'CURRENT ROLE' : 'PREVIOUS EXPERIENCE'}</span><span>{job.dates.replace(' - ',' – ')}</span></div>
        <div class="panel-company"><CompanyLogo company={job.company} /><h3 id={`career-company-${index}`}>{job.company}</h3></div><p class="panel-role">{job.role}</p>
        {index===1 && <p class="promotion-note">Career progression: promoted from Lead Backend Engineer to Associate Technical Architect.</p>}
        <p class="panel-context">{job.context}</p>
        <p class="role-highlight">{job.bullets[index===0?1:0]}</p>
        <section class="work-map" aria-label={`Work overview at ${job.company}`}>
          <p class="map-caption">WHAT I WORKED ON</p>
          <div class="map-hub"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="8" y="2" width="8" height="6" rx="1"/><path d="M12 8v5M5 16v-3h14v3"/><rect x="2" y="16" width="6" height="6" rx="1"/><rect x="16" y="16" width="6" height="6" rx="1"/></svg>{themes[index].hub}</div>
          <ul class="map-leaves">{themes[index].branches.map(branch=><li><span>{branch.split(' · ')[0]}</span><strong>{branch.split(' · ')[1]}</strong></li>)}</ul>
        </section>
        <h4>Contributions</h4><ul class="contribution-list">{job.bullets.filter((_,bulletIndex)=>bulletIndex!==(index===0?1:0)).map(bullet=><li>{bullet}</li>)}</ul>
        <h4>Technology & practice</h4><ul class="technology-tags">{themes[index].stack.map(tag=><li>{tag}</li>)}</ul>
        <a class="back-to-tree" href="#career-tree">↑ Choose another role</a>
      </article>)}
    </div>
  </div>
</section>

<script>
  const explorer=document.querySelector<HTMLElement>('[data-career-explorer]');
  if(explorer){
    const roles=Array.from(explorer.querySelectorAll<HTMLAnchorElement>('[data-career-role]'));
    const panels=Array.from(explorer.querySelectorAll<HTMLElement>('[data-career-panel]'));
    const announcement=explorer.querySelector<HTMLElement>('[data-career-announcement]');
    const panelHome=explorer.querySelector<HTMLElement>('.career-panels')!;
    const mobile=window.matchMedia('(max-width:640px)');
    const arrangePanels=()=>{
      panels.forEach((panel,index)=>{
        const host=mobile.matches?roles[index].closest('li'):panelHome;
        host?.appendChild(panel);
      });
    };
    arrangePanels();mobile.addEventListener('change',arrangePanels);
    const select=(index:number, moveFocus=false)=>{
      roles.forEach((role,i)=>{
        if(i===index) role.setAttribute('aria-current','true'); else role.removeAttribute('aria-current');
        role.closest('li')?.classList.toggle('is-selected',i===index);
      });
      panels.forEach((panel,i)=>{panel.hidden=i!==index;});
      if(announcement) announcement.textContent=`Showing ${roles[index].querySelector('strong')?.textContent} experience`;
      if(moveFocus){
        panels[index].focus({preventScroll:true});
        if(!mobile.matches)panels[index].scrollIntoView({behavior:'instant',block:'nearest'});
      }
    };
    roles.forEach((role,index)=>role.addEventListener('click',event=>{event.preventDefault();select(index,true);history.replaceState(null,'',role.getAttribute('href')!);}));
    const fromHash=panels.findIndex(panel=>`#${panel.id}`===location.hash);
    select(fromHash>=0?fromHash:0);
    window.addEventListener('hashchange',()=>{const index=panels.findIndex(panel=>`#${panel.id}`===location.hash);if(index>=0) select(index);});
  }
</script>

<style>
  .role-highlight{font-size:.95rem;line-height:1.8;margin:20px 0;border-left:3px solid var(--color-accent);padding-left:16px}
  .node-year{flex-wrap:wrap;line-height:1.7}
  @media(max-width:640px){.tree-branch>.career-panel{margin-top:12px;margin-bottom:12px;padding:20px 16px}.tree-branch .panel-company{gap:12px}.tree-branch .work-map{padding:14px}}

  .node-company{display:flex;align-items:center;gap:12px;flex-wrap:wrap}.panel-company{display:flex;align-items:center;gap:16px;flex-wrap:wrap;margin-bottom:16px}.panel-company h3{margin:0}

  .career-explorer{padding-bottom:64px;color:var(--color-text)}
  .explorer-heading{display:flex;justify-content:space-between;align-items:end;gap:30px;margin-bottom:30px}
  .eyebrow{font-size:.65rem;letter-spacing:.13em;font-weight:600;color:var(--cv-muted);margin:0 0 12px}
  h2{font-family:'IBM Plex Serif',Georgia,serif;font-size:clamp(1.6rem,3vw,2.3rem);font-weight:500;letter-spacing:-.04em;line-height:1.25;margin:0}
  .explorer-hint{font-size:.78rem;line-height:1.8;color:var(--cv-muted);margin:0}
  .explorer-grid{display:grid;grid-template-columns:minmax(280px,.8fr) minmax(0,1.3fr);gap:36px;align-items:start}
  .career-tree{padding:4px 0;scroll-margin-top:100px}
  .tree-cap,.tree-root{font-size:.67rem;color:var(--cv-muted);line-height:1.7;display:flex;align-items:center;gap:14px}
  .tree-cap{padding-bottom:20px}.tree-cap span{color:var(--color-accent);font-size:1.2rem}
  .career-tree ol{list-style:none;margin:0 0 0 7px;padding:0 0 4px 30px;border-left:2px solid var(--color-border)}
  .tree-branch{position:relative;padding-bottom:14px}.tree-branch::before{content:'';position:absolute;left:-31px;top:31px;width:30px;border-top:2px solid var(--color-border)}
  .tree-branch::after{content:'';position:absolute;left:-36px;top:27px;width:8px;height:8px;background:var(--color-bg);border:2px solid var(--color-border);border-radius:50%}
  .tree-branch:nth-child(even){margin-left:22px}.tree-branch:nth-child(even)::before{left:-53px;width:52px}.tree-branch:nth-child(even)::after{left:-58px}
  .tree-branch.is-selected::before{border-color:var(--color-accent)}.tree-branch.is-selected::after{background:var(--color-accent);border-color:var(--color-accent)}
  .role-node{display:block;text-decoration:none;color:var(--color-text);border:1px solid var(--color-border);background:var(--color-surface);padding:16px 18px;border-radius:8px;transition:border-color .15s,background .15s}
  .role-node:hover{border-color:var(--color-accent)}.role-node[aria-current]{border-color:var(--color-accent);background:color-mix(in srgb,var(--color-accent) 7%,var(--color-surface));box-shadow:inset 3px 0 var(--color-accent)}
  .node-year{display:flex;align-items:center;gap:10px;color:var(--color-accent);font-size:.73rem;margin-bottom:8px;font-weight:600;font-variant-numeric:tabular-nums}
  .current-badge{font-size:.52rem;letter-spacing:.1em;border:1px solid var(--color-border);padding:3px 5px;border-radius:3px;color:var(--cv-muted)}
  .role-node strong{font-size:.92rem;line-height:1.5;display:block}.node-role{font-size:.8rem;line-height:1.6;display:block;color:var(--cv-muted);margin-top:4px}
  .node-focus{font-size:.75rem;display:block;margin-top:12px;color:var(--cv-muted);line-height:1.6}.node-focus span{color:var(--color-accent)}
  .tree-root{padding-top:12px}.tree-root span{margin-left:3px;color:var(--color-accent)}
  .career-panels{position:sticky;top:100px;min-width:0}
  .career-panel{border:1px solid var(--color-border);border-radius:12px;background:var(--color-surface);padding:clamp(22px,3vw,36px);scroll-margin-top:100px;margin-bottom:20px}
  .career-panel[hidden]{display:none}
  .panel-topline{display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap;margin-bottom:20px}.panel-topline .eyebrow{margin:0}.panel-topline>span:last-child{font-size:.65rem;color:var(--cv-muted);line-height:1.6}
  h3{font-family:'IBM Plex Serif',Georgia,serif;font-size:clamp(1.55rem,2.5vw,2.1rem);line-height:1.3;letter-spacing:-.035em;margin:0 0 12px;font-weight:500}
  .panel-role{font-size:.85rem;font-weight:600;line-height:1.7;margin:0 0 8px}.panel-context{font-size:.76rem;color:var(--cv-muted);line-height:1.7;margin:0}
  .promotion-note{font-size:.73rem;line-height:1.7;border-left:2px solid var(--color-accent);padding:8px 12px;background:var(--color-surface-2);margin:14px 0}
  .work-map{margin:26px 0;padding:20px;background:var(--color-bg);border:1px solid var(--color-border);border-radius:8px}
  .map-caption{font-size:.58rem;letter-spacing:.12em;color:var(--cv-muted);margin:0 0 18px}.map-hub{display:flex;gap:10px;align-items:center;font-size:.85rem;line-height:1.5;font-weight:600}.map-hub svg{color:var(--color-accent);flex-shrink:0}
  .map-leaves{list-style:none;padding:0 0 0 22px;margin:16px 0 0 10px;border-left:1px solid var(--color-accent);display:grid;gap:12px}
  .map-leaves li{position:relative;display:flex;gap:8px;flex-wrap:wrap;align-items:baseline;line-height:1.6}.map-leaves li::before{content:'';position:absolute;left:-22px;top:11px;width:14px;border-top:1px solid var(--color-accent)}
  .map-leaves span{font-size:.65rem;color:var(--cv-muted);min-width:75px}.map-leaves strong{font-size:.73rem;font-weight:500}
  h4{font-size:.72rem;letter-spacing:.02em;margin:24px 0 12px}.contribution-list{padding-left:17px;margin:0;list-style:disc}.contribution-list li{font-size:.9rem;line-height:1.85;padding-left:3px;margin-bottom:10px}.contribution-list li::marker{color:var(--color-accent)}
  .technology-tags{list-style:none;padding:0;margin:0;display:flex;flex-wrap:wrap;gap:7px}.technology-tags li{font-size:.65rem;line-height:1.6;border:1px solid var(--color-border);padding:5px 9px;border-radius:4px}
  .back-to-tree{display:inline-block;font-size:.73rem;color:var(--color-accent);margin-top:24px;text-underline-offset:5px;padding:8px 0}
  a:focus-visible,.career-panel:focus-visible{outline:2px solid var(--color-accent);outline-offset:4px}
  .sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
  @media(max-width:850px){.explorer-grid{grid-template-columns:minmax(230px,.8fr) minmax(0,1fr);gap:20px}.career-panel{padding:22px}.tree-branch:nth-child(even){margin-left:0}.tree-branch:nth-child(even)::before{left:-31px;width:30px}.tree-branch:nth-child(even)::after{left:-36px}.explorer-heading{display:block}.explorer-hint{margin-top:14px}.desktop-break{display:none}}
  @media(max-width:640px){.explorer-grid{grid-template-columns:1fr;gap:24px}.career-panels{position:static}.role-node{padding:12px 16px}.node-focus{margin-top:7px}.tree-branch{padding-bottom:10px}.career-tree ol{padding-left:26px}.tree-branch::before,.tree-branch:nth-child(even)::before{left:-27px;width:26px}.tree-branch::after,.tree-branch:nth-child(even)::after{left:-32px}.career-explorer{padding-bottom:40px}}
  @media(prefers-reduced-motion:reduce){.role-node{transition:none}}
  @media print{.career-explorer{display:none}}
</style>
