---
import type { CollectionEntry } from 'astro:content';
import { getPostSlug, seriesMeta } from '../lib/posts';

interface Props {
  currentSlug: string;
  series: string;
  lang: string;
  seriesPosts: CollectionEntry<'blog'>[];
}

const { currentSlug, series, lang, seriesPosts } = Astro.props;
const meta = seriesMeta[series];
const currentIndex = seriesPosts.findIndex((p) => getPostSlug(p) === currentSlug);
const currentOrder = currentIndex + 1;
const total = seriesPosts.length;
const prevPost = currentIndex > 0 ? seriesPosts[currentIndex - 1] : null;
const nextPost = currentIndex < seriesPosts.length - 1 ? seriesPosts[currentIndex + 1] : null;
---

<nav class="series-nav">
  <!-- Header bar -->
  <div class="series-header">
    <span class="series-prompt">$</span>
    <span>series: <strong style="color: var(--color-accent);">{meta?.title ?? series}</strong></span>
    <span class="series-progress">[{currentOrder}/{total}]</span>
  </div>

  <!-- Prev / Next -->
  <div class="series-nav-links">
    {prevPost ? (
      <a href={`/${lang}/blog/${getPostSlug(prevPost)}`} class="series-nav-link series-prev">
        <span class="series-nav-arrow">←</span>
        <span class="series-nav-label">{prevPost.data.title}</span>
      </a>
    ) : <div />}
    {nextPost ? (
      <a href={`/${lang}/blog/${getPostSlug(nextPost)}`} class="series-nav-link series-next">
        <span class="series-nav-label">{nextPost.data.title}</span>
        <span class="series-nav-arrow">→</span>
      </a>
    ) : <div />}
  </div>

  <!-- All posts toggle -->
  <details class="series-all">
    <summary class="series-all-toggle">
      <span class="series-prompt">$</span> ls series/{series}/
    </summary>
    <ol class="series-all-list">
      {seriesPosts.map((post, idx) => {
        const slug = getPostSlug(post);
        const isCurrent = slug === currentSlug;
        return (
          <li class={`series-all-item${isCurrent ? ' series-all-current' : ''}`}>
            <span class="series-all-num">{String(idx + 1).padStart(2, '0')}.</span>
            {isCurrent ? (
              <span class="series-all-title">{post.data.title} <span class="series-cursor">◀</span></span>
            ) : (
              <a href={`/${lang}/blog/${slug}`} class="series-all-title series-all-link">{post.data.title}</a>
            )}
          </li>
        );
      })}
    </ol>
  </details>
</nav>

<style>
  .series-nav {
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    margin-bottom: 2rem;
  }

  /* Header */
  .series-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.45rem 0.875rem;
    border-bottom: 1px solid var(--color-border);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--color-text-dim);
    background: var(--color-surface-2);
  }
  .series-prompt { color: var(--color-accent); font-weight: 700; }
  .series-progress { margin-left: auto; color: var(--color-text-muted); }

  /* Prev/Next links */
  .series-nav-links {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
    border-bottom: 1px solid var(--color-border);
  }
  .series-nav-link {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.65rem 0.875rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-text-dim);
    text-decoration: none;
    transition: color 0.15s, background 0.15s;
    min-width: 0;
  }
  .series-nav-link:hover {
    color: var(--color-accent);
    background: var(--color-accent-glow);
  }
  .series-prev { border-right: 1px solid var(--color-border); }
  .series-next { justify-content: flex-end; text-align: right; }
  .series-nav-label {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .series-nav-arrow { color: var(--color-accent); flex-shrink: 0; }

  /* All posts toggle */
  .series-all-toggle {
    padding: 0.45rem 0.875rem;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--color-text-muted);
    cursor: pointer;
    user-select: none;
    list-style: none;
    transition: color 0.15s;
  }
  .series-all-toggle:hover { color: var(--color-accent); }
  .series-all-toggle::-webkit-details-marker { display: none; }

  .series-all-list {
    list-style: none;
    margin: 0;
    padding: 0.25rem 0 0.5rem;
    border-top: 1px solid var(--color-border);
  }
  .series-all-item {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    padding: 0.2rem 0.875rem;
    font-size: 0.78rem;
  }
  .series-all-num {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: var(--color-text-muted);
    flex-shrink: 0;
    width: 1.6rem;
  }
  .series-all-title {
    color: var(--color-text-dim);
    text-decoration: none;
    line-height: 1.5;
  }
  .series-all-link:hover { color: var(--color-accent); }
  .series-all-current .series-all-title {
    color: var(--color-accent);
    font-weight: 600;
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }
  .series-cursor {
    font-size: 0.6rem;
    color: var(--color-accent);
    margin-left: 0.25rem;
    animation: blink-cur 1s step-end infinite;
  }
  @keyframes blink-cur {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }
</style>
