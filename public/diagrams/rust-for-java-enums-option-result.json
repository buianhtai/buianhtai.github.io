  "cards": [
    { "dot": "cyan", "title": "Each variant carries its own data", "items": ["Authorized always has a transaction_id; Declined always has a reason", "There's no way to construct an Authorized state missing its transaction_id"] },
    { "dot": "rose", "title": "match must be exhaustive", "items": ["Add a Refunded variant later, and every match without it fails to compile", "The compiler becomes a checklist for every place that needs updating"] }
